; Makes `dune exec protemu -- <command>` work from anywhere in the repository
; without installing the executable. See software/cli/protemu.ml.

(env
 (_
  (binaries
   (software/cli/protemu.exe as protemu))))

; The required verification tier is the ordinary bounded regression plus emitted-RTL
; checks. Longer seed sweeps remain explicit because their purpose is depth, not replacing
; evidence that must run on every change. The four-state alias is explicit as well even
; though its recorded bounded property remains part of ordinary @runtest.

(alias
 (name verification-required)
 (deps
  (alias_rec runtest)))

(alias
 (name verification)
 (deps
  (alias verification-required)
   (alias_rec rtl)))

; Bounded consumer adoption: no HDL tools, PDK access or implementation flow.
(alias
 (name pt3a)
 (deps
  (alias asic/verif/program_memory/runtest)
  (alias asic/verif/bundle/pt3a)))

; Opt-in emitted RTL replay with actual installed vendor functional models.
(alias
 (name pt3b)
 (deps
  (alias asic/verif/functional/pt3b)))

(rule
 (alias verification-long)
 (action
  (run %{exe:verif/regression/verification_sweep.exe} long)))

(rule
 (alias verification-four-state)
 (action
  (run %{exe:verif/regression/verification_sweep.exe} four-state)))
