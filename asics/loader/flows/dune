; hardcaml-asic flow collection v1
(rule
 (target generated.ml)
 (deps (source_tree .))
 (action
  (with-stdout-to %{target}
   (run %{bin:hardcaml-asic-starter} generate-collection asics/loader/flows %{deps}))))

(library
 (name electrum_loader_flows)
 (libraries core hardcaml_asic electrum_chip_project))
