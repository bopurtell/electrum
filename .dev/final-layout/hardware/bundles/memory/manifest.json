    {
      "key": "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS",
      "value": 0,
      "owner": "(Override\n \"design repair does not put a buffer on every top level output; on a fixed TT tile those buffers spend core area on a load OUTPUT_CAP_LOAD already states to timing analysis; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    { "key": "DIE_AREA", "value": "0 0 1289.28 710.64", "owner": "Target" },
    {
      "key": "FP_DEF_TEMPLATE",
      "value": "tech/ihp-sg13cmos5l/def/tt_block_6x4_pgvdd.def",
      "owner": "Target"
    },
    {
      "key": "FP_IO_HLENGTH",
      "value": 2,
      "owner": "(Override\n \"horizontal I/O pin shapes reach 2 um into the core, far enough for the router to land on a pin placed by the tile's DEF template; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "FP_IO_VLENGTH",
      "value": 2,
      "owner": "(Override\n \"vertical I/O pin shapes reach 2 um into the core; the TT block DEF places this tile's signal pins on its top edge, so this is the one that carries them; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "FP_PDN_MULTILAYER",
      "value": 0,
      "owner": "(Override\n \"single layer power distribution; a multilayer PDN puts straps on TopMetal1, which TT precheck forbids inside a tile; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "FP_PDN_VPITCH",
      "value": 50.0,
      "owner": "(Override\n \"vertical power straps every 50 um; with FP_PDN_VWIDTH this is how much routing resource the power grid takes out of the tile; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "FP_PDN_VWIDTH",
      "value": 2.1,
      "owner": "(Override\n \"vertical power straps are 2.1 um wide, the width the TT tile's power grid is cut for at the 50 um pitch above; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    { "key": "FP_SIZING", "value": "absolute", "owner": "Default" },
    { "key": "GND_PIN", "value": "VGND", "owner": "Target" },
    {
      "key": "GRT_ALLOW_CONGESTION",
      "value": 1,
      "owner": "(Override\n \"global routing reports congestion instead of failing the run; the die is fixed by the TT tile, so there is no floorplan to grow in response, and detailed routing is what decides whether the congestion was real; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "GRT_RESIZER_HOLD_SLACK_MARGIN",
      "value": 0.05,
      "owner": "(Override\n \"post global route hold repair targets 0.05 ns; lower than the placement margin because routing estimates are in hand by then and the buffers cost area; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "LEFT_MARGIN_MULT",
      "value": 6,
      "owner": "(Override\n \"core area is inset from the left die edge by six site widths; wider than the vertical insets, keeping the cell rows clear of the tile boundary it abuts; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "LINTER_INCLUDE_PDK_MODELS",
      "value": 1,
      "owner": "(Override\n \"lint with the PDK cell models in scope, so a standard cell the netlist instantiates is not reported as an undefined module; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "MAGIC_DEF_LABELS",
      "value": 0,
      "owner": "(Override\n \"Magic streams the GDS without copying the DEF's labels into it; the tile's pins travel in the LEF that MAGIC_WRITE_LEF_PINONLY produces, not as GDS text; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "MAGIC_WRITE_LEF_PINONLY",
      "value": 1,
      "owner": "(Override\n \"Magic writes a pin only LEF for the tile, with no internal obstructions; that is the abstract the TT top level abuts, and it describes the tile as its pins; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    { "key": "MAX_FANOUT_CONSTRAINT", "value": 10, "owner": "Target" },
    { "key": "OUTPUT_CAP_LOAD", "value": 6.0, "owner": "Target" },
    { "key": "PDK", "value": "ihp-sg13cmos5l", "owner": "Target" },
    {
      "key": "PL_RESIZER_HOLD_SLACK_MARGIN",
      "value": 0.1,
      "owner": "(Override\n \"post placement hold repair targets 0.1 ns of slack instead of zero, so hold is still met once CTS and routing replace the placement estimates; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "PL_TARGET_DENSITY_PCT",
      "value": 60,
      "owner": "(Override\n \"global placement fills 60% of the core area, leaving room for the hold repair buffers and the clock tree that the resizers and CTS add after it; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "RIGHT_MARGIN_MULT",
      "value": 6,
      "owner": "(Override\n \"core area is inset from the right die edge by six site widths, matching the left inset so the core stays centred in the tile; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    { "key": "RT_MAX_LAYER", "value": "Metal4", "owner": "Target" },
    {
      "key": "RUN_CTS",
      "value": 1,
      "owner": "(Override\n \"run clock tree synthesis; this is LibreLane's own default, stated explicitly so a change to that default cannot silently leave the design on the ideal clock net synthesis assumed; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "RUN_KLAYOUT_DRC",
      "value": 0,
      "owner": "(Override\n \"off: TT precheck runs the same KLayout decks over the submitted GDS after the flow (478.64s, zero items on 2026-09-18), so in flow DRC buys about eight minutes of duplicate coverage; the cost is that LibreLane records no klayout__drc_error__count, so collect reports no KLayout metric; set it to 1 when signoff has to be self contained; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    {
      "key": "RUN_KLAYOUT_XOR",
      "value": 0,
      "owner": "(Override\n \"off: the XOR compares the Magic and KLayout GDS streams for tool disagreement, which is not a rule check and is not what TT precheck repeats; set it to 1 to have the flow catch a streamer disagreement itself; ttihp-verilog-template b86a2a781484bcab7ba522dc5de540086695a430\")"
    },
    { "key": "RUN_LINTER", "value": 1, "owner": "Default" },
