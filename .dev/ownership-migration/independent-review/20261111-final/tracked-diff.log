-    verify_word(2, 16'h3080);
-    verify_word(3, 16'h1234);
-    verify_word(4, 16'h6001);
-    verify_word(5, 16'h0a63);
-    verify_word(6, 16'h0902);
-    verify_word(7, 16'h71ff);
-    verify_word(8, 16'h0000);
