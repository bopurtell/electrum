-    expect ~tag { Status.running with engines_idle = 1 } request Active_execution;
-    expect ~tag engines_busy request Engines_active;
-    expect
-      ~tag
-      Status.halted_idle
-      request
-      (match request with
-       | Run -> No_verified_image
-       | _ -> Image_bounds);
