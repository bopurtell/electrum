--- a/test/host_link/frame_tx/dune
+++ /dev/null
@@ -1,27 +0,0 @@
-; HL4c focused Cyclesim tests for Frame_tx (host_link_migration.md, HL4b4).
-;
-; The transmitter is driven through its public ports with explicit PHY-level events and
-; published frames, and checked against hand-written bits and cycles. The HL4a loader
-; harness in the parent directory stays the acceptance baseline for the composed loader;
-; this suite does not replace it.
-
-(library
- (name protemu_frame_tx_tests)
- (wrapped false)
- (modules
-  frame_tx_testbench
-  frame_tx_publication_tests
-  frame_tx_read_tests
-  frame_tx_lifecycle_tests
-  frame_tx_diagnostics_tests)
- ; Keep the ppx_expect source-tree workaround described in test/common/dune.
- (inline_tests
-  (flags
-   (:standard -source-tree-root .)))
- (libraries core hardcaml hardcaml_protemu protemu_host_link_wire)
- (preprocess
-  (pps ppx_hardcaml ppx_jane))
- (lint
-  (pps ppx_js_style))
- (flags
-  (:standard -w -27-57-33-34-35-40-63-47-26)))
diff --git a/test/host_link/frame_tx/frame_tx_diagnostics_tests.ml b/test/host_link/frame_tx/frame_tx_diagnostics_tests.ml
deleted file mode 100644
index a60bbde..0000000
--- a/test/host_link/frame_tx/frame_tx_diagnostics_tests.ml
+++ /dev/null
@@ -1,101 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_tx_diagnostics_tests.ml" *)
-(* HL4c: the Frame_tx checks detect the errors they exist for, and report enough to
-   reproduce them.
-
-   Each case states an expectation that is wrong, or waits for something that never
-   happens, and requires the check to raise [Tx_failure]. None of them changes the
-   transmitter or leaves a failing test in the suite. The first case prints a complete
-   report, so its format is reviewed here.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_tx_testbench
-
-let require_failure t what f =
-  match failure_of f with
-  | Some failure -> failure
-  | None -> fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-let%expect_test "a wrong bit is reported with the recent cycles" =
-  (* Stands in for a transmitter that presents the version byte's nibbles swapped. *)
-  let t = create ~transcript_cycles:4 "negative: wrong second byte" in
-  let _ : int = publish t (Frames.empty 0x5e) in
-  run t 2;
-  let _ : int = select t in
-  run t 3;
-  print_s
-    (require_failure t "a version byte of 01" (fun () ->
-       expect_read ~periods:[ 2 ] ~count:16 t "header" "\x5a\x01"));
-  [%expect
-    {|
-    (test/host_link/frame_tx/frame_tx_testbench.ml.Tx_failure
-     (scenario "negative: wrong second byte") (cycle 40) (phase Post_run)
-     (what "header: bits read, MSB first") (expected ("5a 01"))
-     (actual ("5a 10"))
-     (transcript
-      ((37 "rst=0 en=1 qual=0" "data=0 ready=1 pending=1")
-       (38 "rst=0 en=1 qual=0 fall" "data=0 ready=1 pending=1")
-       (39 "rst=0 en=1 qual=0" "data=0 ready=1 pending=1")
-       (40 "rst=0 en=1 qual=0 fall" "data=0 ready=1 pending=1"))))
-    |}]
-;;
-
-let%test_unit "a first bit expected in the assert cycle is detected" =
-  (* Stands in for a transmitter that presents the frame before it is armed. *)
-  let t = create "negative: first bit in the assert cycle" in
-  let bytes = "\x80" ^ String.make 7 '\x00' in
-  let _ : int = publish t bytes in
-  run t 2;
-  let asserted = select t in
-  run t 3;
-  ignore
-    (require_failure t "data in the assert cycle" (fun () ->
-       expect_data_cycles t ~from:asserted "early" (List.range asserted t.cycle))
-     : Sexp.t)
-;;
-
-let%test_unit "a commit expected one cycle early is detected" =
-  let t = create "negative: early commit" in
-  let bytes = Frames.empty 0x21 in
-  let _ : int = publish t bytes in
-  run t 2;
-  let { Read.asserted; released } = commit_read t "empty" bytes in
-  ignore
-    (require_failure t "pending low in the release cycle" (fun () ->
-       expect_pending_cycles t ~from:asserted "early" (List.range asserted released))
-     : Sexp.t)
-;;
-
-let%test_unit "a replay that does not restart at byte zero is detected" =
-  let t = create "negative: replay from byte one" in
-  let bytes = Frames.word 0x22 in
-  let _ : int = publish t bytes in
-  run t 2;
-  let _ : Read.t = partial_read t "first byte" bytes ~count:8 in
-  run t 4;
-  ignore
-    (require_failure t "a replay that continues" (fun () ->
-       ignore (commit_read t "continued" (String.drop_prefix bytes 1) : Read.t))
-     : Sexp.t)
-;;
-
-let%test_unit "waits are bounded and time out with a report" =
-  let t = create "negative: wait budget" in
-  let start = t.cycle in
-  ignore
-    (require_failure t "a wait for a response nobody publishes" (fun () ->
-       ignore (wait_for ~budget:25 t "pending" ~f:(fun s -> s.pending) : int))
-     : Sexp.t);
-  check
-    t
-    ~phase:Post_run
-    "cycles spent by the exhausted wait"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:25
-    (t.cycle - start)
-;;
diff --git a/test/host_link/frame_tx/frame_tx_lifecycle_tests.ml b/test/host_link/frame_tx/frame_tx_lifecycle_tests.ml
deleted file mode 100644
index 295b112..0000000
--- a/test/host_link/frame_tx/frame_tx_lifecycle_tests.ml
+++ /dev/null
@@ -1,342 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_tx_lifecycle_tests.ml" *)
-(* HL4c: [Frame_tx]'s reset and disable, and events that coincide at its boundary.
-
-   Reset clears every register at its edge; the outputs still show the old state in the
-   reset cycle itself. Disable gates the outputs low in the disabled cycle and clears
-   pending, the read, and the bit count at its edge; [pending_o] still shows the old state
-   in that cycle, which is how eligibility differs from [serial_ready_o]. Coincident
-   events resolve per register in the transmitter's statement order: publication, arming,
-   shift, release, disable. Tests named "robustness" drive coincidences the composed
-   loader cannot present; each says why.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_tx_testbench
-
-(* Where in a response's life a one-cycle reset or disable lands. *)
-module Point = struct
-  type t =
-    | Pending (* published, no read armed *)
-    | Armed (* a read armed, no fall yet *)
-    | Partial (* a read armed, 13 bits shifted *)
-    | Drained (* every bit shifted, not yet released *)
-  [@@deriving sexp_of, enumerate]
-end
-
-module Cancel = struct
-  type t =
-    | Reset
-    | Disable
-  [@@deriving sexp_of, enumerate]
-end
-
-(* Publish INFO, bring it to [point], and leave the read (if any) selected. *)
-let reach t (point : Point.t) bytes =
-  let _ : int = publish t bytes in
-  run t 3;
-  match point with
-  | Pending -> run t 4
-  | Armed ->
-    ignore (select t : int);
-    run t 4
-  | Partial ->
-    ignore (select t : int);
-    run t 3;
-    ignore (read_bits t 13 : bool list);
-    run t 2
-  | Drained ->
-    ignore (select t : int);
-    run t 3;
-    ignore (read_bits ~periods:[ 2 ] t (8 * String.length bytes) : bool list);
-    run t 2
-;;
-
-(* Apply [cancel] for exactly the next cycle and return that cycle. *)
-let cancel t (cancel : Cancel.t) =
-  let at = t.cycle in
-  (match cancel with
-   | Reset -> set t ~reset:true
-   | Disable -> set t ~enable:false);
-  cycle t;
-  set t ~reset:false ~enable:true;
-  at
-;;
-
-let%test_unit "reset and disable at each point discard the response; a fresh one follows" =
-  List.iter Cancel.all ~f:(fun how ->
-    List.iter Point.all ~f:(fun point ->
-      let name = Sexp.to_string [%sexp (how : Cancel.t), (point : Point.t)] in
-      let t = create name in
-      let bytes = Frames.info 0x44 in
-      reach t point bytes;
-      let before = observed t (t.cycle - 1) in
-      let at = cancel t how in
-      (* In the cancelling cycle: reset leaves the outputs as they were; disable gates the
-         pins but [pending_o] still shows the retained response.
-      *)
-      expect_sample
-        t
-        ~cycle:at
-        name
-        (match how with
-         | Reset -> before
-         | Disable -> { data = false; ready = false; pending = true });
-      (* The host carries on: falls, a release, and a new qualified selection with more
-         falls. None of it finds a response.
-      *)
-      List.iter (List.range 0 20) ~f:(fun _ ->
-        run t 3;
-        ignore (fall t : int));
-      run t 4;
-      ignore (deselect t : int);
-      run t 6;
-      ignore (select t : int);
-      List.iter (List.range 0 20) ~f:(fun _ ->
-        run t 3;
-        ignore (fall t : int));
-      ignore (deselect t : int);
-      run t 100;
-      expect_quiet t ~from:(at + 1) (name ^ " after cancellation");
-      let fresh = Frames.word 0x45 in
-      let _ : int = publish t fresh in
-      run t 3;
-      let _ : Read.t = commit_read t (name ^ ", fresh response") fresh in
-      ()))
-;;
-
-let%test_unit "a publication in a reset or disabled cycle leaves nothing to read" =
-  (* The dispatcher publishes whatever it decided in a reset or disabled cycle; the
-     transmitter must not retain it. Reset clears the store as well; disable leaves it
-     written but not pending, which nothing can observe.
-  *)
-  List.iter Cancel.all ~f:(fun how ->
-    let name = Sexp.to_string [%sexp "publication with", (how : Cancel.t)] in
-    let t = create name in
-    run t 3;
-    let at = t.cycle in
-    stage t (Frames.status 0x71);
-    ignore (cancel t how : int);
-    run t 4;
-    ignore (select t : int);
-    List.iter (List.range 0 30) ~f:(fun _ ->
-      run t 3;
-      ignore (fall t : int));
-    ignore (deselect t : int);
-    run t 50;
-    expect_quiet t ~from:at name;
-    let fresh = Frames.empty 0x72 in
-    let _ : int = publish t fresh in
-    run t 3;
-    let _ : Read.t = commit_read t (name ^ ", fresh response") fresh in
-    ())
-;;
-
-let%test_unit "disable coinciding with an assert, a fall, or a release still discards \
-               the response"
-  =
-  let coincide name bytes ~prepare ~events =
-    let t = create name in
-    let _ : int = publish t bytes in
-    run t 3;
-    prepare t;
-    let at = t.cycle in
-    events t;
-    ignore (cancel t Disable : int);
-    run t 4;
-    ignore (select t : int);
-    List.iter (List.range 0 10) ~f:(fun _ ->
-      run t 3;
-      ignore (fall t : int));
-    ignore (deselect t : int);
-    run t 20;
-    expect_sample t ~cycle:at name { data = false; ready = false; pending = true };
-    expect_quiet t ~from:(at + 1) name
-  in
-  let bytes = Frames.word 0x5f in
-  let total = 8 * String.length bytes in
-  (* Arming needs enable; the selection is not armed and the response is gone. *)
-  coincide
-    "disable with a qualified assert"
-    bytes
-    ~prepare:(fun _ -> ())
-    ~events:(fun t ->
-      set t ~qualified:true;
-      pulse t ~select_assert:true);
-  coincide
-    "disable with a fall"
-    bytes
-    ~prepare:(fun t ->
-      ignore (select t : int);
-      run t 3;
-      ignore (read_bits t 6 : bool list))
-    ~events:(fun t -> pulse t ~clock_fall:true);
-  coincide
-    "disable with a release before the final fall"
-    bytes
-    ~prepare:(fun t ->
-      ignore (select t : int);
-      run t 3;
-      ignore (read_bits t 6 : bool list))
-    ~events:(fun t -> pulse t ~select_release:true);
-  coincide
-    "disable with a committing release"
-    bytes
-    ~prepare:(fun t ->
-      ignore (select t : int);
-      run t 3;
-      ignore (read_bits t total : bool list);
-      run t 4)
-    ~events:(fun t -> pulse t ~select_release:true)
-;;
-
-let%test_unit "a release coinciding with a fall after the read is drained commits" =
-  (* A host that clocks past the frame's end: the extra fall changes nothing. *)
-  let t = create "drained fall with release" in
-  let bytes = Frames.empty 0x2e in
-  let _ : int = publish t bytes in
-  run t 3;
-  let asserted = select t in
-  run t 3;
-  expect_read t "empty" bytes;
-  run t 3;
-  let released = t.cycle in
-  pulse t ~clock_fall:true ~select_release:true;
-  cycle t;
-  run t 50;
-  expect_pending_cycles t ~from:asserted "commit" (List.range asserted (released + 1));
-  expect_quiet t ~from:(released + 1) "after the commit"
-;;
-
-let%test_unit "robustness: a final fall coinciding with the release does not commit" =
-  (* Outside the P3.5 envelope, which puts at least four cycles between the last fall and
-     the deselection. The release reads the count before the fall's edge, so the read is
-     not yet drained: the response is retained and the next read replays it.
-  *)
-  let t = create "final fall with release" in
-  let bytes = Frames.word 0x3d in
-  let total = 8 * String.length bytes in
-  let _ : int = publish t bytes in
-  run t 3;
-  let _ : int = select t in
-  run t 3;
-  expect_read ~count:(total - 1) t "word, all but the final fall" bytes;
-  run t 7;
-  let released = t.cycle in
-  pulse t ~clock_fall:true ~select_release:true;
-  cycle t;
-  run t 100;
-  expect_pending_cycles t ~from:released "retained" (List.range released t.cycle);
-  expect_data_cycles t ~from:(released + 1) "after the release" [];
-  let _ : Read.t = commit_read t "word replayed" bytes in
-  ()
-;;
-
-let%test_unit "robustness: a publication while a response is retained" =
-  (* The dispatcher never publishes while a response is retained: requests stay ineligible
-     until commit. These pin the per-register priorities anyway. Arming copies the store
-     into the shifter but not the length, so a publication at the start of a read, or
-     during one, changes where that read drains.
-  *)
-  let first = Frames.info 0x01 in
-  let second = Frames.word 0x02 in
-  let second_bits = 8 * String.length second in
-  (* With a qualified assert: the read shifts the old frame but drains at the new length;
-     its release then commits, consuming the new publication unread.
-  *)
-  let t = create "publication with an arming assert" in
-  let _ : int = publish t first in
-  run t 3;
-  stage t second;
-  set t ~qualified:true;
-  pulse t ~select_assert:true;
-  cycle t;
-  set t ~qualified:false;
-  run t 3;
-  expect_read ~count:second_bits t "the old frame, to the new length" first;
-  let drained_from = t.cycle in
-  List.iter (List.range 0 20) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  run t 4;
-  let released = deselect t in
-  run t 20;
-  expect_data_cycles t ~from:drained_from "drained at the new length" [];
-  expect_quiet t ~from:(released + 1) "after the commit";
-  (* During a read, released early: the read continues from the shifter, and the replay
-     presents the new frame from the store.
-  *)
-  let t = create "publication during a read, then a replay" in
-  let _ : int = publish t first in
-  run t 3;
-  let _ : int = select t in
-  run t 3;
-  expect_read ~count:40 t "the old frame, first 40 bits" first;
-  let _ : int = publish t second in
-  let rest = wire_bits first |> Fn.flip List.drop 40 |> Fn.flip List.take 16 in
-  let got = read_bits t (List.length rest) in
-  check
-    t
-    ~phase:Post_run
-    "the old frame, bits 40 to 55"
-    [%sexp_of: string]
-    [%equal: string]
-    ~expected:(hex_of_bits rest)
-    (hex_of_bits got);
-  run t 4;
-  ignore (deselect t : int);
-  run t 5;
-  let _ : Read.t = commit_read t "the new frame, replayed from the store" second in
-  (* During a read, read on: the old frame's bits continue up to the new length, and the
-     release commits.
-  *)
-  let t = create "publication during a read, then a commit" in
-  let _ : int = publish t first in
-  run t 3;
-  let _ : int = select t in
-  run t 3;
-  expect_read ~count:40 t "the old frame, first 40 bits" first;
-  let _ : int = publish t second in
-  let rest =
-    wire_bits first |> Fn.flip List.drop 40 |> Fn.flip List.take (second_bits - 40)
-  in
-  let got = read_bits t (List.length rest) in
-  check
-    t
-    ~phase:Post_run
-    "the old frame, bits 40 to the new length"
-    [%sexp_of: string]
-    [%equal: string]
-    ~expected:(hex_of_bits rest)
-    (hex_of_bits got);
-  let drained_from = t.cycle in
-  run t 4;
-  let released = deselect t in
-  run t 20;
-  expect_data_cycles t ~from:drained_from "drained at the new length" [];
-  expect_quiet t ~from:(released + 1) "after the commit";
-  (* With a committing release: the commit wins for pending, so the new frame is never
-     readable.
-  *)
-  let t = create "publication with a commit" in
-  let _ : int = publish t first in
-  run t 3;
-  let _ : int = select t in
-  run t 3;
-  expect_read t "the old frame" first;
-  run t 4;
-  let released = t.cycle in
-  stage t second;
-  pulse t ~select_release:true;
-  cycle t;
-  run t 5;
-  ignore (select t : int);
-  List.iter (List.range 0 20) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  ignore (deselect t : int);
-  run t 20;
-  expect_quiet t ~from:(released + 1) "after the commit"
-;;
diff --git a/test/host_link/frame_tx/frame_tx_publication_tests.ml b/test/host_link/frame_tx/frame_tx_publication_tests.ml
deleted file mode 100644
index a195645..0000000
--- a/test/host_link/frame_tx/frame_tx_publication_tests.ml
+++ /dev/null
@@ -1,177 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_tx_publication_tests.ml" *)
-(* HL4c: [Frame_tx] captures a published frame at the publication edge and retains it,
-   unchanged, until a read of it is committed.
-
-   Publications here are the dispatcher's: complete frames of each legal length,
-   zero-padded, with the strobe for one cycle, never while a response is retained. Tests
-   named "robustness" present what the dispatcher cannot; each says why.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_tx_testbench
-
-let%test_unit "each legal response length is captured at the publication edge and read \
-               out MSB first"
-  =
-  List.iter Frames.legal ~f:(fun (name, bytes) ->
-    let t = create ("capture: " ^ name) in
-    run t 3;
-    let from = t.cycle in
-    let published = publish t bytes in
-    run t 20;
-    (* Pending and ready rise at the publication edge, not in the publication cycle. *)
-    expect_pending_cycles t ~from name (List.range (published + 1) t.cycle);
-    expect_ready_cycles t ~from name (List.range (published + 1) t.cycle);
-    expect_data_cycles t ~from name [];
-    let { Read.released; _ } = commit_read t name bytes in
-    run t 200;
-    expect_quiet t ~from:(released + 1) (name ^ " after commit"))
-;;
-
-let%test_unit "a retained frame is unchanged by time and by other inputs until it is \
-               committed"
-  =
-  let t = create "retention" in
-  let bytes = Frames.status 0x5c in
-  let published = publish t bytes in
-  (* A long idle interval, unqualified selections, falls while no read is armed, and
-     qualification presented without a selection change nothing.
-  *)
-  run t 5000;
-  let _ : int = select ~qualified:false t in
-  run t 8;
-  List.iter (List.range 0 30) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  let _ : int = deselect t in
-  run t 20;
-  set t ~qualified:true;
-  run t 50;
-  set t ~qualified:false;
-  List.iter (List.range 0 10) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  run t 10;
-  expect_pending_cycles
-    t
-    ~from:(published + 1)
-    "retained"
-    (List.range (published + 1) t.cycle);
-  expect_data_cycles t ~from:(published + 1) "retained" [];
-  let _ : Read.t = commit_read t "retained STATUS" bytes in
-  ()
-;;
-
-let%test_unit "the store and the shifted copy are independent: every read starts from \
-               the stored frame"
-  =
-  let t = create "store versus shifter" in
-  let bytes = Frames.info 0x19 in
-  let _ : int = publish t bytes in
-  run t 5;
-  (* Each partial read shifts the copy; the store is unchanged, so each read restarts at
-     byte zero with the same frame.
-  *)
-  List.iter [ 1; 8; 57; 167 ] ~f:(fun count ->
-    run t 4;
-    ignore (partial_read t (sprintf "INFO, %d bits" count) bytes ~count : Read.t));
-  run t 4;
-  let _ : Read.t = commit_read t "INFO after four partial reads" bytes in
-  ()
-;;
-
-let%test_unit "consecutive publications and commits each deliver their own frame" =
-  let t = create "consecutive" in
-  List.iteri
-    (Frames.legal @ List.rev Frames.legal)
-    ~f:(fun index (name, bytes) ->
-      let from = t.cycle in
-      let published = publish t bytes in
-      run t (index % 3);
-      let { Read.released; _ } = commit_read t name bytes in
-      expect_pending_cycles t ~from name (List.range (published + 1) (released + 1));
-      run t 4)
-;;
-
-let%test_unit "robustness: frame and length inputs without the strobe are ignored" =
-  (* The dispatcher drives zero on both when it does not publish. *)
-  let t = create "unstrobed inputs" in
-  let bytes = Frames.word 0x66 in
-  List.iter (List.range 0 20) ~f:(fun _ ->
-    stage ~strobe:false t (Frames.info 0xee);
-    cycle t);
-  expect_quiet t ~from:reset_cycles "unstrobed inputs while idle";
-  let published = publish t bytes in
-  List.iter (List.range 0 20) ~f:(fun _ ->
-    stage ~strobe:false ~padding:0xff t (Frames.status 0xdd);
-    cycle t);
-  let _ : Read.t = commit_read t "word after unstrobed inputs" bytes in
-  expect_pending_cycles
-    t
-    ~from:published
-    "strobe"
-    (List.range (published + 1) (t.cycle - 1))
-;;
-
-let%test_unit "robustness: out-of-contract lengths and nonzero padding" =
-  (* The dispatcher publishes only 8, 10, 20, or 21 bytes, zero-padded. These show what
-     the transmitter does with anything else; none is behavior of the composed loader.
-  *)
-  (* Nonzero padding is never presented: the output is low once the read is drained. *)
-  let t = create "padding" in
-  let bytes = Frames.empty 0x01 in
-  stage ~padding:0xff t bytes;
-  cycle t;
-  run t 2;
-  let _ : Read.t = commit_read t "empty with ff padding" bytes in
-  (* Length 0 is drained when armed: nothing is presented, and the release commits without
-     any fall.
-  *)
-  let t = create "length 0" in
-  let published = t.cycle in
-  stage ~length:0 ~padding:0xff t "";
-  cycle t;
-  run t 2;
-  let asserted = select t in
-  run t 6;
-  let released = deselect t in
-  run t 2;
-  expect_data_cycles t ~from:published "length 0" [];
-  expect_pending_cycles
-    t
-    ~from:published
-    "length 0"
-    (List.range (published + 1) (released + 1));
-  ignore (asserted : int);
-  (* Length 31 counts 248 falls. The 168 stored bits come first, then zeros; a release
-     after 247 falls retains the response, and only the 248th fall lets a release commit.
-  *)
-  let t = create "length 31" in
-  let bytes = Frames.info 0x31 in
-  stage ~length:31 t bytes;
-  cycle t;
-  run t 2;
-  let asserted = select t in
-  run t 3;
-  expect_read ~periods:[ 2 ] t "length 31, stored bits" bytes;
-  expect_read
-    ~periods:[ 2 ]
-    ~count:79
-    t
-    "length 31, bits past the store"
-    (String.make 10 '\x00');
-  let released = deselect t in
-  run t 1;
-  expect_pending_cycles
-    t
-    ~from:asserted
-    "length 31 before its last fall"
-    (List.range asserted (released + 2));
-  let _ : Read.t =
-    commit_read ~periods:[ 2 ] t "length 31" (bytes ^ String.make 10 '\x00')
-  in
-  ()
-;;
diff --git a/test/host_link/frame_tx/frame_tx_read_tests.ml b/test/host_link/frame_tx/frame_tx_read_tests.ml
deleted file mode 100644
index cd7405d..0000000
--- a/test/host_link/frame_tx/frame_tx_read_tests.ml
+++ /dev/null
@@ -1,336 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_tx_read_tests.ml" *)
-(* HL4c: [Frame_tx]'s response reads: arming, shifting, replay, and commit.
-
-   A read is armed only by a select-assert event that finds a response already pending and
-   is qualified. Each fall event advances exactly one bit. A release consumes the response
-   only after the final fall; any earlier release, including one with the final bit
-   presented, leaves it retained, and the next read restarts at byte zero. Tests named
-   "robustness" present what the PHY or the dispatcher cannot; each says why.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_tx_testbench
-
-(* Arming. *)
-
-let%test_unit "an unqualified selection is not armed, and cannot shift or consume the \
-               response"
-  =
-  let t = create "unqualified" in
-  let bytes = Frames.word 0x24 in
-  let published = publish t bytes in
-  run t 3;
-  let from = t.cycle in
-  let _ : int = select ~qualified:false t in
-  run t 3;
-  List.iter (List.range 0 80) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  run t 4;
-  let _ : int = deselect t in
-  run t 6;
-  expect_data_cycles t ~from "unqualified selection" [];
-  expect_pending_cycles
-    t
-    ~from:published
-    "unqualified selection"
-    (List.range (published + 1) t.cycle);
-  let _ : Read.t = commit_read t "qualified read after it" bytes in
-  ()
-;;
-
-let%test_unit "a publication in the select-assert cycle does not arm that selection; one \
-               a cycle earlier does"
-  =
-  (* Pending in the assert cycle itself is what arms; nothing requires the response to
-     have been ready for the qualifying interval. The composed loader can present the
-     coincidence: an early selection whose assert event falls in the publication cycle.
-  *)
-  let t = create "publication with the assert" in
-  let bytes = Frames.empty 0x77 in
-  run t 4;
-  let asserted = t.cycle in
-  stage t bytes;
-  set t ~qualified:true;
-  pulse t ~select_assert:true;
-  cycle t;
-  set t ~qualified:false;
-  run t 3;
-  List.iter (List.range 0 70) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  run t 4;
-  let released = deselect t in
-  run t 10;
-  expect_data_cycles t ~from:asserted "coincident publication" [];
-  expect_pending_cycles
-    t
-    ~from:asserted
-    "coincident publication"
-    (List.range (asserted + 1) t.cycle);
-  ignore (released : int);
-  let _ : Read.t = commit_read t "the next qualified read" bytes in
-  (* The boundary case: published one cycle before a qualified assert. *)
-  let t = create "publication one cycle before the assert" in
-  let bytes = Frames.info 0x78 in
-  run t 4;
-  let published = publish t bytes in
-  let { Read.asserted; _ } = commit_read ~lead:1 t "published one cycle earlier" bytes in
-  check
-    t
-    ~phase:Post_run
-    "assert cycle"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:(published + 1)
-    asserted
-;;
-
-let%test_unit "an early selection before the publication cannot shift or consume it" =
-  let t = create "early selection" in
-  let bytes = Frames.status 0x5e in
-  run t 4;
-  let from = t.cycle in
-  let _ : int = select t in
-  run t 5;
-  List.iter (List.range 0 12) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  let published = publish t bytes in
-  List.iter (List.range 0 200) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  run t 4;
-  let _ : int = deselect t in
-  run t 8;
-  expect_data_cycles t ~from "early selection" [];
-  expect_pending_cycles t ~from "early selection" (List.range (published + 1) t.cycle);
-  let _ : Read.t = commit_read t "the next qualified read" bytes in
-  ()
-;;
-
-(* Shifting. *)
-
-let%test_unit "each fall advances exactly one bit, at its edge, at any spacing" =
-  List.iter
-    [ "2-cycle falls", [ 2 ]
-    ; "8-cycle falls", [ 8 ]
-    ; "irregular falls", [ 2; 5; 3; 17; 2; 9; 4 ]
-    ; "slow host", [ 22 ]
-    ]
-    ~f:(fun (name, periods) ->
-      let t = create name in
-      let bytes = Frames.info 0x3a in
-      let _ : int = publish t bytes in
-      run t 3;
-      let _ : Read.t = commit_read ~periods t name bytes in
-      ())
-;;
-
-let%test_unit "falls outside an armed read are ignored and the read still starts at bit \
-               zero"
-  =
-  let t = create "falls outside a read" in
-  let bytes = Frames.word 0x5b in
-  let _ : int = publish t bytes in
-  (* Deselected clocking, as a host might do between frames. *)
-  List.iter (List.range 0 50) ~f:(fun _ ->
-    run t 2;
-    ignore (fall t : int));
-  run t 4;
-  let _ : Read.t = commit_read t "after deselected falls" bytes in
-  ()
-;;
-
-let%test_unit "a selected pause holds the presented bit indefinitely" =
-  let t = create "pauses" in
-  let bytes = Frames.info 0x12 in
-  let _ : int = publish t bytes in
-  run t 3;
-  (* 10 000 cycles before the first fall, then a pause inside a byte and one on a byte
-     boundary.
-  *)
-  let periods = [ 10_000; 8; 8; 5_000; 8; 8; 8; 8; 8; 8; 8; 8; 7_000; 8 ] in
-  let _ : Read.t = commit_read ~periods t "paused read" bytes in
-  ()
-;;
-
-let%test_unit "the final bit, the drained boundary, and the output after it" =
-  let t = create "drained" in
-  let bytes = Frames.empty 0x2d in
-  let _ : int = publish t bytes in
-  run t 3;
-  let _ : int = select t in
-  run t 3;
-  expect_read ~count:63 t "empty, bits 0 to 62" bytes;
-  (* The last bit is presented until the final fall's edge, then the output is low. *)
-  let last = List.last_exn (wire_bits bytes) in
-  let from = t.cycle in
-  run t 5;
-  let final_fall = fall t in
-  run t 5;
-  expect_data_cycles
-    t
-    ~from
-    "last bit, then drained"
-    (if last then List.range from (final_fall + 1) else []);
-  (* Further falls change nothing; the release still commits. *)
-  List.iter (List.range 0 20) ~f:(fun _ ->
-    run t 3;
-    ignore (fall t : int));
-  run t 4;
-  let released = deselect t in
-  run t 20;
-  expect_data_cycles t ~from:(final_fall + 1) "after the final fall" [];
-  expect_pending_cycles
-    t
-    ~from:(final_fall + 1)
-    "commit"
-    (List.range (final_fall + 1) (released + 1))
-;;
-
-(* Replay and commit. *)
-
-let%test_unit "a release before the final fall retains the response; the next read \
-               restarts at byte zero"
-  =
-  List.iter
-    [ "empty", Frames.empty 0x10; "INFO", Frames.info 0x11 ]
-    ~f:(fun (name, bytes) ->
-      let total = 8 * String.length bytes in
-      (* No bit, one bit, part of a byte, a byte, and every bit but the final fall. *)
-      List.iter
-        [ 0; 1; 5; 8; total - 1 ]
-        ~f:(fun count ->
-          let t = create (sprintf "replay after %d of %d bits of %s" count total name) in
-          let _ : int = publish t bytes in
-          run t 3;
-          let { Read.released; _ } =
-            partial_read t (sprintf "%s, %d bits" name count) bytes ~count
-          in
-          run t 200;
-          expect_pending_cycles
-            t
-            ~from:released
-            "retained after the release"
-            (List.range released t.cycle);
-          let _ : Read.t = commit_read t (name ^ " replayed") bytes in
-          ()))
-;;
-
-let%test_unit "the final bit presented without the final fall is a replay, whatever the \
-               host saw"
-  =
-  (* The host validated the whole frame with LCLK high and deselected without the final
-     fall: P3.5's replay sequence. The last bit stays presented until the release.
-  *)
-  let t = create "final bit without the final fall" in
-  let bytes = Frames.status 0x6f in
-  let total = 8 * String.length bytes in
-  let _ : int = publish t bytes in
-  run t 3;
-  let _ : int = select t in
-  run t 3;
-  expect_read ~count:(total - 1) t "STATUS, all but the final fall" bytes;
-  let last = List.last_exn (wire_bits bytes) in
-  let from = t.cycle in
-  run t 12;
-  let released = deselect t in
-  run t 100;
-  expect_data_cycles
-    t
-    ~from
-    "last bit held until the release"
-    (if last then List.range from (released + 1) else []);
-  expect_pending_cycles t ~from "retained" (List.range from t.cycle);
-  let _ : Read.t = commit_read t "STATUS replayed" bytes in
-  ()
-;;
-
-let%test_unit "a committed response is consumed exactly once, with no stale readiness or \
-               data"
-  =
-  let t = create "commit once" in
-  let bytes = Frames.word 0x90 in
-  let _ : int = publish t bytes in
-  run t 3;
-  let { Read.released; _ } = commit_read t "word" bytes in
-  (* Later qualified selections find nothing pending: nothing is presented and nothing
-     reappears.
-  *)
-  List.iter (List.range 0 3) ~f:(fun _ ->
-    run t 6;
-    let _ : int = select t in
-    List.iter (List.range 0 90) ~f:(fun _ ->
-      run t 3;
-      ignore (fall t : int));
-    run t 3;
-    ignore (deselect t : int));
-  run t 1000;
-  expect_quiet t ~from:(released + 1) "after the commit";
-  (* A new publication is read in full. *)
-  let bytes = Frames.info 0x91 in
-  let _ : int = publish t bytes in
-  run t 3;
-  let _ : Read.t = commit_read t "next response" bytes in
-  ()
-;;
-
-let%test_unit "repeated replays leave the retained frame unchanged" =
-  let t = create "repeated replays" in
-  let bytes = Frames.info 0x4e in
-  let total = 8 * String.length bytes in
-  let _ : int = publish t bytes in
-  List.iter
-    [ 3; total - 1; 0; 100; 17; total - 1; 64 ]
-    ~f:(fun count ->
-      run t 5;
-      ignore (partial_read t (sprintf "replay of %d bits" count) bytes ~count : Read.t));
-  run t 5;
-  let _ : Read.t = commit_read t "INFO after seven replays" bytes in
-  ()
-;;
-
-let%test_unit "robustness: frame content is not interpreted; a first bit of one is \
-               presented from the cycle after the assert"
-  =
-  (* Every legal response starts with magic 5a, whose first bit is zero. This pattern
-     frame, which the dispatcher never builds, shows the first bit's timing directly and
-     exercises every bit position.
-  *)
-  let t = create "pattern frame" in
-  let bytes =
-    String.of_char_list
-      (List.map
-         [ 0x80
-         ; 0x01
-         ; 0xff
-         ; 0x00
-         ; 0xa5
-         ; 0x5a
-         ; 0x40
-         ; 0x02
-         ; 0xc3
-         ; 0x3c
-         ; 0x81
-         ; 0x7e
-         ; 0x20
-         ; 0x04
-         ; 0xf0
-         ; 0x0f
-         ; 0x10
-         ; 0x08
-         ; 0xaa
-         ; 0x55
-         ; 0xfe
-         ]
-         ~f:Char.of_int_exn)
-  in
-  let _ : int = publish t bytes in
-  run t 3;
-  let _ : Read.t = commit_read ~periods:[ 2; 3 ] t "pattern" bytes in
-  ()
-;;
diff --git a/test/host_link/frame_tx/frame_tx_testbench.ml b/test/host_link/frame_tx/frame_tx_testbench.ml
deleted file mode 100644
index 2c259ea..0000000
--- a/test/host_link/frame_tx/frame_tx_testbench.ml
+++ /dev/null
@@ -1,637 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_tx_testbench.ml" *)
-(* HL4c focused Cyclesim testbench for [Frame_tx].
-
-   The transmitter is driven only through its public ports: [Serial_phy]'s one-cycle
-   select-assert, select-release, and clock-fall events with its deselect qualification,
-   and [Command_dispatch]'s one-cycle publication of a complete frame and its length. The
-   PHY's synchronizers and the dispatcher are not part of this boundary. Every observation
-   is a public output: [serial_data_o], [serial_ready_o], and [pending_o]. Expected bits
-   and cycles are written by hand in the tests from the P3.5 record and
-   docs/host_link_hl4b4_record.md: a frame is its bytes in wire order, each most
-   significant bit first. None is computed from the transmitter. [Wire.Crc.compute] builds
-   stimulus only.
-
-   Scheduling contract:
-
-   1. Time. The unit is one system clock cycle. Cycle n is the interval before edge n.
-      Inputs set before [cycle] runs cycle n are applied for the whole of cycle n and
-      sampled at edge n. [cycle] is the only function that advances the simulator.
-   2. Levels ([reset], [enable], [qualified]) keep their value until a test changes them.
-      Events ([select_assert], [select_release], [clock_fall]) and the publication last
-      one cycle: [cycle] clears them after the edge, and the frame and length inputs
-      return to zero, as the dispatcher drives them when it is not publishing.
-   3. Within a cycle: apply the inputs; settle; take the pre-edge sample (the observation
-      for cycle n); clock the edge; take the post-edge sample.
-   4. Every output is a function of the transmitter's registers and [enable_i] alone. So
-      the post-edge sample of edge n (taken with cycle n's inputs) must equal the pre-edge
-      sample of cycle n+1 (taken after its new inputs settle) whenever enable is the same
-      in both cycles, and [pending_o] must be equal always. [cycle] checks this every
-      cycle.
-   5. Every wait has a finite cycle budget. An exhausted budget or a failed check raises
-      [Tx_failure] with the scenario, cycle, sampling phase, what was checked, the
-      expected and actual values, and the inputs and outputs of recent cycles.
-
-   PHY- and dispatcher-coherent stimulus (the default drivers) follows what the composed
-   loader can present: select-assert and select-release events alternate; falls are at
-   least two cycles apart; qualification is presented only with an assert event, as the
-   value the PHY computes for the deselected interval before it; and the dispatcher
-   publishes a complete frame of 8, 10, 20, or 21 bytes, zero-padded, never while a
-   response is retained. Probes outside that, or outside the P3.5 host envelope, are
-   labelled as robustness probes in the tests. Everything here is synchronous digital
-   evidence about this block's boundary.
-*)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-module Wire = Protemu_host_link_wire.Wire
-module Sim = Cyclesim.With_interface (Frame_tx.I) (Frame_tx.O)
-
-(* P3.5: one retained 21-byte response register; INFO is the largest response. *)
-let store_bytes = 21
-
-(* A frame as the dispatcher presents it: [bytes] in wire order, zero-padded to the store
-   ([padding] replaces the zeros in robustness probes), and a byte count.
-*)
-module Publication = struct
-  type t =
-    { bytes : string
-    ; padding : int
-    ; length : int
-    }
-  [@@deriving sexp_of]
-
-  let none = { bytes = ""; padding = 0; length = 0 }
-
-  let padded t =
-    t.bytes
-    ^ String.make (store_bytes - String.length t.bytes) (Char.of_int_exn t.padding)
-  ;;
-
-  let summary t =
-    let shown = String.prefix t.bytes 3 in
-    sprintf
-      "len=%d %s%s"
-      t.length
-      (String.concat_map shown ~f:(fun c -> sprintf "%02x" (Char.to_int c)))
-      (if String.length t.bytes > 3 then ".." else "")
-  ;;
-end
-
-(* The inputs applied for one cycle. *)
-module Inputs = struct
-  type t =
-    { reset : bool
-    ; enable : bool
-    ; qualified : bool
-    ; select_assert : bool
-    ; select_release : bool
-    ; clock_fall : bool
-    ; publish : bool
-    ; frame : Publication.t (* the frame and length inputs, with or without [publish] *)
-    }
-  [@@deriving sexp_of]
-
-  let idle =
-    { reset = false
-    ; enable = true
-    ; qualified = false
-    ; select_assert = false
-    ; select_release = false
-    ; clock_fall = false
-    ; publish = false
-    ; frame = Publication.none
-    }
-  ;;
-
-  let clear_events t =
-    { t with
-      select_assert = false
-    ; select_release = false
-    ; clock_fall = false
-    ; publish = false
-    ; frame = Publication.none
-    }
-  ;;
-
-  let summary t =
-    let bit b = if b then 1 else 0 in
-    let events =
-      List.filter_map
-        [ t.select_assert, "assert"
-        ; t.select_release, "release"
-        ; t.clock_fall, "fall"
-        ; t.publish, "publish " ^ Publication.summary t.frame
-        ; ( (not t.publish) && t.frame.length <> 0
-          , "unstrobed " ^ Publication.summary t.frame )
-        ]
-        ~f:(fun (on, name) -> Option.some_if on name)
-    in
-    sprintf
-      "rst=%d en=%d qual=%d%s"
-      (bit t.reset)
-      (bit t.enable)
-      (bit t.qualified)
-      (if List.is_empty events then "" else " " ^ String.concat ~sep:"," events)
-  ;;
-end
-
-(* One sample of every output. *)
-module Sample = struct
-  type t =
-    { data : bool
-    ; ready : bool
-    ; pending : bool
-    }
-  [@@deriving sexp_of, equal]
-
-  let of_outputs (o : Bits.t ref Frame_tx.O.t) =
-    let bool r = Bits.to_bool !r in
-    { data = bool o.serial_data_o
-    ; ready = bool o.serial_ready_o
-    ; pending = bool o.pending_o
-    }
-  ;;
-
-  let summary t =
-    let bit b = if b then 1 else 0 in
-    sprintf "data=%d ready=%d pending=%d" (bit t.data) (bit t.ready) (bit t.pending)
-  ;;
-end
-
-module Phase = struct
-  type t =
-    | Pre_edge (* the observation of a cycle, before its edge *)
-    | Post_edge (* after an edge, with that cycle's inputs still applied *)
-    | Post_run (* a check made by the test between cycles *)
-  [@@deriving sexp_of]
-end
-
-type t =
-  { scenario : string
-  ; sim : Sim.t
-  ; mutable inputs : Inputs.t (* applied to the next cycle *)
-  ; mutable cycle : int (* the next cycle to run *)
-  ; mutable settled : (Inputs.t * Sample.t) option (* last cycle's inputs, post-edge *)
-  ; applied : Inputs.t Queue.t (* index = cycle *)
-  ; observed : Sample.t Queue.t (* pre-edge samples; index = cycle *)
-  ; transcript_cycles : int
-  }
-
-exception
-  Tx_failure of
-    { scenario : string
-    ; cycle : int
-    ; phase : Phase.t
-    ; what : string
-    ; expected : Sexp.t option
-    ; actual : Sexp.t option
-    ; transcript : Sexp.t
-    }
-[@@deriving sexp_of]
-
-(* The inputs and outputs of the last [transcript_cycles] cycles run. *)
-let transcript t =
-  let first = Int.max 0 (t.cycle - t.transcript_cycles) in
-  List.range first t.cycle
-  |> List.map ~f:(fun cycle ->
-    [%sexp
-      (cycle : int)
-      , (Inputs.summary (Queue.get t.applied cycle) : string)
-      , (Sample.summary (Queue.get t.observed cycle) : string)])
-  |> Sexp.List
-;;
-
-let fail t ?(cycle = t.cycle - 1) ?expected ?actual ~phase what =
-  raise
-    (Tx_failure
-       { scenario = t.scenario
-       ; cycle
-       ; phase
-       ; what
-       ; expected
-       ; actual
-       ; transcript = transcript t
-       })
-;;
-
-let check t ?cycle ~phase what sexp_of equal ~expected actual =
-  if not (equal expected actual)
-  then fail t ?cycle ~phase what ~expected:(sexp_of expected) ~actual:(sexp_of actual)
-;;
-
-let bits_of_bytes bytes =
-  Bits.concat_msb
-    (List.map (String.to_list bytes) ~f:(fun c ->
-       Bits.of_int_trunc ~width:8 (Char.to_int c)))
-;;
-
-(* The single owner of simulator advancement; see items 2 to 4 of the contract. *)
-let cycle t =
-  let i = Cyclesim.inputs t.sim in
-  let before = Cyclesim.outputs ~clock_edge:Before t.sim in
-  let after = Cyclesim.outputs ~clock_edge:After t.sim in
-  let set port value = port := Bits.of_bool value in
-  let inputs = t.inputs in
-  set i.reset_i inputs.reset;
-  set i.enable_i inputs.enable;
-  set i.deselect_qualified_i inputs.qualified;
-  set i.select_assert_i inputs.select_assert;
-  set i.select_release_i inputs.select_release;
-  set i.clock_fall_i inputs.clock_fall;
-  set i.response_publish_i inputs.publish;
-  i.response_frame_i := bits_of_bytes (Publication.padded inputs.frame);
-  i.response_length_i := Bits.of_int_trunc ~width:5 inputs.frame.length;
-  Cyclesim.cycle_check t.sim;
-  Cyclesim.cycle_before_clock_edge t.sim;
-  let observed = Sample.of_outputs before in
-  Queue.enqueue t.applied inputs;
-  Queue.enqueue t.observed observed;
-  Option.iter t.settled ~f:(fun ((previous : Inputs.t), settled) ->
-    let comparable (s : Sample.t) =
-      if Bool.equal previous.enable inputs.enable
-      then s
-      else { s with data = false; ready = false }
-    in
-    check
-      t
-      ~cycle:t.cycle
-      ~phase:Pre_edge
-      "outputs after the new inputs settle equal the last edge's post-edge outputs"
-      [%sexp_of: Sample.t]
-      [%equal: Sample.t]
-      ~expected:(comparable settled)
-      (comparable observed));
-  Cyclesim.cycle_at_clock_edge t.sim;
-  Cyclesim.cycle_after_clock_edge t.sim;
-  t.settled <- Some (inputs, Sample.of_outputs after);
-  t.inputs <- Inputs.clear_events inputs;
-  t.cycle <- t.cycle + 1
-;;
-
-let run t cycles =
-  for _ = 1 to cycles do
-    cycle t
-  done
-;;
-
-(* Set levels for the next cycle onward; unnamed levels keep their value. *)
-let set ?reset ?enable ?qualified t =
-  let keep value current = Option.value value ~default:current in
-  t.inputs
-  <- { t.inputs with
-       reset = keep reset t.inputs.reset
-     ; enable = keep enable t.inputs.enable
-     ; qualified = keep qualified t.inputs.qualified
-     }
-;;
-
-(* Raise events for the next cycle only. *)
-let pulse ?(select_assert = false) ?(select_release = false) ?(clock_fall = false) t =
-  t.inputs
-  <- { t.inputs with
-       select_assert = t.inputs.select_assert || select_assert
-     ; select_release = t.inputs.select_release || select_release
-     ; clock_fall = t.inputs.clock_fall || clock_fall
-     }
-;;
-
-(* Present [bytes] for the next cycle only: a publication, or with [strobe = false] a
-   robustness probe that drives the frame and length inputs without the strobe. [length]
-   and [padding] override the contract values in robustness probes.
-*)
-let stage ?(strobe = true) ?length ?(padding = 0) t bytes =
-  let length = Option.value length ~default:(String.length bytes) in
-  t.inputs <- { t.inputs with publish = strobe; frame = { bytes; padding; length } }
-;;
-
-(* Reset is high in cycles 0 and 1, with everything else idle. [create] returns before
-   running cycle 2, the first cycle out of reset.
-*)
-let reset_cycles = 2
-
-let create ?(transcript_cycles = 12) scenario =
-  let sim = Sim.create (Frame_tx.create (Scope.create ~flatten_design:true ())) in
-  let t =
-    { scenario
-    ; sim
-    ; inputs = { Inputs.idle with reset = true }
-    ; cycle = 0
-    ; settled = None
-    ; applied = Queue.create ()
-    ; observed = Queue.create ()
-    ; transcript_cycles
-    }
-  in
-  check
-    t
-    ~phase:Post_run
-    "response_frame_i holds the 21-byte store"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:(store_bytes * 8)
-    (Bits.width !((Cyclesim.inputs sim).response_frame_i));
-  run t reset_cycles;
-  set t ~reset:false;
-  t
-;;
-
-(* The pre-edge observation of a cycle that has run. *)
-let observed t cycle =
-  if cycle < 0 || cycle >= t.cycle
-  then
-    fail
-      t
-      ~phase:Post_run
-      "observation of a cycle that has run"
-      ~actual:[%sexp { requested = (cycle : int); cycles_run = (t.cycle : int) }];
-  Queue.get t.observed cycle
-;;
-
-(* Coherent drivers. Each runs one cycle and returns the cycle of its event. *)
-
-let publish t bytes =
-  let at = t.cycle in
-  stage t bytes;
-  cycle t;
-  at
-;;
-
-(* An assert event, with [qualified] presented in that cycle only. *)
-let select ?(qualified = true) t =
-  let at = t.cycle in
-  set t ~qualified;
-  pulse t ~select_assert:true;
-  cycle t;
-  set t ~qualified:false;
-  at
-;;
-
-let deselect t =
-  let at = t.cycle in
-  pulse t ~select_release:true;
-  cycle t;
-  at
-;;
-
-let fall t =
-  let at = t.cycle in
-  pulse t ~clock_fall:true;
-  cycle t;
-  at
-;;
-
-(* Wire order: bytes in order, each most significant bit first. *)
-let wire_bits bytes =
-  List.concat_map (String.to_list bytes) ~f:(fun c ->
-    let byte = Char.to_int c in
-    List.init 8 ~f:(fun index -> (byte lsr (7 - index)) land 1 = 1))
-;;
-
-(* Read [count] bits of an armed read. Each bit is presented for [period] cycles: the
-   presented value must not change during them, and the last is a fall event cycle, whose
-   edge advances to the next bit. [period] may vary per bit ([periods], cycled); the PHY
-   cannot present falls less than two cycles apart. Returns the presented bits.
-*)
-let default_period = 8
-
-let read_bits ?(periods = [ default_period ]) t count =
-  let periods = Array.of_list periods in
-  let read = Queue.create () in
-  (* Bits are read in order; [List.init] does not promise an evaluation order. *)
-  for index = 0 to count - 1 do
-    let period = periods.(index % Array.length periods) in
-    let from = t.cycle in
-    run t (period - 1);
-    let _ : int = fall t in
-    let values =
-      List.range from t.cycle |> List.map ~f:(fun cycle -> (observed t cycle).data)
-    in
-    check
-      t
-      ~phase:Post_run
-      (sprintf "bit %d presented unchanged in cycles [%d, %d)" index from t.cycle)
-      [%sexp_of: bool list]
-      [%equal: bool list]
-      ~expected:(List.map values ~f:(fun _ -> List.hd_exn values))
-      values;
-    Queue.enqueue read (List.hd_exn values)
-  done;
-  Queue.to_list read
-;;
-
-(* Bits as hex bytes, for readable failures; a partial final byte is left-aligned. *)
-let hex_of_bits bits =
-  List.chunks_of bits ~length:8
-  |> List.map ~f:(fun chunk ->
-    List.foldi chunk ~init:0 ~f:(fun index acc b ->
-      if b then acc lor (0x80 lsr index) else acc)
-    |> sprintf "%02x")
-  |> String.concat ~sep:" "
-;;
-
-(* Read the first [count] bits of [bytes] (all of them by default) and check them. *)
-let expect_read ?periods ?count t what bytes =
-  let expected = wire_bits bytes in
-  let count = Option.value count ~default:(List.length expected) in
-  let expected = List.take expected count in
-  check
-    t
-    ~phase:Post_run
-    (what ^ ": bits read, MSB first")
-    [%sexp_of: string]
-    [%equal: string]
-    ~expected:(hex_of_bits expected)
-    (hex_of_bits (read_bits ?periods t count))
-;;
-
-(* Cycles in [from, until) in which a sampled flag was high. *)
-let high_cycles t ~from ~until ~f =
-  List.range from until |> List.filter ~f:(fun cycle -> f (observed t cycle))
-;;
-
-let expect_cycles t ~from ?(until = t.cycle) what ~f expected =
-  check
-    t
-    ~phase:Post_run
-    (sprintf "%s: high in cycles [%d, %d)" what from until)
-    [%sexp_of: int list]
-    [%equal: int list]
-    ~expected
-    (high_cycles t ~from ~until ~f)
-;;
-
-let expect_pending_cycles t ~from ?until what expected =
-  expect_cycles t ~from ?until (what ^ ": pending_o") ~f:(fun s -> s.pending) expected
-;;
-
-let expect_ready_cycles t ~from ?until what expected =
-  expect_cycles t ~from ?until (what ^ ": serial_ready_o") ~f:(fun s -> s.ready) expected
-;;
-
-let expect_data_cycles t ~from ?until what expected =
-  expect_cycles t ~from ?until (what ^ ": serial_data_o") ~f:(fun s -> s.data) expected
-;;
-
-let expect_sample t ~cycle what (expected : Sample.t) =
-  check
-    t
-    ~cycle
-    ~phase:Pre_edge
-    (what ^ ": outputs")
-    [%sexp_of: Sample.t]
-    [%equal: Sample.t]
-    ~expected
-    (observed t cycle)
-;;
-
-(* Nothing retained and nothing presented from [from] through the end of the run. *)
-let expect_quiet t ~from what =
-  expect_pending_cycles t ~from what [];
-  expect_ready_cycles t ~from what [];
-  expect_data_cycles t ~from what []
-;;
-
-(* Run until [f] holds for a cycle's pre-edge sample and return that cycle. Raises after
-   [budget] cycles.
-*)
-let wait_for ?(budget = 100) t what ~f =
-  let rec loop spent =
-    if spent >= budget
-    then
-      fail
-        t
-        ~phase:Pre_edge
-        ("wait for " ^ what)
-        ~actual:[%sexp { budget_exhausted = (budget : int) }]
-    else (
-      cycle t;
-      let seen = t.cycle - 1 in
-      if f (observed t seen) then seen else loop (spent + 1))
-  in
-  loop 0
-;;
-
-(* The event cycles of one complete read. *)
-module Read = struct
-  type t =
-    { asserted : int
-    ; released : int
-    }
-  [@@deriving sexp_of]
-end
-
-(* A qualified selection presents nothing in its assert cycle and the first bit of [bytes]
-   from the next cycle, before any fall. Runs [lead] - 1 cycles after the assert.
-*)
-let expect_armed t ~asserted ~lead what bytes =
-  run t (lead - 1);
-  let first = List.hd_exn (wire_bits bytes) in
-  expect_data_cycles
-    t
-    ~from:asserted
-    (what ^ " first bit, before any fall")
-    (if first then List.range (asserted + 1) t.cycle else [])
-;;
-
-(* A qualified selection that reads all of [bytes], supplies the final fall, waits [trail]
-   cycles, and releases. Checks the first bit's timing, every bit, the drained output
-   after the final fall, the commit edge (pending, ready low from the cycle after the
-   release), and that pending and ready were high throughout the read. Runs one cycle past
-   the release.
-*)
-let commit_read ?periods ?(lead = 4) ?(trail = 4) t what bytes =
-  let asserted = select t in
-  expect_armed t ~asserted ~lead what bytes;
-  expect_read ?periods t what bytes;
-  let drained_from = t.cycle in
-  run t trail;
-  let released = deselect t in
-  run t 1;
-  expect_data_cycles t ~from:drained_from (what ^ " after the final fall") [];
-  expect_pending_cycles
-    t
-    ~from:asserted
-    (what ^ " commit")
-    (List.range asserted (released + 1));
-  expect_ready_cycles
-    t
-    ~from:asserted
-    (what ^ " commit")
-    (List.range asserted (released + 1));
-  { Read.asserted; released }
-;;
-
-(* A qualified selection that reads [count] bits and releases without a further fall.
-   Checks the bits, and that the response is still retained after the release.
-*)
-let partial_read ?periods ?(lead = 4) ?(trail = 4) t what bytes ~count =
-  let asserted = select t in
-  expect_armed t ~asserted ~lead what bytes;
-  expect_read ?periods ~count t what bytes;
-  run t trail;
-  let released = deselect t in
-  run t 1;
-  expect_pending_cycles
-    t
-    ~from:asserted
-    (what ^ " retained")
-    (List.range asserted (released + 2));
-  { Read.asserted; released }
-;;
-
-(* [Some failure] when [f] raises [Tx_failure]. Used by the negative checks. *)
-let failure_of f =
-  match f () with
-  | (_ : unit) -> None
-  | exception (Tx_failure _ as failure) -> Some [%sexp (failure : exn)]
-;;
-
-(* Response frames the dispatcher builds, written from the P3.5 layouts: magic 5a, version
-   10, tag, command, result, little-endian payload length, payload, CRC-8/ATM.
-*)
-module Frames = struct
-  let bytes list = String.of_char_list (List.map list ~f:Char.of_int_exn)
-
-  let frame ~tag ~command ~result payload =
-    let body =
-      bytes ([ 0x5a; 0x10; tag; command; result; List.length payload; 0x00 ] @ payload)
-    in
-    body ^ String.of_char (Char.of_int_exn (Wire.Crc.compute body))
-  ;;
-
-  (* 8 bytes: STOP accepted, pending. *)
-  let empty tag = frame ~tag ~command:0x21 ~result:0x01 []
-
-  (* 10 bytes: READ_WORD of 0xbeef. *)
-  let word tag = frame ~tag ~command:0x12 ~result:0x00 [ 0xef; 0xbe ]
-
-  (* 20 bytes: a STATUS with every byte distinct. *)
-  let status tag =
-    frame
-      ~tag
-      ~command:0x01
-      ~result:0x00
-      [ 0x07; 0x00; 0x12; 0x00; 0x34; 0x00; 0x56; 0x00; 0x9a; 0x78; 0x00; 0x02 ]
-  ;;
-
-  (* 21 bytes: an INFO. *)
-  let info tag =
-    frame
-      ~tag
-      ~command:0x00
-      ~result:0x00
-      [ 0x01; 0x00; 0x01; 0x01; 0x7f; 0x00; 0x10; 0x00; 0x00; 0x01; 0x04; 0x00; 0x08 ]
-  ;;
-
-  (* Every legal length, with a distinct tag each. *)
-  let legal =
-    [ "empty (8 bytes)", empty 0x81
-    ; "word (10 bytes)", word 0x42
-    ; "STATUS (20 bytes)", status 0x3c
-    ; "INFO (21 bytes)", info 0xa7
-    ]
-  ;;
-end
diff --git a/test/host_link/serial_host/agent.ml b/test/host_link/serial_host/agent.ml
deleted file mode 100644
index f259553..0000000
--- a/test/host_link/serial_host/agent.ml
+++ /dev/null
@@ -1,42 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "agent.ml" *)
-(* The serial-host agent: its [Config], a [Driver] when active, and the passive [Monitor].
-
-   The agent owns no time and no sequencer. The environment steps the driver through
-   [Driver.Env.step] and calls [sample] once per cycle; a test's sequence is ordinary
-   calls on [driver_exn]. The monitor is independent of the driver even in one agent:
-   nothing here passes driver state to it. See docs/serial_host_pilot.md.
-*)
-
-open! Core
-
-type t =
-  { config : Config.t
-  ; driver : Driver.t option (* [None] exactly when passive *)
-  ; monitor : Monitor.t
-  }
-
-(* An active agent needs [host], the pin adapter and environment hooks for its driver; a
-   passive one must not be given them. Either mistake raises.
-*)
-let create ?host (config : Config.t) =
-  let driver =
-    match config.mode, host with
-    | Active, Some (pins, env) -> Some (Driver.create ~timing:config.timing pins env)
-    | Passive, None -> None
-    | Active, None ->
-      raise_s [%message "an active serial-host agent needs pins and environment hooks"]
-    | Passive, Some _ -> raise_s [%message "a passive serial-host agent has no driver"]
-  in
-  { config; driver; monitor = Monitor.create () }
-;;
-
-let driver_exn t =
-  match t.driver with
-  | Some driver -> driver
-  | None -> raise_s [%message "a passive serial-host agent has no driver"]
-;;
-
-let sample t ~cycle pins = Monitor.sample t.monitor ~cycle pins
-let observed t = Monitor.observed t.monitor
diff --git a/test/host_link/serial_host/config.ml b/test/host_link/serial_host/config.ml
deleted file mode 100644
index ffc83ca..0000000
--- a/test/host_link/serial_host/config.ml
+++ /dev/null
@@ -1,76 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "config.ml" *)
-(* Configuration for the serial-host agent: whether it drives the pins, the host's P3.5
-   timing envelope in system cycles, and the default budgets of its bounded waits.
-
-   docs/p3.5-hardware-loader.md owns the envelope; [Timing.validate] rejects host timing
-   outside it. A budget only bounds a wait so that a loader that never answers fails with
-   a report instead of hanging; it is not a protocol limit. See docs/serial_host_pilot.md.
-*)
-
-open! Core
-
-(* Host serial timing in system cycles. P3.5 requires at least four of each. *)
-module Timing = struct
-  type t =
-    { clock_low : int (* LCLK low; LDI setup before the rise *)
-    ; clock_high : int (* LCLK high; LDI hold after the rise *)
-    ; select_lead : int (* LSEL_N low before the first rise *)
-    ; select_trail : int (* last fall before LSEL_N high *)
-    ; deselect_gap : int (* LSEL_N high between frames *)
-    }
-  [@@deriving sexp_of]
-
-  let minimum = 4
-
-  let envelope =
-    { clock_low = 4; clock_high = 4; select_lead = 4; select_trail = 4; deselect_gap = 4 }
-  ;;
-
-  let validate t =
-    List.iter
-      [ "clock_low", t.clock_low
-      ; "clock_high", t.clock_high
-      ; "select_lead", t.select_lead
-      ; "select_trail", t.select_trail
-      ; "deselect_gap", t.deselect_gap
-      ]
-      ~f:(fun (field, cycles) ->
-        if cycles < minimum
-        then
-          raise_s
-            [%message
-              "host timing is outside the P3.5 envelope"
-                (field : string)
-                (cycles : int)
-                (minimum : int)])
-  ;;
-end
-
-(* Default cycles to wait for an LRDY rise before failing (docs/host_link_hl4a_record.md,
-   item 8).
-*)
-let ready_budget = 20_000
-
-(* An active agent drives the host pins through its [Driver] and monitors them; a passive
-   one only monitors.
-*)
-module Mode = struct
-  type t =
-    | Active
-    | Passive
-  [@@deriving sexp_of]
-end
-
-(* [timing] is the driver's starting timing; [Driver.set_timing] may change it later. A
-   passive agent ignores it.
-*)
-type t =
-  { mode : Mode.t
-  ; timing : Timing.t
-  }
-[@@deriving sexp_of]
-
-let active ?(timing = Timing.envelope) () = { mode = Active; timing }
-let passive = { mode = Passive; timing = Timing.envelope }
diff --git a/test/host_link/serial_host/driver.ml b/test/host_link/serial_host/driver.ml
deleted file mode 100644
index 378d809..0000000
--- a/test/host_link/serial_host/driver.ml
+++ /dev/null
@@ -1,312 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "driver.ml" *)
-(* The serial host's driver: it clocks request frames into LDI and response frames out of
-   LDO, in whole system cycles inside the P3.5 envelope of [Config.Timing].
-
-   The serial host is the link's master, so reading a response is driving too. The driver
-   works on logical pins through [Pins], never on a simulator. It advances time only
-   through the environment's [Env.step], which owns the cycle, and it reports transcript
-   events and failures through [Env.log] and [Env.fail], so the environment keeps its own
-   report format. It never reads the monitor: LRDY history comes from
-   [Pins.ready_changes], the environment's own sampled record.
-
-   One protocol check stays here: LDO must be low at every rise of a request bit. It is
-   keyed to what the driver is doing, which the passive monitor cannot see; SP4 in
-   docs/serial_host_pilot.md records why it was not moved to the monitor.
-*)
-
-open! Core
-module Wire = Protemu_host_link_wire.Wire
-module Timing = Config.Timing
-open Item
-
-(* The pin adapter. Host pins set here are applied by the environment from the next
-   [Env.step]; the DUT's pins are read as the environment sampled them, pre-edge.
-   [ready_changes ~since] is the environment's record of LRDY changes at or after [since],
-   oldest first; a change may lie before the current cycle.
-*)
-module Pins = struct
-  type t =
-    { set_select_n : bool -> unit (* LSEL_N *)
-    ; set_clock : bool -> unit (* LCLK *)
-    ; set_data : bool -> unit (* LDI *)
-    ; ldo : unit -> bool (* pre-edge LDO of the last cycle *)
-    ; ready_changes : since:int -> (int * bool) list
-    }
-end
-
-(* Transcript events the driver reports, in the cycle it reports them. [bytes] are raw. *)
-module Event = struct
-  type t =
-    | Select of bool (* host drives LSEL_N low when true *)
-    | Sent of
-        { bytes : string
-        ; extra_bits : int
-        }
-    | Response_read of
-        { bytes : string
-        ; outcome : Outcome.t
-        }
-  [@@deriving sexp_of]
-end
-
-(* A failed driver-side check, for the environment to report. *)
-module Failure = struct
-  module Kind = struct
-    type t =
-      | Host_sample (* the host's LDO sample, pre-edge in its LCLK rise cycle *)
-      | Ready_wait (* an exhausted wait for LRDY, checked pre-edge *)
-    [@@deriving sexp_of]
-  end
-
-  type t =
-    { kind : Kind.t
-    ; what : string
-    ; expected : Sexp.t
-    ; actual : Sexp.t
-    }
-  [@@deriving sexp_of]
-end
-
-(* Environment hooks. [step] runs one whole cycle (pins applied, sampled, clocked); [now]
-   is the cycle the next [step] runs; [fail] must not return.
-*)
-module Env = struct
-  type t =
-    { step : unit -> unit
-    ; now : unit -> int
-    ; log : Event.t -> unit
-    ; fail : 'a. Failure.t -> 'a
-    }
-end
-
-type t =
-  { pins : Pins.t
-  ; env : Env.t
-  ; mutable timing : Timing.t
-  }
-
-let create ?(timing = Timing.envelope) pins env =
-  Timing.validate timing;
-  { pins; env; timing }
-;;
-
-let timing t = t.timing
-
-let set_timing t timing =
-  Timing.validate timing;
-  t.timing <- timing
-;;
-
-let hold t cycles =
-  for _ = 1 to cycles do
-    t.env.step ()
-  done
-;;
-
-(* Host serial driver. Pins are applied by [Env.step]; these functions only set them and
-   hold the durations in [t.timing].
-*)
-
-let select t =
-  t.pins.set_select_n false;
-  t.env.log (Select true)
-;;
-
-(* LSEL_N high and LDI low from the current cycle; returns that cycle. *)
-let deselect t =
-  t.pins.set_select_n true;
-  t.pins.set_data false;
-  t.env.log (Select false);
-  t.env.now ()
-;;
-
-(* One request bit: LDI changes with the preceding fall, is held [clock_low] cycles before
-   the rise and [clock_high] after it. At each rise LDO must be low: a selection that is
-   sending a request is never also shifting out a response.
-*)
-let send_bit t value =
-  t.pins.set_data value;
-  t.pins.set_clock false;
-  hold t t.timing.clock_low;
-  t.pins.set_clock true;
-  t.env.step ();
-  if t.pins.ldo ()
-  then
-    t.env.fail
-      { kind = Host_sample
-      ; what = "LDO stays low while a request is clocked in"
-      ; expected = [%sexp false]
-      ; actual = [%sexp true]
-      };
-  hold t (t.timing.clock_high - 1);
-  t.pins.set_clock false
-;;
-
-(* Clocks [bytes], then the first [extra_bits] bits of [extra_byte]; all MSB first. *)
-let send t ?(extra_bits = 0) ?(extra_byte = '\xff') bytes =
-  t.env.log (Sent { bytes; extra_bits });
-  String.iter bytes ~f:(fun byte -> List.iter (bits_of_byte byte) ~f:(send_bit t));
-  List.iter (List.take (bits_of_byte extra_byte) extra_bits) ~f:(send_bit t)
-;;
-
-(* The last [8 - bits] bits of [byte], completing a byte begun with [~extra_bits:bits]. *)
-let send_rest_of_byte t byte ~bits =
-  List.iter (List.drop (bits_of_byte byte) bits) ~f:(send_bit t)
-;;
-
-(* LSEL_N low, then [select_lead] cycles before the first rise. The first bit's setup
-   interval ([clock_low]) is part of the lead.
-*)
-let begin_frame t =
-  select t;
-  hold t (Int.max 0 (t.timing.select_lead - t.timing.clock_low))
-;;
-
-(* [select_trail] cycles after the last fall, then LSEL_N high; returns that cycle. The
-   caller holds the gap.
-*)
-let end_frame t =
-  hold t t.timing.select_trail;
-  deselect t
-;;
-
-(* A complete selected frame, including the trailing gap; returns the deselection cycle. *)
-let send_frame t ?extra_bits ?extra_byte bytes =
-  begin_frame t;
-  send t ?extra_bits ?extra_byte bytes;
-  let deselected = end_frame t in
-  hold t t.timing.deselect_gap;
-  deselected
-;;
-
-(* First LRDY rise at or after [since], advancing at most [budget] cycles. *)
-let wait_ready ?(budget = Config.ready_budget) t ~since =
-  let rec loop spent =
-    match
-      List.find (t.pins.ready_changes ~since) ~f:(fun (_, ready) -> ready)
-      |> Option.map ~f:fst
-    with
-    | Some rise -> rise
-    | None ->
-      if spent >= budget
-      then
-        t.env.fail
-          { kind = Ready_wait
-          ; what = sprintf "LRDY rises within %d cycles of cycle %d" budget since
-          ; expected = [%sexp true]
-          ; actual = [%sexp false]
-          }
-      else (
-        t.env.step ();
-        loop (spent + 1))
-  in
-  loop 0
-;;
-
-(* One response bit: [clock_low] cycles low, then a rise whose cycle samples LDO. With
-   [final], LCLK is left high after the sample.
-*)
-let read_bit ?(final = false) ?(high_pause = 0) t =
-  t.pins.set_clock false;
-  hold t t.timing.clock_low;
-  t.pins.set_clock true;
-  t.env.step ();
-  let value = t.pins.ldo () in
-  hold t high_pause;
-  if not final
-  then (
-    hold t (t.timing.clock_high - 1);
-    t.pins.set_clock false);
-  value
-;;
-
-(* Stops a selected response read before its final bit: [select_trail] cycles after the
-   last fall, LSEL_N high, then the gap. Returns the deselection cycle.
-*)
-let abandon_response t =
-  let deselected = end_frame t in
-  hold t t.timing.deselect_gap;
-  deselected
-;;
-
-(* After the final rise and validation, with LCLK high. Commit supplies the final fall;
-   replay deselects first and leaves the final fall out. Returns the deselection cycle.
-*)
-let finish_response t (outcome : Outcome.t) =
-  hold t (t.timing.clock_high - 1);
-  let deselected =
-    match outcome with
-    | Commit ->
-      t.pins.set_clock false;
-      end_frame t
-    | Replay ->
-      let deselected = deselect t in
-      hold t t.timing.clock_high;
-      t.pins.set_clock false;
-      deselected
-  in
-  hold t t.timing.deselect_gap;
-  deselected
-;;
-
-(* Reads the response through its final rise, validates it with LCLK high, and finishes
-   with [decide]'s outcome. The length comes from the received header; a declared payload
-   beyond the largest response is read only to the maximum frame length, so the decoder
-   reports it.
-*)
-let read_response t ?expected ?(pause : Pause.t option) ~decide () =
-  begin_frame t;
-  let selected = t.env.now () in
-  let bits = Queue.create () in
-  let read_one ~final =
-    let count = Queue.length bits + 1 in
-    let pause_here = Option.filter pause ~f:(fun pause -> pause.after_bits = count) in
-    let high_pause =
-      match pause_here with
-      | Some { cycles; clock_high = true; _ } -> cycles
-      | _ -> 0
-    in
-    Queue.enqueue bits (read_bit t ~final ~high_pause);
-    match pause_here with
-    | Some { cycles; clock_high = false; _ } -> hold t cycles
-    | _ -> ()
-  in
-  for _ = 1 to 8 * Wire.Response.header_length do
-    read_one ~final:false
-  done;
-  let header = bytes_of_bits (Queue.to_list bits) in
-  let declared = Wire.U16.get header ~pos:Wire.Response.Offset.payload_length in
-  let total =
-    Int.min
-      (Wire.Response.header_length + declared + Wire.Crc.length)
-      Wire.Response.max_length
-  in
-  for index = (8 * Wire.Response.header_length) + 1 to 8 * total do
-    read_one ~final:(index = 8 * total)
-  done;
-  let bytes = bytes_of_bits (Queue.to_list bits) in
-  let decoded =
-    match expected with
-    | Some expected -> Wire.Response.decode_correlated ~expected bytes
-    | None -> Wire.Response.decode bytes
-  in
-  let outcome = decide decoded in
-  t.env.log (Response_read { bytes; outcome });
-  let deselected = finish_response t outcome in
-  { Read.selected; deselected; bytes; decoded; outcome }
-;;
-
-(* Reads the first [bits] bits of a response and deselects before the final bit. Returns
-   the bits read, packed MSB first, and the deselection cycle.
-*)
-let read_prefix t ~bits =
-  begin_frame t;
-  let values = Queue.create () in
-  for _ = 1 to bits do
-    Queue.enqueue values (read_bit t)
-  done;
-  let deselected = abandon_response t in
-  bytes_of_bits (Queue.to_list values), deselected
-;;
diff --git a/test/host_link/serial_host/dune b/test/host_link/serial_host/dune
deleted file mode 100644
index 04dca56..0000000
--- a/test/host_link/serial_host/dune
+++ /dev/null
@@ -1,18 +0,0 @@
-; Serial-host agent library for the Host_link serial interface (serial_host_pilot.md).
-;
-; Items, configuration, driver, passive monitor and agent for the host side of the P3.5
-; serial link. There are no inline_tests, so endpoint, system and package suites can
-; depend on it without linking another suite's tests; its tests live in the HL4a suite in
-; the parent directory. The driver and monitor work on logical pins as booleans, so
-; nothing here needs Hardcaml; the suite's adapter maps them to the DUT's ports.
-
-(library
- (name protemu_serial_host_agent)
- (modules item config driver monitor agent)
- (libraries core protemu_host_link_wire)
- (preprocess
-  (pps ppx_jane))
- (lint
-  (pps ppx_js_style))
- (flags
-  (:standard -w -27-57-33-34-35-40-63-47-26)))
diff --git a/test/host_link/serial_host/item.ml b/test/host_link/serial_host/item.ml
deleted file mode 100644
index 4f5cc57..0000000
--- a/test/host_link/serial_host/item.ml
+++ /dev/null
@@ -1,180 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "item.ml" *)
-(* Items for the serial-host agent: the transactions that cross the Host_link serial
-   boundary, and the pure helpers that build and read their bytes.
-
-   Product protocol types stay in [Protemu_host_link_wire.Wire]; items refer to them and
-   never redefine them. Nothing here touches a simulator. [Driver] clocks these items
-   through the pins; [Monitor] rebuilds the [Observed] items from them. See
-   docs/serial_host_pilot.md.
-*)
-
-open! Core
-module Wire = Protemu_host_link_wire.Wire
-
-(* Bytes as space-separated hex, for transcripts and failure reports. *)
-let hex bytes =
-  String.to_list bytes
-  |> List.map ~f:(fun byte -> sprintf "%02x" (Char.to_int byte))
-  |> String.concat ~sep:" "
-;;
-
-(* The serial link is MSB first: a byte's bits in send order, and bits back to bytes. *)
-let bits_of_byte byte =
-  List.init 8 ~f:(fun index -> Char.to_int byte land (0x80 lsr index) <> 0)
-;;
-
-let bytes_of_bits bits =
-  List.chunks_of bits ~length:8
-  |> List.map ~f:(fun byte ->
-    List.fold byte ~init:0 ~f:(fun value bit -> (value lsl 1) lor Bool.to_int bit)
-    |> Char.of_int_exn)
-  |> String.of_char_list
-;;
-
-(* The host's choice after validating a response with LCLK high: commit supplies the final
-   fall; replay deselects first so the loader retains the response.
-*)
-module Outcome = struct
-  type t =
-    | Commit
-    | Replay
-  [@@deriving sexp_of, compare, equal]
-end
-
-(* A pause inside a selected response read, after bit [after_bits] (counting from one).
-   With [clock_high] the pause follows that bit's sample with LCLK still high; otherwise
-   it follows the bit's fall.
-*)
-module Pause = struct
-  type t =
-    { after_bits : int
-    ; cycles : int
-    ; clock_high : bool
-    }
-end
-
-(* Validation before the final fall: commit a decodable, correlated response; replay
-   anything else.
-*)
-let commit_if_valid : (Wire.Response.t, _) Result.t -> Outcome.t = function
-  | Ok _ -> Commit
-  | Error _ -> Replay
-;;
-
-(* One response read: its selection and deselection cycles, the bytes read, their
-   decoding, and the outcome the host chose.
-*)
-module Read = struct
-  type t =
-    { selected : int
-    ; deselected : int
-    ; bytes : string
-    ; decoded : (Wire.Response.t, Wire.Response.Decode_error.t) Result.t
-    ; outcome : Outcome.t
-    }
-end
-
-(* The cycles and response of a committed request/response transaction. *)
-module Exchange = struct
-  type t =
-    { started : int (* cycle LSEL_N was asserted for the request *)
-    ; request_deselected : int
-    ; ready : int
-    ; response_selected : int
-    ; response_deselected : int
-    ; bytes : string
-    ; response : Wire.Response.t
-    }
-end
-
-(* A legal request frame from the codec; an encode error is a bug in the test. *)
-let encode ~tag request =
-  match Wire.Request.encode ~tag request with
-  | Ok frame -> frame
-  | Error error ->
-    raise_s [%message "bad test request" (error : Wire.Request.Encode_error.t)]
-;;
-
-(* Malformed request frames, built byte by byte. [Wire.Request.encode] builds only legal
-   frames, so intentional corruption lives here, never in the codec. [crc] uses the
-   software CRC over the bytes given.
-*)
-module Raw = struct
-  let crc body = String.of_char (Char.of_int_exn (Wire.Crc.compute body))
-
-  let body ?(magic = 0xa5) ?(version = 0x10) ?payload_length ~tag ~command payload =
-    let payload_length = Option.value payload_length ~default:(List.length payload) in
-    String.of_char_list
-      (List.map
-         ([ magic; version; tag; command; payload_length land 0xff; payload_length lsr 8 ]
-          @ payload)
-         ~f:Char.of_int_exn)
-  ;;
-
-  (* Header, payload, and a correct CRC for them. *)
-  let frame ?magic ?version ?payload_length ~tag ~command payload =
-    let body = body ?magic ?version ?payload_length ~tag ~command payload in
-    body ^ crc body
-  ;;
-
-  let flip_last frame ~mask =
-    let last = String.length frame - 1 in
-    String.prefix frame last
-    ^ String.of_char (Char.of_int_exn (Char.to_int frame.[last] lxor mask))
-  ;;
-
-  let zeros count = String.make count '\x00'
-end
-
-(* What the passive monitor saw cross the pins in one selection, LSEL_N low to LSEL_N
-   high. Each item is rebuilt from the sampled pins alone, never from what the driver
-   intended. [selected] is the first cycle with LSEL_N low and [deselected] the first
-   cycle with it high again. Bits are sampled at each LCLK rise, pre-edge, in the rise
-   cycle; whole bytes are packed MSB first and [extra_bits] holds the bits of a final
-   partial byte in clocked order.
-*)
-module Observed = struct
-  (* How a response read ended. *)
-  module Ending = struct
-    type t =
-      | Commit (* LSEL_N high with LCLK low after every declared bit *)
-      | Replay (* LSEL_N high with LCLK still high *)
-      | Abandoned (* LSEL_N high with LCLK low before the declared length *)
-    [@@deriving sexp_of, compare, equal]
-  end
-
-  (* A request frame as clocked on LDI. There is no request decoder in the codec, so the
-     frame stays raw.
-  *)
-  module Request = struct
-    type t =
-      { selected : int
-      ; deselected : int
-      ; bytes : string
-      ; extra_bits : bool list
-      }
-    [@@deriving sexp_of, compare, equal]
-  end
-
-  (* A response read as clocked out of LDO, with [Wire.Response.decode] of its whole
-     bytes. Nothing is correlated with a request here.
-  *)
-  module Response = struct
-    type t =
-      { selected : int
-      ; deselected : int
-      ; bytes : string
-      ; extra_bits : bool list
-      ; decoded : (Wire.Response.t, Wire.Response.Decode_error.t) Result.t
-      ; ending : Ending.t
-      }
-    [@@deriving sexp_of, compare, equal]
-  end
-
-  type t =
-    | Request of Request.t
-    | Response of Response.t
-  [@@deriving sexp_of, compare, equal]
-end
diff --git a/test/host_link/serial_host/monitor.ml b/test/host_link/serial_host/monitor.ml
deleted file mode 100644
index 2eed445..0000000
--- a/test/host_link/serial_host/monitor.ml
+++ /dev/null
@@ -1,143 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "monitor.ml" *)
-(* The serial host's passive monitor: it rebuilds what crossed the serial pins, per
-   selection, as [Item.Observed] items.
-
-   The environment's scheduler calls [sample] once per cycle with that cycle's pre-edge
-   pin values, as applied to and read from the DUT. The monitor never advances time and
-   never reads driver state, the driver's results, or any core-side stub; it knows only
-   the pins and the P3.5 frame rules. Items go to [observed], the analysis-port analogue,
-   which a checker drains.
-
-   Per selection (LSEL_N low to high) it records:
-
-   1. the first selected cycle and the first deselected cycle;
-   2. the LDI and LDO values at each LCLK rise while selected, pre-edge in the rise cycle,
-      which is where the host samples LDO;
-   3. LRDY in the first selected cycle;
-   4. LCLK in the deselection cycle.
-
-   A selection that begins with LRDY high is a response read (P3.5: while LRDY is high, a
-   selection starts a response read and request input is ignored); any other selection is
-   a request frame. This is the host-side rule at the pins. The loader decides on its
-   synchronized view two cycles later and also requires four deselected cycles first, so
-   an out-of-contract selection made just before LRDY rises, or too soon after a
-   deselection, can be classified differently from how the loader treated it.
-
-   A response read ends in [Replay] when LSEL_N rises with LCLK high, in [Commit] when
-   LCLK is low and every bit of the frame its header declares was clocked, and otherwise
-   in [Abandoned]. As on the host side, a declared length beyond the largest response is
-   capped at [Wire.Response.max_length].
-*)
-
-open! Core
-module Wire = Protemu_host_link_wire.Wire
-module Observed = Item.Observed
-
-(* One cycle's pins: host-driven LSEL_N, LCLK, LDI and DUT-driven LDO, LRDY, pre-edge. *)
-module Sample = struct
-  type t =
-    { select_n : bool
-    ; clock : bool
-    ; ldi : bool
-    ; ldo : bool
-    ; ready : bool
-    }
-  [@@deriving sexp_of]
-end
-
-(* An open selection; bits are oldest first. *)
-module Selection = struct
-  type t =
-    { selected : int
-    ; ready_at_select : bool
-    ; ldi : bool Queue.t
-    ; ldo : bool Queue.t
-    }
-end
-
-type t =
-  { mutable clock : bool (* LCLK in the previous sampled cycle *)
-  ; mutable selection : Selection.t option
-  ; observed : Observed.t Queue.t
-  }
-
-let create () = { clock = false; selection = None; observed = Queue.create () }
-
-(* Observed items, oldest first. A checker dequeues what it has compared. *)
-let observed t = t.observed
-
-(* Whole bytes MSB first, and the bits of a final partial byte. *)
-let split bits =
-  let whole = List.length bits / 8 * 8 in
-  Item.bytes_of_bits (List.take bits whole), List.drop bits whole
-;;
-
-(* Bits in the response frame whose header begins [bytes], if the header is complete. *)
-let response_bits bytes =
-  if String.length bytes < Wire.Response.header_length
-  then None
-  else (
-    let declared = Wire.U16.get bytes ~pos:Wire.Response.Offset.payload_length in
-    Some
-      (8
-       * Int.min
-           (Wire.Response.header_length + declared + Wire.Crc.length)
-           Wire.Response.max_length))
-;;
-
-let close t (selection : Selection.t) ~deselected ~clock_high =
-  let item : Observed.t =
-    if selection.ready_at_select
-    then (
-      let bits = Queue.to_list selection.ldo in
-      let bytes, extra_bits = split bits in
-      let ending : Observed.Ending.t =
-        if clock_high
-        then Replay
-        else (
-          match response_bits bytes with
-          | Some length when List.length bits >= length -> Commit
-          | _ -> Abandoned)
-      in
-      Response
-        { selected = selection.selected
-        ; deselected
-        ; bytes
-        ; extra_bits
-        ; decoded = Wire.Response.decode bytes
-        ; ending
-        })
-    else (
-      let bytes, extra_bits = split (Queue.to_list selection.ldi) in
-      Request { selected = selection.selected; deselected; bytes; extra_bits })
-  in
-  Queue.enqueue t.observed item
-;;
-
-(* Called by the scheduler once per cycle, pre-edge. A selection opens in its first cycle
-   with LSEL_N low and closes in the first cycle with it high; a rise in the deselection
-   cycle is not part of the selection.
-*)
-let sample t ~cycle (pins : Sample.t) =
-  (match t.selection, pins.select_n with
-   | None, false ->
-     t.selection
-     <- Some
-          { selected = cycle
-          ; ready_at_select = pins.ready
-          ; ldi = Queue.create ()
-          ; ldo = Queue.create ()
-          }
-   | Some selection, true ->
-     close t selection ~deselected:cycle ~clock_high:pins.clock;
-     t.selection <- None
-   | None, true | Some _, false -> ());
-  (match t.selection with
-   | Some selection when pins.clock && not t.clock ->
-     Queue.enqueue selection.ldi pins.ldi;
-     Queue.enqueue selection.ldo pins.ldo
-   | _ -> ());
-  t.clock <- pins.clock
-;;
diff --git a/test/host_link/serial_phy/dune b/test/host_link/serial_phy/dune
deleted file mode 100644
index 80de84f..0000000
--- a/test/host_link/serial_phy/dune
+++ /dev/null
@@ -1,21 +0,0 @@
-; HL4c focused Cyclesim tests for Serial_phy (host_link_migration.md, HL4b1).
-;
-; The PHY is driven through its public ports and checked against hand-written cycle
-; expectations. The HL4a loader harness in the parent directory stays the acceptance
-; baseline for the composed loader; this suite does not replace it.
-
-(library
- (name protemu_serial_phy_tests)
- (wrapped false)
- (modules serial_phy_testbench serial_phy_tests serial_phy_diagnostics_tests)
- ; Keep the ppx_expect source-tree workaround described in test/common/dune.
- (inline_tests
-  (flags
-   (:standard -source-tree-root .)))
- (libraries core hardcaml hardcaml_protemu)
- (preprocess
-  (pps ppx_hardcaml ppx_jane))
- (lint
-  (pps ppx_js_style))
- (flags
-  (:standard -w -27-57-33-34-35-40-63-47-26)))
diff --git a/test/host_link/serial_phy/serial_phy_diagnostics_tests.ml b/test/host_link/serial_phy/serial_phy_diagnostics_tests.ml
deleted file mode 100644
index e8df513..0000000
--- a/test/host_link/serial_phy/serial_phy_diagnostics_tests.ml
+++ /dev/null
@@ -1,86 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "serial_phy_diagnostics_tests.ml" *)
-(* HL4c: the Serial_phy checks detect the timing errors they exist for, and report enough
-   to reproduce them.
-
-   Each case states an expectation that is wrong by one cycle, or waits for something that
-   never happens, and requires the check to raise [Phy_failure]. None of them changes the
-   PHY or leaves a failing test in the suite. The first case prints a complete report, so
-   its format is reviewed here.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Serial_phy_testbench
-
-let require_failure t what f =
-  match failure_of f with
-  | Some failure -> failure
-  | None -> fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-let%expect_test "an event expected one cycle late is reported with the recent cycles" =
-  (* Stands in for an added synchronizer stage. *)
-  let t = create ~transcript_cycles:6 "negative: select assert one cycle late" in
-  run t 4;
-  let selected = drive_select t ~select:true ~hold:4 in
-  print_s
-    (require_failure t "a three-cycle select latency" (fun () ->
-       expect_high_cycles
-         t
-         Select_assert
-         ~from:selected
-         ~until:t.cycle
-         "assert"
-         [ selected + latency + 1 ]));
-  [%expect
-    {|
-    (test/host_link/serial_phy/serial_phy_testbench.ml.Phy_failure
-     (scenario "negative: select assert one cycle late") (cycle 9)
-     (phase Post_run) (what "assert: Select_assert high in cycles [6, 10)")
-     (expected ((9))) (actual ((8)))
-     (transcript
-      ((4 "rst=0 en=1 LSEL_N=1 LCLK=0 LDI=0" ())
-       (5 "rst=0 en=1 LSEL_N=1 LCLK=0 LDI=0" ())
-       (6 "rst=0 en=1 LSEL_N=0 LCLK=0 LDI=0" (Deselect_qualified))
-       (7 "rst=0 en=1 LSEL_N=0 LCLK=0 LDI=0" (Deselect_qualified))
-       (8 "rst=0 en=1 LSEL_N=0 LCLK=0 LDI=0"
-        (Selected Select_assert Deselect_qualified))
-       (9 "rst=0 en=1 LSEL_N=0 LCLK=0 LDI=0" (Selected)))))
-    |}]
-;;
-
-let%test_unit "qualification expected one cycle early is detected" =
-  (* Stands in for a threshold of three. *)
-  let t = create "negative: qualification after three cycles" in
-  run t 10;
-  ignore (drive_select t ~select:true ~hold:10 : int);
-  let deselected = drive_select t ~select:false ~hold:10 in
-  ignore
-    (require_failure t "a three-cycle threshold" (fun () ->
-       expect_output
-         t
-         Deselect_qualified
-         ~cycle:(deselected + latency + threshold - 1)
-         "three deselected cycles"
-         true)
-     : Sexp.t)
-;;
-
-let%test_unit "a wait for an event that never happens stops at its budget" =
-  let t = create "negative: no selection" in
-  let started = t.cycle in
-  ignore
-    (require_failure t "a selection with idle pins" (fun () ->
-       ignore (wait_for ~budget:25 t Select_assert ~value:true "idle pins" : int))
-     : Sexp.t);
-  check
-    t
-    ~phase:Post_run
-    "cycles run by the exhausted wait"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:(started + 25)
-    t.cycle
-;;
diff --git a/test/host_link/serial_phy/serial_phy_testbench.ml b/test/host_link/serial_phy/serial_phy_testbench.ml
deleted file mode 100644
index d17bafa..0000000
--- a/test/host_link/serial_phy/serial_phy_testbench.ml
+++ /dev/null
@@ -1,329 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "serial_phy_testbench.ml" *)
-(* HL4c focused Cyclesim testbench for [Serial_phy].
-
-   The PHY is driven only through its public ports, and every observation is a public
-   output. The tests write their expected cycles by hand from the timing contract in
-   docs/host_link_hl4b1_record.md. No expectation is derived from the RTL or from the
-   loader harness.
-
-   Scheduling contract:
-
-   1. Time. The unit is one system clock cycle. Cycle n is the interval before edge n. A
-      pin, reset, or enable value set before [cycle] runs cycle n is applied for the whole
-      of cycle n and sampled at edge n. [cycle] is the only function that advances the
-      simulator.
-   2. Within a cycle: apply the inputs; settle; take the pre-edge sample (the observation
-      for cycle n); clock the edge; take the post-edge sample.
-   3. The post-edge sample of edge n is taken with cycle n's inputs still applied. The
-      pre-edge sample of cycle n+1 is taken after its new inputs settle. The two must be
-      equal, which checks every cycle that no output depends combinationally on a pin,
-      reset, or enable.
-   4. Every wait has a finite cycle budget. An exhausted budget or a failed check raises
-      [Phy_failure] with the scenario, cycle, sampling phase, what was checked, the
-      expected and actual values, and the inputs and outputs of recent cycles.
-
-   This is synchronous digital evidence. Every pin change happens at a cycle boundary, so
-   it establishes nothing about asynchronous phase, metastability, physical setup/hold, or
-   board timing.
-*)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-module Sim = Cyclesim.With_interface (Serial_phy.I) (Serial_phy.O)
-
-(* The PHY's public outputs, by name. *)
-module Output = struct
-  type t =
-    | Selected
-    | Data
-    | Select_assert
-    | Select_release
-    | Clock_rise
-    | Clock_fall
-    | Deselect_qualified
-  [@@deriving sexp_of, compare, equal, enumerate]
-
-  let get t (o : bool Serial_phy.O.t) =
-    match t with
-    | Selected -> o.selected_o
-    | Data -> o.data_o
-    | Select_assert -> o.select_assert_o
-    | Select_release -> o.select_release_o
-    | Clock_rise -> o.clock_rise_o
-    | Clock_fall -> o.clock_fall_o
-    | Deselect_qualified -> o.deselect_qualified_o
-  ;;
-
-  (* The outputs that are high, for transcripts. *)
-  let high (o : bool Serial_phy.O.t) = List.filter all ~f:(fun t -> get t o)
-end
-
-(* The inputs applied for one cycle. [select_n] is the LSEL_N pin level. *)
-module Inputs = struct
-  type t =
-    { reset : bool
-    ; enable : bool
-    ; select_n : bool
-    ; clock : bool
-    ; data : bool
-    }
-  [@@deriving sexp_of, equal]
-
-  let idle =
-    { reset = false; enable = true; select_n = true; clock = false; data = false }
-  ;;
-
-  let summary t =
-    let bit b = if b then 1 else 0 in
-    sprintf
-      "rst=%d en=%d LSEL_N=%d LCLK=%d LDI=%d"
-      (bit t.reset)
-      (bit t.enable)
-      (bit t.select_n)
-      (bit t.clock)
-      (bit t.data)
-  ;;
-end
-
-module Phase = struct
-  type t =
-    | Pre_edge (* the observation of a cycle, before its edge *)
-    | Post_edge (* after an edge, with that cycle's inputs still applied *)
-    | Post_run (* a check made by the test between cycles *)
-  [@@deriving sexp_of]
-end
-
-type t =
-  { scenario : string
-  ; sim : Sim.t
-  ; mutable inputs : Inputs.t (* applied to the next cycle *)
-  ; mutable cycle : int (* the next cycle to run *)
-  ; mutable settled : bool Serial_phy.O.t option (* post-edge sample of the last edge *)
-  ; applied : Inputs.t Queue.t (* index = cycle *)
-  ; observed : bool Serial_phy.O.t Queue.t (* pre-edge samples; index = cycle *)
-  ; transcript_cycles : int
-  }
-
-exception
-  Phy_failure of
-    { scenario : string
-    ; cycle : int
-    ; phase : Phase.t
-    ; what : string
-    ; expected : Sexp.t option
-    ; actual : Sexp.t option
-    ; transcript : Sexp.t
-    }
-[@@deriving sexp_of]
-
-(* The inputs and high outputs of the last [transcript_cycles] cycles run. *)
-let transcript t =
-  let first = Int.max 0 (t.cycle - t.transcript_cycles) in
-  List.range first t.cycle
-  |> List.map ~f:(fun cycle ->
-    let inputs = Queue.get t.applied cycle in
-    let high = Output.high (Queue.get t.observed cycle) in
-    [%sexp (cycle : int), (Inputs.summary inputs : string), (high : Output.t list)])
-  |> Sexp.List
-;;
-
-let fail t ?(cycle = t.cycle - 1) ?expected ?actual ~phase what =
-  raise
-    (Phy_failure
-       { scenario = t.scenario
-       ; cycle
-       ; phase
-       ; what
-       ; expected
-       ; actual
-       ; transcript = transcript t
-       })
-;;
-
-let check t ?cycle ~phase what sexp_of equal ~expected actual =
-  if not (equal expected actual)
-  then fail t ?cycle ~phase what ~expected:(sexp_of expected) ~actual:(sexp_of actual)
-;;
-
-let sample (o : Bits.t ref Serial_phy.O.t) =
-  Serial_phy.O.map o ~f:(fun r -> Bits.to_bool !r)
-;;
-
-(* The single owner of simulator advancement; see items 2 and 3 of the contract. *)
-let cycle t =
-  let i = Cyclesim.inputs t.sim in
-  let before = Cyclesim.outputs ~clock_edge:Before t.sim in
-  let after = Cyclesim.outputs ~clock_edge:After t.sim in
-  let set port value = port := Bits.of_bool value in
-  set i.reset_i t.inputs.reset;
-  set i.enable_i t.inputs.enable;
-  set i.serial_select_n_i t.inputs.select_n;
-  set i.serial_clock_i t.inputs.clock;
-  set i.serial_data_i t.inputs.data;
-  Cyclesim.cycle_check t.sim;
-  Cyclesim.cycle_before_clock_edge t.sim;
-  let observed = sample before in
-  Queue.enqueue t.applied t.inputs;
-  Queue.enqueue t.observed observed;
-  Option.iter t.settled ~f:(fun settled ->
-    check
-      t
-      ~cycle:t.cycle
-      ~phase:Pre_edge
-      "outputs after the new inputs settle equal the last edge's post-edge outputs"
-      [%sexp_of: bool Serial_phy.O.t]
-      [%equal: bool Serial_phy.O.t]
-      ~expected:settled
-      observed);
-  Cyclesim.cycle_at_clock_edge t.sim;
-  Cyclesim.cycle_after_clock_edge t.sim;
-  t.settled <- Some (sample after);
-  t.cycle <- t.cycle + 1
-;;
-
-let run t cycles =
-  for _ = 1 to cycles do
-    cycle t
-  done
-;;
-
-(* Set inputs for the next cycle onward; unnamed inputs keep their value. [select] is the
-   protocol level: [true] drives LSEL_N low.
-*)
-let set ?reset ?enable ?select ?clock ?data t =
-  let keep value current = Option.value value ~default:current in
-  t.inputs
-  <- { reset = keep reset t.inputs.reset
-     ; enable = keep enable t.inputs.enable
-     ; select_n = Option.value_map select ~default:t.inputs.select_n ~f:not
-     ; clock = keep clock t.inputs.clock
-     ; data = keep data t.inputs.data
-     }
-;;
-
-(* Pins idle, enable high, reset high in cycles 0 and 1. The first cycle out of reset is
-   cycle 2, which [create] returns before running. The PHY is then deselected and not yet
-   qualified.
-*)
-let reset_cycles = 2
-
-let create ?(transcript_cycles = 16) scenario =
-  let sim = Sim.create (Serial_phy.create (Scope.create ~flatten_design:true ())) in
-  let t =
-    { scenario
-    ; sim
-    ; inputs = { Inputs.idle with reset = true }
-    ; cycle = 0
-    ; settled = None
-    ; applied = Queue.create ()
-    ; observed = Queue.create ()
-    ; transcript_cycles
-    }
-  in
-  run t reset_cycles;
-  set t ~reset:false;
-  t
-;;
-
-(* The pre-edge observation of a cycle that has run. *)
-let observed t cycle =
-  if cycle < 0 || cycle >= t.cycle
-  then
-    fail
-      t
-      ~phase:Post_run
-      "observation of a cycle that has run"
-      ~actual:[%sexp { requested = (cycle : int); cycles_run = (t.cycle : int) }];
-  Queue.get t.observed cycle
-;;
-
-(* Cycles in [from, until) in which [output] was high. *)
-let high_cycles t output ~from ~until =
-  List.range from until
-  |> List.filter ~f:(fun cycle -> Output.get output (observed t cycle))
-;;
-
-(* The exact set of cycles in [from, until) in which [output] was high. This also checks
-   one-cycle duration and the absence of repeats.
-*)
-let expect_high_cycles t output ~from ~until what expected =
-  check
-    t
-    ~phase:Post_run
-    (sprintf
-       "%s: %s high in cycles [%d, %d)"
-       what
-       (Sexp.to_string [%sexp (output : Output.t)])
-       from
-       until)
-    [%sexp_of: int list]
-    [%equal: int list]
-    ~expected
-    (high_cycles t output ~from ~until)
-;;
-
-let expect_output t output ~cycle what expected =
-  check
-    t
-    ~cycle
-    ~phase:Pre_edge
-    (sprintf "%s: %s" what (Sexp.to_string [%sexp (output : Output.t)]))
-    [%sexp_of: bool]
-    [%equal: bool]
-    ~expected
-    (Output.get output (observed t cycle))
-;;
-
-(* Run until [output] is [value] in a cycle's pre-edge observation and return that cycle.
-   Raises after [budget] cycles.
-*)
-let wait_for ?(budget = 100) t output ~value what =
-  let rec loop spent =
-    if spent >= budget
-    then
-      fail
-        t
-        ~phase:Pre_edge
-        (sprintf "%s: wait for %s" what (Sexp.to_string [%sexp (output : Output.t)]))
-        ~expected:[%sexp (value : bool)]
-        ~actual:[%sexp { budget_exhausted = (budget : int) }]
-    else (
-      cycle t;
-      let seen = t.cycle - 1 in
-      if Bool.equal (Output.get output (observed t seen)) value
-      then seen
-      else loop (spent + 1))
-  in
-  loop 0
-;;
-
-(* Drive [select] from the next cycle and run [hold] cycles. Returns the cycle in which
-   the pin first has the new level.
-*)
-let drive_select t ~select ~hold =
-  let driven = t.cycle in
-  set t ~select;
-  run t hold;
-  driven
-;;
-
-(* [Some failure] when [f] raises [Phy_failure]. Used by the negative checks. *)
-let failure_of f =
-  match f () with
-  | (_ : unit) -> None
-  | exception (Phy_failure _ as failure) -> Some [%sexp (failure : exn)]
-;;
-
-(* Hand-specified timing from the P3.5 record and the HL4b1 contract. They are written
-   here, not read from [Serial_phy], so that a changed constant there fails these tests.
-
-   [latency] : a pin level driven in cycle n is the synchronized level from cycle n+2, and
-   a change is an event in exactly cycle n+2 (two-stage synchronizer); [threshold] : a
-   cycle is qualified when the synchronized selection was low, with enable high and reset
-   low, in each of the previous four cycles.
-*)
-let latency = 2
-let threshold = 4
diff --git a/test/host_link/serial_phy/serial_phy_tests.ml b/test/host_link/serial_phy/serial_phy_tests.ml
deleted file mode 100644
index 6e12b3a..0000000
--- a/test/host_link/serial_phy/serial_phy_tests.ml
+++ /dev/null
@@ -1,396 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "serial_phy_tests.ml" *)
-(* HL4c: [Serial_phy]'s public timing, from pin changes to synchronized levels, events,
-   and deselect qualification.
-
-   Each test drives pins in known cycles and checks the exact set of cycles in which an
-   output is high over the whole window. An exact set also checks one-cycle event duration
-   and the absence of repeats. Expected cycles are written from the contract in
-   docs/host_link_hl4b1_record.md: a pin change in cycle n is visible in cycle n+2, and a
-   cycle is qualified after four synchronized deselected, enabled, unreset cycles.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Serial_phy_testbench
-
-let%test_unit "each pin reaches its synchronized level two cycles after it changes" =
-  let t = create "synchronizer latency" in
-  let start = t.cycle in
-  let selected = drive_select t ~select:true ~hold:6 in
-  let data_high = t.cycle in
-  set t ~data:true;
-  run t 6;
-  let deselected = drive_select t ~select:false ~hold:6 in
-  let data_low = t.cycle in
-  set t ~data:false;
-  run t 6;
-  (* One-cycle pin pulses pass unfiltered, two cycles later. *)
-  let pulse = t.cycle in
-  set t ~select:true ~data:true;
-  run t 1;
-  set t ~select:false ~data:false;
-  run t 10;
-  let until = t.cycle in
-  expect_high_cycles
-    t
-    Selected
-    ~from:start
-    ~until
-    "LSEL_N low in [selected, deselected) and in the pulse cycle"
-    (List.range (selected + latency) (deselected + latency) @ [ pulse + latency ]);
-  expect_high_cycles
-    t
-    Data
-    ~from:start
-    ~until
-    "LDI high in [data_high, data_low) and in the pulse cycle"
-    (List.range (data_high + latency) (data_low + latency) @ [ pulse + latency ])
-;;
-
-let%test_unit "each pin change is one event in the cycle its level is first visible, and \
-               a stable pin repeats nothing"
-  =
-  let t = create "edge events" in
-  let start = t.cycle in
-  let selected = drive_select t ~select:true ~hold:50 in
-  let rise = t.cycle in
-  set t ~clock:true;
-  run t 50;
-  let fall = t.cycle in
-  set t ~clock:false;
-  run t 50;
-  let deselected = drive_select t ~select:false ~hold:50 in
-  (* One-cycle pulses give a rise and a fall on consecutive cycles. *)
-  let clock_pulse = t.cycle in
-  set t ~clock:true;
-  run t 1;
-  set t ~clock:false;
-  run t 10;
-  let select_pulse = t.cycle in
-  set t ~select:true;
-  run t 1;
-  set t ~select:false;
-  run t 10;
-  let until = t.cycle in
-  let expect output what expected =
-    expect_high_cycles t output ~from:start ~until what expected
-  in
-  expect
-    Select_assert
-    "LSEL_N falls at [selected] and [select_pulse]"
-    [ selected + latency; select_pulse + latency ];
-  expect
-    Select_release
-    "LSEL_N rises at [deselected] and after the pulse"
-    [ deselected + latency; select_pulse + latency + 1 ];
-  expect
-    Clock_rise
-    "LCLK rises at [rise] and [clock_pulse]"
-    [ rise + latency; clock_pulse + latency ];
-  expect
-    Clock_fall
-    "LCLK falls at [fall] and after the pulse"
-    [ fall + latency; clock_pulse + latency + 1 ]
-;;
-
-let%test_unit "deselect qualification: below, at, and above four cycles, saturating over \
-               a long interval and clearing at a selection"
-  =
-  let t = create "qualification threshold" in
-  (* Out of reset from cycle [reset_cycles], deselected throughout. A three-bit count that
-     did not saturate would drop qualification within eight cycles.
-  *)
-  run t 5000;
-  expect_high_cycles
-    t
-    Deselect_qualified
-    ~from:0
-    ~until:t.cycle
-    "after reset, deselected for 5000 cycles"
-    (List.range (reset_cycles + threshold) t.cycle);
-  (* The selection's own assert cycle is still qualified; the count clears at its edge. *)
-  let selected = drive_select t ~select:true ~hold:20 in
-  expect_output t Select_assert ~cycle:(selected + latency) "selection seen" true;
-  expect_high_cycles
-    t
-    Deselect_qualified
-    ~from:selected
-    ~until:t.cycle
-    "selected from [selected]"
-    (List.range selected (selected + latency + 1));
-  (* After release the count restarts from zero. *)
-  let deselected = drive_select t ~select:false ~hold:5000 in
-  let release = deselected + latency in
-  expect_output t Select_release ~cycle:release "release seen" true;
-  expect_output
-    t
-    Deselect_qualified
-    ~cycle:(release + threshold - 1)
-    "below threshold"
-    false;
-  expect_output t Deselect_qualified ~cycle:(release + threshold) "at threshold" true;
-  expect_output
-    t
-    Deselect_qualified
-    ~cycle:(release + threshold + 1)
-    "above threshold"
-    true;
-  expect_high_cycles
-    t
-    Deselect_qualified
-    ~from:deselected
-    ~until:t.cycle
-    "deselected for 5000 cycles after a selection"
-    (List.range (release + threshold) t.cycle)
-;;
-
-let%test_unit "a selection is qualified exactly when LSEL_N was high for at least four \
-               cycles before it"
-  =
-  (* LSEL_N high for [gap] cycles, then low again; the second assertion is seen [latency]
-     cycles after the pin falls. This is the PHY half of the loader's response-arming
-     boundary (HL4a: a 3-cycle gap is not armed, a 4-cycle gap is).
-  *)
-  List.iter
-    [ 1, false; 2, false; 3, false; 4, true; 5, true; 8, true; 100, true ]
-    ~f:(fun (gap, qualified) ->
-      let t = create (sprintf "deselected gap of %d cycles" gap) in
-      run t 10;
-      let first = drive_select t ~select:true ~hold:10 in
-      let deselected = drive_select t ~select:false ~hold:gap in
-      let reselected = drive_select t ~select:true ~hold:10 in
-      let until = t.cycle in
-      expect_high_cycles
-        t
-        Select_assert
-        ~from:first
-        ~until
-        "both selections are seen"
-        [ first + latency; reselected + latency ];
-      expect_high_cycles
-        t
-        Select_release
-        ~from:first
-        ~until
-        "the gap is seen"
-        [ deselected + latency ];
-      expect_output
-        t
-        Deselect_qualified
-        ~cycle:(reselected + latency)
-        (sprintf "second selection after a %d-cycle gap" gap)
-        qualified)
-;;
-
-let%test_unit "short deselected gaps do not accumulate toward qualification" =
-  (* Three-cycle gaps separated by one-cycle selections: each selection clears the count. *)
-  let t = create "repeated short gaps" in
-  run t 10;
-  let start = drive_select t ~select:true ~hold:10 in
-  for _ = 1 to 5 do
-    ignore (drive_select t ~select:false ~hold:3 : int);
-    ignore (drive_select t ~select:true ~hold:1 : int)
-  done;
-  run t 10;
-  expect_high_cycles
-    t
-    Deselect_qualified
-    ~from:start
-    ~until:t.cycle
-    "only before the first selection's edge"
-    (List.range start (start + latency + 1))
-;;
-
-let%test_unit "coincident select, clock, and data changes are reported in the same \
-               cycle, each on its own output"
-  =
-  let t = create "coincident transitions" in
-  run t 10;
-  let start = t.cycle in
-  let step ?select ?clock ?data () =
-    let driven = t.cycle in
-    set t ?select ?clock ?data;
-    run t 20;
-    driven
-  in
-  let together = step ~select:true ~clock:true ~data:true () in
-  let apart = step ~select:false ~clock:false ~data:false () in
-  let reselected = step ~select:true () in
-  let release_rise = step ~select:false ~clock:true () in
-  let assert_fall = step ~select:true ~clock:false () in
-  let until = t.cycle in
-  let expect output what expected =
-    expect_high_cycles t output ~from:start ~until what expected
-  in
-  expect
-    Select_assert
-    "selections"
-    [ together + latency; reselected + latency; assert_fall + latency ];
-  expect Select_release "releases" [ apart + latency; release_rise + latency ];
-  expect Clock_rise "rises" [ together + latency; release_rise + latency ];
-  expect Clock_fall "falls" [ apart + latency; assert_fall + latency ];
-  expect Data "data" (List.range (together + latency) (apart + latency));
-  expect
-    Selected
-    "selected level"
-    (List.range (together + latency) (apart + latency)
-     @ List.range (reselected + latency) (release_rise + latency)
-     @ List.range (assert_fall + latency) until)
-;;
-
-let%test_unit "reset clears the synchronizers, edge history, and qualification at its \
-               edge"
-  =
-  (* A. Reset while an assertion is visible. Outputs are registered, so the event still
-        shows in the reset cycle. Reset then clears the level and the history, so no
-        release is reported. A pin still low afterwards is a new selection two cycles
-        after reset ends.
-  *)
-  let t = create "reset while selected" in
-  run t 10;
-  let selected = drive_select t ~select:true ~hold:latency in
-  let reset_from = t.cycle in
-  set t ~reset:true;
-  run t 2;
-  let released = t.cycle in
-  set t ~reset:false;
-  run t 16;
-  let until = t.cycle in
-  let expect output what expected =
-    expect_high_cycles t output ~from:selected ~until what expected
-  in
-  expect Select_assert "before and after reset" [ reset_from; released + latency ];
-  expect Select_release "reset is not a release" [];
-  expect Selected "cleared by reset" (reset_from :: List.range (released + latency) until);
-  expect
-    Deselect_qualified
-    "qualified until the reset edge"
-    [ selected; selected + 1; reset_from ];
-  (* B. A one-cycle pulse on every pin, with reset in the next cycle, is discarded from
-     the first stage. The control run without reset reports it.
-  *)
-  let pulse ~with_reset =
-    let t =
-      create (if with_reset then "reset discards a pulse in flight" else "pulse control")
-    in
-    run t 10;
-    let pulse = t.cycle in
-    set t ~select:true ~clock:true ~data:true;
-    run t 1;
-    set t ~select:false ~clock:false ~data:false ~reset:with_reset;
-    run t 1;
-    set t ~reset:false;
-    run t 20;
-    t, pulse
-  in
-  let t, p = pulse ~with_reset:false in
-  let expect output what expected =
-    expect_high_cycles t output ~from:p ~until:t.cycle what expected
-  in
-  expect Selected "control" [ p + latency ];
-  expect Data "control" [ p + latency ];
-  expect Select_assert "control" [ p + latency ];
-  expect Select_release "control" [ p + latency + 1 ];
-  expect Clock_rise "control" [ p + latency ];
-  expect Clock_fall "control" [ p + latency + 1 ];
-  (* Selected only in cycle p+2; the count restarts from the release in p+3. *)
-  expect
-    Deselect_qualified
-    "control"
-    (List.range p (p + latency + 1) @ List.range (p + latency + 1 + threshold) t.cycle);
-  let t, p = pulse ~with_reset:true in
-  let expect output what expected =
-    expect_high_cycles t output ~from:p ~until:t.cycle what expected
-  in
-  List.iter
-    [ Output.Selected; Data; Select_assert; Select_release; Clock_rise; Clock_fall ]
-    ~f:(fun output -> expect output "reset in cycle p+1" []);
-  (* The count restarts from the first cycle out of reset, p+2. *)
-  expect
-    Deselect_qualified
-    "reset in cycle p+1"
-    ([ p; p + 1 ] @ List.range (p + 2 + threshold) t.cycle)
-;;
-
-let%test_unit "disable clears only the qualification; synchronizers and events keep \
-               running"
-  =
-  (* A. Disabled for three cycles while deselected, with LCLK and LDI changing in the
-        first. Qualification is still visible in the first disabled cycle (registered) and
-        returns four enabled cycles after enable does.
-  *)
-  let t = create "disable while deselected" in
-  run t 10;
-  let disabled = t.cycle in
-  set t ~enable:false ~clock:true ~data:true;
-  run t 3;
-  let enabled = t.cycle in
-  set t ~enable:true;
-  run t 2;
-  let fall = t.cycle in
-  set t ~clock:false;
-  run t 15;
-  let until = t.cycle in
-  let expect output what expected =
-    expect_high_cycles t output ~from:disabled ~until what expected
-  in
-  expect
-    Deselect_qualified
-    "disabled in [disabled, enabled)"
-    (disabled :: List.range (enabled + threshold) until);
-  expect Clock_rise "during disable" [ disabled + latency ];
-  expect Clock_fall "after disable" [ fall + latency ];
-  expect Data "unaffected by disable" (List.range (disabled + latency) until);
-  (* B. A selection driven just before disable is still reported while disabled (reset
-     would discard it), and the count stays clear while selected after enable returns.
-  *)
-  let t = create "disable keeps synchronizers running" in
-  run t 10;
-  let selected = drive_select t ~select:true ~hold:1 in
-  set t ~enable:false;
-  run t 4;
-  set t ~enable:true;
-  run t 10;
-  let deselected = drive_select t ~select:false ~hold:12 in
-  let until = t.cycle in
-  let expect output what expected =
-    expect_high_cycles t output ~from:selected ~until what expected
-  in
-  expect Select_assert "while disabled" [ selected + latency ];
-  expect Select_release "after enable" [ deselected + latency ];
-  expect
-    Selected
-    "unaffected by disable"
-    (List.range (selected + latency) (deselected + latency));
-  expect
-    Deselect_qualified
-    "cleared by the first disabled edge"
-    ([ selected; selected + 1 ] @ List.range (deselected + latency + threshold) until);
-  (* C. Disable in the cycle whose edge would complete the count: disable wins over the
-     increment, and the count restarts after it.
-  *)
-  let t = create "disable at the threshold edge" in
-  run t 10;
-  ignore (drive_select t ~select:true ~hold:10 : int);
-  let deselected = drive_select t ~select:false ~hold:(latency + threshold - 1) in
-  let disabled = t.cycle in
-  set t ~enable:false;
-  run t 1;
-  set t ~enable:true;
-  run t 10;
-  expect_output
-    t
-    Deselect_qualified
-    ~cycle:(deselected + latency + threshold)
-    "the edge that would have qualified was disabled"
-    false;
-  expect_high_cycles
-    t
-    Deselect_qualified
-    ~from:deselected
-    ~until:t.cycle
-    "disabled in one cycle"
-    (List.range (disabled + 1 + threshold) t.cycle)
-;;
diff --git a/test/integration/core_engine/core_engine_control_port_tests.ml b/test/integration/core_engine/core_engine_control_port_tests.ml
deleted file mode 100644
index 465e80f..0000000
--- a/test/integration/core_engine/core_engine_control_port_tests.ml
+++ /dev/null
@@ -1,246 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "core_engine_control_port_tests.ml" *)
-(* Focused checks of the [Control_port] temporal contract at the real [Emulator_core]
-   boundary.
-
-   These cover obligations that no earlier suite checks at this boundary: idle decisions,
-   refusal under reset and disable, cross-group arbitration, READBACK response timing and
-   cancellation, and STOP acceptance versus halting. Program-request decisions are also
-   compared every edge against the independent model in [test/core/protocol_core]. ABORT
-   cleanup is checked in [core_engine_tests.ml] and through [Simulator_backend] in
-   [test/integration/host_simulator]. Every expectation here is written out by hand from
-   the contract; none is computed from the core's acceptance expressions.
-*)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-open! Protemu_isa
-open! Core_engine_testbench
-
-let halt_program = program "halt" [ Instruction.Halt ]
-
-(* Offer [request] for one cycle and return the decisions sampled before its edge. *)
-let decide t request =
-  let sampled = ref None in
-  step
-    ~before:(fun _ o ->
-      sampled := Some (Control_port.Decision.map o.control_decision_o ~f:( ! )))
-    t
-    request;
-  Option.value_exn !sampled
-;;
-
-(* The accepted/rejected pair a single shared request receives. *)
-let pair (d : Bits.t Control_port.Decision.t) request =
-  let accepted, rejected =
-    match request with
-    | Start _ -> d.load_start_accepted, d.load_start_rejected
-    | Write _ -> d.load_write_accepted, d.load_write_rejected
-    | Read _ | Verify _ -> d.readback_accepted, d.readback_rejected
-    | Complete -> d.load_complete_accepted, d.load_complete_rejected
-    | Run -> d.run_accepted, d.run_rejected
-    | Stop -> d.stop_accepted, d.stop_rejected
-    | Abort -> d.abort_accepted, d.abort_rejected
-    | _ -> raise_s [%message "not a shared control request"]
-  in
-  Bits.to_bool accepted, Bits.to_bool rejected
-;;
-
-(* Names of the decision fields that are high, ignoring the response data word. *)
-let raised (d : Bits.t Control_port.Decision.t) =
-  Control_port.Decision.(map2 port_names d ~f:(fun name value -> name, value) |> to_list)
-  |> List.filter_map ~f:(fun (name, value) ->
-    if (not (String.equal name "readback_response_data")) && Bits.to_int_trunc value <> 0
-    then Some name
-    else None)
-;;
-
-let words = [| 0x1234; 0xabcd |]
-
-(* One core per prepared state, each chosen so the named request alone is accepted. *)
-let fresh () = create ()
-
-let started () =
-  let t = create () in
-  step t (Start 2);
-  t
-;;
-
-let written () =
-  let t = started () in
-  Array.iteri words ~f:(fun address data -> step t (Write (address, data)));
-  t
-;;
-
-let verified () =
-  let t = written () in
-  Array.iteri words ~f:(fun address expected ->
-    step t (Verify (address, expected));
-    step t Idle);
-  t
-;;
-
-let loaded () =
-  let t = create () in
-  ignore (load_program t halt_program : Assembler.Assembled.t);
-  t
-;;
-
-let acceptable_offers =
-  [ "load-start", fresh, Start 2
-  ; "load-write", started, Write (0, words.(0))
-  ; "readback", written, Read 0
-  ; "verify", written, Verify (0, words.(0))
-  ; "load-complete", verified, Complete
-  ; "run", loaded, Run
-  ; "stop", loaded, Stop
-  ; "abort", loaded, Abort
-  ]
-;;
-
-let%test_unit "with no offer every shared decision is low" =
-  let running () =
-    let t = create () in
-    ignore
-      (load_program
-         t
-         (program "wait" [ Instruction.Wait_cycles_imm { delay = 20 }; Halt ])
-       : Assembler.Assembled.t);
-    step t Run;
-    step t Idle;
-    step t Idle;
-    [%test_result: bool] (bool (outputs t).halted_o) ~expect:false;
-    t
-  in
-  List.iter
-    [ "reset core", fresh (), Idle
-    ; "loaded image", loaded (), Idle
-    ; "load session", written (), Idle
-    ; "running", running (), Idle
-    ; "reset asserted", loaded (), Reset
-    ; "disabled", loaded (), Together [ Enable false ]
-    ]
-    ~f:(fun (state, t, request) ->
-      [%test_result: string list] ~message:state (raised (decide t request)) ~expect:[])
-;;
-
-let%test_unit "reset and disable refuse every shared offer" =
-  List.iter acceptable_offers ~f:(fun (name, prepare, offer) ->
-    [%test_result: bool * bool]
-      ~message:(name ^ " alone")
-      (pair (decide (prepare ()) offer) offer)
-      ~expect:(true, false);
-    [%test_result: bool * bool]
-      ~message:(name ^ " in reset")
-      (pair (decide (prepare ()) (Together [ Reset; offer ])) offer)
-      ~expect:(false, true);
-    (* [Together] lowers [en_i] for this cycle only. *)
-    [%test_result: bool * bool]
-      ~message:(name ^ " while disabled")
-      (pair (decide (prepare ()) (Together [ Enable false; offer ])) offer)
-      ~expect:(false, true))
-;;
-
-let%test_unit "ABORT, STOP, RUN, and program requests arbitrate across groups" =
-  (* An accepted ABORT halts execution, which refuses a program request. *)
-  let t = loaded () in
-  let d = decide t (Together [ Abort; Start 2 ]) in
-  [%test_result: bool * bool] (pair d Abort) ~expect:(true, false);
-  [%test_result: bool * bool] (pair d (Start 2)) ~expect:(false, true);
-  [%test_result: bool] (bool (outputs t).image_valid_o) ~expect:true;
-  (* STOP does not refuse a program request while halted between instructions. *)
-  let t = loaded () in
-  let d = decide t (Together [ Stop; Start 2 ]) in
-  [%test_result: bool * bool] (pair d Stop) ~expect:(true, false);
-  [%test_result: bool * bool] (pair d (Start 2)) ~expect:(true, false);
-  [%test_result: bool] (bool (outputs t).image_valid_o) ~expect:false;
-  [%test_result: bool] (bool (outputs t).load_active_o) ~expect:true;
-  (* A program request refuses RUN. *)
-  let t = loaded () in
-  let d = decide t (Together [ Run; Read 0 ]) in
-  [%test_result: bool * bool] (pair d (Read 0)) ~expect:(true, false);
-  [%test_result: bool * bool] (pair d Run) ~expect:(false, true);
-  [%test_result: bool] (bool (outputs t).halted_o) ~expect:true;
-  (* Program priority is by validity: a refused LOAD_START still refuses a legal write. *)
-  let t = started () in
-  let d = decide t (Together [ Start 0; Write (0, words.(0)) ]) in
-  [%test_result: bool * bool] (pair d (Start 0)) ~expect:(false, true);
-  [%test_result: bool * bool] (pair d (Write (0, words.(0)))) ~expect:(false, true);
-  [%test_result: bool * bool]
-    (pair (decide t (Write (0, words.(0)))) (Write (0, words.(0))))
-    ~expect:(true, false)
-;;
-
-let%test_unit "READBACK responds once, one edge after acceptance, unless cancelled" =
-  let response t =
-    let d = (outputs t).control_decision_o in
-    bool d.readback_response_valid, int d.readback_response_data
-  in
-  let accepted_read () =
-    let t = verified () in
-    step t Complete;
-    [%test_result: bool * bool] (pair (decide t (Read 1)) (Read 1)) ~expect:(true, false);
-    t
-  in
-  (* Operands are consumed at the offer edge: the idle cycles below drive them to zero. *)
-  let t = accepted_read () in
-  [%test_result: bool] (fst (response t)) ~expect:false;
-  step t Idle;
-  [%test_result: bool * int] (response t) ~expect:(true, words.(1));
-  [%test_result: bool]
-    (bool (outputs t).control_decision_o.readback_response_match)
-    ~expect:false;
-  step t Idle;
-  [%test_result: bool] (fst (response t)) ~expect:false;
-  (* A second READBACK is refused while the first is outstanding, which still completes. *)
-  let t = accepted_read () in
-  [%test_result: bool * bool] (pair (decide t (Read 0)) (Read 0)) ~expect:(false, true);
-  [%test_result: bool * int] (response t) ~expect:(true, words.(1));
-  (* Reset, disable, an accepted ABORT, or an accepted LOAD_START cancels it. *)
-  List.iter
-    [ "reset", Reset, None
-    ; "disable", Together [ Enable false ], None
-    ; "abort", Abort, Some Abort
-    ; "load-start", Start 2, Some (Start 2)
-    ]
-    ~f:(fun (name, cancel, offer) ->
-      let t = accepted_read () in
-      let d = decide t cancel in
-      Option.iter offer ~f:(fun offer ->
-        [%test_result: bool * bool] ~message:name (pair d offer) ~expect:(true, false));
-      for _ = 1 to 3 do
-        [%test_result: bool] ~message:name (fst (response t)) ~expect:false;
-        step t Idle
-      done)
-;;
-
-let%test_unit "STOP acceptance is not a halt, and a STOP accepted while halted is not \
-               kept"
-  =
-  let two_waits =
-    program
-      "two_waits"
-      [ Instruction.Wait_cycles_imm { delay = 4 }; Wait_cycles_imm { delay = 4 }; Halt ]
-  in
-  let stopped = create () in
-  ignore (load_program stopped two_waits : Assembler.Assembled.t);
-  step stopped Run;
-  while not (bool (outputs stopped).timing_busy_o) do
-    step stopped Idle
-  done;
-  [%test_result: bool * bool] (pair (decide stopped Stop) Stop) ~expect:(true, false);
-  [%test_result: bool] (bool (outputs stopped).halted_o) ~expect:false;
-  while not (bool (outputs stopped).halted_o) do
-    step stopped Idle
-  done;
-  [%test_result: int] (int (outputs stopped).instruction_count_o) ~expect:1;
-  [%test_result: bool] (bool (outputs stopped).normal_halt_o) ~expect:false;
-  let halted = create () in
-  ignore (load_program halted two_waits : Assembler.Assembled.t);
-  [%test_result: bool * bool] (pair (decide halted Stop) Stop) ~expect:(true, false);
-  ignore (run_until_halted halted : int);
-  [%test_result: int] (int (outputs halted).instruction_count_o) ~expect:3;
-  [%test_result: bool] (bool (outputs halted).normal_halt_o) ~expect:true
-;;
diff --git a/test/integration/core_engine/core_engine_testbench.ml b/test/integration/core_engine/core_engine_testbench.ml
deleted file mode 100644
index cbff750..0000000
--- a/test/integration/core_engine/core_engine_testbench.ml
+++ /dev/null
@@ -1,223 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "core_engine_testbench.ml" *)
-(* Loaded-program Cyclesim harness for the P3.3 integrated core and a contract-only
-   latency-one program memory. External pins and queue peers remain test-controlled. *)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-open! Protemu_isa
-module Sim = Cyclesim.With_interface (Emulator_core.I) (Emulator_core.O)
-
-type request =
-  | Idle
-  | Reset
-  | Enable of bool
-  | Start of int
-  | Write of int * int
-  | Read of int
-  | Verify of int * int
-  | Complete
-  | Run
-  | Stop
-  | Abort
-  | Step
-  | Controls of
-      { run : bool
-      ; stop : bool
-      ; abort : bool
-      ; step : bool
-      }
-  | Claim of int
-  | Release of int
-  | Together of request list (* Offered in the same cycle. *)
-
-type t =
-  { sim : Sim.t
-  ; words : int option array
-  ; mutable read_data : int
-  ; mutable enabled : bool
-  ; mutable pin_async : int
-  ; mutable occupied : int
-  ; mutable tx_ready : bool
-  ; mutable rx_valid : bool
-  ; mutable rx_data : int
-  ; mutable transfer_rx_ready : bool
-  ; mutable edge : int
-  }
-
-let bool signal = Bits.to_bool !signal
-let int signal = Bits.to_int_trunc !signal
-let set_bool signal value = signal := Bits.of_bool value
-let set_int signal value = signal := Bits.of_int_trunc ~width:(Bits.width !signal) value
-let outputs t = Cyclesim.outputs t.sim
-let outputs_before t = Cyclesim.outputs ~clock_edge:Before t.sim
-
-let clear_inputs (i : _ Emulator_core.I.t) =
-  set_bool i.reset_i false;
-  set_bool i.en_i true;
-  set_bool i.control_request_i.load_start_valid false;
-  set_int i.control_request_i.load_length 0;
-  set_bool i.control_request_i.load_write_valid false;
-  set_int i.control_request_i.load_address 0;
-  set_int i.control_request_i.load_data 0;
-  set_bool i.control_request_i.load_complete_valid false;
-  set_bool i.control_request_i.readback_valid false;
-  set_int i.control_request_i.readback_address 0;
-  set_bool i.control_request_i.readback_verify false;
-  set_int i.control_request_i.readback_expected 0;
-  set_bool i.control_request_i.run_valid false;
-  set_bool i.control_request_i.stop_valid false;
-  set_bool i.control_request_i.abort_valid false;
-  set_bool i.step_valid_i false;
-  set_int i.pin_async_i 0;
-  set_int i.occupied_i 0;
-  set_bool i.software_claim_valid_i false;
-  set_int i.software_claim_mask_i 0;
-  set_bool i.software_release_valid_i false;
-  set_int i.software_release_mask_i 0;
-  set_bool i.tx_ready_i false;
-  set_bool i.rx_valid_i false;
-  set_int i.rx_data_i 0;
-  set_bool i.transfer_rx_ready_i true
-;;
-
-let rec drive_request (i : _ Emulator_core.I.t) = function
-  | Idle -> ()
-  | Reset -> set_bool i.reset_i true
-  | Enable value -> set_bool i.en_i value
-  | Start length ->
-    set_bool i.control_request_i.load_start_valid true;
-    set_int i.control_request_i.load_length length
-  | Write (address, data) ->
-    set_bool i.control_request_i.load_write_valid true;
-    set_int i.control_request_i.load_address address;
-    set_int i.control_request_i.load_data data
-  | Read address ->
-    set_bool i.control_request_i.readback_valid true;
-    set_int i.control_request_i.readback_address address
-  | Verify (address, expected) ->
-    set_bool i.control_request_i.readback_valid true;
-    set_int i.control_request_i.readback_address address;
-    set_bool i.control_request_i.readback_verify true;
-    set_int i.control_request_i.readback_expected expected
-  | Complete -> set_bool i.control_request_i.load_complete_valid true
-  | Run -> set_bool i.control_request_i.run_valid true
-  | Stop -> set_bool i.control_request_i.stop_valid true
-  | Abort -> set_bool i.control_request_i.abort_valid true
-  | Step -> set_bool i.step_valid_i true
-  | Controls { run; stop; abort; step } ->
-    set_bool i.control_request_i.run_valid run;
-    set_bool i.control_request_i.stop_valid stop;
-    set_bool i.control_request_i.abort_valid abort;
-    set_bool i.step_valid_i step
-  | Claim mask ->
-    set_bool i.software_claim_valid_i true;
-    set_int i.software_claim_mask_i mask
-  | Release mask ->
-    set_bool i.software_release_valid_i true;
-    set_int i.software_release_mask_i mask
-  | Together requests -> List.iter requests ~f:(drive_request i)
-;;
-
-let settle sim =
-  Cyclesim.cycle_check sim;
-  Cyclesim.cycle_before_clock_edge sim
-;;
-
-let step ?before t request =
-  let i = Cyclesim.inputs t.sim in
-  clear_inputs i;
-  set_bool i.en_i t.enabled;
-  set_int i.pin_async_i t.pin_async;
-  set_int i.occupied_i t.occupied;
-  set_bool i.tx_ready_i t.tx_ready;
-  set_bool i.rx_valid_i t.rx_valid;
-  set_int i.rx_data_i t.rx_data;
-  set_bool i.transfer_rx_ready_i t.transfer_rx_ready;
-  drive_request i request;
-  (match request with
-   | Enable value -> t.enabled <- value
-   | _ -> ());
-  settle t.sim;
-  let o = outputs_before t in
-  let mem_enable = bool o.prog_mem_enable_o in
-  let mem_write = bool o.prog_mem_write_enable_o in
-  let address = int o.prog_mem_address_o in
-  let write_data = int o.prog_mem_write_data_o in
-  Option.iter before ~f:(fun f -> f t.edge o);
-  Cyclesim.cycle_at_clock_edge t.sim;
-  Cyclesim.cycle_after_clock_edge t.sim;
-  if mem_enable
-  then
-    if mem_write
-    then (
-      t.words.(address) <- Some write_data;
-      t.read_data <- 0xdead)
-    else t.read_data <- Option.value t.words.(address) ~default:0xbeef;
-  i.prog_mem_read_data_i := Bits.of_int_trunc ~width:16 t.read_data;
-  t.edge <- t.edge + 1
-;;
-
-let create () =
-  let sim = Sim.create (Emulator_core.create (Scope.create ~flatten_design:true ())) in
-  let t =
-    { sim
-    ; words = Array.create ~len:Program_memory_controller.Config.program_depth None
-    ; read_data = 0xa5a5
-    ; enabled = true
-    ; pin_async = 0
-    ; occupied = 0
-    ; tx_ready = false
-    ; rx_valid = false
-    ; rx_data = 0
-    ; transfer_rx_ready = true
-    ; edge = 0
-    }
-  in
-  let i = Cyclesim.inputs sim in
-  i.prog_mem_read_data_i := Bits.of_int_trunc ~width:16 t.read_data;
-  step t Reset;
-  t
-;;
-
-let load_image t words =
-  step t (Start (Array.length words));
-  Array.iteri words ~f:(fun address data -> step t (Write (address, data)));
-  Array.iteri words ~f:(fun address expected ->
-    step t (Verify (address, expected));
-    step t Idle);
-  step t Complete
-;;
-
-let assemble program =
-  match Assembler.assemble ~memory:Assembler.Memory.word16 program with
-  | Ok assembled -> assembled
-  | Error reason -> raise_s [%message "assembly failed" (reason : Invalid.t)]
-;;
-
-let load_program t program =
-  let assembled = assemble program in
-  load_image t assembled.image.words;
-  assembled
-;;
-
-let run_until_halted ?(limit = 1000) t =
-  step t Run;
-  let rec loop cycles =
-    if cycles >= limit then raise_s [%message "execution did not halt" (limit : int)];
-    if bool (outputs t).halted_o
-    then cycles
-    else (
-      step t Idle;
-      loop (cycles + 1))
-  in
-  loop 0
-;;
-
-let program name instructions =
-  { Program.name
-  ; items = List.map instructions ~f:(fun instruction -> Program.instr instruction)
-  }
-;;
diff --git a/test/integration/core_engine/core_engine_tests.ml b/test/integration/core_engine/core_engine_tests.ml
deleted file mode 100644
index be7e57c..0000000
--- a/test/integration/core_engine/core_engine_tests.ml
+++ /dev/null
@@ -1,790 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "core_engine_tests.ml" *)
-(* Directed and bounded generated checks for the real P3.3 loaded-program path. *)
-
-open! Core
-open! Hardcaml_protemu
-open! Protemu_isa
-open! Core_engine_testbench
-open Instruction
-
-let event_bit kind = 1 lsl Event_kind.index kind
-
-let reference_fifo_sequence values =
-  let module Fifo = Protemu_f_model.Fifo in
-  let ok = function
-    | Ok value -> value
-    | Error reason ->
-      raise_s
-        [%message
-          "unexpected reference FIFO refusal" (reason : Protemu_f_model.Fault.Reject.t)]
-  in
-  match values with
-  | [] -> []
-  | last :: reversed_initial ->
-    let initial = List.rev reversed_initial in
-    let full =
-      List.fold
-        initial
-        ~init:(Fifo.create ~id:Kinds.Fifo_id.Tx ~depth:8)
-        ~f:(fun fifo value -> ok (Fifo.push fifo value))
-    in
-    let fifo, first, pushed, popped = Fifo.step full ~push:(Some last) ~pop:true in
-    [%test_result: (unit, Protemu_f_model.Fault.Reject.t) Result.t option]
-      pushed
-      ~expect:(Some (Ok ()));
-    [%test_result: (unit, Protemu_f_model.Fault.Reject.t) Result.t option]
-      popped
-      ~expect:(Some (Ok ()));
-    let rec drain fifo result =
-      if Fifo.is_empty fifo
-      then List.rev result
-      else (
-        let fifo, value = ok (Fifo.pop fifo) in
-        drain fifo (value :: result))
-    in
-    Option.to_list first @ drain fifo []
-;;
-
-let%test_unit "prepared P2.6b program reaches the committed pin bank" =
-  let t = create () in
-  let words = [| 0x7804; 0x0000; 0xa300; 0x7804; 0x0001; 0x0000 |] in
-  step t (Claim 0x01);
-  [%test_result: int] (int (outputs t).software_claim_o) ~expect:1;
-  load_image t words;
-  step t Run;
-  let first_commit = ref None in
-  let armed = ref None in
-  let external_edge = ref None in
-  let synchronized = ref None in
-  let decision = ref None in
-  let bank_request = ref None in
-  let final_commit = ref None in
-  let trace = Queue.create () in
-  for _ = 0 to 80 do
-    let o = outputs t in
-    Queue.enqueue
-      trace
-      ( t.edge
-      , int o.pc_o
-      , int o.phase_o
-      , bool o.mechanism_request_valid_o
-      , int o.mechanism_kind_o
-      , bool o.mechanism_completion_valid_o
-      , int o.pins_o
-      , int o.pin_oe_o
-      , bool o.execution_fault_o );
-    if Option.is_none !first_commit && int o.pin_oe_o land 1 <> 0
-    then first_commit := Some t.edge;
-    if Option.is_none !armed && bool o.timing_busy_o
-    then (
-      armed := Some t.edge;
-      t.pin_async <- 0x08;
-      external_edge := Some t.edge);
-    if Option.is_none !synchronized && int o.rising_o land 0x08 <> 0
-    then synchronized := Some t.edge;
-    if Option.is_none !final_commit && int o.pins_o land 1 <> 0
-    then final_commit := Some t.edge;
-    if bool o.halted_o && Option.is_some !final_commit
-    then ()
-    else
-      step
-        ~before:(fun edge o ->
-          if Option.is_none !decision
-             && bool o.mechanism_completion_valid_o
-             && int o.mechanism_kind_o = Execution_unit.Mechanism_kind.wait_edge
-          then decision := Some edge;
-          if Option.is_none !bank_request
-             && bool o.mechanism_request_valid_o
-             && int o.mechanism_kind_o = Execution_unit.Mechanism_kind.write_pins_imm
-             && Option.is_some !decision
-          then bank_request := Some edge)
-        t
-        Idle
-  done;
-  let get name = function
-    | Some value -> value
-    | None ->
-      raise_s
-        [%message
-          "missing P2.6b timestamp"
-            (name : string)
-            (Queue.to_list trace
-             : (int * int * int * bool * int * bool * int * int * bool) list)]
-  in
-  let external_edge = get "external" !external_edge in
-  let synchronized = get "synchronized" !synchronized in
-  let decision = get "decision" !decision in
-  let bank_request = get "bank request" !bank_request in
-  let final_commit = get "final commit" !final_commit in
-  [%test_result: int]
-    (get "initial commit" !first_commit < external_edge |> Bool.to_int)
-    ~expect:1;
-  [%test_result: int] (synchronized - external_edge) ~expect:2;
-  [%test_result: int] (decision - synchronized) ~expect:1;
-  [%test_result: int] (bank_request - decision) ~expect:3;
-  [%test_result: int] (final_commit - bank_request) ~expect:1;
-  [%test_result: int] (int (outputs t).pins_o land 1) ~expect:1;
-  [%test_result: int] (int (outputs t).pin_oe_o land 1) ~expect:1;
-  [%test_result: bool] (bool (outputs t).normal_halt_o) ~expect:true
-;;
-
-let%test_unit "status acknowledgement clears selected bits and waits leave periodic \
-               timing live"
-  =
-  let t = create () in
-  let p =
-    program
-      "status_and_timing"
-      [ Instruction.Start_periodic { period = 2 }
-      ; Wait_cycles_imm { delay = 5 }
-      ; Read_status { rd = 0 }
-      ; Ack_status { mask = Event_kind.mask }
-      ; Stop_periodic
-      ; Halt
-      ]
-  in
-  ignore (load_program t p : Assembler.Assembled.t);
-  ignore (run_until_halted t : int);
-  let status = int (outputs t).status_o in
-  [%test_result: int] (status land event_bit Event_kind.Delay_expired) ~expect:0;
-  [%test_result: int] (status land event_bit Tick) ~expect:(event_bit Tick);
-  [%test_result: bool] (bool (outputs t).execution_fault_o) ~expect:false
-;;
-
-let%test_unit "a synchronized event wins on the exact timeout completion edge" =
-  let run inject_at =
-    let t = create () in
-    let p =
-      program
-        "event_timeout_collision"
-        [ Instruction.Wait_edge { pin = 3; edge = Kinds.Edge.Rising; timeout = Some 6 }
-        ; Halt
-        ]
-    in
-    ignore (load_program t p : Assembler.Assembled.t);
-    step t Run;
-    while not (bool (outputs t).timing_busy_o) do
-      step t Idle
-    done;
-    let rising = ref None in
-    let completion = ref None in
-    for relative = 0 to 20 do
-      if Option.equal Int.equal inject_at (Some relative) then t.pin_async <- 0x08;
-      step
-        ~before:(fun _ o ->
-          if int o.rising_o land 0x08 <> 0 && Option.is_none !rising
-          then rising := Some relative;
-          if bool o.mechanism_completion_valid_o && Option.is_none !completion
-          then completion := Some relative)
-        t
-        Idle
-    done;
-    !rising, !completion, int (outputs t).status_o
-  in
-  let _, timeout_completion, _ = run None in
-  let timeout_completion = Option.value_exn timeout_completion in
-  let collision =
-    List.find_map (List.range 0 10) ~f:(fun inject_at ->
-      let rising, completion, status = run (Some inject_at) in
-      if Option.equal Int.equal rising (Some (timeout_completion - 1))
-         && Option.equal Int.equal completion (Some timeout_completion)
-      then Some status
-      else None)
-    |> Option.value_exn
-  in
-  [%test_result: int]
-    (collision land event_bit Event_kind.Wait_complete)
-    ~expect:(event_bit Wait_complete);
-  [%test_result: int] (collision land event_bit Event_kind.Wait_timeout) ~expect:0
-;;
-
-let%test_unit "FIFO pressure blocks only the core and preserves byte ordering" =
-  let t = create () in
-  let pushes =
-    List.init 8 ~f:(fun value ->
-      [ Instruction.Ldi { rd = 0; value }
-      ; Fifo_push { fifo = Kinds.Fifo_id.Tx; rs = 0; blocking = Blocking }
-      ])
-    |> List.concat
-  in
-  let p =
-    program
-      "fifo_pressure"
-      (pushes
-       @ [ Ldi { rd = 0; value = 8 }
-         ; Fifo_push { fifo = Tx; rs = 0; blocking = Blocking }
-         ; Halt
-         ])
-  in
-  ignore (load_program t p : Assembler.Assembled.t);
-  step t Run;
-  while int (outputs t).tx_count_o < 8 do
-    step t Idle
-  done;
-  for _ = 1 to 4 do
-    step t Idle
-  done;
-  [%test_result: bool] (bool (outputs t).engines_idle_o) ~expect:false;
-  t.tx_ready <- true;
-  let popped = Queue.create () in
-  for _ = 0 to 80 do
-    let o = outputs t in
-    if bool o.tx_valid_o then Queue.enqueue popped (int o.tx_data_o);
-    step t Idle
-  done;
-  [%test_result: int list]
-    (Queue.to_list popped |> Fn.flip List.take 9)
-    ~expect:(reference_fifo_sequence (List.range 0 9 |> List.rev));
-  [%test_result: bool] (bool (outputs t).normal_halt_o) ~expect:true
-;;
-
-let%test_unit "pin snapshots, register writes, level waits, branches, and FIFO pop \
-               compose"
-  =
-  let t = create () in
-  let p =
-    { Program.name = "remaining_mechanisms"
-    ; items =
-        List.map
-          [ Ldi { rd = 0; value = 1 }
-          ; Ldi { rd = 1; value = 1 }
-          ; Write_pins_reg { mode = Push_pull; mask_reg = 0; value_reg = 1 }
-          ; Wait_level { pin = 3; level = true; timeout = None }
-          ; Read_pins { rd = 2 }
-          ; Ldi { rd = 3; value = 2 }
-          ; Wait_cycles_reg { rd = 3 }
-          ; Branch_pin { pin = 3; level = true; target = "taken" }
-          ; Ldi { rd = 4; value = 0xdead }
-          ]
-          ~f:Program.instr
-        @ [ Program.at "taken"
-          ; Program.instr
-              (Fifo_pop { fifo = Kinds.Fifo_id.Rx; rd = 5; blocking = Blocking })
-          ; Program.instr Halt
-          ]
-    }
-  in
-  step t (Claim 1);
-  t.pin_async <- 0x08;
-  step t Idle;
-  step t Idle;
-  t.rx_valid <- true;
-  t.rx_data <- 0xa5;
-  step t Idle;
-  t.rx_valid <- false;
-  ignore (load_program t p : Assembler.Assembled.t);
-  ignore (run_until_halted t : int);
-  let registers = !((outputs t).registers_o) in
-  let reg index =
-    Hardcaml.Bits.select registers ~high:((index * 16) + 15) ~low:(index * 16)
-    |> Hardcaml.Bits.to_int_trunc
