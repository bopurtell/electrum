-[@@@ocamlformat "enable"]
diff --git a/lib/host_link/frame_rx.ml b/lib/host_link/frame_rx.ml
deleted file mode 100644
index 3d6b9a1..0000000
--- a/lib/host_link/frame_rx.ml
+++ /dev/null
@@ -1,267 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_rx.ml" *)
-(* P3.5 serial loader request receiver: byte assembly, the bounded byte count and sticky
-   overrun, header and payload capture, CRC accumulation, and deselect validation.
-
-   It consumes [Serial_phy]'s synchronized levels and events as plain inputs. A request
-   starts at an eligible selection, takes one MSB-first bit at each clock rise while
-   selected, and ends at deselection, which is the only frame boundary. In the release
-   cycle [frame_end_o] is high and [result_o] and [echo_valid_o] hold the frame's
-   validation; nothing is registered between validation and the consumer. The retained
-   tag, command, length, and payload then hold until the next eligible selection or
-   disable.
-
-   [Host_link] supplies eligibility. [Command_dispatch] consumes the handoff and the
-   retained fields: command legality, fixed lengths and device bounds, dispatch,
-   completion waits, and every response. docs/host_link_hl4b2_record.md records the timing
-   contract. [check_wire_encodings] checks the request layout and CRC start value this
-   block assumes against [Wire] whenever it is elaborated; [Wire_crc] checks the CRC
-   parameters.
-*)
-
-open! Core
-open! Hardcaml
-open! Signal
-module Wire = Protemu_host_link_wire.Wire
-
-(* Receiver sizing derived from the wire limits. *)
-module Config = struct
-  let max_request_bytes = Wire.Request.max_length
-  let request_byte_count_bits = Int.ceil_log2 (max_request_bytes + 1)
-end
-
-(* Elaboration-time consistency between [Wire] and the fixed choices in [create]: the
-   literal byte counts that capture each header field and payload byte, and the CRC
-   accumulator's clear to zero at each start. Plain OCaml comparisons; they create no
-   logic and cannot change emitted RTL.
-*)
-let check_wire_encodings () =
-  let require condition message =
-    if not condition then invalid_arg ("Frame_rx: " ^ message)
-  in
-  Wire_layout.check
-    ~owner:"Frame_rx"
-    "request header"
-    ~length:Wire.Request.header_length
-    Wire.Request.Offset.[ magic, 1; version, 1; tag, 1; command, 1; payload_length, 2 ];
-  require
-    (Wire.Request.Offset.payload = Wire.Request.header_length)
-    "request payload does not follow the header";
-  Wire_layout.check_request_payload ~owner:"Frame_rx";
-  require (Wire.Crc.initial = 0) "request CRC does not start from zero"
-;;
-
-module I = struct
-  type 'a t =
-    { (* System clock domain; reset is synchronous and active high. Disable cancels the
-         request and clears every field. *)
-      clock_i : 'a
-    ; reset_i : 'a
-    ; enable_i : 'a
-    ; (* Serial_phy -> receiver: synchronized selection (active high) and LDI levels, and
-         the one-cycle select and LCLK rise events. *)
-      selected_i : 'a
-    ; data_i : 'a
-    ; select_assert_i : 'a
-    ; select_release_i : 'a
-    ; clock_rise_i : 'a
-    ; (* Loader -> receiver: no command, completion wait, or retained response exists, so
-         a selection may start a request. Sampled only in the select-assert cycle. *)
-      eligible_i : 'a
-    }
-  [@@deriving hardcaml]
-end
-
-module O = struct
-  type 'a t =
-    { (* A request selection is being received. *)
-      active_o : 'a
-    ; (* The active request's deselection: one cycle, the frame's only handoff. *)
-      frame_end_o : 'a
-    ; (* Deselect validation as a [Wire.Result_code]: [Complete] for a frame the loader
-         may dispatch, else the framing error. Read with [frame_end_o]. *)
-      result_o : 'a [@bits 8]
-    ; (* Tag and command were both received, so an error response may echo them. *)
-      echo_valid_o : 'a
-    ; (* Retained request fields; payload integers are little-endian on the wire. *)
-      tag_o : 'a [@bits 8]
-    ; command_o : 'a [@bits 8]
-    ; payload_length_o : 'a [@bits 16]
-    ; payload_o : 'a [@bits 32]
-    }
-  [@@deriving hardcaml]
-end
-
-[@@@ocamlformat "disable"]
-
-(* Registered receiver state. Fields hold unless explicitly assigned by [compile]; an
-   eligible selection, disable, and reset clear every field.
-*)
-module I_Regs = struct
-  type 'a t =
-    { byte_shift       : 'a [@bits 8]
-    ; bit_count        : 'a [@bits 3]
-    ; byte_count       : 'a [@bits Config.request_byte_count_bits]
-    ; request_active   : 'a
-    ; request_overrun  : 'a
-    ; request_magic    : 'a [@bits 8]
-    ; request_version  : 'a [@bits 8]
-    ; request_tag      : 'a [@bits 8]
-    ; request_command  : 'a [@bits 8]
-    ; payload_length   : 'a [@bits 16]
-    ; payload          : 'a [@bits 32]
-    ; request_crc      : 'a [@bits 8]
-    ; crc_match        : 'a
-    }
-  [@@deriving hardcaml]
-end
-
-let result_code code = of_int_trunc ~width:8 (Wire.Result_code.to_int code)
-
-let create (scope : Scope.t) (i : _ I.t) : _ O.t =
-  check_wire_encodings ();
-  let open Always in
-  let spec = Reg_spec.create ~clock:i.clock_i ~clear:i.reset_i () in
-  let r = I_Regs.Of_always.reg spec in
-  I_Regs.Of_always.apply_names ~prefix:"reg_" ~naming_op:(Scope.naming scope) r;
-
-  let request_idle = ~:(r.request_active.value) &: i.eligible_i in
-  let receiving =
-    i.enable_i &: i.selected_i &: r.request_active.value
-  in
-  let frame_end = i.select_release_i &: r.request_active.value in
-  let completed_byte = concat_lsb [ i.data_i; select r.byte_shift.value ~high:6 ~low:0 ] in
-  let expected_crc_index = uresize r.payload_length.value ~width:16 +:. Wire.Request.header_length in
-  let completed_byte_index = uresize r.byte_count.value ~width:16 in
-  let completed_is_crc = completed_byte_index ==: expected_crc_index in
-  let expected_frame_bytes = r.payload_length.value +:. Wire.Request.min_length in
-  let request_bytes = uresize r.byte_count.value ~width:16 in
-  let request_complete =
-    ~:(r.request_overrun.value)
-    &: (r.bit_count.value ==:. 0)
-    &: (request_bytes >=:. Wire.Request.min_length)
-    &: (request_bytes ==: expected_frame_bytes)
-  in
-  (* Overrun, then completeness, then the header fields, then the CRC. *)
-  let parser_error =
-    mux2 r.request_overrun.value (result_code Bad_length)
-      (mux2 (~:(request_complete)) (result_code Incomplete)
-      (mux2 (r.request_magic.value <>:. Wire.Request.magic) (result_code Bad_magic)
-         (mux2 (r.request_version.value <>:. Wire.Version.byte) (result_code Bad_version)
-            (mux2 (r.payload_length.value >:. Wire.Request.max_payload_length) (result_code Bad_length)
-               (mux2 (~:(r.crc_match.value)) (result_code Bad_crc) (result_code Complete))))))
-  in
-  (* The echo needs every byte through the command. *)
-  let correlation_valid = r.byte_count.value >=:. Wire.Request.Offset.command + 1 in
-
-  (* Hold by default. Start, receive, and deselect are mutually exclusive; disable is last
-     and clears every field.
-  *)
-  compile
-    [ r.byte_shift <-- r.byte_shift.value
-    ; r.bit_count <-- r.bit_count.value
-    ; r.byte_count <-- r.byte_count.value
-    ; r.request_active <-- r.request_active.value
-    ; r.request_overrun <-- r.request_overrun.value
-    ; r.request_magic <-- r.request_magic.value
-    ; r.request_version <-- r.request_version.value
-    ; r.request_tag <-- r.request_tag.value
-    ; r.request_command <-- r.request_command.value
-    ; r.payload_length <-- r.payload_length.value
-    ; r.payload <-- r.payload.value
-    ; r.request_crc <-- r.request_crc.value
-    ; r.crc_match <-- r.crc_match.value
-
-    ; when_ (i.select_assert_i &: i.enable_i &: request_idle)
-        [ r.byte_shift <--. 0
-        ; r.bit_count <--. 0
-        ; r.byte_count <--. 0
-        ; r.request_active <--. 1
-        ; r.request_overrun <--. 0
-        ; r.request_magic <--. 0
-        ; r.request_version <--. 0
-        ; r.request_tag <--. 0
-        ; r.request_command <--. 0
-        ; r.payload_length <--. 0
-        ; r.payload <--. 0
-        ; r.request_crc <--. 0
-        ; r.crc_match <--. 0
-        ]
-    ; when_ (i.clock_rise_i &: receiving)
-        [ r.byte_shift <-- completed_byte
-        ; if_ (r.bit_count.value ==:. 7)
-            [ r.bit_count <--. 0
-            ; if_ (r.byte_count.value >=:. Config.max_request_bytes)
-                [ (* Saturation plus a sticky error prevents any suffix from becoming a
-                     second frame before deselection. *)
-                  r.byte_count <--. Config.max_request_bytes
-                ; r.request_overrun <--. 1
-                ]
-                [ r.byte_count <-- r.byte_count.value +:. 1
-                ; if_ completed_is_crc
-                    [ r.crc_match <-- (completed_byte ==: r.request_crc.value) ]
-                    [ r.request_crc <-- Wire_crc.crc8_byte r.request_crc.value completed_byte ]
-                ; switch r.byte_count.value
-                [ of_int_trunc ~width:Config.request_byte_count_bits 0, [ r.request_magic <-- completed_byte ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 1, [ r.request_version <-- completed_byte ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 2, [ r.request_tag <-- completed_byte ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 3, [ r.request_command <-- completed_byte ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 4, [ r.payload_length <-- concat_msb [ zero 8; completed_byte ] ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 5,
-                  [ r.payload_length <--
-                      concat_msb [ completed_byte; select r.payload_length.value ~high:7 ~low:0 ]
-                  ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 6, [ r.payload <-- concat_msb [ zero 24; completed_byte ] ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 7,
-                  [ r.payload <--
-                      concat_msb
-                        [ zero 16; completed_byte; select r.payload.value ~high:7 ~low:0 ]
-                  ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 8,
-                  [ r.payload <--
-                      concat_msb
-                        [ zero 8; completed_byte; select r.payload.value ~high:15 ~low:0 ]
-                  ]
-                ; of_int_trunc ~width:Config.request_byte_count_bits 9,
-                  [ r.payload <--
-                      concat_msb [ completed_byte; select r.payload.value ~high:23 ~low:0 ]
-                  ]
-                ]
-                ]
-            ]
-            [ r.bit_count <-- r.bit_count.value +:. 1 ]
-        ]
-    ; (* Deselect ends the request; the loader validates and dispatches in this cycle. *)
-      when_ frame_end
-        [ r.request_active <--. 0 ]
-
-    ; (* Disable is cancellation, not a delayed wire timeout. *)
-      when_ (~:(i.enable_i))
-        [ r.byte_shift <--. 0
-        ; r.bit_count <--. 0
-        ; r.byte_count <--. 0
-        ; r.request_active <--. 0
-        ; r.request_overrun <--. 0
-        ; r.request_magic <--. 0
-        ; r.request_version <--. 0
-        ; r.request_tag <--. 0
-        ; r.request_command <--. 0
-        ; r.payload_length <--. 0
-        ; r.payload <--. 0
-        ; r.request_crc <--. 0
-        ; r.crc_match <--. 0
-        ]
-    ];
-
-  { O.active_o       = r.request_active.value
-  ; frame_end_o      = frame_end
-  ; result_o         = parser_error
-  ; echo_valid_o     = correlation_valid
-  ; tag_o            = r.request_tag.value
-  ; command_o        = r.request_command.value
-  ; payload_length_o = r.payload_length.value
-  ; payload_o        = r.payload.value
-  }
-;;
-[@@@ocamlformat "enable"]
diff --git a/lib/host_link/frame_tx.ml b/lib/host_link/frame_tx.ml
deleted file mode 100644
index 043df4f..0000000
--- a/lib/host_link/frame_tx.ml
+++ /dev/null
@@ -1,192 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_tx.ml" *)
-(* P3.5 serial loader response transmitter: the retained response, response arming, the
-   restartable shifter, replay, and commit.
-
-   It consumes [Serial_phy]'s one-cycle events and deselect qualification, and
-   [Command_dispatch]'s combinational publication, as plain inputs. A publication stores
-   the complete padded frame and its length at that edge and makes the response pending;
-   nothing is registered between the dispatcher's decision and the store. A selection
-   whose assert event finds a response already pending, after a qualified deselected
-   interval, copies the stored frame into the shifter and presents its first bit. Each
-   synchronized LCLK fall then advances one bit, MSB first, and a selected pause holds it.
-   The release ends the read. It consumes the response only if the fall after the final
-   bit came first; otherwise the response stays pending, and the next armed selection
-   restarts at byte zero from the unchanged store.
-
-   [pending_o] is the retained-response state the loader combines into request
-   eligibility; [serial_ready_o] is the same state gated by enable, for LRDY. Reset clears
-   every register. Disable clears pending, the read, and the bit count, but not the store,
-   shifter, or length. Nothing can read those again: a new read needs a pending response,
-   and only a publication, which rewrites the store and length, makes one.
-
-   [Command_dispatch] owns every frame's content, CRC, and length; this block interprets
-   none of it. docs/host_link_hl4b4_record.md records the timing and priority contract.
-
-   Careful: a read copies the store but not the length. A publication during a read, or in
-   its arming cycle, changes where that read drains. The loader never publishes while a
-   response is retained, so it cannot happen there; the focused robustness tests pin it.
-*)
-
-open! Core
-open! Hardcaml
-open! Signal
-module Wire = Protemu_host_link_wire.Wire
-
-(* Response-store sizing derived from the wire limits. *)
-module Config = struct
-  let max_response_bytes = Wire.Response.max_length
-  let response_bits = max_response_bytes * 8
-end
-
-(* Elaboration-time checks of the store's fixed register widths against [Wire]. Plain
-   OCaml comparisons; they create no logic and cannot change emitted RTL.
-*)
-let check_wire_encodings () =
-  let require condition message =
-    if not condition then invalid_arg ("Frame_tx: " ^ message)
-  in
-  (* [response_length] and [response_bits] are 5 and 8 bits wide. *)
-  require (Config.max_response_bytes < 1 lsl 5) "response length register too narrow";
-  require (Config.response_bits < 1 lsl 8) "response bit counter too narrow"
-;;
-
-module I = struct
-  type 'a t =
-    { (* System clock domain; reset is synchronous and active high. Disable cancels the
-         retained response and any read. *)
-      clock_i : 'a
-    ; reset_i : 'a
-    ; enable_i : 'a
-    ; (* Serial_phy -> transmitter: the one-cycle select and LCLK fall events, and whether
-         the synchronized selection was deselected for the qualifying interval before this
-         cycle. Qualification is read only with a select-assert event. *)
-      select_assert_i : 'a
-    ; select_release_i : 'a
-    ; clock_fall_i : 'a
-    ; deselect_qualified_i : 'a
-    ; (* Command_dispatch -> transmitter: store this frame at this edge. The frame is
-         complete, MSB-first from its top bit, and zero-padded; the length is its byte
-         count. There is no ready: the loader keeps requests ineligible while a response
-         is pending. *)
-      response_publish_i : 'a
-    ; response_frame_i : 'a [@bits Config.response_bits]
-    ; response_length_i : 'a [@bits 5]
-    }
-  [@@deriving hardcaml]
-end
-
-module O = struct
-  type 'a t =
-    { (* Physical response pins, low while disabled. Data is meaningful while a read is
-         armed and not drained, and low otherwise. *)
-      serial_data_o : 'a
-    ; serial_ready_o : 'a
-    ; (* A response is retained, whatever enable; the loader's request eligibility and
-         busy state. *)
-      pending_o : 'a
-    }
-  [@@deriving hardcaml]
-end
-
-[@@@ocamlformat "disable"]
-
-(* Registered response state. Fields hold unless explicitly assigned by [compile]; reset
-   clears every field, and disable clears pending, active, and bits.
-
-   response_pending : a published response is retained and not yet committed;
-   response_active  : a read is armed, from its selection to its release;
-   response_store   : the published frame, unchanged by reads;
-   response_shift   : the read's copy, shifted left once per fall;
-   response_length  : the published frame's byte count;
-   response_bits    : falls taken in the current read;
-*)
-module I_Regs = struct
-  type 'a t =
-    { response_pending : 'a
-    ; response_active  : 'a
-    ; response_store   : 'a [@bits Config.response_bits]
-    ; response_shift   : 'a [@bits Config.response_bits]
-    ; response_length  : 'a [@bits 5]
-    ; response_bits    : 'a [@bits 8]
-    }
-  [@@deriving hardcaml]
-end
-
-let create (scope : Scope.t) (i : _ I.t) : _ O.t =
-  check_wire_encodings ();
-  let open Always in
-  let spec = Reg_spec.create ~clock:i.clock_i ~clear:i.reset_i () in
-  let r = I_Regs.Of_always.reg spec in
-  I_Regs.Of_always.apply_names ~prefix:"reg_" ~naming_op:(Scope.naming scope) r;
-
-  (* Every bit of the frame has been shifted out: the final fall has occurred. *)
-  let response_drained =
-    r.response_bits.value ==: sll (uresize r.response_length.value ~width:8) ~by:3
-  in
-
-  (* Hold by default. Every condition reads registered values, so a publication does not
-     arm a selection in its own cycle. Later statements win: a commit or disable clears
-     [response_pending] after a coincident publication sets it, and disable is last.
-  *)
-  compile
-    [ r.response_pending  <-- r.response_pending.value
-    ; r.response_active   <-- r.response_active.value
-    ; r.response_store    <-- r.response_store.value
-    ; r.response_shift    <-- r.response_shift.value
-    ; r.response_length   <-- r.response_length.value
-    ; r.response_bits     <-- r.response_bits.value
-
-    ; (* A handoff error, an immediate response, or a completion, in the cycle
-         [Command_dispatch] decides it. Not gated by enable: disable below still wins for
-         [response_pending]. *)
-      when_ i.response_publish_i
-        [ r.response_store <-- i.response_frame_i
-        ; r.response_length <-- i.response_length_i
-        ; r.response_pending <--. 1
-        ]
-
-    ; (* A response selection starts or restarts a retained frame. *)
-      when_
-        (i.select_assert_i
-         &: i.enable_i
-         &: r.response_pending.value
-         &: i.deselect_qualified_i)
-        [ r.response_shift <-- r.response_store.value
-        ; r.response_bits <--. 0
-        ; r.response_active <--. 1
-        ]
-    ; when_
-        (i.clock_fall_i
-         &: r.response_active.value
-         &: ~:response_drained)
-        [ r.response_shift <-- sll r.response_shift.value ~by:1
-        ; r.response_bits <-- r.response_bits.value +:. 1
-        ]
-    ; (* Release ends the read; only a drained read commits. *)
-      when_ (i.select_release_i &: r.response_active.value)
-        [ r.response_active <--. 0
-        ; if_ response_drained
-            [ r.response_pending <--. 0; r.response_bits <--. 0 ]
-            []
-        ]
-
-    ; (* Disable is cancellation, not a delayed wire timeout. *)
-      when_ (~:(i.enable_i))
-        [ r.response_pending <--. 0
-        ; r.response_active <--. 0
-        ; r.response_bits <--. 0
-        ]
-    ];
-
-  { O.serial_data_o =
-      mux2
-        (i.enable_i &: r.response_active.value &: ~:response_drained)
-        (msb r.response_shift.value)
-        gnd
-  ; serial_ready_o = i.enable_i &: r.response_pending.value
-  ; pending_o      = r.response_pending.value
-  }
-;;
-[@@@ocamlformat "enable"]
diff --git a/lib/host_link/host_link.ml b/lib/host_link/host_link.ml
deleted file mode 100644
index d1f9a87..0000000
--- a/lib/host_link/host_link.ml
+++ /dev/null
@@ -1,160 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "host_link.ml" *)
-(*
-  The complete serial host-control endpoint. This can be thought of as a large IP block that would go into an ASIC where the customer is other people on the chip itself.
-*)
-
-open! Core
-open! Hardcaml
-open! Signal
-
-module I = struct
-  type 'a t = 
-  {
-      clock_i   : 'a
-    ; reset_i   : 'a
-    ; enable_i  : 'a
-
-    (* select is active low, clock idles low; built in loose symmetry to SPI *)
-    ; serial_select_n_i : 'a
-    ; serial_clock_i    : 'a (* fed from the master; in this case the external clock pin *)
-    ; serial_data_i     : 'a
-
-    (* These are the wrapped words that are input/output *)
-    (* do these not have some sort of backpressure emission scheme? *)
-    (* The fanout on these is VERY LARGE; be warned here, as the interface nesting is much more intense than you might think; *)
-    ; control_decision_i : 'a Control_port.Decision.t [@rtlsuffix "_i"]
-
-    (* This is our status bus; In theory we include a pin that does some sort of scan chain thing for DFT? *)
-    ; control_status_i : 'a Control_port.Status.t [@rtlsuffix "_i"]
-  } [@@deriving hardcaml ~rtlmangle:false]
-end
-
-module O = struct
-  type 'a t = 
-    {
-      (* the data *)
-      serial_data_o       : 'a
-
-      (* Highkey no idea what this is for; and why it isnt a valid signal instead? *)
-    ; serial_ready_o      : 'a
-
-    (* This is the emitted request the serial link is making to the control core; *)
-    ; control_request_o   : 'a Control_port.Request.t [@rtlsuffix "_o"]
-
-    (* Main busy designator. A proper CSR block might be in order; we'll see. *)
-    ; busy_o              : 'a
-    } [@@deriving hardcaml ~rtlmangle:false]
-end
-
-[@@@ocamlformat "disable"]
-
-let create 
-  (scope : Scope.t) 
-  (i : _ I.t) 
-  : _ O.t =
-
-  (* Synchronized pins and their one-cycle events; see [Serial_phy] for their timing. *)
-  let phy =
-    Serial_phy.create
-      (Scope.sub_scope scope "serial_phy")
-      { Serial_phy.I.clock_i = i.clock_i
-      ; reset_i              = i.reset_i
-      ; enable_i             = i.enable_i
-      ; serial_select_n_i    = i.serial_select_n_i
-      ; serial_clock_i       = i.serial_clock_i
-      ; serial_data_i        = i.serial_data_i
-      }
-  in
-
-  let select_assert      = phy.select_assert_o in
-  let select_release     = phy.select_release_o in
-  let clock_rise         = phy.clock_rise_o in
-  let clock_fall         = phy.clock_fall_o in
-  let deselect_qualified = phy.deselect_qualified_o in
-
-  (* A request may start only while no command, completion wait, or retained response
-     exists, so [Frame_rx]'s retained fields hold for as long as [Command_dispatch] reads
-     them. Eligibility reads the retained response itself, not the enable-gated
-     [serial_ready_o]. [dispatch_busy] and [response_pending] are joined once their blocks
-     exist; both are registered, so the loops through [Frame_rx] are not combinational.
-  *)
-  let dispatch_busy    = Signal.wire 1 in
-  let response_pending = Signal.wire 1 in
-  let rx =
-    Frame_rx.create
-      (Scope.sub_scope scope "frame_rx")
-      { Frame_rx.I.clock_i = i.clock_i
-      ; reset_i            = i.reset_i
-      ; enable_i           = i.enable_i
-      ; selected_i         = phy.selected_o
-      ; data_i             = phy.data_o
-      ; select_assert_i    = select_assert
-      ; select_release_i   = select_release
-      ; clock_rise_i       = clock_rise
-      ; eligible_i         = ~:dispatch_busy &: ~:response_pending
-      }
-  in
-
-  let dispatch_response_publish = Signal.wire Frame_tx.I.port_widths.response_publish_i in
-  let dispatch_response_frame   = Signal.wire Frame_tx.I.port_widths.response_frame_i in
-  let dispatch_response_length  = Signal.wire Frame_tx.I.port_widths.response_length_i in
-
-  (* The published response, retained until a read of it is committed. *)
-  let tx =
-    Frame_tx.create
-      (Scope.sub_scope scope "frame_tx")
-      { Frame_tx.I.clock_i   = i.clock_i
-      ; reset_i              = i.reset_i
-      ; enable_i             = i.enable_i
-      ; select_assert_i      = select_assert
-      ; select_release_i     = select_release
-      ; clock_fall_i         = clock_fall
-      ; deselect_qualified_i = deselect_qualified
-      ; response_publish_i   = dispatch_response_publish
-      ; response_frame_i     = dispatch_response_frame
-      ; response_length_i    = dispatch_response_length
-      }
-  in
-
-  (* Offers, completion waits, and the response to store, from the handoff onward. *)
-  let dispatch =
-    Command_dispatch.create
-      (Scope.sub_scope scope "command_dispatch")
-      { Command_dispatch.I.clock_i = i.clock_i
-      ; reset_i                    = i.reset_i
-      ; enable_i                   = i.enable_i
-      ; frame_end_i                = rx.frame_end_o
-      ; result_i                   = rx.result_o
-      ; echo_valid_i               = rx.echo_valid_o
-      ; tag_i                      = rx.tag_o
-      ; command_i                  = rx.command_o
-      ; payload_length_i           = rx.payload_length_o
-      ; payload_i                  = rx.payload_o
-      ; control_decision_i         = i.control_decision_i
-      ; control_status_i           = i.control_status_i
-      }
-  in
-
-  (* Backwards assignments; *)
-  Signal.( <-- ) response_pending           tx.pending_o;
-  Signal.( <-- ) dispatch_busy              dispatch.busy_o;
-  Signal.( <-- ) dispatch_response_publish  dispatch.response_publish_o;
-  Signal.( <-- ) dispatch_response_frame    dispatch.response_frame_o;
-  Signal.( <-- ) dispatch_response_length   dispatch.response_length_o;
-
-  let busy = 
-    tx.pending_o
-    |: rx.active_o 
-    |: dispatch.busy_o
-  in
-
-  { O.
-    serial_data_o     = tx.serial_data_o
-  ; serial_ready_o    = tx.serial_ready_o
-  ; control_request_o = dispatch.control_request_o
-  ; busy_o            = busy
-  }
-;;
-[@@@ocamlformat "enable"]
diff --git a/lib/host_link/serial_phy.ml b/lib/host_link/serial_phy.ml
deleted file mode 100644
index b99f8b0..0000000
--- a/lib/host_link/serial_phy.ml
+++ /dev/null
@@ -1,131 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "serial_phy.ml" *)
-(* P3.5 serial loader PHY: pin synchronizers, edge events, and deselect qualification.
-
-   [LSEL_N], [LCLK], and [LDI] pass through matching two-stage synchronizers into the
-   system clock domain; the host clock never clocks logic. A pin value driven in cycle n
-   is visible as a level in cycle n+2, and a change is reported as a one-cycle event in
-   that same cycle. Deselect qualification counts synchronized deselected cycles and
-   saturates at the threshold response arming uses.
-
-   Every output is a function of this block's registers alone, so reset and disable act
-   only through the next edge. Reset clears every register, which reads as deselected with
-   [LCLK] and [LDI] low. Disable clears only the qualification count; the synchronizers
-   and edge history keep running.
-
-   This block interprets no frame. [Frame_rx] owns request arming and framing,
-   [Command_dispatch] dispatch, and [Frame_tx] response arming, the retained response, and
-   commit; [Host_link] composes them. docs/host_link_hl4b1_record.md records the
-   timing contract.
-*)
-
-open! Core
-open! Hardcaml
-open! Signal
-
-(* Deselected cycles, not counting the current one, that qualify a selection for a
-   response read.
-*)
-let deselect_qualification = 4
-
-module I = struct
-  type 'a t =
-    { (* System clock domain; reset is synchronous and active high. Disable clears the
-         deselect qualification only. *)
-      clock_i : 'a
-    ; reset_i : 'a
-    ; enable_i : 'a
-    ; (* Asynchronous physical loader pins. Select is active low, clock idles low. *)
-      serial_select_n_i : 'a
-    ; serial_clock_i : 'a
-    ; serial_data_i : 'a
-    }
-  [@@deriving hardcaml]
-end
-
-module O = struct
-  type 'a t =
-    { (* Synchronized levels: selection (active high) and LDI. *)
-      selected_o : 'a
-    ; data_o : 'a
-    ; (* One-cycle events, visible in the cycle the synchronized level first changes. *)
-      select_assert_o : 'a
-    ; select_release_o : 'a
-    ; clock_rise_o : 'a
-    ; clock_fall_o : 'a
-    ; (* The synchronized selection was low (deselected), with enable high and reset low,
-         in each of the [deselect_qualification] cycles before this one. *)
-      deselect_qualified_o : 'a
-    }
-  [@@deriving hardcaml]
-end
-
-[@@@ocamlformat "disable"]
-
-(* Registered synchronizer and qualification state; [compile] holds each field by default.
-
-   *_meta            : first synchronizer stage, possibly metastable, read only by *_sync;
-   *_sync            : second stage, the synchronized level;
-   *_previous        : *_sync one cycle earlier, for edge detection;
-   select_high_count : consecutive synchronized deselected cycles, saturating at
-                       [deselect_qualification];
-*)
-module I_Regs = struct
-  type 'a t =
-    { select_meta       : 'a
-    ; select_sync       : 'a
-    ; select_previous   : 'a
-    ; select_high_count : 'a [@bits 3]
-    ; clock_meta        : 'a
-    ; clock_sync        : 'a
-    ; clock_previous    : 'a
-    ; data_meta         : 'a
-    ; data_sync         : 'a
-    }
-  [@@deriving hardcaml]
-end
-
-let create (scope : Scope.t) (i : _ I.t) : _ O.t =
-  let open Always in
-  let spec = Reg_spec.create ~clock:i.clock_i ~clear:i.reset_i () in
-  let r = I_Regs.Of_always.reg spec in
-  I_Regs.Of_always.apply_names ~prefix:"reg_" ~naming_op:(Scope.naming scope) r;
-
-  let selected_async = ~:(i.serial_select_n_i) in
-
-  (* The synchronizers advance every edge. A selection resets the count; otherwise it
-     saturates at the threshold. Disable clears the count last, so it wins.
-  *)
-  compile
-    [ (* The three asynchronous inputs use matching two-stage synchronizers. *)
-      r.select_meta <-- selected_async
-    ; r.select_sync <-- r.select_meta.value
-    ; r.select_previous <-- r.select_sync.value
-    ; r.select_high_count <-- r.select_high_count.value
-    ; r.clock_meta <-- i.serial_clock_i
-    ; r.clock_sync <-- r.clock_meta.value
-    ; r.clock_previous <-- r.clock_sync.value
-    ; r.data_meta <-- i.serial_data_i
-    ; r.data_sync <-- r.data_meta.value
-
-    ; if_ r.select_sync.value
-        [ r.select_high_count <--. 0 ]
-        [ when_ (r.select_high_count.value <:. deselect_qualification)
-            [ r.select_high_count <-- r.select_high_count.value +:. 1 ]
-        ]
-
-    ; when_ (~:(i.enable_i))
-        [ r.select_high_count <--. 0 ]
-    ];
-
-  { O.selected_o         = r.select_sync.value
-  ; data_o               = r.data_sync.value
-  ; select_assert_o      = r.select_sync.value &: ~:(r.select_previous.value)
-  ; select_release_o     = ~:(r.select_sync.value) &: r.select_previous.value
-  ; clock_rise_o         = r.clock_sync.value &: ~:(r.clock_previous.value)
-  ; clock_fall_o         = ~:(r.clock_sync.value) &: r.clock_previous.value
-  ; deselect_qualified_o = r.select_high_count.value >=:. deselect_qualification
-  }
-;;
-[@@@ocamlformat "enable"]
diff --git a/lib/host_link/wire_crc.ml b/lib/host_link/wire_crc.ml
deleted file mode 100644
index 47f89f3..0000000
--- a/lib/host_link/wire_crc.ml
+++ /dev/null
@@ -1,37 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "wire_crc.ml" *)
-(* The synthesizable CRC-8 step shared by the host-link hardware.
-
-   [Frame_rx] folds it over each received request byte and [Command_dispatch] over every
-   response frame it builds, so both sides of the link use one hardware expression. The
-   parameters come from [Wire.Crc], the P3.5 definition; the software CRC there is a
-   separate implementation and is not used here. This is the one CRC the link needs, not a
-   general CRC generator.
-
-   The implementation is an MSB-first shift register with no reflection and no final XOR.
-   [crc8_byte] checks at elaboration, every time it is used, that [Wire.Crc] still
-   describes that; so the check runs whichever block is elaborated, alone or composed.
-*)
-
-open! Core
-open! Hardcaml
-open! Signal
-module Wire = Protemu_host_link_wire.Wire
-
-(* Plain OCaml; raises at circuit construction and creates no logic. *)
-let check_parameters () =
-  if not (Wire.Crc.width = 8 && (not Wire.Crc.reflected) && Wire.Crc.final_xor = 0)
-  then invalid_arg "Wire_crc: CRC parameters are not supported by crc8_byte"
-;;
-
-(* One byte of CRC-8, MSB first, with no reflection or final XOR. *)
-let crc8_byte crc data =
-  check_parameters ();
-  List.fold
-    (List.init 8 ~f:(fun index -> 7 - index))
-    ~init:crc
-    ~f:(fun crc bit_index ->
-      let feedback = bit crc ~pos:7 ^: bit data ~pos:bit_index in
-      mux2 feedback (sll crc ~by:1 ^:. Wire.Crc.polynomial) (sll crc ~by:1))
-;;
diff --git a/lib/host_link/wire_layout.ml b/lib/host_link/wire_layout.ml
deleted file mode 100644
index 8eba484..0000000
--- a/lib/host_link/wire_layout.ml
+++ /dev/null
@@ -1,42 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "wire_layout.ml" *)
-(* Elaboration-time checks that the host-link hardware's fixed byte layouts follow [Wire].
-
-   The hardware builds and parses frames from literal byte lists and fixed byte counts,
-   not from [Wire]'s offsets, so each block checks at elaboration that the layout it
-   assumes still tiles [Wire]'s. Each block owns the checks for the layouts it alone
-   relies on; this module holds the tiling check itself and the one layout two blocks
-   share. Plain OCaml: a failed check raises at circuit construction and nothing here
-   creates logic.
-*)
-
-open! Core
-module Wire = Protemu_host_link_wire.Wire
-
-(* Byte fields, as (offset, width), in the order [owner] uses them. They must tile the
-   layout exactly: each field starts where the previous one ended, and the last ends at
-   [length].
-*)
-let check ~owner name ~length fields =
-  let next =
-    List.fold fields ~init:0 ~f:(fun expected (offset, width) ->
-      if offset <> expected
-      then invalid_argf "%s: %s field at %d, expected %d" owner name offset expected ();
-      offset + width)
-  in
-  if next <> length
-  then invalid_argf "%s: %s layout is %d bytes, expected %d" owner name next length ()
-;;
-
-(* The request payload is two little-endian u16 fields filling [max_payload_length].
-   [Frame_rx] stores the payload bytes positionally and [Command_dispatch] selects each
-   field at [Wire]'s offset, so both rely on it.
-*)
-let check_request_payload ~owner =
-  check
-    ~owner
-    "request payload"
-    ~length:Wire.Request.max_payload_length
-    Wire.Request.Payload_offset.[ address, 2; word, 2 ]
-;;
