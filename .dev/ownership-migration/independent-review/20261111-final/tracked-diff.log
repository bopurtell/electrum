-; The whole synthesizable surface of this repository, as ONE wrapped library.
-;
-; (include_subdirs unqualified) groups files into subsystem directories for browsing
-; only. Module names stay flat: a consumer writes `open! Hardcaml_protemu` and reaches
-; blocks as <Module>, whatever directory holds them. Executables (e.g. the RTL
-; generator) live in bin/, because include_subdirs claims this subtree.
+; Build facade for the existing flat, wrapped hardware library. Authored sources
+; live with their owners; these explicit copies exist only in the build tree.
+; Keep plain copy_files (not copy_files#): PPX lint reads the generated .pp.ml
+; source path in this directory. ASIC-dependent package modules are separate.
 
-(include_subdirs unqualified)
+(copy_files ../ip/mechanisms/rtl/byte_fifo.ml)
+(copy_files ../ip/mechanisms/rtl/input_events.ml)
+(copy_files ../ip/mechanisms/rtl/pin_bank.ml)
+(copy_files ../ip/mechanisms/rtl/shift_lane.ml)
+(copy_files ../ip/mechanisms/rtl/timing.ml)
+(copy_files ../ip/mechanisms/rtl/staging/observed_transfer.ml)
+(copy_files ../ip/mechanisms/rtl/staging/observed_transfer_bank.ml)
+(copy_files ../ip/mechanisms/rtl/staging/primitive_demo.ml)
+(copy_files ../ip/mechanisms/rtl/staging/uart_slice.ml)
+(copy_files ../ip/mechanisms/rtl/staging/uart_tx.ml)
+(copy_files ../ip/program_memory_controller/rtl/program_memory_controller.ml)
+(copy_files ../ip/emulator_core/rtl/control_port.ml)
+(copy_files ../ip/emulator_core/rtl/emulator_core.ml)
+(copy_files ../ip/emulator_core/rtl/execution_unit.ml)
+(copy_files ../ip/emulator_core/rtl/instruction_decoder.ml)
