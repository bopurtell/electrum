-
-let%test_unit "an abandoned partial read replays from byte zero without re-offering" =
-  (* Contract-faithful. RUN is the side-effecting command the peer uses for replay. *)
-  let t = create "partial read replay" in
-  set_status t { Status.halted_idle with image_valid = 1 };
-  let started = t.cycle in
-  let request_deselected = send_frame t (encode ~tag:0x75 Run) in
-  let ready = wait_ready t ~since:request_deselected in
-  let prefix, deselected = read_prefix t ~bits:24 in
-  expect_retained t ~deselected ~cycles:200;
-  let exchange =
-    receive
-      t
-      ~started
-      ~request_deselected
-      ~expected:(Wire.Request.correlation ~tag:0x75 Run)
-  in
-  expect_response
-    t
-    "replayed RUN"
-    ~expected:(response ~tag:0x75 Run Complete)
-    exchange.response;
-  check
-    t
-    ~phase:Host_sample
-    "the abandoned read saw the first three bytes of the same frame"
-    [%sexp_of: string]
-    String.equal
-    ~expected:(hex (String.prefix exchange.bytes 3))
-    (hex prefix);
-  expect_int t "LRDY rose once, before the abandoned read" ~expected:ready exchange.ready;
-  expect_offered_once t exchange Run ~accepted:true;
-  expect_quiet t 200 "RUN is not offered again after replay and commit"
-;;
-
-let%test_unit "final-bit validation rejection retains the response; a later read commits" =
-  (* Contract-faithful. As in the peer, the host rejects a frame it has received in full:
-     it deselects with the final LCLK still high, so the final fall is absent. It rejects
-     twice before committing.
-  *)
-  let t = create "reject then commit" in
-  set_status t { Status.halted_idle with image_valid = 1 };
-  let expected = Wire.Request.correlation ~tag:0x76 Run in
-  let started = t.cycle in
-  let request_deselected = send_frame t (encode ~tag:0x76 Run) in
-  ignore (wait_ready t ~since:request_deselected : int);
-  let reject () =
-    let read = read_response t ~expected ~decide:(fun _ -> Replay) () in
-    check
-      t
-      ~phase:Host_sample
-      "the rejected frame was complete and valid; the rejection is the host's"
-      [%sexp_of: (Wire.Response.t, Wire.Response.Decode_error.t) Result.t]
-      [%equal: (Wire.Response.t, Wire.Response.Decode_error.t) Result.t]
-      ~expected:(Ok (response ~tag:0x76 Run Complete))
-      read.decoded;
-    expect_retained t ~deselected:read.deselected ~cycles:200;
-    read.bytes
-  in
-  let first = reject () in
-  let second = reject () in
-  let rejected = [ first; second ] in
-  let exchange = receive t ~started ~request_deselected ~expected in
-  check
-    t
-    ~phase:Host_sample
-    "every read of the retained response returns the same frame"
-    [%sexp_of: string list]
-    [%equal: string list]
-    ~expected:[ hex exchange.bytes; hex exchange.bytes ]
-    (List.map rejected ~f:hex);
-  expect_offered_once t exchange Run ~accepted:true;
-  expect_quiet t 200 "RUN is offered once across two rejections and a commit"
-;;
-
-let%test_unit "a response selection arms only after four deselected cycles and with LRDY \
-               high"
-  =
-  (* Characterization of the unsplit loader, fixed for HL4b. Each host here breaks the
-     P3.5 envelope on purpose, by selecting too soon, to find the device-side boundary. A
-     selection LSEL_N-low in cycle n is seen in cycle n + 2 and arms only if the loader
-     has counted four deselected cycles and LRDY is high in that cycle. An armed read
-     returns magic [0x5a] as its first byte; an ignored one returns zeros. Either way the
-     retained response is then read in full.
-  *)
-  let first_byte t = fst (read_prefix t ~bits:8) in
-  List.iter
-    [ 3, "\x00"; 4, "\x5a" ]
-    ~f:(fun (gap, expected) ->
-      let t = create (sprintf "INFO read after a %d-cycle gap" gap) in
-      let started = t.cycle in
-      begin_frame t;
-      send t (encode ~tag:0x51 Info);
-      let request_deselected = end_frame t in
-      hold t gap;
-      check
-        t
-        ~phase:Host_sample
-        (sprintf "first response byte after a %d-cycle deselected gap" gap)
-        [%sexp_of: string]
-        String.equal
-        ~expected:(hex expected)
-        (hex (first_byte t));
-      let exchange =
-        receive
-          t
-          ~started
-          ~request_deselected
-          ~expected:(Wire.Request.correlation ~tag:0x51 Info)
-      in
-      expect_response
-        t
-        "INFO after the probe"
-        ~expected:(response ~tag:0x51 Info ~payload:info_payload Complete)
-        exchange.response);
-  (* Robustness probe: a READ response delayed by 20 cycles makes the LRDY rise late
-     enough that only the LRDY condition decides.
-  *)
-  let delay = 20 in
-  List.iter
-    [ 3, "\x00"; 2, "\x5a" ]
-    ~f:(fun (early, expected) ->
-      let t = create (sprintf "READ selected %d cycles before LRDY" early) in
-      t.stub.readback_completion <- Delayed delay;
-      t.stub.memory.(4) <- 0x4444;
-      let started = t.cycle in
-      begin_frame t;
-      send t (encode ~tag:0x52 (Read_word { address = 4 }));
-      let request_deselected = end_frame t in
-      let ready =
-        request_deselected
-        + Latency.offer_after_deselect
-        + Latency.readback_after_offer
-        + delay
-        + Latency.ready_after_completion
-      in
-      hold t (ready - early - t.cycle);
-      check
-        t
-        ~phase:Host_sample
-        (sprintf "first response byte, selected %d cycles before LRDY" early)
-        [%sexp_of: string]
-        String.equal
-        ~expected:(hex expected)
-        (hex (first_byte t));
-      let exchange =
-        receive
-          t
-          ~started
-          ~request_deselected
-          ~expected:(Wire.Request.correlation ~tag:0x52 (Read_word { address = 4 }))
-      in
-      expect_int
-        t
-        "LRDY rose where the delayed response put it"
-        ~expected:ready
-        exchange.ready;
-      expect_response
-        t
-        "READ after the probe"
-        ~expected:(response ~tag:0x52 Read_word ~payload:(Word 0x4444) Complete)
-        exchange.response)
-;;
diff --git a/test/host_link/archived/hl4a/serial_host_monitor_tests.ml b/test/host_link/archived/hl4a/serial_host_monitor_tests.ml
deleted file mode 100644
index 4070642..0000000
--- a/test/host_link/archived/hl4a/serial_host_monitor_tests.ml
+++ /dev/null
@@ -1,311 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "serial_host_monitor_tests.ml" *)
-(* SP2: the serial-host agent's passive monitor agrees with its driver at the composed
-   [Host_link]'s serial pins.
-
-   The scoreboard here compares two independent streams. Expected items are written from
-   what the driver sent and from the results it returned ([Read.t], [Exchange.t], a prefix
-   and its deselection cycle). Actual items are the monitor's, rebuilt from the sampled
-   pins alone. Neither component reads the other; only this file joins them. The last case
-   corrupts one LDI bit on its way to the DUT, through the testbench's test-only adapter
-   path, and requires the scoreboard to report it. See docs/serial_host_pilot.md, SP2.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Hardware_loader_testbench
-module Observed = Serial_host.Item.Observed
-
-(* Items with bytes in hex, for the trace and for scoreboard reports. *)
-let sexp_of_item : Observed.t -> Sexp.t = function
-  | Request { selected; deselected; bytes; extra_bits } ->
-    [%message
-      "request"
-        (selected : int)
-        (deselected : int)
-        ~bytes:(hex bytes : string)
-        (extra_bits : bool list)]
-  | Response { selected; deselected; bytes; extra_bits; decoded; ending } ->
-    [%message
-      "response"
-        (selected : int)
-        (deselected : int)
-        ~bytes:(hex bytes : string)
-        (extra_bits : bool list)
-        (decoded : (Wire.Response.t, Wire.Response.Decode_error.t) Result.t)
-        (ending : Observed.Ending.t)]
-;;
-
-(* The scoreboard: the monitor's items since the last call are exactly [expected], in
-   order. Compared items are dequeued.
-*)
-let expect_observed t what expected =
-  let actual = Queue.to_list (observed t) in
-  Queue.clear (observed t);
-  check
-    t
-    ~phase:Post_run
-    what
-    [%sexp_of: item list]
-    [%equal: Observed.t list]
-    ~expected
-    actual
-;;
-
-(* Cycles [begin_frame] holds after LSEL_N falls. [Read.selected] counts from after it;
-   the monitor's [selected] is the cycle LSEL_N fell.
-*)
-let lead t = Int.max 0 (t.timing.select_lead - t.timing.clock_low)
-
-(* Expected items, from the driver's side only. *)
-
-let request ?(extra_bits = 0) ?(extra_byte = '\xff') ~selected ~deselected bytes
-  : Observed.t
-  =
-  Request
-    { selected
-    ; deselected
-    ; bytes
-    ; extra_bits = List.take (bits_of_byte extra_byte) extra_bits
-    }
-;;
-
-(* The monitor decodes without a correlation, so a driver-side mismatch is the response it
-   carries.
-*)
-let uncorrelated = function
-  | Error (Wire.Response.Decode_error.Correlation_mismatch { response; _ }) -> Ok response
-  | decoded -> decoded
-;;
-
-let response_read t (read : Read.t) : Observed.t =
-  Response
-    { selected = read.selected - lead t
-    ; deselected = read.deselected
-    ; bytes = read.bytes
-    ; extra_bits = []
-    ; decoded = uncorrelated read.decoded
-    ; ending =
-        (match read.outcome with
-         | Commit -> Commit
-         | Replay -> Replay)
-    }
-;;
-
-let committed t (exchange : Exchange.t) : Observed.t =
-  Response
-    { selected = exchange.response_selected - lead t
-    ; deselected = exchange.response_deselected
-    ; bytes = exchange.bytes
-    ; extra_bits = []
-    ; decoded = Ok exchange.response
-    ; ending = Commit
-    }
-;;
-
-(* A request frame [frame] and its committed response. *)
-let transaction ?extra_bits ?extra_byte t (exchange : Exchange.t) frame =
-  [ request
-      ?extra_bits
-      ?extra_byte
-      ~selected:exchange.started
-      ~deselected:exchange.request_deselected
-      frame
-  ; committed t exchange
-  ]
-;;
-
-let expect_transaction t ~tag request =
-  let exchange = transact t ~tag request in
-  expect_observed
-    t
-    (Sexp.to_string [%sexp (request : Wire.Request.t)])
-    (transaction t exchange (encode ~tag request))
-;;
-
-let%expect_test "the monitor's items for one WRITE_WORD transaction" =
-  let t = create "monitor trace" in
-  let exchange = transact t ~tag:0x31 (Write_word { address = 0x12; word = 0xbeef }) in
-  Queue.iter (observed t) ~f:(fun item -> print_s (sexp_of_item item));
-  [%expect
-    {|
-    (request (selected 8) (deselected 716)
-     (bytes "a5 10 31 11 04 00 12 00 ef be ff") (extra_bits ()))
-    (response (selected 721) (deselected 1237) (bytes "5a 10 31 11 00 00 00 1e")
-     (extra_bits ())
-     (decoded (Ok ((tag 49) (command 17) (result Complete) (payload Empty))))
-     (ending Commit))
-    |}];
-  expect_observed
-    t
-    "WRITE_WORD"
-    (transaction
-       t
-       exchange
-       (encode ~tag:0x31 (Write_word { address = 0x12; word = 0xbeef })))
-;;
-
-let%test_unit "legal INFO, READ, and VERIFY transactions" =
-  let t = create "monitor: legal transactions" in
-  expect_transaction t ~tag:0x41 Info;
-  expect_transaction t ~tag:0x42 (Read_word { address = 3 });
-  expect_transaction
-    t
-    ~tag:0x43
-    (Verify_word { address = 3; expected = t.stub.memory.(3) });
-  expect_transaction t ~tag:0x44 (Verify_word { address = 4; expected = 0 })
-;;
-
-let%test_unit "a malformed request is observed as the raw bytes clocked" =
-  let t = create "monitor: malformed request" in
-  let info = Wire.Command.to_int Info in
-  List.iter
-    [ Raw.frame ~magic:0x00 ~tag:0x24 ~command:info []
-    ; Raw.flip_last (encode ~tag:0x25 Info) ~mask:0x80
-    ]
-    ~f:(fun frame ->
-      let started = t.cycle in
-      let request_deselected = send_frame t frame in
-      let exchange =
-        receive
-          t
-          ~started
-          ~request_deselected
-          ~expected:{ tag = Char.to_int frame.[2]; command = info }
-      in
-      expect_observed t ("malformed " ^ hex frame) (transaction t exchange frame))
-;;
-
-let%test_unit "a request with trailing extra bits keeps them apart from its bytes" =
-  let t = create "monitor: extra bits" in
-  let frame = encode ~tag:0x26 (Write_word { address = 0; word = 0x1234 }) in
-  let started = t.cycle in
-  let request_deselected = send_frame t frame ~extra_bits:3 ~extra_byte:'\xa0' in
-  let exchange =
-    receive
-      t
-      ~started
-      ~request_deselected
-      ~expected:{ tag = 0x26; command = Wire.Command.to_int Write_word }
-  in
-  expect_observed
-    t
-    "WRITE_WORD and three bits"
-    (transaction t exchange frame ~extra_bits:3 ~extra_byte:'\xa0')
-;;
-
-let%test_unit "a replayed response, then its commit" =
-  let t = create "monitor: replay" in
-  let frame = encode ~tag:0x27 Status in
-  let expected = Wire.Request.correlation ~tag:0x27 Status in
-  let started = t.cycle in
-  let request_deselected = send_frame t frame in
-  ignore (wait_ready t ~since:request_deselected : int);
-  let replayed = read_response t ~expected ~decide:(fun _ -> Replay) () in
-  let exchange = receive t ~started ~request_deselected ~expected in
-  expect_observed
-    t
-    "STATUS replayed once, then committed"
-    [ request ~selected:started ~deselected:request_deselected frame
-    ; response_read t replayed
-    ; committed t exchange
-    ]
-;;
-
-let%test_unit "abandoned reads before and after the header" =
-  (* INFO is the largest response, so the frame its header declares is
-     [Wire.Response.max_length] bytes. Twenty-four bits stop inside the header; sixty-four
-     stop after it, where only the declared length shows the read was cut short.
-  *)
-  let t = create "monitor: abandoned reads" in
-  let frame = encode ~tag:0x28 Info in
-  let started = t.cycle in
-  let request_deselected = send_frame t frame in
-  ignore (wait_ready t ~since:request_deselected : int);
-  let abandoned ~bits ~decoded =
-    let selected = t.cycle in
-    let bytes, deselected = read_prefix t ~bits in
-    Observed.Response
-      { selected; deselected; bytes; extra_bits = []; decoded; ending = Abandoned }
-  in
-  let short =
-    abandoned
-      ~bits:24
-      ~decoded:(Error (Truncated { expected = Wire.Response.min_length; actual = 3 }))
-  in
-  let past_header =
-    abandoned
-      ~bits:64
-      ~decoded:(Error (Truncated { expected = Wire.Response.max_length; actual = 8 }))
-  in
-  let exchange =
-    receive
-      t
-      ~started
-      ~request_deselected
-      ~expected:(Wire.Request.correlation ~tag:0x28 Info)
-  in
-  expect_observed
-    t
-    "INFO abandoned twice, then committed"
-    [ request ~selected:started ~deselected:request_deselected frame
-    ; short
-    ; past_header
-    ; committed t exchange
-    ]
-;;
-
-let%test_unit "the agent is active only with a driver" =
-  let passive = Serial_host.Agent.create Serial_host.Config.passive in
-  assert (Option.is_none passive.driver);
-  assert (Queue.is_empty (Serial_host.Agent.observed passive));
-  match Serial_host.Agent.create (Serial_host.Config.active ()) with
-  | (_ : Serial_host.Agent.t) -> raise_s [%message "an active agent without hooks"]
-  | exception _ -> ()
-;;
-
-let require_failure t what f =
-  match failure_of f with
-  | Some failure -> failure
-  | None -> fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-let%expect_test "the scoreboard reports an LDI bit the driver did not send" =
-  (* Test-only: the adapter inverts LDI on its way to the DUT for the whole interval of
-     request bit 20, from the fall before it to the fall after it. That is bit 4 of the
-     tag byte, so the pins carry tag 0x4a where the driver sent 0x42. The driver's own
-     record is unchanged; only the monitor can see the difference.
-  *)
-  let t = create ~transcript_limit:4 "negative: one LDI bit corrupted" in
-  let frame = encode ~tag:0x42 Info in
-  let started = t.cycle in
-  let period = t.timing.clock_low + t.timing.clock_high in
-  let from = started + lead t + (20 * period) in
-  t.ldi_fault <- (fun cycle -> cycle >= from && cycle < from + period);
-  let request_deselected = send_frame t frame in
-  t.ldi_fault <- Fn.const false;
-  print_s
-    (require_failure t "a corrupted LDI bit" (fun () ->
-       expect_observed
-         t
-         "the monitor saw the frame the driver sent"
-         [ request ~selected:started ~deselected:request_deselected frame ]));
-  [%expect
-    {|
-    (test/host_link/hardware_loader_testbench.ml.Harness_failure
-     (scenario "negative: one LDI bit corrupted") (cycle 463) (phase Post_run)
-     (what "the monitor saw the frame the driver sent")
-     (expected
-      (((request (selected 8) (deselected 460) (bytes "a5 10 42 00 00 00 df")
-         (extra_bits ())))))
-     (actual
-      (((request (selected 8) (deselected 460) (bytes "a5 10 4a 00 00 00 df")
-         (extra_bits ())))))
-     (transcript
-      ((earlier_events_omitted 3)
-       (events
-        ((8 (Sent (bytes "a5 10 42 00 00 00 df") (extra_bits 0)))
-         (11 (Busy true)) (460 (Select false)) (463 (Ready true)))))))
-    |}]
-;;
diff --git a/test/host_link/command_dispatch/command_dispatch_command_tests.ml b/test/host_link/command_dispatch/command_dispatch_command_tests.ml
deleted file mode 100644
index 37fd971..0000000
--- a/test/host_link/command_dispatch/command_dispatch_command_tests.ml
+++ /dev/null
@@ -1,417 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "command_dispatch_command_tests.ml" *)
-(* HL4c: [Command_dispatch]'s command recognition, fixed lengths, device bounds, result
-   precedence, and one-shot core offers with exact operands.
-
-   Expected records are written by hand. Every operand of the request record is driven
-   continuously from the retained fields (control_port.ml item 2): addresses and lengths
-   are the low nine bits of payload bytes 0 and 1, and both data operands are payload
-   bytes 2 and 3, which after a two-byte payload are the CRC byte and zero
-   (docs/host_link_hl4b2_record.md). The tests pin those driven values even where the core
-   ignores them.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Command_dispatch_testbench
-
-let quiet_after = 50
-
-(* The request record for 16-bit address/length [a] and data [d], with no valid. *)
-let operands ~a ~d ~verify : Port.t =
-  { Port.idle with
-    load_length = a
-  ; load_address = a
-  ; load_data = d
-  ; readback_address = a
-  ; readback_verify = Bool.to_int verify
-  ; readback_expected = d
-  }
-;;
-
-(* Dispatch one legal request and check its offer, operands, response, and busy cycles.
-   The stub accepts, so every response is the success case.
-*)
-let expect_dispatch t ~tag request ~offer ~record ~response =
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag request) in
-  run t quiet_after;
-  let o = h + Latency.offer_after_handoff in
-  expect_offers
-    t
-    ~since:from
-    "one offer, in the cycle after the handoff"
-    (Option.to_list offer
-     |> List.map ~f:(fun request ->
-       { Core_stub.Offer.cycle = o; request; accepted = true }));
-  expect_request t ~cycle:o "offer cycle" record;
-  let what = Sexp.to_string [%sexp (request : Wire.Request.t)] in
-  expect_publications t ~from what [ h + Latency.immediate_after_handoff, response ];
-  expect_busy t ~from what [ o ]
-;;
-
-let%test_unit "each immediate command is offered once, in the cycle after the handoff, \
-               with exact operands"
-  =
-  let t = create "immediate commands" in
-  (* INFO and STATUS answer from the dispatcher and offer nothing. *)
-  let info = Handoff.request ~tag:0x01 Info in
-  let from = t.cycle in
-  let h = handoff t info in
-  run t quiet_after;
-  expect_offers t ~since:from "INFO" [];
-  expect_request
-    t
-    ~cycle:(h + 1)
-    "INFO operands (CRC byte in payload[7:0])"
-    (operands ~a:(info.payload land 0xff) ~d:0 ~verify:false);
-  expect_busy t ~from "INFO" [ h + 1 ];
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x02 Status) in
-  run t quiet_after;
-  expect_offers t ~since:from "STATUS" [];
-  expect_busy t ~from "STATUS" [ h + 1 ];
-  let load_start = Handoff.request ~tag:0x10 (Load_start { length = 0x0040 }) in
-  expect_dispatch
-    t
-    ~tag:0x10
-    (Load_start { length = 0x0040 })
-    ~offer:(Some (Load_start { length = 0x040 }))
-    ~record:
-      { (operands ~a:0x040 ~d:(load_start.payload lsr 16) ~verify:false) with
-        load_start_valid = 1
-      }
-    ~response:(response ~tag:0x10 Load_start Complete);
-  expect_dispatch
-    t
-    ~tag:0x11
-    (Write_word { address = 0x00ff; word = 0xbeef })
-    ~offer:(Some (Load_write { address = 0x0ff; data = 0xbeef }))
-    ~record:{ (operands ~a:0x0ff ~d:0xbeef ~verify:false) with load_write_valid = 1 }
-    ~response:(response ~tag:0x11 Write_word Complete);
-  expect_dispatch
-    t
-    ~tag:0x14
-    Load_complete
-    ~offer:(Some Load_complete)
-    ~record:
-      { (operands ~a:(Handoff.request ~tag:0x14 Load_complete).payload ~d:0 ~verify:false) with
-        load_complete_valid = 1
-      }
-    ~response:(response ~tag:0x14 Load_complete Complete);
-  expect_dispatch
-    t
-    ~tag:0x20
-    Run
-    ~offer:(Some Run)
-    ~record:
-      { (operands ~a:(Handoff.request ~tag:0x20 Run).payload ~d:0 ~verify:false) with
-        run_valid = 1
-      }
-    ~response:(response ~tag:0x20 Run Complete);
-  expect_dispatch
-    t
-    ~tag:0x21
-    Stop
-    ~offer:(Some Stop)
-    ~record:
-      { (operands ~a:(Handoff.request ~tag:0x21 Stop).payload ~d:0 ~verify:false) with
-        stop_valid = 1
-      }
-    ~response:(response ~tag:0x21 Stop Accepted_pending)
-;;
-
-let%test_unit "READ, VERIFY, and ABORT are offered once and wait; operands are exact" =
-  let t = create "waiting commands" in
-  (* READ: the expected operand carries the CRC byte; the core ignores it without
-     [readback_verify]. *)
-  let read = Handoff.request ~tag:0x12 (Read_word { address = 0x0042 }) in
-  let from = t.cycle in
-  let h = handoff t read in
-  run t quiet_after;
-  let o = h + 1 in
-  expect_offers
-    t
-    ~since:from
-    "READ"
-    [ { cycle = o; request = Read { address = 0x042 }; accepted = true } ];
-  expect_request
-    t
-    ~cycle:o
-    "READ"
-    { (operands ~a:0x042 ~d:(read.payload lsr 16) ~verify:false) with readback_valid = 1 };
-  check
-    t
-    ~phase:Post_run
-    "READ's expected operand is the CRC byte, as stimulus"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:
-      (Char.to_int (Handoff.encode ~tag:0x12 (Read_word { address = 0x0042 })).[8])
-    (read.payload lsr 16);
-  let word = t.stub.memory.(0x42) in
-  expect_publications
-    t
-    ~from
-    "READ"
-    [ ( o + Latency.readback_after_offer
-      , response ~tag:0x12 Read_word ~payload:(Word word) Complete )
-    ];
-  expect_busy t ~from "READ" [ o; o + 1; o + 2 ];
-  let from = t.cycle in
-  let h =
-    handoff
-      t
-      (Handoff.request ~tag:0x13 (Verify_word { address = 0x0007; expected = 0x1234 }))
-  in
-  run t quiet_after;
-  let o = h + 1 in
-  expect_offers
-    t
-    ~since:from
-    "VERIFY"
-    [ { cycle = o
-      ; request = Verify { address = 0x007; expected = 0x1234 }
-      ; accepted = true
-      }
-    ];
-  expect_request
-    t
-    ~cycle:o
-    "VERIFY"
-    { (operands ~a:0x007 ~d:0x1234 ~verify:true) with readback_valid = 1 };
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x22 Abort) in
-  run t quiet_after;
-  let o = h + 1 in
-  expect_offers t ~since:from "ABORT" [ { cycle = o; request = Abort; accepted = true } ];
-  expect_request
-    t
-    ~cycle:o
-    "ABORT"
-    { (operands ~a:(Handoff.request ~tag:0x22 Abort).payload ~d:0 ~verify:false) with
-      abort_valid = 1
-    };
-  expect_publications
-    t
-    ~from
-    "ABORT"
-    [ o + Latency.abort_clean_after_offer, response ~tag:0x22 Abort Complete ];
-  expect_busy t ~from "ABORT" [ o; o + 1 ]
-;;
-
-let%test_unit "nothing is offered while idle, while waiting, or after completion" =
-  let t = create "no unsolicited offers" in
-  run t 2000;
-  expect_quiet t ~from:0 "idle after reset";
-  (* A READ whose response never comes (robustness): one offer, then only the wait. *)
-  t.stub.readback_completion <- Never;
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x31 (Read_word { address = 0x0001 })) in
-  run t 2000;
-  expect_offers
-    t
-    ~since:from
-    "robustness: an unbounded READ wait"
-    [ { cycle = h + 1; request = Read { address = 0x001 }; accepted = true } ];
-  expect_publications t ~from "robustness: an unbounded READ wait" [];
-  expect_busy t ~from "robustness: an unbounded READ wait" (List.range (h + 1) t.cycle);
-  (* Disable ends the wait; then a completed STOP and a long idle interval. *)
-  set t ~enable:false;
-  run t 1;
-  set t ~enable:true;
-  t.stub.readback_completion <- Contract;
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x32 Stop) in
-  run t 3000;
-  expect_offers
-    t
-    ~since:from
-    "after completion"
-    [ { cycle = h + 1; request = Stop; accepted = true } ]
-;;
-
-let%test_unit "unknown command bytes publish Bad_command with the raw byte and offer \
-               nothing"
-  =
-  let t = create "unknown commands" in
-  List.iter
-    [ 0x02, 0; 0x0f, 0; 0x15, 0; 0x23, 0; 0x7f, 0; 0x80, 0; 0xff, 0; 0x15, 2; 0x7f, 4 ]
-    ~f:(fun (command, payload_length) ->
-      let from = t.cycle in
-      let h =
-        handoff t (Handoff.raw ~tag:0xc3 ~command ~payload_length ~payload:0x0000_0100)
-      in
-      run t 10;
-      let what = sprintf "command %02x, length %d" command payload_length in
-      expect_offers t ~since:from what [];
-      expect_publications
-        t
-        ~from
-        what
-        [ h + 1, raw_response ~tag:0xc3 ~command Bad_command ];
-      expect_busy t ~from what [ h + 1 ])
-;;
-
-let%test_unit "every known command with a wrong fixed length publishes Bad_length and \
-               offers nothing"
-  =
-  let t = create "wrong fixed lengths" in
-  (* Legal lengths: 0 for INFO, STATUS, LOAD_COMPLETE, RUN, STOP, ABORT; 2 for LOAD_START
-     and READ; 4 for WRITE and VERIFY. Operands are in range, so only the length fails.
-  *)
-  let cases : (Wire.Command.t * int list) list =
-    [ Info, [ 1; 2; 3; 4 ]
-    ; Status, [ 1; 2; 3; 4 ]
-    ; Load_start, [ 0; 1; 3; 4 ]
-    ; Write_word, [ 0; 1; 2; 3 ]
-    ; Read_word, [ 0; 1; 3; 4 ]
-    ; Verify_word, [ 0; 1; 2; 3 ]
-    ; Load_complete, [ 1; 2; 3; 4 ]
-    ; Run, [ 1; 2; 3; 4 ]
-    ; Stop, [ 1; 2; 3; 4 ]
-    ; Abort, [ 1; 2; 3; 4 ]
-    ]
-  in
-  List.iter cases ~f:(fun (command, lengths) ->
-    List.iter lengths ~f:(fun payload_length ->
-      let from = t.cycle in
-      let h =
-        handoff
-          t
-          (Handoff.raw
-             ~tag:0x5a
-             ~command:(Wire.Command.to_int command)
-             ~payload_length
-             ~payload:0x1234_0010)
-      in
-      run t 10;
-      let what =
-        sprintf
-          "%s, length %d"
-          (Sexp.to_string [%sexp (command : Wire.Command.t)])
-          payload_length
-      in
-      expect_offers t ~since:from what [];
-      expect_publications t ~from what [ h + 1, response ~tag:0x5a command Bad_length ]));
-  (* Robustness: [Frame_rx] never hands off [Complete] with a length above four, but the
-     comparison is on all sixteen bits: a matching low byte does not pass.
-  *)
-  List.iter
-    [ Wire.Command.Run, 0x0100; Load_start, 0x0102; Write_word, 0x0404; Info, 0xff00 ]
-    ~f:(fun (command, payload_length) ->
-      let from = t.cycle in
-      let h =
-        handoff
-          t
-          (Handoff.raw
-             ~tag:0x5b
-             ~command:(Wire.Command.to_int command)
-             ~payload_length
-             ~payload:0x1234_0010)
-      in
-      run t 10;
-      let what = sprintf "robustness: length %04x" payload_length in
-      expect_offers t ~since:from what [];
-      expect_publications t ~from what [ h + 1, response ~tag:0x5b command Bad_length ])
-;;
-
-let%test_unit "device bounds are checked on the full sixteen-bit operand before narrowing"
-  =
-  let t = create "device bounds" in
-  let dispatch ~tag request =
-    let from = t.cycle in
-    let h = handoff t (Handoff.request ~tag request) in
-    run t 10;
-    from, h
-  in
-  (* LOAD_START: 1 to 256 words. 0x0201 and 0x0300 would narrow to 1 and 0x100. *)
-  List.iter
-    [ 0x0001, 0x001; 0x00ff, 0x0ff; 0x0100, 0x100 ]
-    ~f:(fun (length, narrowed) ->
-      let from, h = dispatch ~tag:0x40 (Load_start { length }) in
-      let what = sprintf "LOAD_START %04x" length in
-      expect_offers
-        t
-        ~since:from
-        what
-        [ { cycle = h + 1; request = Load_start { length = narrowed }; accepted = true } ];
-      expect_publications t ~from what [ h + 1, response ~tag:0x40 Load_start Complete ]);
-  List.iter [ 0x0000; 0x0101; 0x0201; 0x0300; 0x1000; 0xffff ] ~f:(fun length ->
-    let from, h = dispatch ~tag:0x41 (Load_start { length }) in
-    let what = sprintf "LOAD_START %04x" length in
-    expect_offers t ~since:from what [];
-    expect_publications t ~from what [ h + 1, response ~tag:0x41 Load_start Image_bounds ]);
-  (* WRITE, READ, VERIFY: addresses 0 to 0xff. 0x0200 would narrow to 0. *)
-  List.iter [ 0x0000; 0x00ff ] ~f:(fun address ->
-    let from, h = dispatch ~tag:0x42 (Write_word { address; word = 0x5555 }) in
-    expect_offers
-      t
-      ~since:from
-      "WRITE in range"
-      [ { cycle = h + 1
-        ; request = Load_write { address; data = 0x5555 }
-        ; accepted = true
-        }
-      ]);
-  List.iter [ 0x0100; 0x0200; 0x01ff; 0xff00; 0xffff ] ~f:(fun address ->
-    List.iter
-      [ Wire.Request.Write_word { address; word = 0x5555 }
-      ; Read_word { address }
-      ; Verify_word { address; expected = 0x5555 }
-      ]
-      ~f:(fun request ->
-        let from, h = dispatch ~tag:0x43 request in
-        let what = Sexp.to_string [%sexp (request : Wire.Request.t)] in
-        expect_offers t ~since:from what [];
-        expect_publications
-          t
-          ~from
-          what
-          [ h + 1, response ~tag:0x43 (Wire.Request.command request) Image_bounds ];
-        expect_busy t ~from what [ h + 1 ]))
-;;
-
-let%test_unit "results resolve in the existing precedence: length, then bounds, then the \
-               core's decision"
-  =
-  let t = create "result precedence" in
-  (* The core would refuse everything; it is never asked when an earlier check fails. *)
-  t.stub.accept <- (fun _ -> false);
-  set_status t Status.running;
-  let case ~tag ~command ~payload_length ~payload expected =
-    let from = t.cycle in
-    let h =
-      handoff
-        t
-        (Handoff.raw ~tag ~command:(Wire.Command.to_int command) ~payload_length ~payload)
-    in
-    run t 10;
-    let what = sprintf "tag %02x" tag in
-    expect_offers t ~since:from what [];
-    expect_publications t ~from what [ h + 1, response ~tag command expected ]
-  in
-  (* Wrong length and out of bounds: Bad_length. *)
-  case ~tag:0x60 ~command:Write_word ~payload_length:3 ~payload:0x0000_0100 Bad_length;
-  case ~tag:0x61 ~command:Load_start ~payload_length:4 ~payload:0x0000_0000 Bad_length;
-  case ~tag:0x62 ~command:Verify_word ~payload_length:2 ~payload:0x0000_0010 Bad_length;
-  case ~tag:0x63 ~command:Read_word ~payload_length:4 ~payload:0x0000_0010 Bad_length;
-  (* Right length, out of bounds, core refusing and executing: Image_bounds, no offer. *)
-  case ~tag:0x64 ~command:Read_word ~payload_length:2 ~payload:0x0000_0100 Image_bounds;
-  case ~tag:0x65 ~command:Load_start ~payload_length:2 ~payload:0x0000_0000 Image_bounds;
-  (* In bounds: offered, and the refusal is classified from status. *)
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x66 (Read_word { address = 0x0010 })) in
-  run t 10;
-  expect_offers
-    t
-    ~since:from
-    "in bounds"
-    [ { cycle = h + 1; request = Read { address = 0x010 }; accepted = false } ];
-  expect_publications
-    t
-    ~from
-    "in bounds"
-    [ h + 1, response ~tag:0x66 Read_word Active_execution ]
-;;
diff --git a/test/host_link/command_dispatch/command_dispatch_diagnostics_tests.ml b/test/host_link/command_dispatch/command_dispatch_diagnostics_tests.ml
deleted file mode 100644
index 292ea99..0000000
--- a/test/host_link/command_dispatch/command_dispatch_diagnostics_tests.ml
+++ /dev/null
@@ -1,126 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "command_dispatch_diagnostics_tests.ml" *)
-(* HL4c: the Command_dispatch checks detect the errors they exist for, and report enough
-   to reproduce them.
-
-   Each case states an expectation that is wrong, or waits for something that never
-   happens, and requires the check to raise [Dispatch_failure]. None of them changes the
-   dispatcher or leaves a failing test in the suite. The first case prints a complete
-   report, so its format is reviewed here.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Command_dispatch_testbench
-
-let require_failure t what f =
-  match failure_of f with
-  | Some failure -> failure
-  | None -> fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-let%expect_test "a wrong refusal class is reported with the recent cycles" =
-  let t = create ~transcript_cycles:4 "negative: engines-active refusal expected" in
-  t.stub.accept <- (fun _ -> false);
-  set_status t Status.running;
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x5e Run) in
-  run t 2;
-  print_s
-    (require_failure t "execution refusal reported as engines active" (fun () ->
-       expect_publications t ~from "RUN" [ h + 1, response ~tag:0x5e Run Engines_active ]));
-  [%expect
-    {|
-    (test/host_link/command_dispatch/command_dispatch_testbench.ml.Dispatch_failure
-     (scenario "negative: engines-active refusal expected") (cycle 4)
-     (phase Post_run) (what "RUN: publications in cycles [2, 5)")
-     (expected
-      (((3
-         (Response
-          ((tag 94) (command 32) (result Engines_active) (payload Empty)))))))
-     (actual
-      (((3
-         (Response
-          ((tag 94) (command 32) (result Active_execution) (payload Empty)))))))
-     (transcript
-      ((1
-        "rst=1 en=1 result=15 echo=0 tag=00 command=00 length=0000 payload=00000000"
-        "idle status=halted=1,engines_idle=1")
-       (2
-        "rst=0 en=1 FRAME_END result=00 echo=1 tag=5e command=20 length=0000 payload=00000013"
-        "idle status=image_valid=1,execution_active=1,phase=5,pin_oe=2,engine_claim=2")
-       (3
-        "rst=0 en=1 result=00 echo=1 tag=5e command=20 length=0000 payload=00000013"
-        "busy offer=Run refused PUBLISH 5a 10 5e 20 20 00 00 7e status=image_valid=1,execution_active=1,phase=5,pin_oe=2,engine_claim=2")
-       (4
-        "rst=0 en=1 result=00 echo=1 tag=5e command=20 length=0000 payload=00000013"
-        "idle status=image_valid=1,execution_active=1,phase=5,pin_oe=2,engine_claim=2"))))
-    |}]
-;;
-
-let%test_unit "a publication expected one cycle late is detected" =
-  (* Stands in for a registered publication between the decision and the store. *)
-  let t = create "negative: publication one cycle late" in
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x01 Stop) in
-  run t 5;
-  ignore
-    (require_failure t "a one-cycle-late publication" (fun () ->
-       expect_publications
-         t
-         ~from
-         "late"
-         [ h + 2, response ~tag:0x01 Stop Accepted_pending ])
-     : Sexp.t)
-;;
-
-let%test_unit "a repeated offer is detected" =
-  (* Stands in for dispatch that is not cleared after its offer. *)
-  let t = create "negative: a second offer expected" in
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x02 Run) in
-  run t 5;
-  ignore
-    (require_failure t "two offers" (fun () ->
-       expect_offers
-         t
-         ~since:from
-         "twice"
-         [ { cycle = h + 1; request = Run; accepted = true }
-         ; { cycle = h + 2; request = Run; accepted = true }
-         ])
-     : Sexp.t)
-;;
-
-let%test_unit "a lost correlation is detected" =
-  let t = create "negative: wrong tag expected" in
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x03 Load_complete) in
-  run t 3;
-  ignore
-    (require_failure t "a response with another tag" (fun () ->
-       expect_publications
-         t
-         ~from
-         "tag"
-         [ h + 1, response ~tag:0x04 Load_complete Complete ])
-     : Sexp.t)
-;;
-
-let%test_unit "waits are bounded and time out with a report" =
-  let t = create "negative: wait budget" in
-  let start = t.cycle in
-  ignore
-    (require_failure t "a wait for a publication that never happens" (fun () ->
-       ignore (wait_for ~budget:25 t "publication" ~f:(fun s -> s.publish) : int))
-     : Sexp.t);
-  check
-    t
-    ~phase:Post_run
-    "cycles spent by the exhausted wait"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:25
-    (t.cycle - start)
-;;
diff --git a/test/host_link/command_dispatch/command_dispatch_lifecycle_tests.ml b/test/host_link/command_dispatch/command_dispatch_lifecycle_tests.ml
deleted file mode 100644
index 13f3616..0000000
--- a/test/host_link/command_dispatch/command_dispatch_lifecycle_tests.ml
+++ /dev/null
@@ -1,317 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "command_dispatch_lifecycle_tests.ml" *)
-(* HL4c: [Command_dispatch]'s lifecycle: dispatch-to-wait-to-publication transitions,
-   [busy_o] over every cycle the retained fields are read, reset and disable at each
-   boundary, and same-cycle priorities.
-
-   Reset and disable are applied for one cycle. Neither gates the offer or the publication
-   in the cycle it is applied: the core refuses the offer (control_port.ml item 8), and
-   the loader's own reset or disable removes the published response. What the dispatcher
-   guarantees is that nothing is offered or published afterwards. Tests named "robustness"
-   present handoffs the composed loader cannot (while [busy_o] is high, when [Frame_rx] is
-   ineligible); they pin the existing statement priority.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Command_dispatch_testbench
-
-type cancel =
-  | Reset
-  | Disable
-[@@deriving sexp_of]
-
-let cancels = [ Reset; Disable ]
-
-(* Apply [cancel] for the next cycle only and return that cycle. *)
-let cancel t = function
-  | Reset ->
-    set t ~reset:true;
-    let at = t.cycle in
-    run t 1;
-    set t ~reset:false;
-    at
-  | Disable ->
-    set t ~enable:false;
-    let at = t.cycle in
-    run t 1;
-    set t ~enable:true;
-    at
-;;
-
-(* Cancel in the cycle [offset] after the handoff of [request]. *)
-let cancel_at t request ~offset kind =
-  let h = handoff t request in
-  run t (offset - 1);
-  let at = cancel t kind in
-  h, at
-;;
-
-(* The retained state is gone: a fresh INFO is answered normally. *)
-let expect_fresh_info t what =
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0xee Info) in
-  run t 3;
-  match publications t ~from ~until:t.cycle with
-  | [ (cycle, Response { tag = 0xee; command = 0x00; result = Complete; _ }) ]
-    when cycle = h + 1 -> ()
-  | other ->
-    fail
-      t
-      ~phase:Post_run
-      (what ^ ": a fresh INFO is answered in the cycle after its handoff")
-      ~actual:[%sexp (other : (int * Published.t) list)]
-;;
-
-let%test_unit "dispatch, waits, and publications follow the handoff at exact cycles" =
-  let t = create "lifecycle timeline" in
-  set_status t Status.running;
-  (* Framing error: published in the handoff cycle, never busy. *)
-  let from = t.cycle in
-  let h = handoff t (Handoff.error Bad_crc ~tag:0x01 ~command:0x20) in
-  run t 5;
-  expect_busy t ~from "framing error" [];
-  expect_publications
-    t
-    ~from
-    "framing error"
-    [ h, raw_response ~tag:0x01 ~command:0x20 Bad_crc ];
-  (* Immediate: busy only in the dispatch cycle, which publishes. *)
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x02 Stop) in
-  run t 5;
-  expect_busy t ~from "STOP" [ h + 1 ];
-  expect_publications t ~from "STOP" [ h + 1, response ~tag:0x02 Stop Accepted_pending ];
-  (* READ: busy from dispatch through the response cycle, which publishes. *)
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x03 (Read_word { address = 1 })) in
-  run t 5;
-  expect_busy t ~from "READ" [ h + 1; h + 2; h + 3 ];
-  expect_publications
-    t
-    ~from
-    "READ"
-    [ h + 3, response ~tag:0x03 Read_word ~payload:(Word t.stub.memory.(1)) Complete ];
-  (* ABORT from execution: busy from dispatch through the first clean cycle. *)
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x04 Abort) in
-  run t 5;
-  expect_busy t ~from "ABORT" [ h + 1; h + 2 ];
-  expect_publications t ~from "ABORT" [ h + 2, response ~tag:0x04 Abort Complete ];
-  (* In every case busy is low in the handoff cycle and falls at the publication's edge,
-     where the loader's retained response takes over eligibility.
-  *)
-  check
-    t
-    ~phase:Post_run
-    "busy in any handoff cycle"
-    [%sexp_of: bool]
-    [%equal: bool]
-    ~expected:false
-    (List.exists (List.range 0 t.cycle) ~f:(fun c ->
-       let applied = Queue.get t.applied c in
-       applied.frame_end && (observed t c).busy))
-;;
-
-let%test_unit "reset or disable in the handoff cycle discards the request; a framing \
-               error is still presented in that cycle"
-  =
-  let t = create "cancel at the handoff" in
-  List.iter cancels ~f:(fun kind ->
-    let what = Sexp.to_string [%sexp (kind : cancel)] in
-    (* A valid frame: nothing is armed, so nothing is offered. *)
-    let from = t.cycle in
-    (match kind with
-     | Reset -> set t ~reset:true
-     | Disable -> set t ~enable:false);
-    let h = handoff t (Handoff.request ~tag:0x10 Run) in
-    set t ~reset:false ~enable:true;
-    run t 10;
-    expect_quiet t ~from (what ^ ", valid frame");
-    ignore h;
-    (* A framing error: presented in the handoff cycle (the loader's own cancellation
-       discards it), and nothing later.
-    *)
-    let from = t.cycle in
-    (match kind with
-     | Reset -> set t ~reset:true
-     | Disable -> set t ~enable:false);
-    let h = handoff t (Handoff.error Bad_magic ~tag:0x11 ~command:0x01) in
-    set t ~reset:false ~enable:true;
-    run t 10;
-    expect_publications
-      t
-      ~from
-      (what ^ ", framing error")
-      [ h, raw_response ~tag:0x11 ~command:0x01 Bad_magic ];
-    expect_offers t ~since:from (what ^ ", framing error") [];
-    expect_busy t ~from (what ^ ", framing error") [];
-    expect_fresh_info t what)
-;;
-
-let%test_unit "reset or disable in the dispatch cycle: the offer stays visible and is \
-               refused, its refusal is presented, and nothing follows"
-  =
-  let t = create "cancel in the dispatch cycle" in
-  List.iter cancels ~f:(fun kind ->
-    let what = Sexp.to_string [%sexp (kind : cancel)] in
-    List.iter
-      [ Wire.Request.Load_start { length = 2 }, 0x20
-      ; Read_word { address = 3 }, 0x21
-      ; Abort, 0x22
-      ; Stop, 0x23
-      ]
-      ~f:(fun (request, tag) ->
-        let from = t.cycle in
-        let h, at = cancel_at t (Handoff.request ~tag request) ~offset:1 kind in
-        run t 20;
-        let what = what ^ " " ^ Sexp.to_string [%sexp (request : Wire.Request.t)] in
-        check
-          t
-          ~phase:Post_run
-          (what ^ ": one offer, in the cancelled dispatch cycle, refused")
-          [%sexp_of: (int * bool) list]
-          [%equal: (int * bool) list]
-          ~expected:[ h + 1, false ]
-          (offers ~since:from t
-           |> List.map ~f:(fun (o : Core_stub.Offer.t) -> o.cycle, o.accepted));
-        check
-          t
-          ~phase:Post_run
-          (what ^ ": cancel cycle")
-          [%sexp_of: int]
-          [%equal: int]
-          ~expected:(h + 1)
-          at;
-        (* Halted and idle, with no verified image: the refusal class is 0x23. *)
-        expect_publications
-          t
-          ~from
-          what
-          [ h + 1, response ~tag (Wire.Request.command request) Image_bounds ];
-        expect_busy t ~from what [ h + 1 ]);
-    (* STATUS dispatched while disabled reports the enabled flag clear. *)
-    let from = t.cycle in
-    let h, _ = cancel_at t (Handoff.request ~tag:0x24 Status) ~offset:1 kind in
-    run t 5;
-    let flags : Wire.Status.Flag.t list =
-      match kind with
-      | Reset -> [ Enabled; Halted; Engines_idle ]
-      | Disable -> [ Halted; Engines_idle ]
-    in
-    expect_publications
-      t
-      ~from
-      (what ^ " STATUS")
-      [ ( h + 1
-        , response
-            ~tag:0x24
-            Status
-            ~payload:
-              (Status
-                 { flags
-                 ; image_length = 0
-                 ; words_written = 0
-                 ; words_verified = 0
-                 ; pc = 0
-                 ; fault_kind = No_fault
-                 ; phase = Halted
-                 })
-            Complete )
-      ];
-    expect_fresh_info t what)
-;;
-
-let%test_unit "reset or disable at each READ wait boundary ends the wait with no later \
-               publication"
-  =
-  let t = create "cancel a READ wait" in
-  List.iter cancels ~f:(fun kind ->
-    let what = Sexp.to_string [%sexp (kind : cancel)] in
-    (* The first wait cycle: the core's response is cancelled with it (item 8). *)
-    let from = t.cycle in
-    let h, _ =
-      cancel_at t (Handoff.request ~tag:0x30 (Read_word { address = 6 })) ~offset:2 kind
-    in
-    run t 20;
-    expect_publications t ~from (what ^ ", first wait cycle") [];
-    expect_busy t ~from (what ^ ", first wait cycle") [ h + 1; h + 2 ];
-    (* The response cycle: the completion is presented in that cycle, as the loader's own
-       cancellation discards it, and the wait is over.
-    *)
-    let from = t.cycle in
-    let h, _ =
-      cancel_at t (Handoff.request ~tag:0x31 (Read_word { address = 7 })) ~offset:3 kind
-    in
-    run t 20;
-    expect_publications
-      t
-      ~from
-      (what ^ ", response cycle")
-      [ h + 3, response ~tag:0x31 Read_word ~payload:(Word t.stub.memory.(7)) Complete ];
-    expect_busy t ~from (what ^ ", response cycle") [ h + 1; h + 2; h + 3 ];
-    expect_fresh_info t what)
-;;
-
-let%test_unit "reset or disable in the ABORT cleanup cycle presents the completion and \
-               nothing more"
-  =
-  let t = create "cancel in the cleanup cycle" in
-  List.iter cancels ~f:(fun kind ->
-    let what = Sexp.to_string [%sexp (kind : cancel)] in
-    set_status t Status.running;
-    let from = t.cycle in
-    let h, _ = cancel_at t (Handoff.request ~tag:0x40 Abort) ~offset:2 kind in
-    run t 20;
-    expect_publications t ~from what [ h + 2, response ~tag:0x40 Abort Complete ];
-    expect_busy t ~from what [ h + 1; h + 2 ];
-    expect_fresh_info t what)
-;;
-
-let%test_unit "robustness: a READ completion coinciding with a framing-error handoff \
-               publishes the completion"
-  =
-  let t = create "robustness: completion versus handoff" in
-  let read = Handoff.request ~tag:0x50 (Read_word { address = 8 }) in
-  let from = t.cycle in
-  let h = handoff t read in
-  run t 1;
-  (* The response cycle h + 3 also carries a failed handoff with the same fields. *)
-  run t 1;
-  ignore (handoff t { read with result = Wire.Result_code.to_int Bad_crc } : int);
-  run t 10;
-  expect_publications
-    t
-    ~from
-    "completion and handoff"
-    [ h + 3, response ~tag:0x50 Read_word ~payload:(Word t.stub.memory.(8)) Complete ];
-  expect_busy t ~from "completion and handoff" [ h + 1; h + 2; h + 3 ]
-;;
-
-let%test_unit "robustness: a handoff in the dispatch cycle neither re-arms dispatch nor \
-               replaces the immediate response"
-  =
-  let t = create "robustness: handoff during dispatch" in
-  (* A valid handoff: dispatch clears at that edge, so there is still one offer. *)
-  let run_request = Handoff.request ~tag:0x60 Run in
-  let from = t.cycle in
-  let h = handoff t run_request in
-  ignore (handoff t run_request : int);
-  run t 10;
-  expect_offers
-    t
-    ~since:from
-    "valid"
-    [ { cycle = h + 1; request = Run; accepted = true } ];
-  expect_publications t ~from "valid" [ h + 1, response ~tag:0x60 Run Complete ];
-  expect_busy t ~from "valid" [ h + 1 ];
-  (* A failed handoff: the dispatch response is published, not the error. *)
-  let from = t.cycle in
-  let h = handoff t run_request in
-  ignore
-    (handoff t { run_request with result = Wire.Result_code.to_int Bad_version } : int);
-  run t 10;
-  expect_publications t ~from "failed" [ h + 1, response ~tag:0x60 Run Complete ];
-  expect_busy t ~from "failed" [ h + 1 ]
-;;
diff --git a/test/host_link/command_dispatch/command_dispatch_response_tests.ml b/test/host_link/command_dispatch/command_dispatch_response_tests.ml
deleted file mode 100644
index 4b9d14f..0000000
--- a/test/host_link/command_dispatch/command_dispatch_response_tests.ml
+++ /dev/null
@@ -1,454 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "command_dispatch_response_tests.ml" *)
-(* HL4c: [Command_dispatch]'s immediate responses, INFO and STATUS contents and sampling,
-   refusal classification, framing-error responses, and correlation.
-
-   Refusal classes are written from the P3.5 result table: executing (not halted) is 0x20,
-   an active engine 0x21, RUN without a verified image 0x22, and anything else 0x23. The
-   stub's [accept] decides refusals; the status it reports is what the dispatcher
-   classifies.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Command_dispatch_testbench
-
-(* The P3.5 INFO descriptor, written from the record's table. *)
-let info_payload : Wire.Response.Payload.t =
-  Info
-    { wire_major = 1
-    ; wire_minor = 0
-    ; isa_version = 1
-    ; memory_layout = 1
-    ; capabilities =
-        [ Status; Program_load; Program_read; Program_verify; Run; Stop; Abort ]
-    ; memory_word_bits = 16
-    ; memory_depth = 256
-    ; max_request_payload_bytes = 4
-    ; protocol_pin_count = 8
-    }
-;;
-
-let%test_unit "INFO reports the fixed descriptor whatever the status" =
-  let t = create "INFO" in
-  List.iter
-    [ 0x00, Status.halted_idle
-    ; 0x80, Status.running
-    ; 0xff, Status.cleaned Status.running
-    ]
-    ~f:(fun (tag, status) ->
-      set_status t status;
-      let from = t.cycle in
-      let h = handoff t (Handoff.request ~tag Info) in
-      run t 5;
-      expect_publications
-        t
-        ~from
-        "INFO"
-        [ h + 1, response ~tag Info ~payload:info_payload Complete ]);
-  (* The raw frame for tag 0x5c, with its CRC computed independently of both the hardware
-     and [Wire]: CRC-8 (polynomial 0x07, initial 0) of the 20 bytes before it.
-  *)
-  let from = t.cycle in
-  let h = handoff t (Handoff.request ~tag:0x5c Info) in
-  run t 2;
-  let body =
-    [ 0x5a
-    ; 0x10
-    ; 0x5c
-    ; 0x00
-    ; 0x00
-    ; 0x0d
-    ; 0x00
-    ; 0x01
-    ; 0x00
-    ; 0x01
-    ; 0x01
-    ; 0x7f
-    ; 0x00
-    ; 0x10
-    ; 0x00
-    ; 0x00
-    ; 0x01
-    ; 0x04
-    ; 0x00
-    ; 0x08
-    ]
-  in
-  let crc =
-    List.fold body ~init:0 ~f:(fun crc byte ->
-      List.fold (List.range 0 8) ~init:(crc lxor byte) ~f:(fun crc _ ->
-        if crc land 0x80 <> 0
-        then (crc lsl 1) lxor 0x07 land 0xff
-        else (crc lsl 1) land 0xff))
-  in
-  expect_published_bytes
-    t
-    ~cycle:(h + 1)
-    "INFO raw bytes"
-    (hex (String.of_char_list (List.map (body @ [ crc ]) ~f:Char.of_int_exn)))
