-
-let%test_unit "P2.4 full simultaneous pop/push preserves byte order" =
-  let sim =
-    Sim.create (Byte_fifo.create ~depth:4 (Scope.create ~flatten_design:true ()))
-  in
-  let i = Cyclesim.inputs sim in
-  let o = Cyclesim.outputs sim in
-  i.reset_i := Bits.vdd;
-  i.enable_i := Bits.vdd;
