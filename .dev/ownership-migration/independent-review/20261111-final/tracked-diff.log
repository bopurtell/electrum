diff --git a/test/core/control_execution/instruction_decoder_tests.ml b/test/core/control_execution/instruction_decoder_tests.ml
deleted file mode 100644
index aeddee7..0000000
--- a/test/core/control_execution/instruction_decoder_tests.ml
+++ /dev/null
@@ -1,90 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "instruction_decoder_tests.ml" *)
-(* Exhaustive agreement checks between the shared procedural decoder and its Hardcaml
-   reader. Extension values are swept at every semantic boundary used by the ISA. *)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-open! Protemu_isa
-module Sim = Cyclesim.With_interface (Instruction_decoder.I) (Instruction_decoder.O)
-
-let bool signal = Bits.to_bool !signal
-let int signal = Bits.to_int_trunc !signal
-
-let settle sim ~word ~extension_valid ~extension =
-  let i : _ Instruction_decoder.I.t = Cyclesim.inputs sim in
-  i.word_i := Bits.of_int_trunc ~width:Encoding.instruction_bits word;
-  i.extension_valid_i := Bits.of_bool extension_valid;
-  i.extension_i := Bits.of_int_trunc ~width:Encoding.instruction_bits extension;
-  Cyclesim.cycle_check sim;
-  Cyclesim.cycle_before_clock_edge sim;
-  Cyclesim.outputs ~clock_edge:Before sim
-;;
-
-let fail ~word ~extension what expected actual =
-  raise_s
-    [%message
-      "instruction decoder mismatch"
-        (word : int)
-        (extension : int option)
-        (what : string)
-        (expected : bool)
-        (actual : bool)]
-;;
-
-let%test_unit "all base words agree with Encoding.decode" =
-  let sim =
-    Sim.create (Instruction_decoder.create (Scope.create ~flatten_design:true ()))
-  in
-  for word = 0 to 0xffff do
-    let o = settle sim ~word ~extension_valid:false ~extension:0 in
-    match Encoding.decode word with
-    | Encoding.Decoded.Invalid _ ->
-      if bool o.base_valid_o then fail ~word ~extension:None "base_valid" false true
-    | Complete _ ->
-      if not (bool o.base_valid_o) then fail ~word ~extension:None "base_valid" true false;
-      if bool o.needs_extension_o
-      then fail ~word ~extension:None "needs_extension" false true;
-      if not (bool o.valid_o) then fail ~word ~extension:None "valid" true false
-    | Needs_extension _ ->
-      if not (bool o.base_valid_o) then fail ~word ~extension:None "base_valid" true false;
-      if not (bool o.needs_extension_o)
-      then fail ~word ~extension:None "needs_extension" true false;
-      if bool o.valid_o then fail ~word ~extension:None "valid" false true
-  done
-;;
-
-let extension_boundaries =
-  [ 0; 1; 15; 16; 31; 32; 63; 64; 127; 128; 255; 256; 1023; 1024; 0xffff ]
-;;
-
-let%test_unit "extension resolution agrees at semantic boundaries" =
-  let sim =
-    Sim.create (Instruction_decoder.create (Scope.create ~flatten_design:true ()))
-  in
-  for word = 0 to 0xffff do
-    match Encoding.decode word with
-    | Encoding.Decoded.Needs_extension build ->
-      List.iter extension_boundaries ~f:(fun extension ->
-        let expected =
-          match build extension with
-          | Encoding.Decoded.Complete _ -> true
-          | Invalid _ | Needs_extension _ -> false
-        in
-        let o = settle sim ~word ~extension_valid:true ~extension in
-        let actual = bool o.valid_o in
-        if Bool.(expected <> actual)
-        then fail ~word ~extension:(Some extension) "extension valid" expected actual;
-        if actual && int o.immediate_o <> extension
-        then
-          raise_s
-            [%message
-              "extension value mismatch"
-                (word : int)
-                (extension : int)
-                ~actual:(int o.immediate_o : int)])
-    | Complete _ | Invalid _ -> ()
-  done
-;;
diff --git a/test/core/control_port/agent.ml b/test/core/control_port/agent.ml
deleted file mode 100644
index 7f52049..0000000
--- a/test/core/control_port/agent.ml
+++ /dev/null
@@ -1,37 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "agent.ml" *)
-(* The Control_port agent: its [Config], a [Responder] in responder mode, and the passive
-   [Monitor].
-
-   The agent owns no time and no sequencer. The environment's scheduler calls the
-   responder in its cycle phases and [sample] once per cycle; a test sets the responder's
-   policy fields directly. The monitor is independent of the responder even in one agent:
-   nothing here passes responder state to it. See docs/serial_host_pilot.md.
-*)
-
-open! Core
-
-type t =
-  { config : Config.t
-  ; responder : Responder.t option (* [None] exactly when passive *)
-  ; monitor : Monitor.t
-  }
-
-let create (config : Config.t) =
-  let responder =
-    match config.mode with
-    | Responder -> Some (Responder.create ~injection:config.injection)
-    | Passive -> None
-  in
-  { config; responder; monitor = Monitor.create () }
-;;
-
-let responder_exn t =
-  match t.responder with
-  | Some responder -> responder
-  | None -> raise_s [%message "a passive Control_port agent has no responder"]
-;;
-
-let sample t ~cycle sample = Monitor.sample t.monitor ~cycle sample
-let observed t = Monitor.observed t.monitor
diff --git a/test/core/control_port/config.ml b/test/core/control_port/config.ml
deleted file mode 100644
index 9f038b4..0000000
--- a/test/core/control_port/config.ml
+++ /dev/null
@@ -1,50 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "config.ml" *)
-(* Configuration for the Control_port agent: whether it answers the port as the core, and
-   how its responder treats an injected READBACK response pulse.
-
-   The temporal contract, including the READBACK latency, belongs to control_port.ml and
-   is implemented in [Responder]; nothing here changes it. See docs/serial_host_pilot.md.
-*)
-
-open! Core
-
-(* A [Responder] agent answers a producer's offers as the core does and monitors the port;
-   a [Passive] one only monitors. A [Master] mode, which would drive requests into the
-   real [Emulator_core], is reserved for a later step and not implemented.
-*)
-module Mode = struct
-  type t =
-    | Responder
-    | Passive
-  [@@deriving sexp_of]
-end
-
-(* How [Responder.inject_readback_response], a robustness probe, interacts with accepted
-   READBACKs. Both are labelled choices that existing suites rely on.
-
-   - [Outstanding]: the injected pulse replaces the responder's pending READBACK response.
-     It makes a READBACK outstanding until its cycle passes, so a READBACK offered
-     meanwhile is refused; reset, disable, or an accepted ABORT or LOAD_START cancels it.
-     The HL4a loader suite uses this.
-   - [Independent]: injected pulses are kept apart from the pending response. They never
-     make a READBACK outstanding, reset and disable do not cancel them, and an accepted
-     READBACK's response wins a cycle in which both are due. The dispatch suite uses this.
-*)
-module Injection = struct
-  type t =
-    | Outstanding
-    | Independent
-  [@@deriving sexp_of]
-end
-
-(* [injection] is the responder's policy; a passive agent ignores it. *)
-type t =
-  { mode : Mode.t
-  ; injection : Injection.t
-  }
-[@@deriving sexp_of]
-
-let responder ~injection = { mode = Responder; injection }
-let passive = { mode = Passive; injection = Independent }
diff --git a/test/core/control_port/dune b/test/core/control_port/dune
deleted file mode 100644
index 2dc2a65..0000000
--- a/test/core/control_port/dune
+++ /dev/null
@@ -1,18 +0,0 @@
-; Control_port agent library for Emulator_core's control port (serial_host_pilot.md, SP3).
-;
-; Items, configuration, responder, passive monitor and agent for the core side of the
-; Control_port contract in lib/emulator_core/control_port.ml. There are no inline_tests,
-; so loader, dispatcher, endpoint and system suites can depend on it without linking
-; another suite's tests; the suites that use it exercise it. Everything works on int port
-; records; each suite converts its simulator ports at its adapter.
-
-(library
- (name protemu_control_port_agent)
- (modules item config responder monitor agent)
- (libraries core hardcaml_protemu)
- (preprocess
-  (pps ppx_jane))
- (lint
-  (pps ppx_js_style))
- (flags
-  (:standard -w -27-57-33-34-35-40-63-47-26)))
diff --git a/test/core/control_port/item.ml b/test/core/control_port/item.ml
deleted file mode 100644
index 7fd8864..0000000
--- a/test/core/control_port/item.ml
+++ /dev/null
@@ -1,171 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "item.ml" *)
-(* Items for the Control_port agent: the transactions that cross [Emulator_core]'s control
-   port, decoded from its [int] request, decision, and status records.
-
-   [Control_port] in lib/emulator_core/control_port.ml owns the records and the temporal
-   contract; items refer to them and never redefine them. Nothing here touches a
-   simulator: each suite converts its ports to [int] records at its adapter. [Responder]
-   answers [Request] offers; [Monitor] rebuilds [Observed] items from the port records.
-   See docs/serial_host_pilot.md.
-*)
-
-open! Core
-open! Hardcaml_protemu
-
-(* A decoded [Control_port.Request] offer. READ carries no expected word: that operand is
-   meaningful only with [readback_verify].
-*)
-module Request = struct
-  type t =
-    | Load_start of { length : int }
-    | Load_write of
-        { address : int
-        ; data : int
-        }
-    | Load_complete
-    | Read of { address : int }
-    | Verify of
-        { address : int
-        ; expected : int
-        }
-    | Run
-    | Stop
-    | Abort
-  [@@deriving sexp_of, compare, equal]
-
-  (* Every request whose valid is high, in [Control_port.Request]'s field order. *)
-  let of_port (r : int Control_port.Request.t) =
-    let valid value = value <> 0 in
-    List.filter_opt
-      [ Option.some_if (valid r.load_start_valid) (Load_start { length = r.load_length })
-      ; Option.some_if
-          (valid r.load_write_valid)
-          (Load_write { address = r.load_address; data = r.load_data })
-      ; Option.some_if (valid r.load_complete_valid) Load_complete
-      ; Option.some_if
-          (valid r.readback_valid)
-          (if valid r.readback_verify
-           then Verify { address = r.readback_address; expected = r.readback_expected }
-           else Read { address = r.readback_address })
-      ; Option.some_if (valid r.run_valid) Run
-      ; Option.some_if (valid r.stop_valid) Stop
-      ; Option.some_if (valid r.abort_valid) Abort
-      ]
-  ;;
-end
-
-(* When a responder completes an accepted READBACK or ABORT. [Delayed] and [Never] are
-   robustness probes of a producer's waits, not behavior of the current [Emulator_core];
-   tests using them say so.
-*)
-module Completion = struct
-  type t =
-    | Contract
-    | Delayed of int (* extra cycles beyond the contract; robustness only *)
-    | Never (* robustness only *)
-  [@@deriving sexp_of]
-end
-
-(* One offer and its decision, in the cycle it was decided. *)
-module Offer = struct
-  type t =
-    { cycle : int
-    ; request : Request.t
-    ; accepted : bool
-    }
-  [@@deriving sexp_of, compare, equal]
-end
-
-(* One READBACK response pulse, in the cycle its valid is high. *)
-module Response = struct
-  type t =
-    { cycle : int
-    ; data : int
-    ; matches : bool
-    }
-  [@@deriving sexp_of, compare, equal]
-end
-
-(* Core status as plain integers, one per [Control_port.Status] field. *)
-module Status = struct
-  type t = int Control_port.Status.t
-
-  let sexp_of_t (t : t) = Control_port.Status.sexp_of_t Int.sexp_of_t t
-  let equal = Control_port.Status.equal Int.equal
-
-  let halted_idle : t =
-    { halted = 1
-    ; engines_idle = 1
-    ; image_valid = 0
-    ; load_active = 0
-    ; image_length = 0
-    ; words_written = 0
-    ; words_verified = 0
-    ; verification_failed = 0
-    ; fetch_fault = 0
-    ; execution_active = 0
-    ; normal_halt = 0
-    ; execution_fault = 0
-    ; fault_kind = 0
-    ; pc = 0
-    ; phase = 0
-    ; pin_oe = 0
-    ; software_claim = 0
-    ; engine_claim = 0
-    }
-  ;;
-
-  (* Executing with one engine driving and claiming pin 1. *)
-  let running : t =
-    { halted_idle with
-      halted = 0
-    ; engines_idle = 0
-    ; image_valid = 1
-    ; execution_active = 1
-    ; phase = 5
-    ; pin_oe = 0x02
-    ; engine_claim = 0x02
-    }
-  ;;
-
-  (* Contract item 6: halted, engines idle, and no output enable or claim. The responder
-     also clears [execution_active] and reports the halted phase.
-  *)
-  let cleaned (t : t) : t =
-    { t with
-      halted = 1
-    ; engines_idle = 1
-    ; execution_active = 0
-    ; phase = 0
-    ; pin_oe = 0
-    ; software_claim = 0
-    ; engine_claim = 0
-    }
-  ;;
-
-  (* Nonzero fields only, by port name, for a transcript. *)
-  let summary (t : t) =
-    Control_port.Status.(map2 port_names t ~f:(fun name value -> name, value) |> to_list)
-    |> List.filter ~f:(fun (_, value) -> value <> 0)
-  ;;
-end
-
-(* What the passive monitor saw cross the port, in cycle order. *)
-module Observed = struct
-  type t =
-    | Offer of Offer.t
-    | Response of Response.t
-  [@@deriving sexp_of, compare, equal]
-
-  let offer = function
-    | Offer offer -> Some offer
-    | Response _ -> None
-  ;;
-
-  let response = function
-    | Response response -> Some response
-    | Offer _ -> None
-  ;;
-end
diff --git a/test/core/control_port/monitor.ml b/test/core/control_port/monitor.ml
deleted file mode 100644
index a1d2bb3..0000000
--- a/test/core/control_port/monitor.ml
+++ /dev/null
@@ -1,72 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "monitor.ml" *)
-(* The Control_port agent's passive monitor: it records what crossed the port as
-   [Item.Observed] items.
-
-   The environment's scheduler calls [sample] once per cycle, pre-edge, after the cycle's
-   decision has been applied and settled, with that cycle's request, decision, and status
-   records as [int]s read from the ports. The monitor never advances time and never reads
-   responder state; it knows only the port records and the contract's field pairing.
-
-   Per cycle it emits, in this order:
-
-   1. an [Offer] for each request whose valid is high, in [Control_port.Request]'s field
-      order, accepted when that request's [*_accepted] decision field is high (item 3);
-   2. a [Response] when [readback_response_valid] is high, with the data and match fields
-      of that cycle (item 5).
-
-   Status is part of the sample so that a checker can be given one consistent view of the
-   cycle; no item is emitted for it today. Items go to [observed], the analysis-port
-   analogue, which a checker reads or drains.
-*)
-
-open! Core
-open! Hardcaml_protemu
-module Observed = Item.Observed
-
-(* One cycle's port records, pre-edge. *)
-module Sample = struct
-  type t =
-    { request : int Control_port.Request.t
-    ; decision : int Control_port.Decision.t
-    ; status : int Control_port.Status.t
-    }
-end
-
-type t = { observed : Observed.t Queue.t }
-
-let create () = { observed = Queue.create () }
-
-(* The decision field that accepts [request]. *)
-let accepted (decision : int Control_port.Decision.t) (request : Item.Request.t) =
-  let field =
-    match request with
-    | Load_start _ -> decision.load_start_accepted
-    | Load_write _ -> decision.load_write_accepted
-    | Load_complete -> decision.load_complete_accepted
-    | Read _ | Verify _ -> decision.readback_accepted
-    | Run -> decision.run_accepted
-    | Stop -> decision.stop_accepted
-    | Abort -> decision.abort_accepted
-  in
-  field <> 0
-;;
-
-let sample t ~cycle ({ request; decision; status = _ } : Sample.t) =
-  List.iter (Item.Request.of_port request) ~f:(fun request ->
-    Queue.enqueue
-      t.observed
-      (Offer { cycle; request; accepted = accepted decision request }));
-  if decision.readback_response_valid <> 0
-  then
-    Queue.enqueue
-      t.observed
-      (Response
-         { cycle
-         ; data = decision.readback_response_data
-         ; matches = decision.readback_response_match <> 0
-         })
-;;
-
-let observed t = t.observed
diff --git a/test/core/control_port/responder.ml b/test/core/control_port/responder.ml
deleted file mode 100644
index f59233b..0000000
--- a/test/core/control_port/responder.ml
+++ /dev/null
@@ -1,224 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "responder.ml" *)
-(* The Control_port responder: a test-only stand-in for [Emulator_core] behind the port,
-   answering a producer's offers. It is a reactive (slave) driver, not a RAM or execution
-   model: acceptance comes from [accept], READBACK data from [memory], and status from
-   [status], all set by the test. It never inspects the producer's refusal or dispatch
-   logic, and it records nothing; [Monitor] observes what crossed the port.
-
-   The scheduler calls it inside its cycle phases and it never advances time. In cycle n:
-
-   1. [decision ~offer:None] before the first settle, which drives the registered READBACK
-      response visible in n with every offer decision low;
-   2. [decide] on the one request offered in n, if any, after that settle;
-   3. [decision ~offer] with that request and its acceptance, before the second settle;
-   4. [edge] after edge n, for the accepted side effects, completions, and cancellation.
-
-   Contract-faithful behavior, from control_port.ml:
-
-   - decisions are combinational in the offer cycle; with no offer both are low, and a
-     refusal is [valid & ~accepted] (item 3);
-   - reset or disable refuses every offer and cancels a pending READBACK response and
-     ABORT cleanup (item 8);
-   - an accepted READBACK has its response valid only in the cycle [readback_latency]
-     after the offer (item 5); a second READBACK is refused while it is outstanding; an
-     accepted ABORT or LOAD_START cancels it;
-   - an accepted ABORT makes [Status.cleaned] visible from the cycle after its edge (item
-     6);
-   - [readback_response_match] compares the word with the expected operand for VERIFY and
-     is low for READ, where it is meaningless.
-
-   Robustness probes, each labelled where a test uses it: [Completion.Delayed] and
-   [Never]; [inject_readback_response], an unsolicited pulse whose interaction with
-   READBACK is the [Config.Injection] policy; [read_match], which drives the meaningless
-   READ match high; [rejected], which drives every rejected signal to a fixed level
-   whatever the offer; and an [accept] that refuses STOP or ABORT, which the real core
-   accepts whenever enabled and out of reset.
-*)
-
-open! Core
-open! Hardcaml_protemu
-module Completion = Item.Completion
-module Request = Item.Request
-module Response = Item.Response
-module Status = Item.Status
-
-(* Contract item 5: an offer accepted at edge E has its response valid in the cycle
-   between E+1 and E+2, two cycles after the offer cycle.
-*)
-let readback_latency = 2
-
-(* Contract item 6: cleanup completes at the accepting edge, so it is visible from the
-   cycle after the offer.
-*)
-let abort_cleanup_latency = 0
-
-(* Program memory as the responder reports it: one word per address, initially a fixed
-   pattern so that distinct addresses read distinct words.
-*)
-let default_memory () =
-  Array.init Program_memory_controller.Config.program_depth ~f:(fun address ->
-    address * 0x0101 lxor 0xa55a)
-;;
-
-(* The policy fields, set by tests, come first; the rest is the responder's own state.
-   [pending_response] is the response of the last accepted READBACK or an [Outstanding]
-   injection, and makes a READBACK outstanding; [injected] holds [Independent] injections,
-   which never do.
-*)
-type t =
-  { mutable status : Status.t
-  ; mutable accept : Request.t -> bool
-  ; memory : int array
-  ; mutable readback_completion : Completion.t
-  ; mutable abort_completion : Completion.t
-  ; mutable read_match : bool (* robustness only *)
-  ; mutable rejected : bool option (* robustness only *)
-  ; injection : Config.Injection.t
-  ; mutable pending_response : Response.t option
-  ; mutable injected : Response.t list
-  ; mutable pending_cleanup : int option (* edge after which cleanup is visible *)
-  }
-
-let create ~injection =
-  { status = Status.halted_idle
-  ; accept = (fun _ -> true)
-  ; memory = default_memory ()
-  ; readback_completion = Contract
-  ; abort_completion = Contract
-  ; read_match = false
-  ; rejected = None
-  ; injection
-  ; pending_response = None
-  ; injected = []
-  ; pending_cleanup = None
-  }
-;;
-
-(* The registered response visible in [cycle], if any: an accepted READBACK's, else an
-   injected one.
-*)
-let response t ~cycle =
-  let at (response : Response.t) = response.cycle = cycle in
-  match Option.filter t.pending_response ~f:at with
-  | Some response -> Some response
-  | None -> List.find t.injected ~f:at
-;;
-
-(* Robustness only: a response pulse in [cycle] that no accepted READBACK requested.
-   Whether it counts as outstanding is [t.injection]; see [Config.Injection].
-*)
-let inject_readback_response t ~cycle ~data ~matches =
-  let response = { Response.cycle; data; matches } in
-  match t.injection with
-  | Outstanding -> t.pending_response <- Some response
-  | Independent -> t.injected <- response :: t.injected
-;;
-
-(* Acceptance of [request], offered in the current cycle under [reset] and [enable]. *)
-let decide t ~reset ~enable request =
-  let outstanding =
-    match request, t.pending_response with
-    | (Request.Read _ | Verify _), Some _ -> true
-    | _ -> false
-  in
-  enable && (not reset) && (not outstanding) && t.accept request
-;;
-
-(* The decision record for [cycle]: the registered response visible then, and the decision
-   on [offer], a request with its acceptance, if any.
-*)
-let decision t ~cycle ~offer : int Control_port.Decision.t =
-  let d = Control_port.Decision.map Control_port.Decision.port_widths ~f:(fun _ -> 0) in
-  let d =
-    match response t ~cycle with
-    | None -> d
-    | Some response ->
-      { d with
-        readback_response_valid = 1
-      ; readback_response_data = response.data
-      ; readback_response_match = Bool.to_int response.matches
-      }
-  in
-  let d =
-    match offer with
-    | None -> d
-    | Some (request, accepted) ->
-      let a = Bool.to_int accepted in
-      let r = Bool.to_int (not accepted) in
-      (match (request : Request.t) with
-       | Load_start _ -> { d with load_start_accepted = a; load_start_rejected = r }
-       | Load_write _ -> { d with load_write_accepted = a; load_write_rejected = r }
-       | Load_complete ->
-         { d with load_complete_accepted = a; load_complete_rejected = r }
-       | Read _ | Verify _ -> { d with readback_accepted = a; readback_rejected = r }
-       | Run -> { d with run_accepted = a; run_rejected = r }
-       | Stop -> { d with stop_accepted = a; stop_rejected = r }
-       | Abort -> { d with abort_accepted = a; abort_rejected = r })
-  in
-  match t.rejected with
-  | None -> d
-  | Some level ->
-    let r = Bool.to_int level in
-    { d with
-      load_start_rejected = r
-    ; load_write_rejected = r
-    ; load_complete_rejected = r
-    ; readback_rejected = r
-    ; run_rejected = r
-    ; stop_rejected = r
-    ; abort_rejected = r
-    }
-;;
-
-let schedule completion ~contract =
-  match (completion : Completion.t) with
-  | Contract -> Some contract
-  | Delayed extra -> Some (contract + extra)
-  | Never -> None
-;;
-
-(* Post-edge work for the edge that ends [cycle]:
-
-   1. a response whose cycle has come expires, delivered or not;
-   2. reset or disable cancels the pending response and cleanup;
-   3. an accepted READBACK schedules its response, an accepted ABORT cancels the pending
-      response and schedules cleanup, and an accepted LOAD_START cancels the pending
-      response;
-   4. cleanup due at this edge makes [Status.cleaned] visible from the next cycle.
-*)
-let edge t ~cycle ~reset ~enable ~offer =
-  let future (response : Response.t) = response.cycle > cycle in
-  t.pending_response <- Option.filter t.pending_response ~f:future;
-  t.injected <- List.filter t.injected ~f:future;
-  if reset || not enable
-  then (
-    t.pending_response <- None;
-    t.pending_cleanup <- None);
-  (match offer with
-   | Some (((Request.Read { address } | Verify { address; _ }) as request), true) ->
-     let data = t.memory.(address) in
-     let matches =
-       match request with
-       | Verify { expected; _ } -> expected = data
-       | _ -> t.read_match
-     in
-     t.pending_response
-     <- Option.map
-          (schedule t.readback_completion ~contract:readback_latency)
-          ~f:(fun latency -> { Response.cycle = cycle + latency; data; matches })
-   | Some (Abort, true) ->
-     t.pending_response <- None;
-     t.pending_cleanup
-     <- Option.map
-          (schedule t.abort_completion ~contract:abort_cleanup_latency)
-          ~f:(fun latency -> cycle + latency)
-   | Some (Load_start _, true) -> t.pending_response <- None
-   | _ -> ());
-  match t.pending_cleanup with
-  | Some at when at = cycle ->
-    t.status <- Status.cleaned t.status;
-    t.pending_cleanup <- None
-  | _ -> ()
-;;
diff --git a/test/core/protocol_core/dune b/test/core/protocol_core/dune
index a1965f1..b5b6774 100644
--- a/test/core/protocol_core/dune
+++ b/test/core/protocol_core/dune
