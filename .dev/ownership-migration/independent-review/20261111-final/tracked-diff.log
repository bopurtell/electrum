-(* One accepted command: its request, response, and when LRDY rises after the offer. *)
-type accepted_case =
-  { what : string
-  ; wire : Wire.Request.t
-  ; request : Request.t
-  ; expected : Wire.Response.t
-  ; ready_after_offer : int
-  ; prepare : t -> unit
