-      , { kind = Execution_unit.Mechanism_kind.read_status
-        ; arg0 = 2
-        ; arg1 = 0
-        ; arg2 = 0
-        ; timeout = false
-        ; result = 0x21
-        ; result_register = Some (2, 0x21)
