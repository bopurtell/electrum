-        ; arg1 = 0
-        ; arg2 = 0
-        ; timeout = false
-        ; result = 0
-        ; result_register = None
-        } )
-    ; ( "wait_cycles_reg"
-      , [ Ldi { rd = 0; value = 7 }; Wait_cycles_reg { rd = 0 } ]
-      , { kind = Execution_unit.Mechanism_kind.wait_cycles_reg
-        ; arg0 = 7
-        ; arg1 = 0
-        ; arg2 = 0
-        ; timeout = false
-        ; result = 0
-        ; result_register = None
-        } )
-    ; ( "wait_level"
-      , [ Wait_level { pin = 3; level = true; timeout = Some 32 } ]
-      , { kind = Execution_unit.Mechanism_kind.wait_level
-        ; arg0 = 3
-        ; arg1 = 1
-        ; arg2 = 32
-        ; timeout = true
-        ; result = 0
-        ; result_register = None
-        } )
