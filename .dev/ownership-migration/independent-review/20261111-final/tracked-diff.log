-    | 1 when bool o.mechanism_request_valid_o ->
-      phase := 2;
-      { quiet_mechanism with accepted = true }
-    | 2 ->
-      [%test_result: bool] (bool o.mechanism_request_valid_o) ~expect:false;
-      phase := 3;
