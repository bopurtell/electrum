--- a/test/host_link/archived/hl4a/hardware_loader_cancellation_tests.ml
+++ /dev/null
@@ -1,476 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "hardware_loader_cancellation_tests.ml" *)
-(* HL4a: in-flight protection, correlation, and reset/disable cancellation at the composed
-   [Host_link]'s serial pins and [Control_port].
-
-   Early selections here are out-of-contract host traffic that the loader must ignore:
-   they cannot shift out, consume, or overwrite the command moving through dispatch or a
-   completion wait. Each test says whether its stub follows the [Control_port] contract or
-   is a robustness probe of the loader's waits. A robustness probe says nothing about the
-   current [Emulator_core], whose READBACK and ABORT completions are prompt.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Hardware_loader_testbench
-
-(* A legal VERIFY with a tag no scenario uses, clocked in by the early selection. If the
-   loader took it as a request, its tag, command, or offer would appear.
-*)
-let intruder_tag = 0x77
-
-let intruder =
-  encode ~tag:intruder_tag (Verify_word { address = 0x55; expected = 0x6666 })
-;;
-
-let intruder_correlation = { Wire.Correlation.tag = intruder_tag; command = 0x13 }
-
-(* The response is neither for the intruder nor decodable as its answer. *)
-let expect_not_intruder t (exchange : Exchange.t) =
-  match Wire.Response.decode_correlated ~expected:intruder_correlation exchange.bytes with
-  | Error (Correlation_mismatch _) -> ()
-  | result ->
-    fail
-      t
-      ~phase:Host_sample
-      "the response does not correlate with the early selection's frame"
-      ~expected:[%sexp "Correlation_mismatch"]
-      ~actual:[%sexp (result : (Wire.Response.t, Wire.Response.Decode_error.t) Result.t)]
-;;
-
-(* Sends [request] and deselects without the gap, holds [early] cycles, then selects and
-   clocks the intruder frame. Returns the exchange read afterwards.
-*)
-let with_early_selection ?(disturbances = [ 1 ]) t ~tag request =
-  let started = t.cycle in
-  begin_frame t;
-  send t (encode ~tag request);
-  let request_deselected = end_frame t in
-  List.iter disturbances ~f:(fun at ->
-    hold t (request_deselected + at - t.cycle);
-    ignore (disturb t intruder : int));
-  receive t ~started ~request_deselected ~expected:(Wire.Request.correlation ~tag request)
-;;
-
-let%test_unit "an early selection during dispatch cannot consume or overwrite the command"
-  =
-  (* Contract-faithful stub. Selections one to three cycles after the deselection are too
-     early for the loader's four-cycle qualification; the peer uses one to two.
-  *)
-  List.iter [ 1; 2; 3 ] ~f:(fun early ->
-    let t = create (sprintf "early selection %d cycles into dispatch" early) in
-    let exchange = with_early_selection ~disturbances:[ early ] t ~tag:0x0a Info in
-    expect_response
-      t
-      "INFO after an early selection"
-      ~expected:(response ~tag:0x0a Info ~payload:info_payload Complete)
-      exchange.response;
-    expect_not_intruder t exchange;
-    expect_no_offers t ~since:exchange.started "neither INFO nor the intruder offers";
-    let exchange =
-      with_early_selection
-        ~disturbances:[ early ]
-        t
-        ~tag:0x0b
-        (Write_word { address = 0x21; word = 0x4321 })
-    in
-    expect_response
-      t
-      "WRITE after an early selection"
-      ~expected:(response ~tag:0x0b Write_word Complete)
-      exchange.response;
-    expect_not_intruder t exchange;
-    expect_offered_once
-      t
-      exchange
-      (Load_write { address = 0x21; data = 0x4321 })
-      ~accepted:true;
-    expect_int
-      t
-      "LRDY rises one cycle after the offer despite the early selection"
-      ~expected:
-        (exchange.request_deselected
-         + Latency.offer_after_deselect
-         + Latency.ready_after_offer)
-      exchange.ready)
-;;
-
-let%test_unit "an early selection during a READ wait cannot consume or overwrite it" =
-  let read = Wire.Request.Read_word { address = 0x3a } in
-  let expected = response ~tag:0x3a Read_word ~payload:(Word 0x3a3a) Complete in
-  let run ~scenario ~completion ~disturbances =
-    let t = create scenario in
-    t.stub.readback_completion <- completion;
-    t.stub.memory.(0x3a) <- 0x3a3a;
-    let exchange = with_early_selection ~disturbances t ~tag:0x3a read in
-    expect_response t "READ after early selections" ~expected exchange.response;
-    expect_not_intruder t exchange;
-    expect_offered_once t exchange (Read { address = 0x3a }) ~accepted:true;
-    let offer = exchange.request_deselected + Latency.offer_after_deselect in
-    let extra =
-      match completion with
-      | Delayed extra -> extra
-      | _ -> 0
-    in
-    expect_int
-      t
-      "LRDY rises one cycle after the READBACK response"
-      ~expected:
-        (offer + Latency.readback_after_offer + extra + Latency.ready_after_completion)
-      exchange.ready
-  in
-  (* Contract-faithful: the response arrives during the early selection. *)
-  run
-    ~scenario:"early selection over a prompt READ"
-    ~completion:Contract
-    ~disturbances:[ 1 ];
-  (* Robustness probe: a 2000-cycle response delay, with two early selections inside it.
-     Each intruder frame takes about 710 cycles to clock in.
-  *)
-  run
-    ~scenario:"robustness: early selections inside a delayed READ"
-    ~completion:(Delayed 2000)
-    ~disturbances:[ 1; 900 ]
-;;
-
-let%test_unit "an early selection during an ABORT wait cannot consume or overwrite it" =
-  (* Contract-faithful: cleanup is visible one cycle after the accepting edge. *)
-  let t = create "early selection over a prompt ABORT" in
-  set_status t Status.running;
-  let exchange = with_early_selection t ~tag:0x76 Abort in
-  expect_response
-    t
-    "ABORT"
-    ~expected:(response ~tag:0x76 Abort Complete)
-    exchange.response;
-  expect_not_intruder t exchange;
-  expect_offered_once t exchange Abort ~accepted:true;
-  expect_int
-    t
-    "LRDY rises one cycle after cleanup is visible"
-    ~expected:
-      (exchange.request_deselected
-       + Latency.offer_after_deselect
-       + Latency.abort_clean_after_offer
-       + Latency.ready_after_completion)
-    exchange.ready;
-  (* Robustness probe: cleanup never completes by itself. The test clears the five cleanup
-     conditions one at a time, with early selections in between; LRDY waits for the last
-     one.
-  *)
-  let t = create "robustness: staged ABORT cleanup" in
-  t.stub.abort_completion <- Never;
-  set_status t { Status.running with software_claim = 0x10 };
-  let started = t.cycle in
-  begin_frame t;
-  send t (encode ~tag:0x57 Abort);
-  let request_deselected = end_frame t in
-  let stages : (string * (Status.t -> Status.t)) list =
-    [ ("halted", fun s -> { s with halted = 1; execution_active = 0; phase = 0 })
-    ; ("engines idle", fun s -> { s with engines_idle = 1 })
-    ; ("outputs released", fun s -> { s with pin_oe = 0 })
-    ; ("software claim released", fun s -> { s with software_claim = 0 })
-    ; ("engine claim released", fun s -> { s with engine_claim = 0 })
-    ]
-  in
-  List.iteri stages ~f:(fun index (what, update) ->
-    hold t 60;
-    if index = 1 then ignore (disturb t intruder : int);
-    check
-      t
-      ~phase:Pre_edge
-      ("no ABORT response before cleanup: " ^ what)
-      [%sexp_of: (int * bool) list]
-      [%equal: (int * bool) list]
-      ~expected:[]
-      (ready_changes ~since:request_deselected t);
-    set_status t (update t.stub.status));
-  let visible = t.cycle in
-  let exchange =
-    receive
-      t
-      ~started
-      ~request_deselected
-      ~expected:(Wire.Request.correlation ~tag:0x57 Abort)
-  in
-  expect_response
-    t
-    "staged ABORT"
-    ~expected:(response ~tag:0x57 Abort Complete)
-    exchange.response;
-  expect_not_intruder t exchange;
-  expect_offered_once t exchange Abort ~accepted:true;
-  expect_int
-    t
-    "LRDY rises one cycle after the last cleanup condition is visible"
-    ~expected:(visible + Latency.ready_after_completion)
-    exchange.ready
-;;
-
-let%test_unit "consecutive distinct tags and commands each correlate with their own \
-               answer"
-  =
-  (* Contract-faithful. Each answer is decoded against its own request's correlation, and
-     against the previous one, which must mismatch. A stale or overwritten answer would
-     fail one of the two.
-  *)
-  let t = create "correlation sequence" in
-  t.stub.memory.(1) <- 0x0101;
-  let requests =
-    [ 0x01, Wire.Request.Status
-    ; 0x02, Read_word { address = 1 }
-    ; 0x03, Load_start { length = 2 }
-    ; 0x04, Info
-    ; 0x05, Write_word { address = 1; word = 2 }
-    ; 0x06, Stop
-    ]
-  in
-  ignore
-    (List.fold requests ~init:None ~f:(fun previous (tag, request) ->
-       let exchange = transact t ~tag request in
-       Option.iter previous ~f:(fun correlation ->
-         match Wire.Response.decode_correlated ~expected:correlation exchange.bytes with
-         | Error (Correlation_mismatch _) -> ()
-         | result ->
-           fail
-             t
-             ~phase:Host_sample
-             "an answer does not correlate with the previous request"
-             ~actual:
-               [%sexp (result : (Wire.Response.t, Wire.Response.Decode_error.t) Result.t)]);
-       Some (Wire.Request.correlation ~tag request))
-     : Wire.Correlation.t option)
-;;
-
-(* Reset or disable for [cycles] cycles from the current one, then back. *)
-let pulse t ~reset ~cycles =
-  let at = t.cycle in
-  if reset then set_reset t true else set_enable t false;
-  hold t cycles;
-  if reset then set_reset t false else set_enable t true;
-  at
-;;
-
-let%test_unit "reset and disable cancel a partial request" =
-  (* As in the peer: one byte and three bits, cancellation with LSEL_N still low, then
-     LSEL_N high in the cycle reset or enable is restored.
-  *)
-  List.iter [ false; true ] ~f:(fun reset ->
-    let name = if reset then "reset" else "disable" in
-    let t = create (name ^ " during a partial request") in
-    let frame = encode ~tag:0xb0 (Load_start { length = 1 }) in
-    let since = t.cycle in
-    begin_frame t;
-    send t (String.prefix frame 1) ~extra_bits:3 ~extra_byte:frame.[1];
-    if reset then set_reset t true else set_enable t false;
-    hold t 4;
-    if t.ready || t.ldo || t.busy
-    then
-      fail
-        t
-        ~phase:Pre_edge
-        (name ^ " releases LRDY, LDO, and busy")
-        ~actual:
-          [%sexp { ready : bool = t.ready; ldo : bool = t.ldo; busy : bool = t.busy }];
-    if reset then set_reset t false else set_enable t true;
-    ignore (deselect t : int);
-    expect_quiet t 300 (name ^ ": the partial request is never answered or offered");
-    expect_no_offers t ~since (name ^ ": nothing was offered");
-    expect_info_works t ~tag:0xb1 (name ^ ": a fresh INFO works"))
-;;
-
-let%test_unit "reset or disable in the dispatch cycle cancels the command" =
-  (* Contract-faithful: the offer is still visible in that cycle, and the core refuses
-     every offer under reset or disable (item 8). No response follows.
-  *)
-  List.iter [ false; true ] ~f:(fun reset ->
-    let name = if reset then "reset" else "disable" in
-    let t = create (name ^ " in the dispatch cycle") in
-    let started = t.cycle in
-    begin_frame t;
-    send t (encode ~tag:0xc0 (Write_word { address = 2; word = 3 }));
-    let request_deselected = end_frame t in
-    hold t Latency.offer_after_deselect;
-    let at = pulse t ~reset ~cycles:1 in
-    expect_int
-      t
-      (name ^ " falls in the dispatch cycle")
-      ~expected:(request_deselected + Latency.offer_after_deselect)
-      at;
-    expect_quiet t 300 (name ^ ": no response and no further offer");
-    expect_offers
-      t
-      ~since:started
-      (name ^ ": the dispatch-cycle offer is refused")
-      [ { cycle = at; request = Load_write { address = 2; data = 3 }; accepted = false } ];
-    expect_info_works t ~tag:0xc1 (name ^ ": a fresh INFO works"))
-;;
-
-let%test_unit "reset or disable during a READ wait cancels its response" =
-  List.iter [ false; true ] ~f:(fun reset ->
-    let name = if reset then "reset" else "disable" in
-    (* Contract-faithful: cancellation in the cycle between the accepting edge and the
-       next cancels the READBACK response (item 5).
-    *)
-    let t = create (name ^ " during a prompt READ") in
-    let started = t.cycle in
-    begin_frame t;
-    send t (encode ~tag:0xd0 (Read_word { address = 5 }));
-    let request_deselected = end_frame t in
-    let offer = request_deselected + Latency.offer_after_deselect in
-    hold t (offer + 1 - t.cycle);
-    ignore (pulse t ~reset ~cycles:1 : int);
-    expect_quiet t 300 (name ^ ": no READ response");
-    check
-      t
-      ~phase:Post_run
-      (name ^ ": the READBACK response was cancelled")
-      [%sexp_of: Core_stub.Response.t list]
-      [%equal: Core_stub.Response.t list]
-      ~expected:[]
-      (responses ~since:started t);
-    expect_offers
-      t
-      ~since:started
-      (name ^ ": READ was offered once")
-      [ { cycle = offer; request = Read { address = 5 }; accepted = true } ];
-    t.stub.memory.(5) <- 0x0505;
-    let exchange = transact t ~tag:0xd1 (Read_word { address = 5 }) in
-    expect_response
-      t
-      (name ^ ": a fresh READ works")
-      ~expected:(response ~tag:0xd1 Read_word ~payload:(Word 0x0505) Complete)
-      exchange.response;
-    (* Robustness probe: a delayed READ is cancelled, then a stray response pulse arrives
-       after re-enabling. The loader no longer waits and must ignore it.
-    *)
-    let t =
-      create (sprintf "robustness: %s during a delayed READ, then a stray response" name)
-    in
-    t.stub.readback_completion <- Delayed 100;
-    let started = t.cycle in
-    begin_frame t;
-    send t (encode ~tag:0xd2 (Read_word { address = 6 }));
-    let request_deselected = end_frame t in
-    hold t 40;
-    ignore (pulse t ~reset ~cycles:2 : int);
-    let stray = request_deselected + 120 in
-    hold t (stray - t.cycle);
-    Core_stub.inject_readback_response t.stub ~cycle:stray ~data:0xdead ~matches:false;
-    expect_quiet t 300 (name ^ ": the stray response is ignored");
-    check
-      t
-      ~phase:Post_run
-      (name ^ ": the stray response pulse was driven")
-      [%sexp_of: int list]
-      [%equal: int list]
-      ~expected:[ stray ]
-      (List.map (responses ~since:started t) ~f:(fun r -> r.cycle));
-    expect_info_works t ~tag:0xd3 (name ^ ": a fresh INFO works"))
-;;
-
-let%test_unit "robustness: reset or disable during an ABORT wait cancels its response" =
-  (* Robustness probe: cleanup never completes by itself. After the cancellation the test
-     makes the status clean; the loader no longer waits, so no stale response appears.
-  *)
-  List.iter [ false; true ] ~f:(fun reset ->
-    let name = if reset then "reset" else "disable" in
-    let t = create (name ^ " during a stalled ABORT") in
-    t.stub.abort_completion <- Never;
-    set_status t Status.running;
-    let started = t.cycle in
-    begin_frame t;
-    send t (encode ~tag:0xe0 Abort);
-    let request_deselected = end_frame t in
-    hold t 50;
-    ignore (pulse t ~reset ~cycles:3 : int);
-    set_status t (Status.cleaned Status.running);
-    expect_quiet t 300 (name ^ ": no ABORT response after cleanup");
-    expect_offers
-      t
-      ~since:started
-      (name ^ ": ABORT was offered once")
-      [ { cycle = request_deselected + Latency.offer_after_deselect
-        ; request = Abort
-        ; accepted = true
-        }
-      ];
-    expect_info_works t ~tag:0xe1 (name ^ ": a fresh INFO works"))
-;;
-
-let%test_unit "disable discards a retained response in the same cycle" =
-  (* LRDY is gated by enable, so it falls in the disabled cycle itself; the retained
-     response is gone when enable returns.
-  *)
-  let t = create "disable with a retained response" in
-  let started = t.cycle in
-  let request_deselected = send_frame t (encode ~tag:0xf0 Status) in
-  ignore (wait_ready t ~since:request_deselected : int);
-  hold t 10;
-  let at = pulse t ~reset:false ~cycles:1 in
-  check
-    t
-    ~phase:Pre_edge
-    "LRDY falls in the disabled cycle and stays low"
-    [%sexp_of: (int * bool) list]
-    [%equal: (int * bool) list]
-    ~expected:[ at, false ]
-    (ready_changes ~since:at t);
-  expect_quiet t 300 "the discarded response does not return";
-  if t.busy then fail t ~phase:Pre_edge "busy is clear after the discard";
-  expect_no_offers t ~since:started "STATUS offers nothing";
-  expect_info_works t ~tag:0xf1 "a fresh INFO works"
-;;
-
-let%test_unit "reset discards a partially read response" =
-  (* Reset is synchronous: LRDY and LDO fall from the cycle after the first reset edge.
-     LSEL_N stays low through reset and rises in the cycle reset is released, as in the
-     peer.
-  *)
-  let t = create "reset during a response read" in
-  set_status t { Status.halted_idle with image_valid = 1; image_length = 1 };
-  let started = t.cycle in
-  let request_deselected = send_frame t (encode ~tag:0xf2 Status) in
-  ignore (wait_ready t ~since:request_deselected : int);
-  begin_frame t;
-  for _ = 1 to 20 do
-    ignore (read_bit t : bool)
-  done;
-  set_reset t true;
-  let at = t.cycle in
-  hold t 3;
-  check
-    t
-    ~phase:Pre_edge
-    "LRDY falls in the cycle after the first reset edge"
-    [%sexp_of: (int * bool) list]
-    [%equal: (int * bool) list]
-    ~expected:[ at + 1, false ]
-    (ready_changes ~since:at t);
-  set_reset t false;
-  ignore (deselect t : int);
-  expect_quiet t 300 "the discarded response does not return";
-  if t.busy then fail t ~phase:Pre_edge "busy is clear after reset";
-  expect_no_offers t ~since:started "STATUS offers nothing";
-  let exchange = transact t ~tag:0xf3 Status in
-  expect_response
-    t
-    "a fresh STATUS after reset"
-    ~expected:
-      (response
-         ~tag:0xf3
-         Status
-         ~payload:
-           (Status
-              { flags = [ Enabled; Halted; Engines_idle; Image_valid ]
-              ; image_length = 1
-              ; words_written = 0
-              ; words_verified = 0
-              ; pc = 0
-              ; fault_kind = No_fault
-              ; phase = Halted
-              })
-         Complete)
-    exchange.response
-;;
diff --git a/test/host_link/archived/hl4a/hardware_loader_diagnostics_tests.ml b/test/host_link/archived/hl4a/hardware_loader_diagnostics_tests.ml
deleted file mode 100644
index 29d1287..0000000
--- a/test/host_link/archived/hl4a/hardware_loader_diagnostics_tests.ml
+++ /dev/null
@@ -1,114 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "hardware_loader_diagnostics_tests.ml" *)
-(* HL4a: the harness's key assertions detect the failures they exist for, and report
-   enough to reproduce them.
-
-   Each case sets up a controlled mismatch between what the host did and what the check
-   expects, and requires the check to raise [Harness_failure]. None of them changes the
-   loader or leaves a failing test in the suite. The first case prints a complete report,
-   so its format is reviewed here.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Hardware_loader_testbench
-
-let require_failure t what f =
-  match failure_of f with
-  | Some failure -> failure
-  | None -> fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-let%expect_test "the retention check detects a response that the host committed" =
-  (* The host supplies the final fall, which commits the response; the retention check
-     that guards replay must then fail at the commit boundary. The transcript is limited
-     to twelve events to show how truncation is reported.
-  *)
-  let t =
-    create ~transcript_limit:12 "negative: committed response checked as retained"
-  in
-  set_status t { Status.halted_idle with image_valid = 1 };
-  let request_deselected = send_frame t (encode ~tag:0x75 Run) in
-  ignore (wait_ready t ~since:request_deselected : int);
-  let read =
-    read_response
-      t
-      ~expected:(Wire.Request.correlation ~tag:0x75 Run)
-      ~decide:(fun _ -> Commit)
-      ()
-  in
-  print_s
-    (require_failure t "retention after a commit" (fun () ->
-       expect_retained t ~deselected:read.deselected ~cycles:10));
-  [%expect
-    {|
-    (test/host_link/hardware_loader_testbench.ml.Harness_failure
-     (scenario "negative: committed response checked as retained") (cycle 990)
-     (phase Pre_edge) (what "retained response keeps LRDY high for 10 cycles")
-     (expected ((() true))) (actual ((((984 false)) false)))
-     (transcript
-      ((earlier_events_omitted 2)
-       (events
-        ((8 (Select true))
-         (8 (Sent (bytes "a5 10 75 20 00 00 57") (extra_bits 0)))
-         (8 (Status ((halted 1) (engines_idle 1) (image_valid 1))))
-         (11 (Busy true)) (460 (Select false))
-         (463 (Offer (request Run) (accepted true))) (464 (Ready true))
-         (465 (Select true))
-         (974 (Response_read (bytes "5a 10 75 20 00 00 00 e6") (outcome Commit)))
-         (981 (Select false)) (984 (Ready false)) (984 (Busy false)))))))
-    |}]
-;;
-
-let%test_unit "the offer check detects a one-cycle change in offer timing" =
-  (* HL4b must not add a pipeline stage. An expectation one cycle late stands in for a
-     loader that offers one cycle late.
-  *)
-  let t = create "negative: offer one cycle late" in
-  let exchange = transact t ~tag:0x11 (Write_word { address = 1; word = 2 }) in
-  ignore
-    (require_failure t "a late offer" (fun () ->
-       expect_offers
-         t
-         ~since:exchange.started
-         "offer one cycle later than observed"
-         [ { cycle = exchange.request_deselected + Latency.offer_after_deselect + 1
-           ; request = Load_write { address = 1; data = 2 }
-           ; accepted = true
-           }
-         ])
-     : Sexp.t)
-;;
-
-let%test_unit "the quiet check detects a response that was not cancelled" =
-  (* Without the disable, the retained STATUS response keeps LRDY high. *)
-  let t = create "negative: response not discarded" in
-  let request_deselected = send_frame t (encode ~tag:0x12 Status) in
-  ignore (wait_ready t ~since:request_deselected : int);
-  ignore
-    (require_failure t "a retained response" (fun () -> expect_quiet t 10 "no response")
-     : Sexp.t)
-;;
-
-let%test_unit "waits are bounded and time out with a report" =
-  (* Robustness stub: the READBACK response never arrives. *)
-  let t = create "negative: bounded wait" in
-  t.stub.readback_completion <- Never;
-  let request_deselected = send_frame t (encode ~tag:0x13 (Read_word { address = 0 })) in
-  ignore
-    (require_failure t "an unbounded wait" (fun () ->
-       ignore (wait_ready ~budget:100 t ~since:request_deselected : int))
-     : Sexp.t);
-  expect_int
-    t
-    "the wait stopped at its budget"
-    ~expected:(request_deselected + t.timing.deselect_gap + 100)
-    t.cycle
-;;
-
-let%test_unit "the harness refuses host timing outside the P3.5 envelope" =
-  match create ~timing:{ Timing.envelope with clock_low = 3 } "negative: 3-cycle low" with
-  | (_ : t) -> raise_s [%message "a 3-cycle LCLK low was accepted"]
-  | exception _ -> ()
-;;
diff --git a/test/host_link/archived/hl4a/hardware_loader_framing_tests.ml b/test/host_link/archived/hl4a/hardware_loader_framing_tests.ml
deleted file mode 100644
index 7a635bf..0000000
--- a/test/host_link/archived/hl4a/hardware_loader_framing_tests.ml
+++ /dev/null
@@ -1,353 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "hardware_loader_framing_tests.ml" *)
-(* HL4a: request framing, parser recovery, and device bounds at the composed
-   [Host_link]'s serial pins.
-
-   The stub accepts every offer, so any request that reached the core would show as an
-   accepted offer; every malformed case requires none. Malformed frames come from
-   [Hardware_loader_testbench.Raw], never from the codec. Expected results and echoed
-   correlation are written out from the P3.5 record's request framing rules. Each
-   malformed case is followed by a legal INFO with a fresh tag, which must succeed after
-   the ordinary inter-frame gap.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Hardware_loader_testbench
-
-let write = Wire.Command.to_int Write_word
-let load_start = Wire.Command.to_int Load_start
-let info = Wire.Command.to_int Info
-
-(* Where the loader rejects a frame: at deselect validation, before any dispatch cycle, or
-   in the dispatch cycle without offering.
-*)
-module Stage = struct
-  type t =
-    | Validation
-    | Dispatch
-
-  let ready_after_deselect = function
-    | Validation -> Latency.validation_error_ready
-    | Dispatch -> Latency.offer_after_deselect + Latency.ready_after_offer
-  ;;
-end
-
-(* Sends [frame] as one selection and requires the given error answer at the stage's
-   cycle, no offer, and a working legal INFO afterwards.
-*)
-let expect_rejected
-  t
-  ~what
-  ?(stage = Stage.Validation)
-  ?extra_bits
-  ?extra_byte
-  frame
-  ~(echo : Wire.Correlation.t)
-  result
-  =
-  let started = t.cycle in
-  let request_deselected = send_frame t ?extra_bits ?extra_byte frame in
-  let exchange = receive t ~started ~request_deselected ~expected:echo in
-  expect_response
-    t
-    what
-    ~expected:{ tag = echo.tag; command = echo.command; result; payload = Empty }
-    exchange.response;
-  expect_no_offers t ~since:started (what ^ ": no core request is offered");
-  expect_int
-    t
-    (what ^ ": LRDY rises at the rejecting stage's cycle")
-    ~expected:(exchange.request_deselected + Stage.ready_after_deselect stage)
-    exchange.ready;
-  expect_info_works t ~tag:(0x80 lxor echo.tag) (what ^ ": a later legal INFO works")
-;;
-
-let echo ~tag ~command = { Wire.Correlation.tag; command }
-let zeroed = echo ~tag:0 ~command:0
-
-let%test_unit "the maximum legal frame dispatches; a twelfth byte latches overrun" =
-  let t = create "maximum frame and overrun" in
-  let frame = encode ~tag:0x3f (Write_word { address = 0; word = 0xbeef }) in
-  expect_int
-    t
-    "a WRITE_WORD frame is the eleven-byte maximum"
-    ~expected:11
-    (String.length frame);
-  let exchange = transact t ~tag:0x3f (Write_word { address = 0; word = 0xbeef }) in
-  expect_response
-    t
-    "maximum frame"
-    ~expected:(response ~tag:0x3f Write_word Complete)
-    exchange.response;
-  expect_offered_once
-    t
-    exchange
-    (Load_write { address = 0; data = 0xbeef })
-    ~accepted:true;
-  expect_rejected
-    t
-    ~what:"one byte after the maximum frame"
-    (frame ^ "\x00")
-    ~echo:(echo ~tag:0x3f ~command:write)
-    Bad_length;
-  expect_rejected
-    t
-    ~what:"thirty bytes, ending in a valid INFO, after the maximum frame"
-    (frame ^ Raw.zeros 23 ^ encode ~tag:0x40 Info)
-    ~echo:(echo ~tag:0x3f ~command:write)
-    Bad_length;
-  expect_rejected
-    t
-    ~what:"a complete frame declaring a five-byte payload is twelve bytes long"
-    (Raw.frame ~tag:0x28 ~command:info [ 0x11; 0x22; 0x33; 0x44; 0x55 ])
-    ~echo:(echo ~tag:0x28 ~command:info)
-    Bad_length;
-  expect_rejected
-    t
-    ~what:"one extra byte after a seven-byte INFO"
-    (encode ~tag:0x29 Info ^ "\x5a")
-    ~echo:(echo ~tag:0x29 ~command:info)
-    Incomplete
-;;
-
-let%test_unit "long zero prefixes and valid-looking suffixes cannot dispatch" =
-  (* The historical four-bit counter-wrap attack shapes: 15, 16, 32, and 48 zero bytes
-     before a valid LOAD_START, and 16 and 32 before a valid WRITE_WORD. Bytes 2 and 3 of
-     the prefix are zero, so the echo is tag 0, command 0.
-  *)
-  let t = create "prefix attacks" in
-  List.iter
-    [ 15, encode ~tag:0x35 (Load_start { length = 1 })
-    ; 16, encode ~tag:0x36 (Load_start { length = 1 })
-    ; 32, encode ~tag:0x37 (Load_start { length = 1 })
-    ; 48, encode ~tag:0x38 (Load_start { length = 1 })
-    ; 16, encode ~tag:0x3d (Write_word { address = 0; word = 0xbeef })
-    ; 32, encode ~tag:0x3e (Write_word { address = 0; word = 0xbeef })
-    ]
-    ~f:(fun (prefix, frame) ->
-      expect_rejected
-        t
-        ~what:(sprintf "%d zero bytes before %s" prefix (hex frame))
-        (Raw.zeros prefix ^ frame)
-        ~echo:zeroed
-        Bad_length)
-;;
-
-let%test_unit "bad magic, version, CRC, command, and payload length are rejected" =
-  let t = create "header errors" in
-  expect_rejected
-    t
-    ~what:"LOAD_START with its CRC's top bit flipped"
-    (Raw.flip_last (encode ~tag:0x21 (Load_start { length = 1 })) ~mask:0x80)
-    ~echo:(echo ~tag:0x21 ~command:load_start)
-    Bad_crc;
-  expect_rejected
-    t
-    ~what:"magic 0x00"
-    (Raw.frame ~magic:0x00 ~tag:0x24 ~command:info [])
-    ~echo:(echo ~tag:0x24 ~command:info)
-    Bad_magic;
-  expect_rejected
-    t
-    ~what:"version 0x20"
-    (Raw.frame ~version:0x20 ~tag:0x25 ~command:info [])
-    ~echo:(echo ~tag:0x25 ~command:info)
-    Bad_version;
-  List.iter [ 0xff; 0x15; 0x02 ] ~f:(fun command ->
-    expect_rejected
-      t
-      ~what:(sprintf "unknown command 0x%02x" command)
-      ~stage:Dispatch
-      (Raw.frame ~tag:0x26 ~command [])
-      ~echo:(echo ~tag:0x26 ~command)
-      Bad_command);
-  (* Complete frames with a correct CRC and a payload length at most four that is not the
-     command's one legal length.
-  *)
-  List.iteri
-    [ Wire.Command.Info, 2
-    ; Status, 4
-    ; Load_start, 0
-    ; Load_start, 4
-    ; Write_word, 3
-    ; Write_word, 2
-    ; Read_word, 4
-    ; Verify_word, 2
-    ; Load_complete, 2
-    ; Run, 4
-    ; Stop, 2
-    ; Abort, 1
-    ]
-    ~f:(fun index (command, length) ->
-      let tag = 0x90 + index in
-      let command = Wire.Command.to_int command in
-      expect_rejected
-        t
-        ~what:(sprintf "command 0x%02x with a %d-byte payload" command length)
-        ~stage:Dispatch
-        (Raw.frame ~tag ~command (List.init length ~f:(fun byte -> 0x10 + byte)))
-        ~echo:(echo ~tag ~command)
-        Bad_length)
-;;
-
-let%test_unit "device bounds refuse lengths and addresses without an offer" =
-  (* Addresses and lengths stay 16-bit until checked, so none of these is narrowed into a
-     legal RAM address.
-  *)
-  let t = create "device bounds" in
-  List.iteri
-    [ Wire.Request.Load_start { length = 0 }
-    ; Load_start { length = 257 }
-    ; Load_start { length = 0xffff }
-    ; Write_word { address = 256; word = 1 }
-    ; Write_word { address = 0x8000; word = 1 }
-    ; Read_word { address = 256 }
-    ; Verify_word { address = 0xffff; expected = 0 }
-    ]
-    ~f:(fun index request ->
-      let tag = 0xa0 + index in
-      let exchange = transact t ~tag request in
-      let what = Sexp.to_string [%sexp (request : Wire.Request.t)] in
-      expect_response
-        t
-        what
-        ~expected:(response ~tag (Wire.Request.command request) Image_bounds)
-        exchange.response;
-      expect_no_offers t ~since:exchange.started (what ^ ": no core request is offered");
-      expect_int
-        t
-        (what ^ ": the refusal is ready one cycle after the dispatch cycle")
-        ~expected:(exchange.request_deselected + Stage.ready_after_deselect Dispatch)
-        exchange.ready)
-;;
-
-let%test_unit "truncated frames and partial bytes are incomplete, echoed from four bytes" =
-  (* P3.5: all four magic/version/tag/command bytes echo tag and command; fewer zero both.
-     A partial final byte, a missing payload or CRC, and a nonzero high length byte are
-     all [Incomplete].
-  *)
-  let t = create "truncation" in
-  let frame = encode ~tag:0x22 (Write_word { address = 0; word = 0x1234 }) in
-  let echoed = echo ~tag:0x22 ~command:write in
-  List.iter
-    [ "an empty selection", 0, 0, zeroed
-    ; "one byte", 1, 0, zeroed
-    ; "three bytes", 3, 0, zeroed
-    ; "three bytes and five bits", 3, 5, zeroed
-    ; "four bytes", 4, 0, echoed
-    ; "four bytes and three bits", 4, 3, echoed
-    ; "the header only", 6, 0, echoed
-    ; "the header and half the payload", 8, 0, echoed
-    ; "no CRC", 10, 0, echoed
-    ; "no CRC, with seven of its bits", 10, 7, echoed
-    ]
-    ~f:(fun (what, bytes, bits, echo) ->
-      expect_rejected
-        t
-        ~what:("WRITE_WORD truncated to " ^ what)
-        (String.prefix frame bytes)
-        ~extra_bits:bits
-        ~extra_byte:(if bytes < String.length frame then frame.[bytes] else '\xff')
-        ~echo
-        Incomplete);
-  expect_rejected
-    t
-    ~what:"a complete WRITE_WORD followed by three bits"
-    frame
-    ~extra_bits:3
-    ~echo:echoed
-    Incomplete;
-  expect_rejected
-    t
-    ~what:"INFO with a nonzero high length byte and a seven-byte transfer"
-    (Raw.frame ~payload_length:0x100 ~tag:0x2a ~command:info [])
-    ~echo:(echo ~tag:0x2a ~command:info)
-    Incomplete
-;;
-
-let%test_unit "a zeroed echo can match INFO with tag 0 but is still an error" =
-  (* The HL2 record's recorded ambiguity. Two bytes of an INFO with tag 0 get a zeroed
-     echo that [decode_correlated] accepts as INFO/tag 0, and its result is still
-     [Incomplete]: correlation equality does not prove the header arrived. For tag 0x33
-     the same answer is a correlation mismatch, which the host replays. The test then
-     reads it without a correlation check and commits it itself, only to clean up; that is
-     not a recovery policy, and no command is retried.
-  *)
-  let t = create "zeroed echo" in
-  let info_tag_0 = encode ~tag:0 Info in
-  expect_rejected
-    t
-    ~what:"INFO tag 0 truncated to two bytes"
-    (String.prefix info_tag_0 2)
-    ~echo:zeroed
-    Incomplete;
-  let expected = Wire.Request.correlation ~tag:0x33 Info in
-  let started = t.cycle in
-  let request_deselected = send_frame t (String.prefix (encode ~tag:0x33 Info) 2) in
-  ignore (wait_ready t ~since:request_deselected : int);
-  let read = read_response t ~expected ~decide:commit_if_valid () in
-  check
-    t
-    ~phase:Host_sample
-    "a zeroed echo for tag 0x33 is a correlation mismatch and is replayed"
-    [%sexp_of: Outcome.t * (Wire.Response.t, Wire.Response.Decode_error.t) Result.t]
-    [%equal: Outcome.t * (Wire.Response.t, Wire.Response.Decode_error.t) Result.t]
-    ~expected:
-      ( Replay
-      , Error
-          (Correlation_mismatch
-             { expected
-             ; response = { tag = 0; command = 0; result = Incomplete; payload = Empty }
-             }) )
-    (read.outcome, read.decoded);
-  expect_retained t ~deselected:read.deselected ~cycles:100;
-  let exchange = receive t ~started ~request_deselected ~expected:zeroed in
-  expect_response
-    t
-    "the retained zeroed answer, committed by the test"
-    ~expected:{ tag = 0; command = 0; result = Incomplete; payload = Empty }
-    exchange.response;
-  expect_no_offers t ~since:started "a truncated INFO offers nothing";
-  expect_info_works t ~tag:0x34 "INFO after the zeroed answer"
-;;
-
-(* The peer's replayable malformed generator: a 32-bit LFSR with taps 31, 21, 1, and 0,
-   seeded with 20260921. Trial n builds an INFO tagged with the state's low byte and a CRC
-   inverted in bit 7 when n is odd, then applies mutation n mod 4.
-*)
-let next_state state =
-  let tap bit = (state lsr bit) land 1 in
-  (state lsl 1) land 0xffff_ffff lor (tap 31 lxor tap 21 lxor tap 1 lxor tap 0)
-;;
-
-let%test_unit "the peer's sixteen malformed trials at seed 20260921 are rejected" =
-  let t = create "seeded malformed trials" in
-  let state = ref 20260921 in
-  for trial = 0 to 15 do
-    state := next_state !state;
-    let tag = !state land 0xff in
-    let base = encode ~tag Info in
-    let base = if trial land 1 = 1 then Raw.flip_last base ~mask:0x80 else base in
-    let frame, result, mutation =
-      match trial % 4 with
-      | 0 -> Raw.flip_last base ~mask:0x80, Wire.Result_code.Bad_crc, "CRC bit 7 inverted"
-      | 1 -> String.prefix base 6, Incomplete, "CRC missing"
-      | 2 ->
-        ( base ^ String.of_char (Char.of_int_exn ((!state lsr 8) land 0xff))
-        , Incomplete
-        , "one extra byte" )
-      | _ ->
-        ( String.mapi base ~f:(fun index byte -> if index = 5 then '\x01' else byte)
-        , Incomplete
-        , "high length byte 1" )
-    in
-    expect_rejected
-      t
-      ~what:(sprintf "trial %d (tag 0x%02x): %s" trial tag mutation)
-      frame
-      ~echo:(echo ~tag ~command:info)
-      result
-  done
-;;
diff --git a/test/host_link/archived/hl4a/hardware_loader_testbench.ml b/test/host_link/archived/hl4a/hardware_loader_testbench.ml
deleted file mode 100644
index fd9e56f..0000000
--- a/test/host_link/archived/hl4a/hardware_loader_testbench.ml
+++ /dev/null
@@ -1,322 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "hardware_loader_testbench.ml" *)
-(* HL4a compatibility shim over the Host_link endpoint fixture, and the HL4a suite's own
-   scenario and check helpers.
-
-   The environment the HL4a suite runs in is [Protemu_host_link_endpoint.Fixture]
-   (test/host_link/endpoint/): the real composed [Host_link], an active serial-host agent
-   on its pins, a Control_port responder agent behind its port, one scheduler, the
-   transcript, and [Harness_failure]. Its header holds the scheduling contract, also
-   recorded in docs/host_link_hl4a_record.md. This file keeps the HL4a names over it, as
-   aliases and one-line wrappers, so the four HL4a test files and
-   serial_host_monitor_tests.ml compile and print exactly as before
-   (docs/serial_host_pilot.md, SP4). [t] is the fixture's state; [t.stub] is its
-   Control_port responder under the HL4a name, and [t.timing] mirrors the serial driver's
-   timing for the tests that read it.
-
-   What remains here is HL4a scenario and check code: the composite transactions
-   ([receive], [exchange], [transact], [disturb]), the [expect_*] checks other than the
-   fixture's LRDY lifecycle checks, and the expected responses ([response],
-   [info_payload]). Legal requests are built with [Wire.Request.encode] and responses are
-   read with [Wire.Response.decode_correlated]; malformed frames come from [Raw]. The
-   suite is the cycle-observed baseline that the HL4b extractions must reproduce.
-*)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-module Wire = Protemu_host_link_wire.Wire
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-module Sim = Fixture.Sim
-module Serial_host = Protemu_serial_host_agent
-module Control_port_agent = Protemu_control_port_agent
-module Timing = Serial_host.Config.Timing
-module Outcome = Serial_host.Item.Outcome
-module Pause = Serial_host.Item.Pause
-module Read = Serial_host.Item.Read
-module Exchange = Serial_host.Item.Exchange
-module Raw = Serial_host.Item.Raw
-
-let hex = Serial_host.Item.hex
-let bits_of_byte = Serial_host.Item.bits_of_byte
-let bytes_of_bits = Serial_host.Item.bytes_of_bits
-let encode = Serial_host.Item.encode
-
-(* The checker's latency predictions, shared with the endpoint pilots. *)
-module Latency = Endpoint.Latency
-
-(* Decoded offers and core status come from the Control_port agent's [Item]. *)
-module Request = Control_port_agent.Item.Request
-module Status = Control_port_agent.Item.Status
-
-(* The HL4a name for the Control_port agent's responder (test/core/control_port/), kept as
-   a shim so the tests' spelling ([t.stub.accept], [t.stub.memory.(i)],
-   [Core_stub.Offer.t], [Core_stub.inject_readback_response], ...) is unchanged. The
-   responder's header lists its contract-faithful behavior and its robustness probes. HL4a
-   uses the [Outstanding] injection policy: an injected pulse is the pending READBACK
-   response, so it can refuse a READBACK and is cancelled like one.
-*)
-module Core_stub = struct
-  module Completion = Control_port_agent.Item.Completion
-  module Offer = Control_port_agent.Item.Offer
-  module Response = Control_port_agent.Item.Response
-
-  type t = Control_port_agent.Responder.t
-
-  let inject_readback_response = Control_port_agent.Responder.inject_readback_response
-end
-
-module Phase = Fixture.Phase
-module Event = Fixture.Event
-
-(* The fixture's state under the HL4a name, with its fields, which the tests read. *)
-type t = Fixture.t =
-  { scenario : string
-  ; sim : Sim.t
-  ; serial_host : Serial_host.Agent.t
-  ; control_port : Control_port_agent.Agent.t
-  ; mutable cycle : int
-  ; mutable reset : bool
-  ; mutable enable : bool
-  ; mutable select_n : bool
-  ; mutable clock : bool
-  ; mutable data : bool
-  ; mutable ldi_fault : int -> bool
-  ; mutable ready : bool
-  ; mutable ldo : bool
-  ; mutable busy : bool
-  ; mutable ready_changes : (int * bool) list
-  ; mutable last_status : Status.t
-  ; transcript : (int * Event.t) Queue.t
-  ; transcript_limit : int
-  ; mutable omitted : int
-  ; mutable finished : bool
-  ; stub : Core_stub.t
-  ; mutable timing : Timing.t
-  }
-
-(* The fixture's environment under the HL4a names. *)
-
-let log = Fixture.log
-let note = Fixture.note
-let transcript = Fixture.transcript
-let fail = Fixture.fail
-let check = Fixture.check
-let failure_of = Fixture.failure_of
-let cycle = Fixture.cycle
-let hold = Fixture.hold
-let set_reset = Fixture.set_reset
-let set_enable = Fixture.set_enable
-let set_status t status = t.stub.status <- status
-let ready_changes = Fixture.ready_changes
-let create = Fixture.create
-let driver = Fixture.driver
-let set_timing = Fixture.set_timing
-
-(* The serial monitor's items, oldest first; a checker dequeues what it compares. *)
-let observed = Fixture.serial_observed
-let offers = Fixture.offers
-
-let accepted ?since t =
-  offers ?since t |> List.filter ~f:(fun (offer : Core_stub.Offer.t) -> offer.accepted)
-;;
-
-let responses = Fixture.responses
-let expect_ready_cleared = Fixture.expect_ready_cleared
-let expect_retained = Fixture.expect_retained
-
-let expect_no_offers t ~since what =
-  check
-    t
-    ~phase:Post_run
-    what
-    [%sexp_of: Core_stub.Offer.t list]
-    [%equal: Core_stub.Offer.t list]
-    ~expected:[]
-    (offers ~since t)
-;;
-
-let expect_offers t ~since what expected =
-  check
-    t
-    ~phase:Post_run
-    what
-    [%sexp_of: Core_stub.Offer.t list]
-    [%equal: Core_stub.Offer.t list]
-    ~expected
-    (offers ~since t)
-;;
-
-let expect_int t ?cycle what ~expected actual =
-  check t ?cycle ~phase:Post_run what [%sexp_of: int] Int.equal ~expected actual
-;;
-
-(* Holds [cycles] and requires LRDY and LDO low and no offer throughout. *)
-let expect_quiet t cycles what =
-  let since = t.cycle in
-  for _ = 1 to cycles do
-    cycle t;
-    if t.ready || t.ldo
-    then
-      fail
-        t
-        ~phase:Pre_edge
-        what
-        ~expected:[%sexp { ready = false; ldo = false }]
-        ~actual:[%sexp { ready : bool = t.ready; ldo : bool = t.ldo }]
-  done;
-  expect_no_offers t ~since what
-;;
-
-(* Host serial driver: [Serial_host.Driver] through the fixture's adapter, under the HL4a
-   names and argument order. Each wrapper's behavior and failure is the driver's.
-*)
-
-let select t = Serial_host.Driver.select (driver t)
-let deselect t = Serial_host.Driver.deselect (driver t)
-let send_bit t value = Serial_host.Driver.send_bit (driver t) value
-
-let send t ?extra_bits ?extra_byte bytes =
-  Serial_host.Driver.send (driver t) ?extra_bits ?extra_byte bytes
-;;
-
-let send_rest_of_byte t byte ~bits =
-  Serial_host.Driver.send_rest_of_byte (driver t) byte ~bits
-;;
-
-let begin_frame t = Serial_host.Driver.begin_frame (driver t)
-let end_frame t = Serial_host.Driver.end_frame (driver t)
-
-let send_frame t ?extra_bits ?extra_byte bytes =
-  Serial_host.Driver.send_frame (driver t) ?extra_bits ?extra_byte bytes
-;;
-
-let wait_ready ?budget t ~since = Serial_host.Driver.wait_ready ?budget (driver t) ~since
-
-let read_bit ?final ?high_pause t =
-  Serial_host.Driver.read_bit ?final ?high_pause (driver t)
-;;
-
-let abandon_response t = Serial_host.Driver.abandon_response (driver t)
-let finish_response t outcome = Serial_host.Driver.finish_response (driver t) outcome
-
-let read_response t ?expected ?pause ~decide () =
-  Serial_host.Driver.read_response (driver t) ?expected ?pause ~decide ()
-;;
-
-let read_prefix t ~bits = Serial_host.Driver.read_prefix (driver t) ~bits
-let commit_if_valid = Serial_host.Item.commit_if_valid
-
-(* Waits for LRDY after a request frame, reads and validates the response, commits it, and
-   checks that LRDY clears on the commit boundary. A response that fails validation is
-   replayed first, so the failure report describes a retained response.
-*)
-let receive ?ready_budget ?pause t ~started ~request_deselected ~expected =
-  let ready = wait_ready ?budget:ready_budget t ~since:request_deselected in
-  let read = read_response t ~expected ?pause ~decide:commit_if_valid () in
-  match read.decoded with
-  | Error error ->
-    fail
-      t
-      ~phase:Host_sample
-      "response decodes and correlates; it was replayed"
-      ~expected:[%sexp (expected : Wire.Correlation.t)]
-      ~actual:[%sexp (error : Wire.Response.Decode_error.t), (hex read.bytes : string)]
-  | Ok response ->
-    expect_ready_cleared t ~deselected:read.deselected;
-    { Exchange.started
-    ; request_deselected
-    ; ready
-    ; response_selected = read.selected
-    ; response_deselected = read.deselected
-    ; bytes = read.bytes
-    ; response
-    }
-;;
-
-(* A complete transaction for [frame]: send it with the gap, then [receive]. *)
-let exchange ?ready_budget ?pause t frame ~expected =
-  let started = t.cycle in
-  let request_deselected = send_frame t frame in
-  receive ?ready_budget ?pause t ~started ~request_deselected ~expected
-;;
-
-let transact ?ready_budget ?pause t ~tag request =
-  exchange
-    ?ready_budget
-    ?pause
-    t
-    (encode ~tag request)
-    ~expected:(Wire.Request.correlation ~tag request)
-;;
-
-(* The command reached the core exactly once, [Latency.offer_after_deselect] cycles after
-   its frame's deselection, with [request]'s operands.
-*)
-let expect_offered_once t (exchange : Exchange.t) request ~accepted =
-  expect_offers
-    t
-    ~since:exchange.started
-    "the command is offered once, three cycles after its deselection"
-    [ { cycle = exchange.request_deselected + Latency.offer_after_deselect
-      ; request
-      ; accepted
-      }
-    ]
-;;
-
-(* Out-of-contract selection while a command is in flight: select, clock [bytes] as if
-   sending a request ([send] checks that LDO stays low at every rise), deselect, and hold
-   the gap. Returns the deselection cycle.
-*)
-let disturb t bytes =
-  note t "out-of-contract selection";
-  send_frame t bytes
-;;
-
-let expect_response t what ~expected (actual : Wire.Response.t) =
-  check
-    t
-    ~phase:Host_sample
-    what
-    [%sexp_of: Wire.Response.t]
-    [%equal: Wire.Response.t]
-    ~expected
-    actual
-;;
-
-(* Response written out from a scenario's expected fields. *)
-let response ~tag command ?(payload = Wire.Response.Payload.Empty) result =
-  { Wire.Response.tag; command = Wire.Command.to_int command; result; payload }
-;;
-
-(* A legal INFO with a fresh tag, answered with the fixed INFO descriptor: the check that
-   the loader accepts new work after a malformed frame or a cancellation.
-*)
-let info_payload =
-  Wire.Response.Payload.Info
-    { wire_major = 1
-    ; wire_minor = 0
-    ; isa_version = 1
-    ; memory_layout = 1
-    ; capabilities =
-        [ Status; Program_load; Program_read; Program_verify; Run; Stop; Abort ]
-    ; memory_word_bits = 16
-    ; memory_depth = 256
-    ; max_request_payload_bytes = 4
-    ; protocol_pin_count = 8
-    }
-;;
-
-let expect_info_works t ~tag what =
-  let since = t.cycle in
-  let exchange = transact t ~tag Info in
-  expect_response
-    t
-    what
-    ~expected:(response ~tag Info ~payload:info_payload Complete)
-    exchange.response;
-  expect_no_offers t ~since what
-;;
diff --git a/test/host_link/archived/hl4a/hardware_loader_transaction_tests.ml b/test/host_link/archived/hl4a/hardware_loader_transaction_tests.ml
deleted file mode 100644
index 9e9c29f..0000000
--- a/test/host_link/archived/hl4a/hardware_loader_transaction_tests.ml
+++ /dev/null
@@ -1,727 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "hardware_loader_transaction_tests.ml" *)
-(* HL4a: legal transactions, host timing, pauses, and response replay/commit at the
-   composed [Host_link]'s serial pins and [Control_port].
-
-   Expected responses are written out from the P3.5 record and the scenario's stub
-   configuration, never computed from the offered request or the loader's logic. Each test
-   says whether its stub follows the [Control_port] contract or deliberately departs from
-   it as a loader robustness probe. See docs/host_link_hl4a_record.md for the case map.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Hardware_loader_testbench
-
-(* Raw INFO response for tag 0x5c, with its CRC from an independent bitwise CRC-8/ATM
-   script (check value [123456789] -> [0xf4]), not from [Wire].
-*)
-let info_response_5c = "5a 10 5c 00 00 0d 00 01 00 01 01 7f 00 10 00 00 01 04 00 08 36"
-
-let%test_unit "INFO and STATUS report the fixed descriptor and the core's status" =
-  (* Contract-faithful: status is a live observation with no qualifier (item 9). *)
-  let t = create "INFO and STATUS" in
-  let exchange = transact t ~tag:0x5c Info in
-  check
-    t
-    ~phase:Host_sample
-    "INFO bytes"
-    [%sexp_of: string]
-    String.equal
-    ~expected:info_response_5c
-    (hex exchange.bytes);
-  expect_response
-    t
-    "INFO"
-    ~expected:(response ~tag:0x5c Info ~payload:info_payload Complete)
-    exchange.response;
-  expect_no_offers t ~since:exchange.started "INFO is answered without an offer";
-  expect_int
-    t
-    "INFO is ready one cycle after its dispatch cycle"
-    ~expected:
-      (exchange.request_deselected
-       + Latency.offer_after_deselect
-       + Latency.ready_after_offer)
-    exchange.ready;
-  let status_cases : (string * Status.t * Wire.Status.t) list =
-    [ ( "after reset"
-      , Status.halted_idle
-      , { flags = [ Enabled; Halted; Engines_idle ]
-        ; image_length = 0
-        ; words_written = 0
-        ; words_verified = 0
-        ; pc = 0
-        ; fault_kind = No_fault
-        ; phase = Halted
-        } )
-    ; ( "verified image after a normal halt"
-      , { Status.halted_idle with
-          image_valid = 1
-        ; image_length = 3
-        ; words_written = 3
-        ; words_verified = 3
-        ; normal_halt = 1
-        ; pc = 2
-        }
-      , { flags = [ Enabled; Halted; Engines_idle; Image_valid; Normal_halt ]
-        ; image_length = 3
-        ; words_written = 3
-        ; words_verified = 3
-        ; pc = 2
-        ; fault_kind = No_fault
-        ; phase = Halted
-        } )
-    ; ( "executing with an engine on pin 1; the 17-bit PC is reported in 16 bits"
-      , { Status.running with image_length = 10; pc = 0x1_0007 }
-      , { flags =
-            [ Enabled; Image_valid; Execution_active; Pin_output_enabled; Pin_claimed ]
-        ; image_length = 10
-        ; words_written = 0
-        ; words_verified = 0
-        ; pc = 0x0007
-        ; fault_kind = No_fault
-        ; phase = Mechanism_wait
-        } )
-    ; ( "invalid-instruction fault"
-      , { Status.halted_idle with
-          image_valid = 1
-        ; image_length = 1
-        ; words_written = 1
-        ; words_verified = 1
-        ; execution_fault = 1
-        ; fault_kind = 1
-        ; phase = 6
-        ; pc = 1
-        }
-      , { flags = [ Enabled; Halted; Engines_idle; Image_valid; Execution_fault ]
-        ; image_length = 1
-        ; words_written = 1
-        ; words_verified = 1
-        ; pc = 1
-        ; fault_kind = Invalid_base
-        ; phase = Fault
-        } )
-    ; ( "load in progress with a failed verify, a fetch fault, and a software claim"
-      , { Status.halted_idle with
-          load_active = 1
-        ; verification_failed = 1
-        ; fetch_fault = 1
-        ; image_length = 256
-        ; words_written = 255
-        ; words_verified = 17
-        ; software_claim = 0x80
-        ; fault_kind = 9
-        ; phase = 3
-        }
-      , { flags =
-            [ Enabled
-            ; Halted
-            ; Engines_idle
-            ; Load_active
-            ; Verification_failed
-            ; Fetch_fault
-            ; Pin_claimed
-            ]
-        ; image_length = 256
-        ; words_written = 255
-        ; words_verified = 17
-        ; pc = 0
-        ; fault_kind = Mechanism_protocol
-        ; phase = Extension_wait
-        } )
-    ]
-  in
-  List.iteri status_cases ~f:(fun index (what, status, expected) ->
-    set_status t status;
-    let tag = 0x60 + index in
-    let exchange = transact t ~tag Status in
-    expect_response
-      t
-      ("STATUS " ^ what)
-      ~expected:(response ~tag Status ~payload:(Status expected) Complete)
-      exchange.response;
-    expect_no_offers t ~since:exchange.started "STATUS is answered without an offer")
