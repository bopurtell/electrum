-        ; Fifo_push
-            { fifo = Kinds.Fifo_id.Tx; rs = 0; blocking = Kinds.Blocking.Blocking }
-        ]
-      , { kind = Execution_unit.Mechanism_kind.fifo_push
-        ; arg0 = 0
-        ; arg1 = 0
-        ; arg2 = 0x55
-        ; timeout = false
