diff --git a/test/host_link/endpoint/fixture.ml b/test/host_link/endpoint/fixture.ml
deleted file mode 100644
index 8cacce2..0000000
--- a/test/host_link/endpoint/fixture.ml
+++ /dev/null
@@ -1,533 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "fixture.ml" *)
-(* The Host_link endpoint fixture: the real composed [Host_link] in Cyclesim, an active
-   serial-host agent on its three serial pins, and a Control_port agent in responder mode
-   behind its [Control_port], under one scheduler.
-
-   The fixture owns the environment: the simulator, the scheduler ([cycle], [hold]), reset
-   and enable, both agents with their pin and port adapters and the serial driver's hooks,
-   the transcript, and failure reporting ([fail], [check], [Harness_failure]). A test owns
-   a fresh instance through [run], which builds everything, runs the scenario, and
-   finishes the instance. Scenario intent, expected values, and composite checks belong to
-   the test; [Scoreboard] is the opt-in end-of-scenario check over both monitors. The
-   endpoint suite in this directory is written against the fixture directly; the frozen
-   HL4a archive reaches it through its compatibility shim
-   test/host_link/archived/hl4a/hardware_loader_testbench.ml (docs/serial_host_pilot.md,
-   SP4 and SP5).
-
-   This is synchronous digital evidence. Every pin change happens at a cycle boundary, so
-   the fixture establishes nothing about asynchronous phase, metastability, board timing,
-   or physical setup/hold margins. The independent emitted-RTL peer
-   tinytapeout/test/p3_loader_tb.v and physical evidence own those. The Control_port
-   monitor's offers and responses are evidence about loader dispatch only, never about RAM
-   writes, core cleanup, or pins.
-
-   Scheduling contract (docs/host_link_hl4a_record.md records the same contract):
-
-   1. Time. The unit is one system clock cycle. Cycle n is the interval before edge n. A
-      reset, enable, pin, or status value set for cycle n is applied before that cycle's
-      settle and sampled at edge n. [cycle] is the only function that advances the
-      simulator. Host steps call it in sequence, through the serial driver's [step] hook,
-      and the responder runs inside it; neither advances time on its own.
-   2. Within a cycle: apply reset/enable, the serial pins, the responder's status, and its
-      registered READBACK response; settle; read the offered request; apply the
-      responder's combinational decision; settle again and check that the request did not
-      change; pass the Control_port records to that agent's monitor and log the offer and
-      response it observed; take the pre-edge observation (LRDY, LDO, busy) and pass the
-      serial pins to the serial agent's monitor; clock the edge; then do the responder's
-      post-edge work (accepted side effects, completions, cancellation).
-   3. Host pins follow the P3.5 envelope in whole cycles (see [Timing]). The host samples
-      LDO in the cycle in which it raises LCLK, before that cycle's edge. This matches the
-      peer's sample 1 ps after its rise.
-   4. A response is read as 7 header bytes, then the length they declare, up to the final
-      bit. The host samples that bit on its rise and validates the frame while LCLK stays
-      high. Commit then supplies the final fall, waits [select_trail] and raises LSEL_N.
-      Replay raises LSEL_N with LCLK high, and lowers LCLK [clock_high] cycles later.
-   5. Every wait has a finite cycle budget. An exhausted budget or a failed check raises
-      [Harness_failure] with the scenario, cycle, sampling phase, what was checked, the
-      expected and actual values, and a bounded transcript of recent public-boundary
-      events.
-*)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-module Wire = Protemu_host_link_wire.Wire
-module Sim = Cyclesim.With_interface (Host_link.I) (Host_link.O)
-module Serial_host = Protemu_serial_host_agent
-module Control_port_agent = Protemu_control_port_agent
-module Timing = Serial_host.Config.Timing
-module Outcome = Serial_host.Item.Outcome
-module Request = Control_port_agent.Item.Request
-module Status = Control_port_agent.Item.Status
-module Offer = Control_port_agent.Item.Offer
-module Response = Control_port_agent.Item.Response
-
-module Phase = struct
-  type t =
-    | Settle (* between the two settles of a cycle *)
-    | Pre_edge
-    | Host_sample (* the host's LDO sample, pre-edge in its LCLK rise cycle *)
-    | Post_run (* a check made by the test between cycles *)
-  [@@deriving sexp_of]
-end
-
-(* Public-boundary events, logged in the cycle they are driven or observed. *)
-module Event = struct
-  type t =
-    | Reset of bool
-    | Enable of bool
-    | Select of bool (* host drives LSEL_N low when true *)
-    | Sent of
-        { bytes : string
-        ; extra_bits : int
-        }
-    | Offer of
-        { request : Request.t
-        ; accepted : bool
-        }
-    | Readback_response of
-        { data : int
-        ; matches : bool
-        }
-    | Status of (string * int) list
-    | Ready of bool
-    | Busy of bool
-    | Response_read of
-        { bytes : string
-        ; outcome : Outcome.t
-        }
-    | Note of string
-  [@@deriving sexp_of]
-end
-
-(* The fixture's state. [serial_host] and [control_port] are the two agents; the responder
-   is [control_port]'s. [select_n], [clock] and [data] are the host pins the driver last
-   set through the adapter, applied by [cycle]. [finished] is set when [run] ends.
-
-   The last two fields exist only for the HL4a shim, whose unedited tests read them as
-   record fields, which cannot be computed: [stub] is [control_port]'s responder, and
-   [timing] mirrors the serial driver's timing, kept equal by [set_timing]. Nothing in
-   this fixture reads either; [responder] and [timing] are the accessors.
-*)
-type t =
-  { scenario : string
-  ; sim : Sim.t
-  ; serial_host : Serial_host.Agent.t
-  ; control_port : Control_port_agent.Agent.t
-  ; mutable cycle : int
-  ; mutable reset : bool
-  ; mutable enable : bool
-  ; mutable select_n : bool
-  ; mutable clock : bool
-  ; mutable data : bool
-  ; mutable ldi_fault : int -> bool (* test-only: invert the applied LDI in cycle n *)
-  ; mutable ready : bool (* pre-edge LRDY of the last cycle *)
-  ; mutable ldo : bool (* pre-edge LDO of the last cycle *)
-  ; mutable busy : bool
-  ; mutable ready_changes : (int * bool) list (* newest first *)
-  ; mutable last_status : Status.t
-  ; transcript : (int * Event.t) Queue.t
-  ; transcript_limit : int
-  ; mutable omitted : int
-  ; mutable finished : bool
-  ; stub : Control_port_agent.Responder.t (* HL4a shim only *)
-  ; mutable timing : Timing.t (* HL4a shim only *)
-  }
-
-let log t ?(cycle = t.cycle) event =
-  Queue.enqueue t.transcript (cycle, event);
-  while Queue.length t.transcript > t.transcript_limit do
-    ignore (Queue.dequeue_exn t.transcript : int * Event.t);
-    t.omitted <- t.omitted + 1
-  done
-;;
-
-let note t message = log t (Note message)
-
-let transcript t =
-  let events = Queue.to_list t.transcript in
-  if t.omitted = 0
-  then [%sexp (events : (int * Event.t) list)]
-  else
-    [%sexp { earlier_events_omitted = (t.omitted : int); events : (int * Event.t) list }]
-;;
-
-(* A failed check, as [Harness_failure] reports it. *)
-module Report = struct
-  type t =
-    { scenario : string
-    ; cycle : int
-    ; phase : Phase.t
-    ; what : string
-    ; expected : Sexp.t option
-    ; actual : Sexp.t option
-    ; transcript : Sexp.t
-    }
-  [@@deriving sexp_of]
-end
-
-exception Harness_failure of Report.t
-
-(* The name a report prints. The HL4a baseline's expect output records the exception under
-   the file that first defined it, and the endpoint pilots must print the same reports, so
-   the converter is written here with that name instead of derived from this file's path.
-   It prints the report's fields exactly as [@@deriving sexp_of] on the original inline
-   record did. Renaming it is an expect change, and the owner's decision.
-*)
-let harness_failure_name = "test/host_link/hardware_loader_testbench.ml.Harness_failure"
-
-let () =
-  Sexplib0.Sexp_conv.Exn_converter.add [%extension_constructor Harness_failure] (function
-    | Harness_failure report ->
-      (match Report.sexp_of_t report with
-       | List fields -> List (Atom harness_failure_name :: fields)
-       | Atom _ as atom -> atom)
-    | _ -> assert false)
-;;
-
-let fail t ?(cycle = t.cycle - 1) ?expected ?actual ~phase what =
-  raise
-    (Harness_failure
-       { scenario = t.scenario
-       ; cycle
-       ; phase
-       ; what
-       ; expected
-       ; actual
-       ; transcript = transcript t
-       })
-;;
-
-let check t ?cycle ~phase what sexp_of equal ~expected actual =
-  if not (equal expected actual)
-  then fail t ?cycle ~phase what ~expected:(sexp_of expected) ~actual:(sexp_of actual)
-;;
-
-(* [Some failure] when [f] raises [Harness_failure]. Used by the negative checks. *)
-let failure_of f =
-  match f () with
-  | (_ : unit) -> None
-  | exception (Harness_failure _ as failure) -> Some [%sexp (failure : exn)]
-;;
-
-let set_int port value = port := Bits.of_int_trunc ~width:(Bits.width !port) value
-let set_bool port value = port := Bits.of_bool value
-
-(* Serial-host pin adapter, port side: the logical serial pins in one cycle, as applied to
-   and read from the [Host_link] ports pre-edge. Reading the host pins back from the
-   inputs means the monitor sees what the DUT saw, including an injected LDI fault.
-*)
-let serial_pins (i : Bits.t ref Host_link.I.t) (o : Bits.t ref Host_link.O.t)
-  : Serial_host.Monitor.Sample.t
-  =
-  { select_n = Bits.to_bool !(i.serial_select_n_i)
-  ; clock = Bits.to_bool !(i.serial_clock_i)
-  ; ldi = Bits.to_bool !(i.serial_data_i)
-  ; ldo = Bits.to_bool !(o.serial_data_o)
-  ; ready = Bits.to_bool !(o.serial_ready_o)
-  }
-;;
-
-(* Control_port adapter: the port records in one cycle as [int]s, read back from the
-   [Host_link] ports pre-edge, so the monitor sees the decision and status the DUT saw.
-*)
-let control_port_sample (i : Bits.t ref Host_link.I.t) (o : Bits.t ref Host_link.O.t)
-  : Control_port_agent.Monitor.Sample.t
-  =
-  let value port = Bits.to_int_trunc !port in
-  { request = Control_port.Request.map o.control_request_o ~f:value
-  ; decision = Control_port.Decision.map i.control_decision_i ~f:value
-  ; status = Control_port.Status.map i.control_status_i ~f:value
-  }
-;;
-
-let responder t = Control_port_agent.Agent.responder_exn t.control_port
-
-(* Logs, in the current cycle, the Control_port monitor's items from position [from] on:
-   the offer and READBACK response that crossed the port.
-*)
-let log_port_items t ~from =
-  let observed = Control_port_agent.Agent.observed t.control_port in
-  for index = from to Queue.length observed - 1 do
-    match Queue.get observed index with
-    | Offer { request; accepted; cycle = _ } -> log t (Offer { request; accepted })
-    | Response { data; matches; cycle = _ } -> log t (Readback_response { data; matches })
-  done
-;;
-
-(* The single owner of simulator advancement; see item 2 of the contract. *)
-let cycle t =
-  if t.finished
-  then
-    raise_s
-      [%message
-        "the endpoint fixture is used after its scoped run"
-          ~scenario:(t.scenario : string)];
-  let sim = t.sim in
-  let i = Cyclesim.inputs sim in
-  let o = Cyclesim.outputs ~clock_edge:Before sim in
-  let responder = responder t in
-  if not (Control_port.Status.equal Int.equal responder.status t.last_status)
-  then (
-    log t (Status (Status.summary responder.status));
-    t.last_status <- responder.status);
-  set_bool i.reset_i t.reset;
-  set_bool i.enable_i t.enable;
-  set_bool i.serial_select_n_i t.select_n;
-  set_bool i.serial_clock_i t.clock;
-  set_bool i.serial_data_i (Bool.( <> ) t.data (t.ldi_fault t.cycle));
-  Control_port.Status.iter2 i.control_status_i responder.status ~f:set_int;
-  let drive_decision offer =
-    Control_port.Decision.iter2
-      i.control_decision_i
-      (Control_port_agent.Responder.decision responder ~cycle:t.cycle ~offer)
-      ~f:set_int
-  in
-  drive_decision None;
-  Cyclesim.cycle_check sim;
-  Cyclesim.cycle_before_clock_edge sim;
-  let request () = Control_port.Request.map o.control_request_o ~f:( ! ) in
-  let offered = request () in
-  let offer =
-    match Request.of_port (Control_port.Request.map offered ~f:Bits.to_int_trunc) with
-    | [] -> None
-    | [ request ] ->
-      Some
-        ( request
-        , Control_port_agent.Responder.decide
-            responder
-            ~reset:t.reset
-            ~enable:t.enable
-            request )
-    | requests ->
-      fail
-        t
-        ~cycle:t.cycle
-        ~phase:Settle
-        "at most one request is offered per cycle"
-        ~actual:[%sexp (requests : Request.t list)]
-  in
-  drive_decision offer;
-  Cyclesim.cycle_before_clock_edge sim;
-  check
-    t
-    ~cycle:t.cycle
-    ~phase:Settle
-    "the offered request does not depend on the decision in the same cycle"
-    [%sexp_of: Bits.t Control_port.Request.t]
-    (Control_port.Request.equal Bits.equal)
-    ~expected:offered
-    (request ());
-  let from = Queue.length (Control_port_agent.Agent.observed t.control_port) in
-  Control_port_agent.Agent.sample t.control_port ~cycle:t.cycle (control_port_sample i o);
-  log_port_items t ~from;
-  let ready = Bits.to_bool !(o.serial_ready_o) in
-  if Bool.( <> ) ready t.ready
-  then (
-    t.ready_changes <- (t.cycle, ready) :: t.ready_changes;
-    log t (Ready ready));
-  let busy = Bits.to_bool !(o.busy_o) in
-  if Bool.( <> ) busy t.busy then log t (Busy busy);
-  t.ready <- ready;
-  t.busy <- busy;
-  t.ldo <- Bits.to_bool !(o.serial_data_o);
-  Serial_host.Agent.sample t.serial_host ~cycle:t.cycle (serial_pins i o);
-  Cyclesim.cycle_at_clock_edge sim;
-  Cyclesim.cycle_after_clock_edge sim;
-  Control_port_agent.Responder.edge
-    responder
-    ~cycle:t.cycle
-    ~reset:t.reset
-    ~enable:t.enable
-    ~offer;
-  t.cycle <- t.cycle + 1
-;;
-
-let hold t cycles =
-  for _ = 1 to cycles do
-    cycle t
-  done
-;;
-
-let set_reset t value =
-  t.reset <- value;
-  log t (Reset value)
-;;
-
-let set_enable t value =
-  t.enable <- value;
-  log t (Enable value)
-;;
-
-(* Sampled LRDY changes at or after [since], oldest first. *)
-let ready_changes ?(since = 0) t =
-  List.rev t.ready_changes |> List.filter ~f:(fun (cycle, _) -> cycle >= since)
-;;
-
-(* Serial-host pin adapter and environment hooks, driver side. Host pins land in [t] for
-   [cycle] to apply; LDO and the LRDY history are [cycle]'s pre-edge samples. Driver
-   events and failures map one to one onto [Event] and [Phase], so transcripts and reports
-   keep the HL4a format. [self] is [t] once [create] has built it.
-*)
-let serial_host_hooks (self : t Set_once.t) =
-  let t () = Set_once.get_exn self in
-  let phase : Serial_host.Driver.Failure.Kind.t -> Phase.t = function
-    | Host_sample -> Host_sample
-    | Ready_wait -> Pre_edge
-  in
-  let pins : Serial_host.Driver.Pins.t =
-    { set_select_n = (fun value -> (t ()).select_n <- value)
-    ; set_clock = (fun value -> (t ()).clock <- value)
-    ; set_data = (fun value -> (t ()).data <- value)
-    ; ldo = (fun () -> (t ()).ldo)
-    ; ready_changes = (fun ~since -> ready_changes ~since (t ()))
-    }
-  in
-  let env : Serial_host.Driver.Env.t =
-    { step = (fun () -> cycle (t ()))
-    ; now = (fun () -> (t ()).cycle)
-    ; log =
-        (fun event ->
-          log
-            (t ())
-            (match event with
-             | Select selected -> Select selected
-             | Sent { bytes; extra_bits } ->
-               Sent { bytes = Serial_host.Item.hex bytes; extra_bits }
-             | Response_read { bytes; outcome } ->
-               Response_read { bytes = Serial_host.Item.hex bytes; outcome }))
-    ; fail =
-        (fun { kind; what; expected; actual } ->
-          fail (t ()) ~phase:(phase kind) what ~expected ~actual)
-    }
-  in
-  pins, env
-;;
-
-(* Pins idle, reset held for four cycles, then four idle cycles. The loader's
-   deselected-cycle count therefore already qualifies a response selection. The serial
-   agent is active and the Control_port agent a responder with the [Outstanding] injection
-   policy (see [Control_port_agent.Config.Injection]), each with its monitor sampled in
-   every cycle from the first. [timing] is validated before the simulator is built.
-
-   Prefer [run], which also finishes the instance; [create] remains for the HL4a shim.
-*)
-let create ?(timing = Timing.envelope) ?(transcript_limit = 48) scenario =
-  let self = Set_once.create () in
-  let serial_host =
-    Serial_host.Agent.create
-      ~host:(serial_host_hooks self)
-      (Serial_host.Config.active ~timing ())
-  in
-  let sim = Sim.create (Host_link.create (Scope.create ~flatten_design:true ())) in
-  let control_port =
-    Control_port_agent.Agent.create
-      (Control_port_agent.Config.responder ~injection:Outstanding)
-  in
-  let stub = Control_port_agent.Agent.responder_exn control_port in
-  let t =
-    { scenario
-    ; sim
-    ; serial_host
-    ; control_port
-    ; cycle = 0
-    ; reset = false
-    ; enable = true
-    ; select_n = true
-    ; clock = false
-    ; data = false
-    ; ldi_fault = Fn.const false
-    ; ready = false
-    ; ldo = false
-    ; busy = false
-    ; ready_changes = []
-    ; last_status = stub.status
-    ; transcript = Queue.create ()
-    ; transcript_limit
-    ; omitted = 0
-    ; finished = false
-    ; stub
-    ; timing
-    }
-  in
-  Set_once.set_exn self t;
-  set_reset t true;
-  hold t 4;
-  set_reset t false;
-  hold t 4;
-  t
-;;
-
-(* The scoped entry point: a fresh simulator, agents, monitors, responder policy, and
-   transcript for [scenario], passed to [f]. The instance is finished when [f] returns or
-   raises, and [cycle] on it raises afterwards, so a handle that escapes cannot advance a
-   later scenario's time.
-*)
-let run ?timing ?transcript_limit ~scenario f =
-  let t = create ?timing ?transcript_limit scenario in
-  Exn.protect ~f:(fun () -> f t) ~finally:(fun () -> t.finished <- true)
-;;
-
-let driver t = Serial_host.Agent.driver_exn t.serial_host
-
-(* The host timing has one source, the serial driver. *)
-let timing t = Serial_host.Driver.timing (driver t)
-
-let set_timing t timing =
-  Serial_host.Driver.set_timing (driver t) timing;
-  t.timing <- timing
-;;
-
-(* The two monitors' items, oldest first. A checker dequeues what it compares; [offers]
-   and [responses] read without dequeuing.
-*)
-let serial_observed t = Serial_host.Agent.observed t.serial_host
-let control_port_observed t = Control_port_agent.Agent.observed t.control_port
-
-(* Offers and delivered READBACK responses as the Control_port monitor observed them,
-   oldest first.
-*)
-let offers ?(since = 0) t =
-  Queue.to_list (control_port_observed t)
-  |> List.filter_map ~f:Control_port_agent.Item.Observed.offer
-  |> List.filter ~f:(fun (offer : Offer.t) -> offer.cycle >= since)
-;;
-
-let responses ?(since = 0) t =
-  Queue.to_list (control_port_observed t)
-  |> List.filter_map ~f:Control_port_agent.Item.Observed.response
-  |> List.filter ~f:(fun (response : Response.t) -> response.cycle >= since)
-;;
-
-(* Response lifecycle checks on LRDY. *)
-
-(* A committed response clears LRDY [Latency.ready_cleared_after_deselect] cycles after
-   the host deselects, and LRDY does not change otherwise in between.
-*)
-let expect_ready_cleared t ~deselected =
-  hold t (Int.max 0 (deselected + Latency.ready_cleared_after_deselect + 1 - t.cycle));
-  check
-    t
-    ~phase:Pre_edge
-    ~cycle:(deselected + Latency.ready_cleared_after_deselect)
-    "committed response clears LRDY"
-    [%sexp_of: (int * bool) list]
-    [%equal: (int * bool) list]
-    ~expected:[ deselected + Latency.ready_cleared_after_deselect, false ]
-    (ready_changes ~since:deselected t)
-;;
-
-(* A retained response keeps LRDY high for [cycles] after the host deselects. *)
-let expect_retained t ~deselected ~cycles =
-  hold t (Int.max 0 (deselected + cycles - t.cycle));
-  check
-    t
-    ~phase:Pre_edge
-    (sprintf "retained response keeps LRDY high for %d cycles" cycles)
-    [%sexp_of: (int * bool) list * bool]
-    [%equal: (int * bool) list * bool]
-    ~expected:([], true)
-    (ready_changes ~since:deselected t, t.ready)
-;;
diff --git a/test/host_link/endpoint/latency.ml b/test/host_link/endpoint/latency.ml
deleted file mode 100644
index ff14534..0000000
--- a/test/host_link/endpoint/latency.ml
+++ /dev/null
@@ -1,56 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "latency.ml" *)
-(* Latencies of the unsplit loader, in cycles, fixed here as the HL4b baseline. P3.5
-   bounds only the host envelope; these values are the current cycle behavior, each
-   explained from the loader's structure or the [Control_port] contract. Cycle n is the
-   cycle in which the host drives the pin change.
-
-   These are the checker's predictions, written from that explanation; nothing here is
-   read from the loader or from the Control_port responder, whose own contract latencies
-   ([Responder.readback_latency]) are a separate implementation. The endpoint suite,
-   [Scoreboard], and the archived HL4a suite (test/host_link/archived/hl4a/) share this
-   one copy (docs/serial_host_pilot.md, SP4).
-*)
-
-open! Core
-
-(* LSEL_N high in cycle n passes the two-stage synchronizer (edges n and n+1), is seen as
-   a release in cycle n+2, arms dispatch at edge n+2, and is offered in cycle n+3.
-*)
-let offer_after_deselect = 3
-
-(* An immediate response is stored at the offer's edge, so LRDY is high from the next
-   cycle. Dispatch-stage errors (unknown command, wrong fixed length, device bounds) use
-   the same cycle but offer nothing.
-*)
-let ready_after_offer = 1
-
-(* A frame that fails deselect validation (overrun, incomplete, magic, version, oversized
-   length, CRC) stores its error at the release edge n+2, so LRDY is high from n+3: one
-   cycle before a valid frame would be offered.
-*)
-let validation_error_ready = 3
-
-(* Contract item 5: an offer accepted at edge E has its response valid in the cycle
-   between E+1 and E+2.
-*)
-let readback_after_offer = 2
-
-(* The loader stores a READ or ABORT response at the edge of the cycle in which the
-   completion is visible.
-*)
-let ready_after_completion = 1
-
-(* Contract item 6: cleanup is visible in the first cycle after the accepting edge. *)
-let abort_clean_after_offer = 1
-
-(* After a synchronized final fall, LSEL_N high in cycle n is seen as a release in cycle
-   n+2, which clears LRDY from cycle n+3.
-*)
-let ready_cleared_after_deselect = 3
-
-(* LSEL_N low in cycle n is seen as a selection in cycle n+2. It arms a response read only
-   if LRDY is high and four deselected cycles have been counted in that cycle.
-*)
-let response_select_to_armed = 2
diff --git a/test/host_link/endpoint/scoreboard.ml b/test/host_link/endpoint/scoreboard.ml
deleted file mode 100644
index 373e039..0000000
--- a/test/host_link/endpoint/scoreboard.ml
+++ /dev/null
@@ -1,199 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "scoreboard.ml" *)
-(* The endpoint fixture's opt-in end-of-scenario scoreboard. It joins two independent
-   streams per monitor: the items a monitor rebuilt from the pins or the port, and the
-   items the scenario expects.
-
-   Expected serial items come from the driver's side only: the frame the scenario sent,
-   with the cycles the driver reported; the [Read.t] the driver returned; and, for a read
-   abandoned before its final bit, the bits the driver read and the cycle it deselected.
-   Expected Control_port items are the scenario's offers and READBACK responses, placed in
-   time by [Latency]'s predictions from the request's deselection cycle. Nothing expected
-   is read from a monitor, the responder, or the loader. [check] drains both monitors and
-   the expectations and compares them in order, so a missing, extra, reordered, or
-   mistimed item is a failure reported through [Fixture.check].
-
-   A scenario opts in through [run] or by calling [check]. Scenarios with early selections
-   do not: the serial monitor classifies those by the host-side rule rather than the
-   loader's (docs/serial_host_pilot.md, SP2 deviations).
-*)
-
-open! Core
-module Wire = Protemu_host_link_wire.Wire
-module Serial_host = Protemu_serial_host_agent
-module Control_port_agent = Protemu_control_port_agent
-module Observed = Serial_host.Item.Observed
-module Read = Serial_host.Item.Read
-module Request = Control_port_agent.Item.Request
-module Offer = Control_port_agent.Item.Offer
-module Response = Control_port_agent.Item.Response
-
-(* Expected items, oldest first. *)
-type t =
-  { serial : Observed.t Queue.t
-  ; offers : Offer.t Queue.t
-  ; responses : Response.t Queue.t
-  }
-
-let create () =
-  { serial = Queue.create (); offers = Queue.create (); responses = Queue.create () }
-;;
-
-(* A request frame of [bytes], clocked from the cycle LSEL_N fell ([selected]) to the
-   cycle it rose ([deselected]). [extra_bits] are the bits of a final partial byte.
-*)
-let request t ?(extra_bits = []) ~selected ~deselected bytes =
-  Queue.enqueue t.serial (Request { selected; deselected; bytes; extra_bits })
-;;
-
-(* The monitor decodes without a correlation, so a driver-side mismatch is the response it
-   carries.
-*)
-let uncorrelated = function
-  | Error (Wire.Response.Decode_error.Correlation_mismatch { response; _ }) -> Ok response
-  | decoded -> decoded
-;;
-
-(* A complete response read that the driver returned as [read]. [selected] is the cycle
-   LSEL_N fell, which the scenario records before calling the driver; [Read.selected]
-   counts from after the select lead.
-*)
-let read t ~selected (read : Read.t) =
-  Queue.enqueue
-    t.serial
-    (Response
-       { selected
-       ; deselected = read.deselected
-       ; bytes = read.bytes
-       ; extra_bits = []
-       ; decoded = uncorrelated read.decoded
-       ; ending =
-           (match read.outcome with
-            | Commit -> Commit
-            | Replay -> Replay)
-       })
-;;
-
-(* A response read the driver abandoned before its final bit, as [Driver.read_prefix]
-   reports it: [bits] bits read, packed MSB first with a final partial byte in the low
-   bits of [packed]. [selected] is the cycle LSEL_N fell, which the scenario records
-   before the read; [deselected] is the cycle the driver raised it. The whole bytes and
-   the bits of the partial byte are split as the monitor holds them, and [decoded] is
-   [Wire.Response.decode] of the whole bytes. A [packed] of the wrong length for [bits] is
-   a bug in the test.
-*)
-let abandoned t ~selected ~deselected ~bits packed =
-  let whole = bits / 8 in
-  let partial = bits % 8 in
-  if String.length packed <> whole + Bool.to_int (partial > 0)
-  then
-    raise_s
-      [%message
-        "abandoned read: packed bits do not match the bit count"
-          (bits : int)
-          ~packed:(Serial_host.Item.hex packed : string)];
-  let bytes = String.prefix packed whole in
-  let extra_bits =
-    if partial = 0
-    then []
-    else List.drop (Serial_host.Item.bits_of_byte packed.[whole]) (8 - partial)
-  in
-  Queue.enqueue
-    t.serial
-    (Response
-       { selected
-       ; deselected
-       ; bytes
-       ; extra_bits
-       ; decoded = Wire.Response.decode bytes
-       ; ending = Abandoned
-       })
-;;
-
-(* [request] offered [Latency.offer_after_deselect] cycles after the deselection of its
-   frame, with decision [accepted]. Returns the predicted offer cycle.
-*)
-let offer t ~deselected request ~accepted =
-  let cycle = deselected + Latency.offer_after_deselect in
-  Queue.enqueue t.offers { cycle; request; accepted };
-  cycle
-;;
-
-(* A READBACK response pulse [Latency.readback_after_offer] cycles after the accepted
-   offer in cycle [offered].
-*)
-let readback t ~offered ~data ~matches =
-  Queue.enqueue
-    t.responses
-    { cycle = offered + Latency.readback_after_offer; data; matches }
-;;
-
-(* Serial items with bytes in hex, for reports. *)
-let sexp_of_serial_item : Observed.t -> Sexp.t = function
-  | Request { selected; deselected; bytes; extra_bits } ->
-    [%message
-      "request"
-        (selected : int)
-        (deselected : int)
-        ~bytes:(Serial_host.Item.hex bytes : string)
-        (extra_bits : bool list)]
-  | Response { selected; deselected; bytes; extra_bits; decoded; ending } ->
-    [%message
-      "response"
-        (selected : int)
-        (deselected : int)
-        ~bytes:(Serial_host.Item.hex bytes : string)
-        (extra_bits : bool list)
-        (decoded : (Wire.Response.t, Wire.Response.Decode_error.t) Result.t)
-        (ending : Observed.Ending.t)]
-;;
-
-let drain queue =
-  let items = Queue.to_list queue in
-  Queue.clear queue;
-  items
-;;
-
-(* Drains both monitors and every expectation, then compares, in this order: serial items,
-   offers, READBACK responses. The first disagreement fails at [Post_run].
-*)
-let check t fixture =
-  let serial = drain (Fixture.serial_observed fixture) in
-  let port = drain (Fixture.control_port_observed fixture) in
-  Fixture.check
-    fixture
-    ~phase:Post_run
-    "the serial monitor saw the driver's frames and reads"
-    [%sexp_of: serial_item list]
-    [%equal: Observed.t list]
-    ~expected:(drain t.serial)
-    serial;
-  Fixture.check
-    fixture
-    ~phase:Post_run
-    "the Control_port monitor saw the predicted offers"
-    [%sexp_of: Offer.t list]
-    [%equal: Offer.t list]
-    ~expected:(drain t.offers)
-    (List.filter_map port ~f:Control_port_agent.Item.Observed.offer);
-  Fixture.check
-    fixture
-    ~phase:Post_run
-    "the Control_port monitor saw the predicted READBACK responses"
-    [%sexp_of: Response.t list]
-    [%equal: Response.t list]
-    ~expected:(drain t.responses)
-    (List.filter_map port ~f:Control_port_agent.Item.Observed.response)
-;;
-
-(* [Fixture.run] with a fresh scoreboard, checked when [f] returns. A scenario that raises
-   is reported by its own failure, not the scoreboard's.
-*)
-let run ?timing ?transcript_limit ~scenario f =
-  Fixture.run ?timing ?transcript_limit ~scenario (fun fixture ->
-    let t = create () in
-    let result = f fixture t in
-    check t fixture;
-    result)
-;;
diff --git a/test/host_link/frame_rx/dune b/test/host_link/frame_rx/dune
deleted file mode 100644
index 4ef50b0..0000000
--- a/test/host_link/frame_rx/dune
+++ /dev/null
@@ -1,27 +0,0 @@
-; HL4c focused Cyclesim tests for Frame_rx (host_link_migration.md, HL4b2).
-;
-; The receiver is driven through its public ports with explicit PHY-level observations
-; and events, and checked against hand-written results, fields, and cycles. The HL4a
-; loader harness in the parent directory stays the acceptance baseline for the composed
-; loader; this suite does not replace it.
-
-(library
- (name protemu_frame_rx_tests)
- (wrapped false)
- (modules
-  frame_rx_testbench
-  frame_rx_receive_tests
-  frame_rx_validation_tests
-  frame_rx_lifecycle_tests
-  frame_rx_diagnostics_tests)
- ; Keep the ppx_expect source-tree workaround described in test/common/dune.
- (inline_tests
-  (flags
-   (:standard -source-tree-root .)))
- (libraries core hardcaml hardcaml_protemu protemu_host_link_wire)
- (preprocess
-  (pps ppx_hardcaml ppx_jane))
- (lint
-  (pps ppx_js_style))
- (flags
-  (:standard -w -27-57-33-34-35-40-63-47-26)))
diff --git a/test/host_link/frame_rx/frame_rx_diagnostics_tests.ml b/test/host_link/frame_rx/frame_rx_diagnostics_tests.ml
deleted file mode 100644
index 2d2fb33..0000000
--- a/test/host_link/frame_rx/frame_rx_diagnostics_tests.ml
+++ /dev/null
@@ -1,104 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_rx_diagnostics_tests.ml" *)
-(* HL4c: the Frame_rx checks detect the errors they exist for, and report enough to
-   reproduce them.
-
-   Each case states an expectation that is wrong, or waits for something that never
-   happens, and requires the check to raise [Rx_failure]. None of them changes the
-   receiver or leaves a failing test in the suite. The first case prints a complete
-   report, so its format is reviewed here.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_rx_testbench
-
-let require_failure t what f =
-  match failure_of f with
-  | Some failure -> failure
-  | None -> fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-let%expect_test "a wrong validation result is reported with the recent cycles" =
-  let t = create ~transcript_cycles:4 "negative: bad CRC expected to be complete" in
-  let frame = Raw.flip_last (encode ~tag:0x5e Stop) ~mask:0x01 in
-  print_s
-    (require_failure t "a CRC error reported as complete" (fun () ->
-       expect_handoff
-         t
-         "STOP"
-         frame
-         { result = Complete
-         ; echo_valid = true
-         ; tag = 0x5e
-         ; command = 0x21
-         ; payload_length = 0
-         ; payload = Char.to_int frame.[6]
-         }));
-  [%expect
-    {|
-    (test/host_link/frame_rx/frame_rx_testbench.ml.Rx_failure
-     (scenario "negative: bad CRC expected to be complete") (cycle 462)
-     (phase Pre_edge) (what "STOP: result, echo, and retained fields")
-     (expected
-      ((((result Complete) (echo_valid true) (tag 94) (command 33)
-         (payload_length 0) (payload 121)))))
-     (actual
-      ((((result Bad_crc) (echo_valid true) (tag 94) (command 33)
-         (payload_length 0) (payload 121)))))
-     (transcript
-      ((460 "rst=0 en=1 elig=1 sel=1 data=0"
-        "active result=13 echo=1 tag=5e command=21 length=0000 payload=00000079")
-       (461 "rst=0 en=1 elig=1 sel=1 data=0"
-        "active result=13 echo=1 tag=5e command=21 length=0000 payload=00000079")
-       (462 "rst=0 en=1 elig=1 sel=0 data=0 release"
-        "active FRAME_END result=13 echo=1 tag=5e command=21 length=0000 payload=00000079")
-       (463 "rst=0 en=1 elig=1 sel=0 data=0"
-        "result=13 echo=1 tag=5e command=21 length=0000 payload=00000079"))))
-    |}]
-;;
-
-let%test_unit "a handoff expected one cycle late is detected" =
-  (* Stands in for a registered handoff between validation and dispatch. *)
-  let t = create "negative: handoff one cycle late" in
-  let from = t.cycle in
-  let { Selection.released; _ } = request t (encode ~tag:0x01 Info) in
-  run t 2;
-  ignore
-    (require_failure t "a one-cycle-late handoff" (fun () ->
-       expect_frame_end_cycles t ~from "late" [ released + 1 ])
-     : Sexp.t)
-;;
-
-let%test_unit "an echo expected below the four-byte threshold is detected" =
-  (* Stands in for a threshold of three bytes. *)
-  let t = create "negative: echo after three bytes" in
-  let { Selection.released; _ } = request t (String.prefix (encode ~tag:0x02 Info) 3) in
-  run t 1;
-  ignore
-    (require_failure t "an echo after three bytes" (fun () ->
-       expect_fields
-         t
-         ~cycle:released
-         "three bytes"
-         { (Expected.empty Incomplete) with echo_valid = true; tag = 0x02 })
-     : Sexp.t)
-;;
-
-let%test_unit "waits are bounded and time out with a report" =
-  let t = create "negative: wait budget" in
-  let start = t.cycle in
-  ignore
-    (require_failure t "a wait for a request that never starts" (fun () ->
-       ignore (wait_for ~budget:25 t "active" ~f:(fun s -> s.active) : int))
-     : Sexp.t);
-  check
-    t
-    ~phase:Post_run
-    "cycles spent by the exhausted wait"
-    [%sexp_of: int]
-    [%equal: int]
-    ~expected:25
-    (t.cycle - start)
-;;
diff --git a/test/host_link/frame_rx/frame_rx_lifecycle_tests.ml b/test/host_link/frame_rx/frame_rx_lifecycle_tests.ml
deleted file mode 100644
index aa074dd..0000000
--- a/test/host_link/frame_rx/frame_rx_lifecycle_tests.ml
+++ /dev/null
@@ -1,299 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_rx_lifecycle_tests.ml" *)
-(* HL4c: [Frame_rx]'s eligibility, retention, and cancellation.
-
-   In the composed loader, eligibility is low from the cycle after a handoff until the
-   response is committed: the handoff's edge sets dispatch or a retained response, and
-   each wait ends in a retained response. These tests drive that pattern directly. Reset
-   and disable are applied for one cycle at each meaningful point of a request.
-
-   Tests named "robustness" drive combinations the loader or the PHY does not present in
-   normal traffic; each says why.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_rx_testbench
-
-let info tag = encode ~tag Info
-let write tag = encode ~tag (Write_word { address = 0x0010; word = 0x1234 })
-
-let complete_info tag : Expected.t =
-  { result = Complete
-  ; echo_valid = true
-  ; tag
-  ; command = 0x00
-  ; payload_length = 0
-  ; payload = Char.to_int (info tag).[6]
-  }
-;;
-
-let complete_write tag : Expected.t =
-  { result = Complete
-  ; echo_valid = true
-  ; tag
-  ; command = 0x11
-  ; payload_length = 4
-  ; payload = 0x12340010
-  }
-;;
-
-let%test_unit "a handed-off request's fields hold while ineligible, through intruding \
-               selections"
-  =
-  let t = create "retention while ineligible" in
-  let { Selection.released; _ } = request t (write 0x42) in
-  (* The loader's dispatch makes the receiver ineligible from the next cycle. *)
-  set t ~eligible:false;
-  let from = released + 1 in
-  (* An early selection in the dispatch cycle itself, carrying a complete frame; then an
-     overrunning one, an empty one, and a long idle interval.
-  *)
-  ignore (request ~lead:1 t (info 0x99) : Selection.t);
-  run t 20;
-  ignore (request t (Raw.zeros 12) : Selection.t);
-  ignore (request t "" : Selection.t);
-  run t 5000;
-  let until = t.cycle in
-  expect_frame_end_cycles t ~from "intruders" [];
-  expect_active_cycles t ~from "intruders" [];
-  expect_stable t ~from ~until "retained fields";
-  expect_fields t ~cycle:(until - 1) "retained fields" (complete_write 0x42);
-  (* Commit makes it eligible again; the next selection is a new request. *)
-  set t ~eligible:true;
-  run t 4;
-  expect_handoff t "next request" (info 0x77) (complete_info 0x77)
-;;
-
-let%test_unit "eligibility is sampled only in the select-assert cycle" =
-  let t = create "eligibility edges" in
-  expect_handoff t "first" (write 0x10) (complete_write 0x10);
-  (* Ineligible in the assert cycle, eligible from the next: the selection is ignored
-     until it ends, and the retained fields do not change.
-  *)
-  set t ~eligible:false;
-  run t 5;
-  let from = t.cycle in
-  ignore (select t : int);
-  set t ~eligible:true;
-  run t 3;
-  send t (info 0x11);
-  run t 8;
-  let released = deselect t in
-  run t 1;
-  expect_frame_end_cycles t ~from "eligible one cycle late" [];
-  expect_active_cycles t ~from "eligible one cycle late" [];
-  expect_fields t ~cycle:released "eligible one cycle late" (complete_write 0x10);
-  (* Eligible from the assert cycle itself, after a long ineligible interval. *)
-  set t ~eligible:false;
-  run t 20;
-  set t ~eligible:true;
-  expect_handoff t "eligible in the assert cycle" (info 0x12) (complete_info 0x12)
-;;
-
-let%test_unit "robustness: eligibility falling after the assert does not end a request" =
-  (* The loader cannot do this: nothing sets its dispatch or response state while a
-     request is active. The receiver still keeps the request it started.
-  *)
-  let t = create "eligible only at the assert" in
-  let from = t.cycle in
-  let asserted = select t in
-  set t ~eligible:false;
-  run t 3;
-  send t (write 0x13);
-  run t 8;
-  let released = deselect t in
-  run t 1;
-  expect_frame_end_cycles t ~from "eligible only at the assert" [ released ];
-  expect_active_cycles
-    t
-    ~from
-    "eligible only at the assert"
-    (List.range (asserted + 1) (released + 1));
-  expect_fields t ~cycle:released "eligible only at the assert" (complete_write 0x13)
-;;
-
-(* Where in a request a one-cycle reset or disable lands. *)
-module Point = struct
-  type t =
-    | After_bits of int
-    | Release
-  [@@deriving sexp_of]
-end
-
-let%test_unit "reset and disable cancel at every receive and validation boundary" =
-  let frame = write 0x71 in
-  let bits = bits_of_string frame in
-  List.iter [ `Reset; `Disable ] ~f:(fun kind ->
-    List.iter
-      [ "mid-byte", Point.After_bits ((8 * 5) + 3)
-      ; "after the header", After_bits 48
-      ; "after the whole frame", After_bits 88
-      ; "in the release cycle", Release
-      ]
-      ~f:(fun (where, point) ->
-        let name =
-          sprintf
-            "%s %s"
-            (match kind with
-             | `Reset -> "reset"
-             | `Disable -> "disable")
-            where
-        in
-        let t = create name in
-        let cancel on =
-          match kind with
-          | `Reset -> set t ~reset:on
-          | `Disable -> set t ~enable:(not on)
-        in
-        let from = t.cycle in
-        let asserted = select t in
-        run t 3;
-        (match point with
-         | After_bits count ->
-           send_bits t (List.take bits count);
-           let cancelled = t.cycle in
-           cancel true;
-           cycle t;
-           cancel false;
-           (* The rest of the frame, still selected, is not a request. *)
-           send_bits t (List.drop bits count);
-           run t 8;
-           ignore (deselect t : int);
-           run t 1;
-           expect_frame_end_cycles t ~from name [];
-           expect_active_cycles t ~from name (List.range (asserted + 1) (cancelled + 1));
-           expect_fields t ~cycle:(cancelled + 1) name (Expected.empty Incomplete);
-           expect_stable t ~from:(cancelled + 1) ~until:t.cycle name
-         | Release ->
-           send_bits t bits;
-           run t 8;
-           cancel true;
-           let released = deselect t in
-           cancel false;
-           run t 1;
-           (* The handoff is presented, ungated, in the cancelled cycle; the loader's own
-              reset or disable clears the dispatch it would arm. The state is gone after.
-           *)
-           expect_frame_end_cycles t ~from name [ released ];
-           expect_active_cycles t ~from name (List.range (asserted + 1) (released + 1));
-           expect_fields t ~cycle:released name (complete_write 0x71);
-           expect_fields t ~cycle:(released + 1) name (Expected.empty Incomplete));
-        (* No stale state: a later request is received normally. *)
-        run t 4;
-        expect_handoff t (name ^ ", then INFO") (info 0x72) (complete_info 0x72)))
-;;
-
-let%test_unit "reset or disable held across an assert prevents that request" =
-  List.iter [ `Reset; `Disable ] ~f:(fun kind ->
-    let name =
-      match kind with
-      | `Reset -> "reset"
-      | `Disable -> "disable"
-    in
-    let t = create (name ^ " across an assert") in
-    expect_handoff t "first" (write 0x20) (complete_write 0x20);
-    let cancel on =
-      match kind with
-      | `Reset -> set t ~reset:on
-      | `Disable -> set t ~enable:(not on)
-    in
-    let from = t.cycle in
-    cancel true;
-    run t 3;
-    ignore (select t : int);
-    run t 3;
-    cancel false;
-    send t (info 0x21);
-    run t 8;
-    let released = deselect t in
-    run t 1;
-    expect_frame_end_cycles t ~from name [];
-    expect_active_cycles t ~from name [];
-    (* The cancellation also cleared the first request's retained fields. *)
-    expect_fields t ~cycle:released name (Expected.empty Incomplete);
-    expect_handoff t (name ^ ", then INFO") (info 0x22) (complete_info 0x22))
-;;
-
-let%test_unit "disable clears a latched overrun before the frame ends" =
-  let t = create "disable after overrun" in
-  let from = t.cycle in
-  ignore (select t : int);
-  run t 3;
-  send t (Raw.zeros 12);
-  set t ~enable:false;
-  cycle t;
-  set t ~enable:true;
-  send t (info 0x30);
-  run t 8;
-  let released = deselect t in
-  run t 1;
-  expect_frame_end_cycles t ~from "disable after overrun" [];
-  expect_fields t ~cycle:released "disable after overrun" (Expected.empty Incomplete);
-  expect_handoff t "INFO after" (info 0x31) (complete_info 0x31)
-;;
-
-let%test_unit "clock rises while deselected and idle change nothing" =
-  (* The PHY reports LCLK edges whether or not LSEL_N is low. *)
-  let t = create "rises while deselected" in
-  expect_handoff t "first" (write 0x40) (complete_write 0x40);
-  let from = t.cycle in
-  List.iter (List.init 50 ~f:(fun index -> index % 3 = 0)) ~f:(send_bit ~period:2 t);
-  expect_frame_end_cycles t ~from "rises while deselected" [];
-  expect_active_cycles t ~from "rises while deselected" [];
-  expect_stable t ~from ~until:t.cycle "rises while deselected"
-;;
-
-let%test_unit "robustness: a clock rise coincident with the assert or the release is not \
-               received"
-  =
-  (* [Serial_phy] can report these together, but the P3.5 envelope keeps four cycles
-     between selection and the first rise, and between the last fall and deselection. Were
-     either rise received, the frame would end with a partial byte.
-  *)
-  let t = create "coincident events" in
-  let from = t.cycle in
-  let asserted = t.cycle in
-  set t ~selected:true ~data:true;
-  pulse t ~select_assert:true ~clock_rise:true;
-  cycle t;
-  run t 3;
-  send t (info 0x50);
-  run t 8;
-  let released = t.cycle in
-  set t ~selected:false ~data:true;
-  pulse t ~select_release:true ~clock_rise:true;
-  cycle t;
-  run t 1;
-  expect_frame_end_cycles t ~from "coincident events" [ released ];
-  expect_active_cycles
-    t
-    ~from
-    "coincident events"
-    (List.range (asserted + 1) (released + 1));
-  expect_fields t ~cycle:released "coincident events" (complete_info 0x50)
-;;
-
-let%test_unit "robustness: a second assert while active does not restart the request" =
-  (* Incoherent input: the PHY cannot report an assert without a release between. *)
-  let t = create "repeated assert" in
-  let frame = info 0x60 in
-  let from = t.cycle in
-  let asserted = select t in
-  run t 3;
-  send t (String.prefix frame 3);
-  pulse t ~select_assert:true;
-  cycle t;
-  send t (String.drop_prefix frame 3);
-  run t 8;
-  let released = deselect t in
-  run t 1;
-  expect_frame_end_cycles t ~from "repeated assert" [ released ];
-  expect_active_cycles
-    t
-    ~from
-    "repeated assert"
-    (List.range (asserted + 1) (released + 1));
-  expect_fields t ~cycle:released "repeated assert" (complete_info 0x60)
-;;
diff --git a/test/host_link/frame_rx/frame_rx_receive_tests.ml b/test/host_link/frame_rx/frame_rx_receive_tests.ml
deleted file mode 100644
index dba3dfb..0000000
--- a/test/host_link/frame_rx/frame_rx_receive_tests.ml
+++ /dev/null
@@ -1,138 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_rx_receive_tests.ml" *)
-(* HL4c: legal requests at [Frame_rx]'s boundary.
-
-   Every legal command is received with its exact retained fields and handed off once, in
-   its release cycle. Expected fields are written literally from the P3.5 request layout.
-   The payload output is positional: it holds whatever arrived at bytes 6 to 9,
-   little-endian, so after a shorter payload it also holds the CRC byte. The expected
-   values below spell those bytes out.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_rx_testbench
-
-(* Little-endian bytes 6 to 9 of what was sent. Used where a CRC byte lands in the payload
-   positions; the tests with a four-byte payload write the value literally.
-*)
-let positional_payload bytes =
-  List.range 6 (Int.min 10 (String.length bytes))
-  |> List.foldi ~init:0 ~f:(fun index acc position ->
-    acc lor (Char.to_int bytes.[position] lsl (8 * index)))
-;;
-
-let complete ~tag ~command ~payload_length ~payload : Expected.t =
-  { result = Complete; echo_valid = true; tag; command; payload_length; payload }
-;;
-
-let%test_unit "every legal request is received with its exact fields and handed off once \
-               at deselection"
-  =
-  let t = create "legal requests" in
-  (* Request, tag, command byte, declared length, and a literal payload where all four
-     payload bytes are payload. The write comes first, so the INFO after it shows that a
-     new request starts from cleared fields.
-  *)
-  let cases : (Wire.Request.t * int * int * int * int option) list =
-    [ Write_word { address = 0x80fe; word = 0x7f01 }, 0xff, 0x11, 4, Some 0x7f0180fe
-    ; Info, 0x01, 0x00, 0, None
-    ; Read_word { address = 0x00ff }, 0x05, 0x12, 2, None
-    ; Verify_word { address = 0x0102; expected = 0xa55a }, 0x06, 0x13, 4, Some 0xa55a0102
-    ; Status, 0x80, 0x01, 0, None
-    ; Load_start { length = 0x0102 }, 0x03, 0x10, 2, None
-    ; Load_complete, 0x07, 0x14, 0, None
-    ; Run, 0x00, 0x20, 0, None
-    ; Stop, 0x5a, 0x21, 0, None
-    ; Abort, 0xa5, 0x22, 0, None
-    ]
-  in
-  List.iter cases ~f:(fun (request, tag, command, payload_length, payload) ->
-    let bytes = encode ~tag request in
-    (* Four-byte payloads make the eleven-byte maximum frame. *)
-    check
-      t
-      ~phase:Post_run
-      "frame length"
-      [%sexp_of: int]
-      [%equal: int]
-      ~expected:(7 + payload_length)
-      (String.length bytes);
-    let payload = Option.value payload ~default:(positional_payload bytes) in
-    expect_handoff
-      t
-      (Sexp.to_string [%sexp (request : Wire.Request.t)])
-      bytes
-      (complete ~tag ~command ~payload_length ~payload);
-    run t 4)
-;;
-
-let%test_unit "the short payloads keep their operands in the low bytes" =
-  (* Written out for the two-byte payloads: the operand in bytes 6-7 and the CRC in 8. *)
-  let t = create "short payloads" in
-  let bytes = encode ~tag:0x10 (Load_start { length = 0x0102 }) in
-  let crc = Char.to_int bytes.[8] in
-  expect_handoff
-    t
-    "LOAD_START"
-    bytes
-    (complete
-       ~tag:0x10
-       ~command:0x10
-       ~payload_length:2
-       ~payload:((crc lsl 16) lor 0x0102));
-  let bytes = encode ~tag:0x11 Info in
-  let crc = Char.to_int bytes.[6] in
-  expect_handoff
-    t
-    "INFO"
-    bytes
-    (complete ~tag:0x11 ~command:0x00 ~payload_length:0 ~payload:crc)
-;;
-
-let%test_unit "each byte is assembled most significant bit first from the data level in \
-               the clock-rise cycle only"
-  =
-  (* [send_bit] drives the complement of each bit in every other cycle, so only a sample
-     in the rise cycle yields the frame. Asymmetric bytes distinguish MSB-first from
-     LSB-first and little-endian from big-endian assembly.
-  *)
-  let write = Wire.Request.Write_word { address = 0x8001; word = 0x0f70 } in
-  List.iter [ 2; 3; 8; 37 ] ~f:(fun period ->
-    let t = create (sprintf "bit order, period %d" period) in
-    expect_handoff
-      t
-      "WRITE"
-      ~period
-      (encode ~tag:0x01 write)
-      (complete ~tag:0x01 ~command:0x11 ~payload_length:4 ~payload:0x0f708001))
-;;
-
-let%test_unit "a selected request may pause for a long finite time and resume without \
-               losing state"
-  =
-  let t = create "selected pauses" in
-  let bytes = encode ~tag:0x5c (Verify_word { address = 0x00fe; expected = 0x1234 }) in
-  let pause = 10_000 in
-  let from = t.cycle in
-  let asserted = select t in
-  run t pause;
-  (* Pauses within a byte (after bit 3 of byte 2) and between bytes (after bytes 5 and 9,
-     counting from 0), with the data level held at the complement of the last bit.
-  *)
-  let pause_after = [ (8 * 2) + 3; (8 * 6) - 1; (8 * 10) - 1 ] in
-  List.iteri (bits_of_string bytes) ~f:(fun index bit ->
-    send_bit t bit;
-    if List.mem pause_after index ~equal:Int.equal then run t pause);
-  run t pause;
-  let released = deselect t in
-  run t 1;
-  expect_frame_end_cycles t ~from "paused" [ released ];
-  expect_active_cycles t ~from "paused" (List.range (asserted + 1) (released + 1));
-  expect_fields
-    t
-    ~cycle:released
-    "paused"
-    (complete ~tag:0x5c ~command:0x13 ~payload_length:4 ~payload:0x123400fe)
-;;
diff --git a/test/host_link/frame_rx/frame_rx_testbench.ml b/test/host_link/frame_rx/frame_rx_testbench.ml
deleted file mode 100644
index 771c8d1..0000000
--- a/test/host_link/frame_rx/frame_rx_testbench.ml
+++ /dev/null
@@ -1,542 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_rx_testbench.ml" *)
-(* HL4c focused Cyclesim testbench for [Frame_rx].
-
-   The receiver is driven only through its public ports, with explicit PHY-level
-   observations: the synchronized selection and data levels and the one-cycle
-   select-assert, select-release, and clock-rise events that [Serial_phy] produces. The
-   PHY's synchronizers are not part of this boundary. Every observation is a public
-   output. Expected results, fields, and cycles are written by hand in the tests from the
-   P3.5 record and docs/host_link_hl4b2_record.md; none is computed from the receiver.
-   [Wire.Request.encode] and [Wire.Crc.compute] build stimulus only.
-
-   Scheduling contract:
-
-   1. Time. The unit is one system clock cycle. Cycle n is the interval before edge n.
-      Inputs set before [cycle] runs cycle n are applied for the whole of cycle n and
-      sampled at edge n. [cycle] is the only function that advances the simulator.
-   2. Levels ([reset], [enable], [eligible], [selected], [data]) keep their value until a
-      test changes them. Events ([select_assert], [select_release], [clock_rise]) last one
-      cycle: [cycle] clears them after the edge.
-   3. Within a cycle: apply the inputs; settle; take the pre-edge sample (the observation
-      for cycle n); clock the edge; take the post-edge sample.
-   4. Every output except [frame_end_o] is a function of the receiver's registers. For
-      those, the post-edge sample of edge n (taken with cycle n's inputs) must equal the
-      pre-edge sample of cycle n+1 (taken after its new inputs settle), and [cycle] checks
-      this every cycle. [frame_end_o] is combinational in [select_release_i] by design:
-      the handoff has no register.
-   5. Every wait has a finite cycle budget. An exhausted budget or a failed check raises
-      [Rx_failure] with the scenario, cycle, sampling phase, what was checked, the
-      expected and actual values, and the inputs and outputs of recent cycles.
-
-   PHY-coherent stimulus (the default drivers) follows what [Serial_phy] can present: an
-   assert event with the selected level rising, a release event with it falling, and clock
-   rises at least two cycles apart. Probes outside that, or outside the P3.5 host
-   envelope, are labelled as robustness probes in the tests. Everything here is
-   synchronous digital evidence about this block's boundary.
-*)
-
-open! Core
-open! Hardcaml
-open! Hardcaml_protemu
-module Wire = Protemu_host_link_wire.Wire
-module Sim = Cyclesim.With_interface (Frame_rx.I) (Frame_rx.O)
-
-(* The inputs applied for one cycle. *)
-module Inputs = struct
-  type t =
-    { reset : bool
-    ; enable : bool
-    ; eligible : bool
-    ; selected : bool
-    ; data : bool
-    ; select_assert : bool
-    ; select_release : bool
-    ; clock_rise : bool
-    }
-  [@@deriving sexp_of, equal]
-
-  let idle =
-    { reset = false
-    ; enable = true
-    ; eligible = true
-    ; selected = false
-    ; data = false
-    ; select_assert = false
-    ; select_release = false
-    ; clock_rise = false
-    }
-  ;;
-
-  let clear_events t =
-    { t with select_assert = false; select_release = false; clock_rise = false }
-  ;;
-
-  let summary t =
-    let bit b = if b then 1 else 0 in
-    let events =
-      List.filter_map
-        [ t.select_assert, "assert"; t.select_release, "release"; t.clock_rise, "rise" ]
-        ~f:(fun (on, name) -> Option.some_if on name)
-    in
-    sprintf
-      "rst=%d en=%d elig=%d sel=%d data=%d%s"
-      (bit t.reset)
-      (bit t.enable)
-      (bit t.eligible)
-      (bit t.selected)
-      (bit t.data)
-      (if List.is_empty events then "" else " " ^ String.concat ~sep:"," events)
-  ;;
-end
-
-(* One sample of every output. *)
-module Sample = struct
-  type t =
-    { active : bool
-    ; frame_end : bool
-    ; result : int
-    ; echo_valid : bool
-    ; tag : int
-    ; command : int
-    ; payload_length : int
-    ; payload : int
-    }
-  [@@deriving sexp_of, equal]
-
-  let of_outputs (o : Bits.t ref Frame_rx.O.t) =
-    let bool r = Bits.to_bool !r in
-    let int r = Bits.to_int_trunc !r in
-    { active = bool o.active_o
-    ; frame_end = bool o.frame_end_o
-    ; result = int o.result_o
-    ; echo_valid = bool o.echo_valid_o
-    ; tag = int o.tag_o
-    ; command = int o.command_o
-    ; payload_length = int o.payload_length_o
-    ; payload = int o.payload_o
-    }
-  ;;
-
-  (* The outputs that depend only on registers; see item 4 of the contract. *)
-  let registered t = { t with frame_end = false }
-
-  let summary t =
-    sprintf
-      "%s%sresult=%02x echo=%d tag=%02x command=%02x length=%04x payload=%08x"
-      (if t.active then "active " else "")
-      (if t.frame_end then "FRAME_END " else "")
-      t.result
-      (if t.echo_valid then 1 else 0)
-      t.tag
-      t.command
-      t.payload_length
-      t.payload
-  ;;
-end
-
-module Phase = struct
-  type t =
-    | Pre_edge (* the observation of a cycle, before its edge *)
-    | Post_edge (* after an edge, with that cycle's inputs still applied *)
-    | Post_run (* a check made by the test between cycles *)
-  [@@deriving sexp_of]
-end
-
-type t =
-  { scenario : string
-  ; sim : Sim.t
-  ; mutable inputs : Inputs.t (* applied to the next cycle *)
-  ; mutable cycle : int (* the next cycle to run *)
-  ; mutable settled : Sample.t option (* post-edge sample of the last edge *)
-  ; applied : Inputs.t Queue.t (* index = cycle *)
-  ; observed : Sample.t Queue.t (* pre-edge samples; index = cycle *)
-  ; transcript_cycles : int
-  }
-
-exception
-  Rx_failure of
-    { scenario : string
-    ; cycle : int
-    ; phase : Phase.t
-    ; what : string
-    ; expected : Sexp.t option
-    ; actual : Sexp.t option
-    ; transcript : Sexp.t
-    }
-[@@deriving sexp_of]
-
-(* The inputs and outputs of the last [transcript_cycles] cycles run. *)
-let transcript t =
-  let first = Int.max 0 (t.cycle - t.transcript_cycles) in
-  List.range first t.cycle
-  |> List.map ~f:(fun cycle ->
-    [%sexp
-      (cycle : int)
-      , (Inputs.summary (Queue.get t.applied cycle) : string)
-      , (Sample.summary (Queue.get t.observed cycle) : string)])
-  |> Sexp.List
-;;
-
-let fail t ?(cycle = t.cycle - 1) ?expected ?actual ~phase what =
-  raise
-    (Rx_failure
-       { scenario = t.scenario
-       ; cycle
-       ; phase
-       ; what
-       ; expected
-       ; actual
-       ; transcript = transcript t
-       })
-;;
-
-let check t ?cycle ~phase what sexp_of equal ~expected actual =
-  if not (equal expected actual)
-  then fail t ?cycle ~phase what ~expected:(sexp_of expected) ~actual:(sexp_of actual)
-;;
-
-(* The single owner of simulator advancement; see items 2 to 4 of the contract. *)
-let cycle t =
-  let i = Cyclesim.inputs t.sim in
-  let before = Cyclesim.outputs ~clock_edge:Before t.sim in
-  let after = Cyclesim.outputs ~clock_edge:After t.sim in
-  let set port value = port := Bits.of_bool value in
-  let inputs = t.inputs in
-  set i.reset_i inputs.reset;
-  set i.enable_i inputs.enable;
-  set i.eligible_i inputs.eligible;
-  set i.selected_i inputs.selected;
-  set i.data_i inputs.data;
-  set i.select_assert_i inputs.select_assert;
-  set i.select_release_i inputs.select_release;
-  set i.clock_rise_i inputs.clock_rise;
-  Cyclesim.cycle_check t.sim;
-  Cyclesim.cycle_before_clock_edge t.sim;
-  let observed = Sample.of_outputs before in
-  Queue.enqueue t.applied inputs;
-  Queue.enqueue t.observed observed;
-  Option.iter t.settled ~f:(fun settled ->
-    check
-      t
-      ~cycle:t.cycle
-      ~phase:Pre_edge
-      "registered outputs after the new inputs settle equal the last edge's post-edge \
-       outputs"
-      [%sexp_of: Sample.t]
-      [%equal: Sample.t]
-      ~expected:(Sample.registered settled)
-      (Sample.registered observed));
-  Cyclesim.cycle_at_clock_edge t.sim;
-  Cyclesim.cycle_after_clock_edge t.sim;
-  t.settled <- Some (Sample.of_outputs after);
-  t.inputs <- Inputs.clear_events inputs;
-  t.cycle <- t.cycle + 1
-;;
-
-let run t cycles =
-  for _ = 1 to cycles do
-    cycle t
-  done
-;;
-
-(* Set levels for the next cycle onward; unnamed levels keep their value. *)
-let set ?reset ?enable ?eligible ?selected ?data t =
-  let keep value current = Option.value value ~default:current in
-  t.inputs
-  <- { t.inputs with
-       reset = keep reset t.inputs.reset
-     ; enable = keep enable t.inputs.enable
-     ; eligible = keep eligible t.inputs.eligible
-     ; selected = keep selected t.inputs.selected
-     ; data = keep data t.inputs.data
-     }
-;;
-
-(* Raise events for the next cycle only. *)
-let pulse ?(select_assert = false) ?(select_release = false) ?(clock_rise = false) t =
-  t.inputs
-  <- { t.inputs with
-       select_assert = t.inputs.select_assert || select_assert
-     ; select_release = t.inputs.select_release || select_release
-     ; clock_rise = t.inputs.clock_rise || clock_rise
-     }
-;;
-
-(* Reset is high in cycles 0 and 1, with everything else idle and eligible. [create]
-   returns before running cycle 2, the first cycle out of reset.
-*)
-let reset_cycles = 2
-
-let create ?(transcript_cycles = 12) scenario =
-  let sim = Sim.create (Frame_rx.create (Scope.create ~flatten_design:true ())) in
-  let t =
-    { scenario
-    ; sim
-    ; inputs = { Inputs.idle with reset = true }
-    ; cycle = 0
-    ; settled = None
-    ; applied = Queue.create ()
-    ; observed = Queue.create ()
-    ; transcript_cycles
-    }
-  in
-  run t reset_cycles;
-  set t ~reset:false;
-  t
-;;
-
-(* The pre-edge observation of a cycle that has run. *)
-let observed t cycle =
-  if cycle < 0 || cycle >= t.cycle
-  then
-    fail
-      t
-      ~phase:Post_run
-      "observation of a cycle that has run"
-      ~actual:[%sexp { requested = (cycle : int); cycles_run = (t.cycle : int) }];
-  Queue.get t.observed cycle
-;;
-
-(* PHY-coherent drivers. Each runs whole cycles and returns the cycle of its event. *)
-
-(* An assert event with the selected level rising in the same cycle. *)
-let select t =
-  let at = t.cycle in
-  set t ~selected:true;
-  pulse t ~select_assert:true;
-  cycle t;
-  at
-;;
-
-(* A release event with the selected level falling in the same cycle. *)
-let deselect t =
-  let at = t.cycle in
-  set t ~selected:false;
-  pulse t ~select_release:true;
-  cycle t;
-  at
-;;
-
-(* One bit: a clock-rise cycle carrying [value] on the data level, then [period] - 1
-   cycles carrying its complement. Only the rise cycle's sample can produce [value], which
-   pins the sampling cycle. [Serial_phy] cannot present rises less than two cycles apart.
-*)
-let default_period = 8
-
-let send_bit ?(period = default_period) t value =
-  set t ~data:value;
-  pulse t ~clock_rise:true;
-  cycle t;
-  set t ~data:(not value);
-  run t (period - 1)
-;;
-
-(* Wire order: most significant bit first. *)
-let bits_of_byte byte = List.init 8 ~f:(fun index -> (byte lsr (7 - index)) land 1 = 1)
-
-let bits_of_string bytes =
-  List.concat_map (String.to_list bytes) ~f:(fun c -> bits_of_byte (Char.to_int c))
-;;
-
-let send_bits ?period t bits = List.iter bits ~f:(send_bit ?period t)
-let send ?period t bytes = send_bits ?period t (bits_of_string bytes)
-
-(* The event cycles of one complete selection. *)
-module Selection = struct
-  type t =
-    { asserted : int
-    ; released : int
-    }
-  [@@deriving sexp_of]
-end
-
-(* Select, wait [lead] cycles, send [bytes] and then [extra_bits], wait [trail] cycles,
-   and deselect. The defaults are close to the P3.5 four-cycle host envelope.
-*)
-let request ?(lead = 4) ?(trail = 8) ?period ?(extra_bits = []) t bytes =
-  let asserted = select t in
-  run t (lead - 1);
-  send ?period t bytes;
-  send_bits ?period t extra_bits;
-  run t trail;
-  let released = deselect t in
-  { Selection.asserted; released }
-;;
-
-(* A legal request's bytes; the encoder refuses nothing the tests pass it. *)
-let encode ~tag request =
-  Wire.Request.encode ~tag request |> Result.ok |> Option.value_exn
-;;
-
-(* Test-local frames the codec cannot build. *)
-module Raw = struct
-  let crc body = String.of_char (Char.of_int_exn (Wire.Crc.compute body))
-  let bytes list = String.of_char_list (List.map list ~f:Char.of_int_exn)
-
-  (* Header and payload with the declared length defaulting to the payload's. *)
-  let body ?(magic = 0xa5) ?(version = 0x10) ?payload_length ~tag ~command payload =
-    let payload_length = Option.value payload_length ~default:(List.length payload) in
-    bytes
-      ([ magic; version; tag; command; payload_length land 0xff; payload_length lsr 8 ]
-       @ payload)
-  ;;
-
-  (* Header, payload, and a correct CRC for them. *)
-  let frame ?magic ?version ?payload_length ~tag ~command payload =
-    let body = body ?magic ?version ?payload_length ~tag ~command payload in
-    body ^ crc body
-  ;;
-
-  let flip_last frame ~mask =
-    let last = String.length frame - 1 in
-    String.prefix frame last
-    ^ String.of_char (Char.of_int_exn (Char.to_int frame.[last] lxor mask))
-  ;;
-
-  let zeros count = String.make count '\x00'
-end
-
-(* What the receiver presents at a handoff. [result] is a [Wire.Result_code]. *)
-module Expected = struct
-  type t =
-    { result : Wire.Result_code.t
-    ; echo_valid : bool
-    ; tag : int
-    ; command : int
-    ; payload_length : int
-    ; payload : int
-    }
-  [@@deriving sexp_of, equal]
-
-  let of_sample (s : Sample.t) =
-    match Wire.Result_code.of_int s.result with
-    | None -> None
-    | Some result ->
-      Some
-        { result
-        ; echo_valid = s.echo_valid
-        ; tag = s.tag
-        ; command = s.command
-        ; payload_length = s.payload_length
-        ; payload = s.payload
-        }
-  ;;
-
-  (* A result with everything else zero: the state after a start, a disable, or a reset
-     with no byte received since.
-  *)
-  let empty result =
-    { result; echo_valid = false; tag = 0; command = 0; payload_length = 0; payload = 0 }
-  ;;
-end
-
-(* The presented validation and fields in a cycle that has run. *)
-let expect_fields t ~cycle what (expected : Expected.t) =
-  check
-    t
-    ~cycle
-    ~phase:Pre_edge
-    (what ^ ": result, echo, and retained fields")
-    [%sexp_of: Expected.t option]
-    [%equal: Expected.t option]
-    ~expected:(Some expected)
-    (Expected.of_sample (observed t cycle))
-;;
-
-(* Cycles in [from, until) in which a sampled flag was high. *)
-let high_cycles t ~from ~until ~f =
-  List.range from until |> List.filter ~f:(fun cycle -> f (observed t cycle))
-;;
-
-let expect_cycles t ~from ~until what ~f expected =
-  check
-    t
-    ~phase:Post_run
-    (sprintf "%s: high in cycles [%d, %d)" what from until)
-    [%sexp_of: int list]
-    [%equal: int list]
-    ~expected
-    (high_cycles t ~from ~until ~f)
-;;
-
-let expect_frame_end_cycles t ~from what expected =
-  expect_cycles
-    t
-    ~from
-    ~until:t.cycle
-    (what ^ ": frame_end_o")
-    ~f:(fun s -> s.frame_end)
-    expected
-;;
-
-let expect_active_cycles t ~from what expected =
-  expect_cycles
-    t
-    ~from
-    ~until:t.cycle
-    (what ^ ": active_o")
-    ~f:(fun s -> s.active)
-    expected
-;;
-
-(* The retained fields and validation are the same in every cycle of [from, until). *)
-let expect_stable t ~from ~until what =
-  let first = observed t from in
-  List.range from until
-  |> List.iter ~f:(fun cycle ->
-    check
-      t
-      ~cycle
-      ~phase:Pre_edge
-      (sprintf "%s: registered outputs unchanged since cycle %d" what from)
-      [%sexp_of: Sample.t]
-      [%equal: Sample.t]
-      ~expected:(Sample.registered first)
-      (Sample.registered (observed t cycle)))
-;;
-
-(* One complete selection that must hand off exactly once, in its release cycle, with
-   [expected]. The request is active from the cycle after the assert through the release
-   cycle, and inactive from the cycle after. Runs one cycle past the release.
-*)
-let expect_handoff ?lead ?trail ?period ?extra_bits t what bytes (expected : Expected.t) =
-  let from = t.cycle in
-  let { Selection.asserted; released } =
-    request ?lead ?trail ?period ?extra_bits t bytes
-  in
-  run t 1;
-  expect_frame_end_cycles t ~from what [ released ];
-  expect_active_cycles t ~from what (List.range (asserted + 1) (released + 1));
-  expect_fields t ~cycle:released what expected;
-  (* The handoff is presented again, unchanged, after the edge. *)
-  expect_fields t ~cycle:(released + 1) (what ^ " after the release edge") expected
-;;
-
-(* Run until [f] holds for a cycle's pre-edge sample and return that cycle. Raises after
-   [budget] cycles.
-*)
-let wait_for ?(budget = 100) t what ~f =
-  let rec loop spent =
-    if spent >= budget
-    then
-      fail
-        t
-        ~phase:Pre_edge
-        ("wait for " ^ what)
-        ~actual:[%sexp { budget_exhausted = (budget : int) }]
-    else (
-      cycle t;
-      let seen = t.cycle - 1 in
-      if f (observed t seen) then seen else loop (spent + 1))
-  in
-  loop 0
-;;
-
-(* [Some failure] when [f] raises [Rx_failure]. Used by the negative checks. *)
-let failure_of f =
-  match f () with
-  | (_ : unit) -> None
-  | exception (Rx_failure _ as failure) -> Some [%sexp (failure : exn)]
-;;
diff --git a/test/host_link/frame_rx/frame_rx_validation_tests.ml b/test/host_link/frame_rx/frame_rx_validation_tests.ml
deleted file mode 100644
index 3abedb3..0000000
--- a/test/host_link/frame_rx/frame_rx_validation_tests.ml
+++ /dev/null
@@ -1,488 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "frame_rx_validation_tests.ml" *)
-(* HL4c: [Frame_rx]'s deselect validation, byte bound, sticky overrun, and correlation.
-
-   Every expected result is written by hand from the P3.5 record's framing rules, not from
-   the receiver's expressions:
-
-   - a twelfth byte is overrun ([Bad_length]), and nothing later in that selection can
-     make the frame valid;
-   - otherwise a frame that is not whole bytes, or whose length is not the declared
-     payload length plus seven, is [Incomplete];
-   - otherwise magic, then version, then CRC are checked ([Bad_magic], [Bad_version],
-     [Bad_crc]);
-   - tag and command are echoed only when all four bytes through the command arrived.
-
-   Command legality, each command's fixed length, and device bounds are dispatch-stage
-   decisions in [Host_link]. Here such frames are [Complete] and the raw fields they
-   need are retained.
-
-   The receiver also maps a declared length above four to [Bad_length] after the header
-   checks. No frame reaches that branch: a whole-byte frame of length plus seven bytes has
-   at most eleven bytes, so its length is at most four, and a longer frame is overrun
-   first. Lengths five to eight are therefore tested through overrun.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Frame_rx_testbench
-
-(* The result, echo, tag, and command presented in the release cycle. *)
-let expect_result t ~released what ~result ~echo_valid ~tag ~command =
-  let s = observed t released in
-  check
-    t
-    ~cycle:released
-    ~phase:Pre_edge
-    (what ^ ": result, echo, tag, and command")
-    [%sexp_of: Wire.Result_code.t option * bool * int * int]
-    [%equal: Wire.Result_code.t option * bool * int * int]
-    ~expected:(Some result, echo_valid, tag, command)
-    (Wire.Result_code.of_int s.result, s.echo_valid, s.tag, s.command)
-;;
-
-(* One selection handing off once with the given result; checks only what is named. *)
-let expect_rejected ?extra_bits ?period t what bytes ~result ~echo_valid ~tag ~command =
-  let from = t.cycle in
-  let { Selection.released; _ } = request ?extra_bits ?period t bytes in
-  run t 1;
-  expect_frame_end_cycles t ~from what [ released ];
-  expect_result t ~released what ~result ~echo_valid ~tag ~command;
-  run t 4;
-  released
-;;
-
-let write = encode ~tag:0x33 (Write_word { address = 0x0102; word = 0x0304 })
-let info tag = encode ~tag Info
-
-let%test_unit "truncated header, payload, and CRC are incomplete; the echo needs four \
-               bytes"
-  =
-  let t = create "truncation" in
-  (* Bytes: a5 10 33 11 04 00 02 01 04 03 crc. *)
-  let expected =
-    [ 0, false, 0x00, 0x00, 0, 0x00000000
-    ; 1, false, 0x00, 0x00, 0, 0x00000000
-    ; 2, false, 0x00, 0x00, 0, 0x00000000
-    ; 3, false, 0x33, 0x00, 0, 0x00000000
-    ; 4, true, 0x33, 0x11, 0, 0x00000000
-    ; 5, true, 0x33, 0x11, 4, 0x00000000
-    ; 6, true, 0x33, 0x11, 4, 0x00000000
-    ; 7, true, 0x33, 0x11, 4, 0x00000002
-    ; 8, true, 0x33, 0x11, 4, 0x00000102
-    ; 9, true, 0x33, 0x11, 4, 0x00040102
-    ; 10, true, 0x33, 0x11, 4, 0x03040102
-    ]
-  in
-  List.iter expected ~f:(fun (count, echo_valid, tag, command, payload_length, payload) ->
-    let what = sprintf "first %d bytes of a WRITE" count in
-    let { Selection.released; _ } = request t (String.prefix write count) in
-    run t 1;
-    expect_fields
-      t
-      ~cycle:released
-      what
-      { result = Incomplete; echo_valid; tag; command; payload_length; payload };
-    run t 4)
-;;
-
-let%test_unit "a partial final byte is incomplete, whether extra or missing bits" =
-  let t = create "partial bytes" in
-  List.iter [ 1; 2; 3; 4; 5; 6; 7 ] ~f:(fun bits ->
-    ignore
-      (expect_rejected
-         t
-         (sprintf "INFO plus %d bits" bits)
-         (info 0x21)
-         ~extra_bits:(List.init bits ~f:(fun index -> index % 2 = 0))
-         ~result:Incomplete
-         ~echo_valid:true
-         ~tag:0x21
-         ~command:0x00
-       : int);
-    (* The same INFO with its CRC byte cut short by [bits]. *)
-    let frame = info 0x22 in
-    ignore
-      (expect_rejected
-         t
-         (sprintf "INFO missing its last %d bits" bits)
-         (String.prefix frame 6)
-         ~extra_bits:(List.take (bits_of_byte (Char.to_int frame.[6])) (8 - bits))
-         ~result:Incomplete
-         ~echo_valid:true
-         ~tag:0x22
-         ~command:0x00
-       : int))
-;;
-
-let%test_unit "whole extra bytes are incomplete up to eleven; the twelfth latches overrun"
-  =
-  let t = create "extra bytes" in
-  List.iter [ 1; 2; 3; 4 ] ~f:(fun extra ->
-    ignore
-      (expect_rejected
-         t
-         (sprintf "INFO plus %d bytes" extra)
-         (info 0x23 ^ Raw.zeros extra)
-         ~result:Incomplete
-         ~echo_valid:true
-         ~tag:0x23
-         ~command:0x00
-       : int));
-  ignore
-    (expect_rejected
-       t
-       "INFO plus 5 bytes"
-       (info 0x23 ^ Raw.zeros 5)
-       ~result:Bad_length
-       ~echo_valid:true
-       ~tag:0x23
-       ~command:0x00
-     : int)
-;;
-
-let%test_unit "overrun is sticky: no suffix restores validity, and the header is not \
-               recaptured"
-  =
-  let t = create "overrun" in
-  (* The maximum frame, then one byte. *)
-  let released =
-    expect_rejected
-      t
-      "WRITE plus one byte"
-      (write ^ Raw.zeros 1)
-      ~result:Bad_length
-      ~echo_valid:true
-      ~tag:0x33
-      ~command:0x11
-  in
-  expect_fields
-    t
-    ~cycle:released
-    "WRITE plus one byte"
-    { result = Bad_length
-    ; echo_valid = true
-    ; tag = 0x33
-    ; command = 0x11
-    ; payload_length = 4
-    ; payload = 0x03040102
-    };
-  (* A complete valid frame after the maximum one: its header must not replace the first
-     frame's, and it cannot become a second frame.
-  *)
-  ignore
-    (expect_rejected
-       t
-       "WRITE then INFO"
-       (write ^ info 0x55)
-       ~result:Bad_length
-       ~echo_valid:true
-       ~tag:0x33
-       ~command:0x11
-     : int);
-  ignore
-    (expect_rejected
-       t
-       "twelve zeros then INFO"
-       (Raw.zeros 12 ^ info 0x55)
-       ~result:Bad_length
-       ~echo_valid:true
-       ~tag:0x00
-       ~command:0x00
-     : int);
-  (* The next eligible selection starts clean. *)
-  expect_handoff
-    t
-    "INFO after overrun"
-    (info 0x56)
-    { result = Complete
-    ; echo_valid = true
-    ; tag = 0x56
-    ; command = 0x00
-    ; payload_length = 0
-    ; payload = Char.to_int (info 0x56).[6]
-    }
-;;
-
-let%test_unit "long prefixes of the historical counter-wrap shapes cannot hand off a \
-               valid frame"
-  =
-  (* With a four-bit count that wraps, sixteen bytes return it to zero, and the frame
-     after the prefix would parse as a fresh request.
-  *)
-  let t = create "prefix attacks" in
-  let load_start = encode ~tag:0x66 (Load_start { length = 0x0010 }) in
-  let zero_fields : Expected.t =
-    { result = Bad_length
-    ; echo_valid = true
-    ; tag = 0
-    ; command = 0
-    ; payload_length = 0
-    ; payload = 0
-    }
-  in
-  List.iter
-    [ 15, load_start
-    ; 16, load_start
-    ; 32, load_start
-    ; 48, load_start
-    ; 16, write
-    ; 15, write
-    ; 11, write
-    ]
-    ~f:(fun (prefix, frame) ->
-      let what = sprintf "%d zeros then a valid frame" prefix in
-      let { Selection.released; _ } = request ~period:2 t (Raw.zeros prefix ^ frame) in
-      run t 1;
-      expect_fields t ~cycle:released what zero_fields;
-      run t 4);
-  (* Far beyond any count width the receiver could plausibly wrap at. *)
-  let { Selection.released; _ } = request ~period:2 t (Raw.zeros 5000 ^ load_start) in
-  run t 1;
-  expect_fields t ~cycle:released "5000 zeros then LOAD_START" zero_fields
-;;
-
-let%test_unit "a declared length is checked against the bytes received; command sizes \
-               are left to dispatch"
-  =
-  let t = create "declared lengths" in
-  (* Consistent frames whose length is wrong for their command: [Complete] here, with the
-     declared length retained for dispatch's [Bad_length].
-  *)
-  let info_4 = Raw.frame ~tag:0x40 ~command:0x00 [ 0x01; 0x02; 0x03; 0x04 ] in
-  expect_handoff
-    t
-    "INFO declaring and carrying four bytes"
-    info_4
-    { result = Complete
-    ; echo_valid = true
-    ; tag = 0x40
-    ; command = 0x00
-    ; payload_length = 4
-    ; payload = 0x04030201
-    };
-  let run_2 = Raw.frame ~tag:0x41 ~command:0x20 [ 0x05; 0x06 ] in
-  expect_handoff
-    t
-    "RUN declaring and carrying two bytes"
-    run_2
-    { result = Complete
-    ; echo_valid = true
-    ; tag = 0x41
-    ; command = 0x20
-    ; payload_length = 2
-    ; payload = (Char.to_int run_2.[8] lsl 16) lor 0x0605
-    };
-  (* Declared and carried lengths disagree. *)
-  List.iter
-    [ ( "WRITE declaring 4, carrying 2"
-      , Raw.frame ~payload_length:4 ~tag:0x42 ~command:0x11 [ 1; 2 ] )
-    ; ( "WRITE declaring 2, carrying 4"
-      , Raw.frame ~payload_length:2 ~tag:0x42 ~command:0x11 [ 1; 2; 3; 4 ] )
-    ; ( "INFO declaring 1, carrying 0"
-      , Raw.frame ~payload_length:1 ~tag:0x42 ~command:0x00 [] )
-    ]
-    ~f:(fun (what, frame) ->
-      ignore
-        (expect_rejected
-           t
-           what
-           frame
-           ~result:Incomplete
-           ~echo_valid:true
-           ~tag:0x42
-           ~command:(Char.to_int frame.[3])
-         : int));
-  (* Lengths five to eight, sent whole: overrun at the twelfth byte. *)
-  List.iter [ 5; 6; 7; 8 ] ~f:(fun length ->
-    ignore
-      (expect_rejected
-         t
-         (sprintf "length %d sent whole" length)
-         (Raw.frame
-            ~tag:0x43
-            ~command:0x11
-            (List.init length ~f:(fun index -> index + 1)))
-         ~result:Bad_length
-         ~echo_valid:true
-         ~tag:0x43
-         ~command:0x11
-       : int));
-  (* A nonzero high length byte never reaches its declared CRC position. The last three
-     would wrap a 16-bit "length plus seven" to 0, 3, and 6.
-  *)
-  List.iter [ 0x0100; 0x0400; 0xff00; 0xfff9; 0xfffc; 0xffff ] ~f:(fun payload_length ->
-    let frame = Raw.frame ~payload_length ~tag:0x44 ~command:0x00 [] in
-    let { Selection.released; _ } = request t frame in
-    run t 1;
-    expect_fields
-      t
-      ~cycle:released
-      (sprintf "INFO declaring %#x" payload_length)
-      { result = Incomplete
-      ; echo_valid = true
-      ; tag = 0x44
-      ; command = 0x00
-      ; payload_length
-      ; payload = Char.to_int frame.[6]
-      };
-    run t 4)
-;;
-
-let%test_unit "bad magic, version, and CRC are rejected; unknown commands and device \
-               bounds are not framing errors"
-  =
-  let t = create "header and CRC" in
-  List.iter
-    [ ( "magic a4"
-      , Raw.frame ~magic:0xa4 ~tag:0x50 ~command:0x00 []
-      , Wire.Result_code.Bad_magic )
-    ; "response magic 5a", Raw.frame ~magic:0x5a ~tag:0x50 ~command:0x00 [], Bad_magic
-    ; "version 11", Raw.frame ~version:0x11 ~tag:0x50 ~command:0x00 [], Bad_version
-    ; "version 00", Raw.frame ~version:0x00 ~tag:0x50 ~command:0x00 [], Bad_version
-    ; "version 20", Raw.frame ~version:0x20 ~tag:0x50 ~command:0x00 [], Bad_version
-    ]
-    ~f:(fun (what, frame, result) ->
-      ignore
-        (expect_rejected t what frame ~result ~echo_valid:true ~tag:0x50 ~command:0x00
-         : int));
-  (* Every single-bit CRC error in the maximum frame. *)
-  List.iter [ 0x01; 0x02; 0x04; 0x08; 0x10; 0x20; 0x40; 0x80 ] ~f:(fun mask ->
-    ignore
-      (expect_rejected
-         t
-         (sprintf "WRITE with CRC ^ %#x" mask)
-         (Raw.flip_last write ~mask)
-         ~result:Bad_crc
-         ~echo_valid:true
-         ~tag:0x33
-         ~command:0x11
-       : int));
-  (* Command legality and device bounds belong to dispatch: the raw fields are kept. *)
-  List.iter [ 0x7f; 0xff; 0x15; 0x23 ] ~f:(fun command ->
-    expect_handoff
-      t
-      (sprintf "unknown command %#x" command)
-      (Raw.frame ~tag:0x51 ~command [])
-      { result = Complete
-      ; echo_valid = true
-      ; tag = 0x51
-      ; command
-      ; payload_length = 0
-      ; payload = Char.to_int (Raw.frame ~tag:0x51 ~command []).[6]
-      });
-  expect_handoff
-    t
-    "WRITE to address 0x100"
-    (encode ~tag:0x52 (Write_word { address = 0x0100; word = 0xffff }))
-    { result = Complete
-    ; echo_valid = true
-    ; tag = 0x52
-    ; command = 0x11
-    ; payload_length = 4
-    ; payload = 0xffff0100
-    }
-;;
-
-let%test_unit "several defects resolve in the existing precedence" =
-  let t = create "precedence" in
-  let bad_everything = Raw.frame ~magic:0x00 ~version:0x00 ~tag:0x60 ~command:0x7f [] in
-  List.iter
-    [ ( "overrun with bad magic, version, and CRC"
-      , Raw.flip_last (bad_everything ^ Raw.zeros 5) ~mask:0x01
-      , []
-      , Wire.Result_code.Bad_length )
-    ; ( "length 5 sent whole, with bad magic and CRC"
-      , Raw.flip_last
-          (Raw.frame ~magic:0x00 ~tag:0x60 ~command:0x7f [ 1; 2; 3; 4; 5 ])
-          ~mask:0x01
-      , []
-      , Bad_length )
-    ; ( "incomplete header with bad magic and version"
-      , String.prefix bad_everything 6
-      , []
-      , Incomplete )
-    ; "partial byte with bad magic", bad_everything, [ true ], Incomplete
-    ; ( "high length byte with bad magic"
-      , Raw.frame ~magic:0x00 ~payload_length:0x0100 ~tag:0x60 ~command:0x7f []
-      , []
-      , Incomplete )
-    ; ( "bad magic, version, and CRC"
-      , Raw.flip_last bad_everything ~mask:0x01
-      , []
-      , Bad_magic )
-    ; ( "bad version and CRC"
-      , Raw.flip_last (Raw.frame ~version:0x00 ~tag:0x60 ~command:0x7f []) ~mask:0x01
-      , []
-      , Bad_version )
-    ; ( "bad CRC, unknown command, and a length wrong for it"
-      , Raw.flip_last (Raw.frame ~tag:0x60 ~command:0x7f [ 1; 2 ]) ~mask:0x80
-      , []
-      , Bad_crc )
-    ]
-    ~f:(fun (what, frame, extra_bits, result) ->
-      ignore
-        (expect_rejected
-           t
-           what
-           frame
-           ~extra_bits
-           ~result
-           ~echo_valid:true
-           ~tag:0x60
-           ~command:0x7f
-         : int))
-;;
-
-let%test_unit "correlation just below and at the four-byte threshold, and the zeroed echo"
-  =
-  let t = create "correlation" in
-  (* Tag received, command not: the tag is retained, but the echo is invalid, so the
-     loader must zero it.
-  *)
-  ignore
-    (expect_rejected
-       t
-       "three bytes"
-       (String.prefix (info 0x33) 3)
-       ~result:Incomplete
-       ~echo_valid:false
-       ~tag:0x33
-       ~command:0x00
-     : int);
-  ignore
-    (expect_rejected
-       t
-       "four bytes"
-       (String.prefix write 4)
-       ~result:Incomplete
-       ~echo_valid:true
-       ~tag:0x33
-       ~command:0x11
-     : int);
-  (* Two bytes of an INFO with tag 0: the zeroed correlation is INFO/tag 0, but the result
-     is never [Complete].
-  *)
-  ignore
-    (expect_rejected
-       t
-       "two bytes of INFO, tag 0"
-       (String.prefix (info 0x00) 2)
-       ~result:Incomplete
-       ~echo_valid:false
-       ~tag:0x00
-       ~command:0x00
-     : int);
-  (* An empty selection is handed off too. *)
-  ignore
-    (expect_rejected
-       t
-       "empty selection"
-       ""
-       ~result:Incomplete
-       ~echo_valid:false
-       ~tag:0x00
-       ~command:0x00
-     : int)
-;;
diff --git a/test/host_link/frame_tx/dune b/test/host_link/frame_tx/dune
