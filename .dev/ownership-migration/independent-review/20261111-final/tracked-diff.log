+++ /dev/null
@@ -1,154 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "endpoint_diagnostics_tests.ml" *)
-(* HL4a: the harness's key assertions detect the failures they exist for, and report
-   enough to reproduce them, written against the endpoint fixture, its agents, and the
-   scoreboard.
-
-   Each case sets up a controlled mismatch between what the host did and what the check
-   expects, and requires the check to raise [Harness_failure]. None of them changes the
-   loader or leaves a failing test in the suite. The first case prints a complete report,
-   so its format is reviewed here.
-
-   Ported from the HL4a suite's hardware_loader_diagnostics_tests.ml with the same names,
-   scenarios, order, and checks (docs/serial_host_pilot.md, SP5). The checks under test
-   are the single implementations in [Fixture] and [Endpoint_scenario], so each report is
-   the original's. Contract-faithful scenarios run under [Scoreboard.run], which then
-   checks what the monitors saw after the negative has been caught; the robustness and
-   construction cases run under [Fixture.run].
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Endpoint_scenario
-module Wire = Protemu_host_link_wire.Wire
-module Serial_host = Protemu_serial_host_agent
-module Driver = Serial_host.Driver
-module Item = Serial_host.Item
-module Timing = Serial_host.Config.Timing
-module Status = Protemu_control_port_agent.Item.Status
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-module Scoreboard = Endpoint.Scoreboard
-module Latency = Endpoint.Latency
-
-let%expect_test "the retention check detects a response that the host committed" =
-  (* The host supplies the final fall, which commits the response; the retention check
-     that guards replay must then fail at the commit boundary. The transcript is limited
-     to twelve events to show how truncation is reported.
-  *)
-  Scoreboard.run
-    ~transcript_limit:12
-    ~scenario:"negative: committed response checked as retained"
-    (fun t board ->
-       let driver = Fixture.driver t in
-       set_status t { Status.halted_idle with image_valid = 1 };
-       let frame = Item.encode ~tag:0x75 Run in
-       let started = t.cycle in
-       let request_deselected = Driver.send_frame driver frame in
-       Scoreboard.request board ~selected:started ~deselected:request_deselected frame;
-       ignore
-         (Scoreboard.offer board ~deselected:request_deselected Run ~accepted:true : int);
-       ignore (Driver.wait_ready driver ~since:request_deselected : int);
-       let selected = t.cycle in
-       let read =
-         Driver.read_response
-           driver
-           ~expected:(Wire.Request.correlation ~tag:0x75 Run)
-           ~decide:(fun _ -> Commit)
-           ()
-       in
-       Scoreboard.read board ~selected read;
-       print_s
-         (require_failure t "retention after a commit" (fun () ->
-            Fixture.expect_retained t ~deselected:read.deselected ~cycles:10)));
-  [%expect
-    {|
-    (test/host_link/hardware_loader_testbench.ml.Harness_failure
-     (scenario "negative: committed response checked as retained") (cycle 990)
-     (phase Pre_edge) (what "retained response keeps LRDY high for 10 cycles")
-     (expected ((() true))) (actual ((((984 false)) false)))
-     (transcript
-      ((earlier_events_omitted 2)
-       (events
-        ((8 (Select true))
-         (8 (Sent (bytes "a5 10 75 20 00 00 57") (extra_bits 0)))
-         (8 (Status ((halted 1) (engines_idle 1) (image_valid 1))))
-         (11 (Busy true)) (460 (Select false))
-         (463 (Offer (request Run) (accepted true))) (464 (Ready true))
-         (465 (Select true))
-         (974 (Response_read (bytes "5a 10 75 20 00 00 00 e6") (outcome Commit)))
-         (981 (Select false)) (984 (Ready false)) (984 (Busy false)))))))
-    |}]
-;;
-
-let%test_unit "the offer check detects a one-cycle change in offer timing" =
-  (* HL4b must not add a pipeline stage. An expectation one cycle late stands in for a
-     loader that offers one cycle late.
-  *)
-  Scoreboard.run ~scenario:"negative: offer one cycle late" (fun t board ->
-    let exchange = transact ~board t ~tag:0x11 (Write_word { address = 1; word = 2 }) in
-    ignore
-      (require_failure t "a late offer" (fun () ->
-         expect_offers
-           t
-           ~since:exchange.started
-           "offer one cycle later than observed"
-           [ { cycle = exchange.request_deselected + Latency.offer_after_deselect + 1
-             ; request = Load_write { address = 1; data = 2 }
-             ; accepted = true
-             }
-           ])
-       : Sexp.t);
-    ignore
-      (Scoreboard.offer
-         board
-         ~deselected:exchange.request_deselected
-         (Load_write { address = 1; data = 2 })
-         ~accepted:true
-       : int))
-;;
-
-let%test_unit "the quiet check detects a response that was not cancelled" =
-  (* Without the disable, the retained STATUS response keeps LRDY high. *)
-  Scoreboard.run ~scenario:"negative: response not discarded" (fun t board ->
-    let driver = Fixture.driver t in
-    let frame = Item.encode ~tag:0x12 Status in
-    let started = t.cycle in
-    let request_deselected = Driver.send_frame driver frame in
-    Scoreboard.request board ~selected:started ~deselected:request_deselected frame;
-    ignore (Driver.wait_ready driver ~since:request_deselected : int);
-    ignore
-      (require_failure t "a retained response" (fun () -> expect_quiet t 10 "no response")
-       : Sexp.t))
-;;
-
-let%test_unit "waits are bounded and time out with a report" =
-  (* Robustness responder: the READBACK response never arrives. *)
-  Fixture.run ~scenario:"negative: bounded wait" (fun t ->
-    let driver = Fixture.driver t in
-    (Fixture.responder t).readback_completion <- Never;
-    let request_deselected =
-      Driver.send_frame driver (Item.encode ~tag:0x13 (Read_word { address = 0 }))
-    in
-    ignore
-      (require_failure t "an unbounded wait" (fun () ->
-         ignore (Driver.wait_ready ~budget:100 driver ~since:request_deselected : int))
-       : Sexp.t);
-    expect_int
-      t
-      "the wait stopped at its budget"
-      ~expected:(request_deselected + (Fixture.timing t).deselect_gap + 100)
-      t.cycle)
-;;
-
-let%test_unit "the harness refuses host timing outside the P3.5 envelope" =
-  match
-    Fixture.run
-      ~timing:{ Timing.envelope with clock_low = 3 }
-      ~scenario:"negative: 3-cycle low"
-      (fun (_ : Fixture.t) -> ())
-  with
-  | () -> raise_s [%message "a 3-cycle LCLK low was accepted"]
-  | exception _ -> ()
-;;
diff --git a/test/host_link/endpoint/endpoint_framing_tests.ml b/test/host_link/endpoint/endpoint_framing_tests.ml
deleted file mode 100644
index f438cf4..0000000
--- a/test/host_link/endpoint/endpoint_framing_tests.ml
+++ /dev/null
@@ -1,416 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "endpoint_framing_tests.ml" *)
-(* HL4a: request framing, parser recovery, and device bounds at the composed [Host_link]'s
-   serial pins, written against the endpoint fixture, its agents, and the scoreboard.
-
-   The responder accepts every offer, so any request that reached the core would show as
-   an accepted offer; every malformed case requires none. Malformed frames come from
-   [Serial_host.Item.Raw], never from the codec. Expected results and echoed correlation
-   are written out from the P3.5 record's request framing rules. Each malformed case is
-   followed by a legal INFO with a fresh tag, which must succeed after the ordinary
-   inter-frame gap.
-
-   Ported from the HL4a suite's hardware_loader_framing_tests.ml with the same names,
-   scenarios, order, and checks (docs/serial_host_pilot.md, SP5). A malformed frame is
-   host traffic the loader must reject, not a departure from the host timing contract, so
-   every scenario runs under [Scoreboard.run]. It also requires the serial monitor to have
-   seen each frame, with any partial final byte, and each read the driver reports, and the
-   Control_port monitor to have seen only the one accepted offer the first test writes
-   out.
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Endpoint_scenario
-module Wire = Protemu_host_link_wire.Wire
-module Serial_host = Protemu_serial_host_agent
-module Driver = Serial_host.Driver
-module Item = Serial_host.Item
-module Outcome = Serial_host.Item.Outcome
-module Raw = Serial_host.Item.Raw
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-module Scoreboard = Endpoint.Scoreboard
-module Latency = Endpoint.Latency
-
-let write = Wire.Command.to_int Write_word
-let load_start = Wire.Command.to_int Load_start
-let info = Wire.Command.to_int Info
-
-(* Where the loader rejects a frame: at deselect validation, before any dispatch cycle, or
-   in the dispatch cycle without offering.
-*)
-module Stage = struct
-  type t =
-    | Validation
-    | Dispatch
-
-  let ready_after_deselect = function
-    | Validation -> Latency.validation_error_ready
-    | Dispatch -> Latency.offer_after_deselect + Latency.ready_after_offer
-  ;;
-end
-
-(* Sends [frame] as one selection and requires the given error answer at the stage's
-   cycle, no offer, and a working legal INFO afterwards. Given a [board], records the
-   frame, its partial final byte, and both reads.
-*)
-let expect_rejected
-  ?board
-  (t : Fixture.t)
-  ~what
-  ?(stage = Stage.Validation)
-  ?extra_bits
-  ?extra_byte
-  frame
-  ~(echo : Wire.Correlation.t)
-  result
-  =
-  let started = t.cycle in
-  let request_deselected =
-    Driver.send_frame (Fixture.driver t) ?extra_bits ?extra_byte frame
-  in
-  record_request
-    ?extra_bits
-    ?extra_byte
-    board
-    ~selected:started
-    ~deselected:request_deselected
-    frame;
-  let exchange = receive ?board t ~started ~request_deselected ~expected:echo in
-  expect_response
-    t
-    what
-    ~expected:{ tag = echo.tag; command = echo.command; result; payload = Empty }
-    exchange.response;
-  expect_no_offers t ~since:started (what ^ ": no core request is offered");
-  expect_int
-    t
-    (what ^ ": LRDY rises at the rejecting stage's cycle")
-    ~expected:(exchange.request_deselected + Stage.ready_after_deselect stage)
-    exchange.ready;
-  expect_info_works
-    ?board
-    t
-    ~tag:(0x80 lxor echo.tag)
-    (what ^ ": a later legal INFO works")
-;;
-
-let echo ~tag ~command = { Wire.Correlation.tag; command }
-let zeroed = echo ~tag:0 ~command:0
-
-let%test_unit "the maximum legal frame dispatches; a twelfth byte latches overrun" =
-  Scoreboard.run ~scenario:"maximum frame and overrun" (fun t board ->
-    let frame = Item.encode ~tag:0x3f (Write_word { address = 0; word = 0xbeef }) in
-    expect_int
-      t
-      "a WRITE_WORD frame is the eleven-byte maximum"
-      ~expected:11
-      (String.length frame);
-    let exchange =
-      transact ~board t ~tag:0x3f (Write_word { address = 0; word = 0xbeef })
-    in
-    expect_response
-      t
-      "maximum frame"
-      ~expected:(response ~tag:0x3f Write_word Complete)
-      exchange.response;
-    expect_offered_once
-      t
-      exchange
-      (Load_write { address = 0; data = 0xbeef })
-      ~accepted:true;
-    ignore
-      (Scoreboard.offer
-         board
-         ~deselected:exchange.request_deselected
-         (Load_write { address = 0; data = 0xbeef })
-         ~accepted:true
-       : int);
-    expect_rejected
-      ~board
-      t
-      ~what:"one byte after the maximum frame"
-      (frame ^ "\x00")
-      ~echo:(echo ~tag:0x3f ~command:write)
-      Bad_length;
-    expect_rejected
-      ~board
-      t
-      ~what:"thirty bytes, ending in a valid INFO, after the maximum frame"
-      (frame ^ Raw.zeros 23 ^ Item.encode ~tag:0x40 Info)
-      ~echo:(echo ~tag:0x3f ~command:write)
-      Bad_length;
-    expect_rejected
-      ~board
-      t
-      ~what:"a complete frame declaring a five-byte payload is twelve bytes long"
-      (Raw.frame ~tag:0x28 ~command:info [ 0x11; 0x22; 0x33; 0x44; 0x55 ])
-      ~echo:(echo ~tag:0x28 ~command:info)
-      Bad_length;
-    expect_rejected
-      ~board
-      t
-      ~what:"one extra byte after a seven-byte INFO"
-      (Item.encode ~tag:0x29 Info ^ "\x5a")
-      ~echo:(echo ~tag:0x29 ~command:info)
-      Incomplete)
-;;
-
-let%test_unit "long zero prefixes and valid-looking suffixes cannot dispatch" =
-  (* The historical four-bit counter-wrap attack shapes: 15, 16, 32, and 48 zero bytes
-     before a valid LOAD_START, and 16 and 32 before a valid WRITE_WORD. Bytes 2 and 3 of
-     the prefix are zero, so the echo is tag 0, command 0.
-  *)
-  Scoreboard.run ~scenario:"prefix attacks" (fun t board ->
-    List.iter
-      [ 15, Item.encode ~tag:0x35 (Load_start { length = 1 })
-      ; 16, Item.encode ~tag:0x36 (Load_start { length = 1 })
-      ; 32, Item.encode ~tag:0x37 (Load_start { length = 1 })
-      ; 48, Item.encode ~tag:0x38 (Load_start { length = 1 })
-      ; 16, Item.encode ~tag:0x3d (Write_word { address = 0; word = 0xbeef })
-      ; 32, Item.encode ~tag:0x3e (Write_word { address = 0; word = 0xbeef })
-      ]
-      ~f:(fun (prefix, frame) ->
-        expect_rejected
-          ~board
-          t
-          ~what:(sprintf "%d zero bytes before %s" prefix (Item.hex frame))
-          (Raw.zeros prefix ^ frame)
-          ~echo:zeroed
-          Bad_length))
-;;
-
-let%test_unit "bad magic, version, CRC, command, and payload length are rejected" =
-  Scoreboard.run ~scenario:"header errors" (fun t board ->
-    expect_rejected
-      ~board
-      t
-      ~what:"LOAD_START with its CRC's top bit flipped"
-      (Raw.flip_last (Item.encode ~tag:0x21 (Load_start { length = 1 })) ~mask:0x80)
-      ~echo:(echo ~tag:0x21 ~command:load_start)
-      Bad_crc;
-    expect_rejected
-      ~board
-      t
-      ~what:"magic 0x00"
-      (Raw.frame ~magic:0x00 ~tag:0x24 ~command:info [])
-      ~echo:(echo ~tag:0x24 ~command:info)
-      Bad_magic;
-    expect_rejected
-      ~board
-      t
-      ~what:"version 0x20"
-      (Raw.frame ~version:0x20 ~tag:0x25 ~command:info [])
-      ~echo:(echo ~tag:0x25 ~command:info)
-      Bad_version;
-    List.iter [ 0xff; 0x15; 0x02 ] ~f:(fun command ->
-      expect_rejected
-        ~board
-        t
-        ~what:(sprintf "unknown command 0x%02x" command)
-        ~stage:Dispatch
-        (Raw.frame ~tag:0x26 ~command [])
-        ~echo:(echo ~tag:0x26 ~command)
-        Bad_command);
-    (* Complete frames with a correct CRC and a payload length at most four that is not
-       the command's one legal length.
-    *)
-    List.iteri
-      [ Wire.Command.Info, 2
-      ; Status, 4
-      ; Load_start, 0
-      ; Load_start, 4
-      ; Write_word, 3
-      ; Write_word, 2
-      ; Read_word, 4
-      ; Verify_word, 2
-      ; Load_complete, 2
-      ; Run, 4
-      ; Stop, 2
-      ; Abort, 1
-      ]
-      ~f:(fun index (command, length) ->
-        let tag = 0x90 + index in
-        let command = Wire.Command.to_int command in
-        expect_rejected
-          ~board
-          t
-          ~what:(sprintf "command 0x%02x with a %d-byte payload" command length)
-          ~stage:Dispatch
-          (Raw.frame ~tag ~command (List.init length ~f:(fun byte -> 0x10 + byte)))
-          ~echo:(echo ~tag ~command)
-          Bad_length))
-;;
-
-let%test_unit "device bounds refuse lengths and addresses without an offer" =
-  (* Addresses and lengths stay 16-bit until checked, so none of these is narrowed into a
-     legal RAM address.
-  *)
-  Scoreboard.run ~scenario:"device bounds" (fun t board ->
-    List.iteri
-      [ Wire.Request.Load_start { length = 0 }
-      ; Load_start { length = 257 }
-      ; Load_start { length = 0xffff }
-      ; Write_word { address = 256; word = 1 }
-      ; Write_word { address = 0x8000; word = 1 }
-      ; Read_word { address = 256 }
-      ; Verify_word { address = 0xffff; expected = 0 }
-      ]
-      ~f:(fun index request ->
-        let tag = 0xa0 + index in
-        let exchange = transact ~board t ~tag request in
-        let what = Sexp.to_string [%sexp (request : Wire.Request.t)] in
-        expect_response
-          t
-          what
-          ~expected:(response ~tag (Wire.Request.command request) Image_bounds)
-          exchange.response;
-        expect_no_offers t ~since:exchange.started (what ^ ": no core request is offered");
-        expect_int
-          t
-          (what ^ ": the refusal is ready one cycle after the dispatch cycle")
-          ~expected:(exchange.request_deselected + Stage.ready_after_deselect Dispatch)
-          exchange.ready))
-;;
-
-let%test_unit "truncated frames and partial bytes are incomplete, echoed from four bytes" =
-  (* P3.5: all four magic/version/tag/command bytes echo tag and command; fewer zero both.
-     A partial final byte, a missing payload or CRC, and a nonzero high length byte are
-     all [Incomplete].
-  *)
-  Scoreboard.run ~scenario:"truncation" (fun t board ->
-    let frame = Item.encode ~tag:0x22 (Write_word { address = 0; word = 0x1234 }) in
-    let echoed = echo ~tag:0x22 ~command:write in
-    List.iter
-      [ "an empty selection", 0, 0, zeroed
-      ; "one byte", 1, 0, zeroed
-      ; "three bytes", 3, 0, zeroed
-      ; "three bytes and five bits", 3, 5, zeroed
-      ; "four bytes", 4, 0, echoed
-      ; "four bytes and three bits", 4, 3, echoed
-      ; "the header only", 6, 0, echoed
-      ; "the header and half the payload", 8, 0, echoed
-      ; "no CRC", 10, 0, echoed
-      ; "no CRC, with seven of its bits", 10, 7, echoed
-      ]
-      ~f:(fun (what, bytes, bits, echo) ->
-        expect_rejected
-          ~board
-          t
-          ~what:("WRITE_WORD truncated to " ^ what)
-          (String.prefix frame bytes)
-          ~extra_bits:bits
-          ~extra_byte:(if bytes < String.length frame then frame.[bytes] else '\xff')
-          ~echo
-          Incomplete);
-    expect_rejected
-      ~board
-      t
-      ~what:"a complete WRITE_WORD followed by three bits"
-      frame
-      ~extra_bits:3
-      ~echo:echoed
-      Incomplete;
-    expect_rejected
-      ~board
-      t
-      ~what:"INFO with a nonzero high length byte and a seven-byte transfer"
-      (Raw.frame ~payload_length:0x100 ~tag:0x2a ~command:info [])
-      ~echo:(echo ~tag:0x2a ~command:info)
-      Incomplete)
-;;
-
-let%test_unit "a zeroed echo can match INFO with tag 0 but is still an error" =
-  (* The HL2 record's recorded ambiguity. Two bytes of an INFO with tag 0 get a zeroed
-     echo that [decode_correlated] accepts as INFO/tag 0, and its result is still
-     [Incomplete]: correlation equality does not prove the header arrived. For tag 0x33
-     the same answer is a correlation mismatch, which the host replays. The test then
-     reads it without a correlation check and commits it itself, only to clean up; that is
-     not a recovery policy, and no command is retried.
-  *)
-  Scoreboard.run ~scenario:"zeroed echo" (fun t board ->
-    let driver = Fixture.driver t in
-    let info_tag_0 = Item.encode ~tag:0 Info in
-    expect_rejected
-      ~board
-      t
-      ~what:"INFO tag 0 truncated to two bytes"
-      (String.prefix info_tag_0 2)
-      ~echo:zeroed
-      Incomplete;
-    let expected = Wire.Request.correlation ~tag:0x33 Info in
-    let frame = String.prefix (Item.encode ~tag:0x33 Info) 2 in
-    let started = t.cycle in
-    let request_deselected = Driver.send_frame driver frame in
-    Scoreboard.request board ~selected:started ~deselected:request_deselected frame;
-    ignore (Driver.wait_ready driver ~since:request_deselected : int);
-    let selected = t.cycle in
-    let read = Driver.read_response driver ~expected ~decide:Item.commit_if_valid () in
-    Scoreboard.read board ~selected read;
-    Fixture.check
-      t
-      ~phase:Host_sample
-      "a zeroed echo for tag 0x33 is a correlation mismatch and is replayed"
-      [%sexp_of: Outcome.t * (Wire.Response.t, Wire.Response.Decode_error.t) Result.t]
-      [%equal: Outcome.t * (Wire.Response.t, Wire.Response.Decode_error.t) Result.t]
-      ~expected:
-        ( Replay
-        , Error
-            (Correlation_mismatch
-               { expected
-               ; response = { tag = 0; command = 0; result = Incomplete; payload = Empty }
-               }) )
-      (read.outcome, read.decoded);
-    Fixture.expect_retained t ~deselected:read.deselected ~cycles:100;
-    let exchange = receive ~board t ~started ~request_deselected ~expected:zeroed in
-    expect_response
-      t
-      "the retained zeroed answer, committed by the test"
-      ~expected:{ tag = 0; command = 0; result = Incomplete; payload = Empty }
-      exchange.response;
-    expect_no_offers t ~since:started "a truncated INFO offers nothing";
-    expect_info_works ~board t ~tag:0x34 "INFO after the zeroed answer")
-;;
-
-(* The peer's replayable malformed generator: a 32-bit LFSR with taps 31, 21, 1, and 0,
-   seeded with 20260921. Trial n builds an INFO tagged with the state's low byte and a CRC
-   inverted in bit 7 when n is odd, then applies mutation n mod 4.
-*)
-let next_state state =
-  let tap bit = (state lsr bit) land 1 in
-  (state lsl 1) land 0xffff_ffff lor (tap 31 lxor tap 21 lxor tap 1 lxor tap 0)
-;;
-
-let%test_unit "the peer's sixteen malformed trials at seed 20260921 are rejected" =
-  Scoreboard.run ~scenario:"seeded malformed trials" (fun t board ->
-    let state = ref 20260921 in
-    for trial = 0 to 15 do
-      state := next_state !state;
-      let tag = !state land 0xff in
-      let base = Item.encode ~tag Info in
-      let base = if trial land 1 = 1 then Raw.flip_last base ~mask:0x80 else base in
-      let frame, result, mutation =
-        match trial % 4 with
-        | 0 ->
-          Raw.flip_last base ~mask:0x80, Wire.Result_code.Bad_crc, "CRC bit 7 inverted"
-        | 1 -> String.prefix base 6, Incomplete, "CRC missing"
-        | 2 ->
-          ( base ^ String.of_char (Char.of_int_exn ((!state lsr 8) land 0xff))
-          , Incomplete
-          , "one extra byte" )
-        | _ ->
-          ( String.mapi base ~f:(fun index byte -> if index = 5 then '\x01' else byte)
-          , Incomplete
-          , "high length byte 1" )
-      in
-      expect_rejected
-        ~board
-        t
-        ~what:(sprintf "trial %d (tag 0x%02x): %s" trial tag mutation)
-        frame
-        ~echo:(echo ~tag ~command:info)
-        result
-    done)
-;;
diff --git a/test/host_link/endpoint/endpoint_lifecycle_tests.ml b/test/host_link/endpoint/endpoint_lifecycle_tests.ml
deleted file mode 100644
index 88baa90..0000000
--- a/test/host_link/endpoint/endpoint_lifecycle_tests.ml
+++ /dev/null
@@ -1,130 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "endpoint_lifecycle_tests.ml" *)
-(* SP4: each [Fixture.run] is a fresh endpoint. Two scoped runs in one test share no
-   monitor items, transcript, offers, or responder policy, and a handle that escapes its
-   run cannot advance time. See docs/serial_host_pilot.md, SP4.
-*)
-
-open! Core
-open! Hardcaml_protemu
-module Serial_host = Protemu_serial_host_agent
-module Driver = Serial_host.Driver
-module Control_port_agent = Protemu_control_port_agent
-module Responder = Control_port_agent.Responder
-module Status = Control_port_agent.Item.Status
-module Offer = Control_port_agent.Item.Offer
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-
-(* What one scenario could leak into the next: the fixture's time and transcript, both
-   monitors' items, and the responder's policy and memory.
-*)
-module State = struct
-  type t =
-    { cycle : int
-    ; transcript : Sexp.t
-    ; serial_items : int
-    ; port_items : int
-    ; offers : Offer.t list
-    ; accepts_write : bool
-    ; memory : int array
-    ; status : Status.t
-    ; readback_completion : Control_port_agent.Item.Completion.t
-    }
-  [@@deriving sexp_of]
-
-  let equal a b = Sexp.equal (sexp_of_t a) (sexp_of_t b)
-
-  (* The fields in which [a] and [b] agree. *)
-  let unchanged a b =
-    let field name sexp_of get = name, Sexp.equal (sexp_of (get a)) (sexp_of (get b)) in
-    [ field "cycle" [%sexp_of: int] (fun t -> t.cycle)
-    ; field "transcript" Fn.id (fun t -> t.transcript)
-    ; field "serial_items" [%sexp_of: int] (fun t -> t.serial_items)
-    ; field "port_items" [%sexp_of: int] (fun t -> t.port_items)
-    ; field "offers" [%sexp_of: Offer.t list] (fun t -> t.offers)
-    ; field "accepts_write" [%sexp_of: bool] (fun t -> t.accepts_write)
-    ; field "memory" [%sexp_of: int array] (fun t -> t.memory)
-    ; field "status" [%sexp_of: Status.t] (fun t -> t.status)
-    ; field
-        "readback_completion"
-        [%sexp_of: Control_port_agent.Item.Completion.t]
-        (fun t -> t.readback_completion)
-    ]
-    |> List.filter_map ~f:(fun (name, same) -> Option.some_if same name)
-  ;;
-
-  let of_fixture (t : Fixture.t) =
-    let responder = Fixture.responder t in
-    { cycle = t.cycle
-    ; transcript = Fixture.transcript t
-    ; serial_items = Queue.length (Fixture.serial_observed t)
-    ; port_items = Queue.length (Fixture.control_port_observed t)
-    ; offers = Fixture.offers t
-    ; accepts_write = responder.accept (Load_write { address = 0; data = 0 })
-    ; memory = Array.copy responder.memory
-    ; status = responder.status
-    ; readback_completion = responder.readback_completion
-    }
-  ;;
-end
-
-let%test_unit "two scoped runs share no monitor items, transcript, offers, or responder \
-               policy"
-  =
-  (* The first run changes every piece of responder policy it can and leaves a refused
-     offer, a request item, and transcript events behind; the second must start as an
-     endpoint fresh from reset does. The first run's handle escapes, and using it
-     afterwards raises.
-  *)
-  let first, left =
-    Fixture.run ~scenario:"isolation: first" (fun t ->
-      let responder = Fixture.responder t in
-      responder.accept <- (fun _ -> false);
-      responder.memory.(0) <- 0x1234;
-      responder.status <- Status.running;
-      responder.readback_completion <- Never;
-      let deselected =
-        Driver.send_frame
-          (Fixture.driver t)
-          (Serial_host.Item.encode ~tag:0x21 (Write_word { address = 0; word = 0x5678 }))
-      in
-      ignore (Driver.wait_ready (Fixture.driver t) ~since:deselected : int);
-      t, State.of_fixture t)
-  in
-  Fixture.run ~scenario:"isolation: second" (fun t ->
-    let fresh : State.t =
-      { cycle = 8
-      ; transcript =
-          [%sexp ([ 0, Reset true; 4, Reset false ] : (int * Fixture.Event.t) list)]
-      ; serial_items = 0
-      ; port_items = 0
-      ; offers = []
-      ; accepts_write = true
-      ; memory = Responder.default_memory ()
-      ; status = Status.halted_idle
-      ; readback_completion = Contract
-      }
-    in
-    (* The first run did leave state behind, so the comparison below is not vacuous. *)
-    Fixture.check
-      t
-      ~phase:Post_run
-      "the first run changed every compared field"
-      [%sexp_of: string list]
-      [%equal: string list]
-      ~expected:[]
-      (State.unchanged fresh left);
-    Fixture.check
-      t
-      ~phase:Post_run
-      "a second scoped run starts fresh"
-      [%sexp_of: State.t]
-      State.equal
-      ~expected:fresh
-      (State.of_fixture t));
-  match Fixture.cycle first with
-  | () -> raise_s [%message "a finished fixture advanced time"]
-  | exception _ -> ()
-;;
diff --git a/test/host_link/endpoint/endpoint_scenario.ml b/test/host_link/endpoint/endpoint_scenario.ml
deleted file mode 100644
index 2877777..0000000
--- a/test/host_link/endpoint/endpoint_scenario.ml
+++ /dev/null
@@ -1,343 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "endpoint_scenario.ml" *)
-(* The endpoint suite's scenario and check helpers, ported from the HL4a suite and written
-   against [Fixture], [Scoreboard], and [Serial_host.Driver]: the composite transactions
-   ([receive], [exchange], [transact], [read_prefix], [disturb]), the offer, LRDY, and
-   response checks ([expect_*]), the expected responses ([response], [info_payload]), the
-   responder shortcuts ([set_status], [accepted]), and the negative-check idiom
-   ([require_failure]). The last section holds the serial monitor suite's own
-   expectations: items built from the driver's side only, compared against the drained
-   serial monitor by [expect_observed].
-
-   These are the scenario/checker side, so they live in the test library, not the fixture
-   library. Each helper's pin activity, cycles, checks, and failure reports are its HL4a
-   original's, or the driver call's it wraps. A helper that drives a transaction takes an
-   optional [board] and records the driver's side into it: the frame it sent, with the
-   cycles LSEL_N fell and rose, the [Read.t] the driver returned, or the bits of a read it
-   abandoned. Offers and READBACK responses are not recorded here; each test writes those
-   out from its scenario. See docs/serial_host_pilot.md, SP5 and SP6.
-*)
-
-open! Core
-module Wire = Protemu_host_link_wire.Wire
-module Serial_host = Protemu_serial_host_agent
-module Driver = Serial_host.Driver
-module Item = Serial_host.Item
-module Exchange = Serial_host.Item.Exchange
-module Observed = Serial_host.Item.Observed
-module Read = Serial_host.Item.Read
-module Control_port_agent = Protemu_control_port_agent
-module Offer = Control_port_agent.Item.Offer
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-module Scoreboard = Endpoint.Scoreboard
-module Latency = Endpoint.Latency
-
-(* The responder's core status, applied from the next cycle. *)
-let set_status t status = (Fixture.responder t).status <- status
-
-(* The offers the responder accepted, oldest first. *)
-let accepted ?since t =
-  Fixture.offers ?since t |> List.filter ~f:(fun (offer : Offer.t) -> offer.accepted)
-;;
-
-let expect_no_offers t ~since what =
-  Fixture.check
-    t
-    ~phase:Post_run
-    what
-    [%sexp_of: Offer.t list]
-    [%equal: Offer.t list]
-    ~expected:[]
-    (Fixture.offers ~since t)
-;;
-
-let expect_offers t ~since what expected =
-  Fixture.check
-    t
-    ~phase:Post_run
-    what
-    [%sexp_of: Offer.t list]
-    [%equal: Offer.t list]
-    ~expected
-    (Fixture.offers ~since t)
-;;
-
-let expect_int t ?cycle what ~expected actual =
-  Fixture.check t ?cycle ~phase:Post_run what [%sexp_of: int] Int.equal ~expected actual
-;;
-
-(* Holds [cycles] and requires LRDY and LDO low and no offer throughout. *)
-let expect_quiet (t : Fixture.t) cycles what =
-  let since = t.cycle in
-  for _ = 1 to cycles do
-    Fixture.cycle t;
-    if t.ready || t.ldo
-    then
-      Fixture.fail
-        t
-        ~phase:Pre_edge
-        what
-        ~expected:[%sexp { ready = false; ldo = false }]
-        ~actual:[%sexp { ready : bool = t.ready; ldo : bool = t.ldo }]
-  done;
-  expect_no_offers t ~since what
-;;
-
-(* The bits of a final partial byte as [Driver.send] clocks them: the first [extra_bits]
-   bits of [extra_byte], MSB first, with the driver's defaults.
-*)
-let extra_bits_sent ?(extra_bits = 0) ?(extra_byte = '\xff') () =
-  List.take (Item.bits_of_byte extra_byte) extra_bits
-;;
-
-(* Records a request frame the driver sent, with any partial final byte, when the scenario
-   keeps a scoreboard.
-*)
-let record_request ?extra_bits ?extra_byte board ~selected ~deselected frame =
-  Option.iter board ~f:(fun board ->
-    Scoreboard.request
-      board
-      ~extra_bits:(extra_bits_sent ?extra_bits ?extra_byte ())
-      ~selected
-      ~deselected
-      frame)
-;;
-
-(* Waits for LRDY after a request frame, reads and validates the response, commits it, and
-   checks that LRDY clears on the commit boundary. A response that fails validation is
-   replayed first, so the failure report describes a retained response.
-*)
-let receive
-  ?board
-  ?ready_budget
-  ?pause
-  (t : Fixture.t)
-  ~started
-  ~request_deselected
-  ~expected
-  =
-  let driver = Fixture.driver t in
-  let ready = Driver.wait_ready ?budget:ready_budget driver ~since:request_deselected in
-  let selected = t.cycle in
-  let read =
-    Driver.read_response driver ~expected ?pause ~decide:Item.commit_if_valid ()
-  in
-  Option.iter board ~f:(fun board -> Scoreboard.read board ~selected read);
-  match read.decoded with
-  | Error error ->
-    Fixture.fail
-      t
-      ~phase:Host_sample
-      "response decodes and correlates; it was replayed"
-      ~expected:[%sexp (expected : Wire.Correlation.t)]
-      ~actual:
-        [%sexp (error : Wire.Response.Decode_error.t), (Item.hex read.bytes : string)]
-  | Ok response ->
-    Fixture.expect_ready_cleared t ~deselected:read.deselected;
-    { Exchange.started
-    ; request_deselected
-    ; ready
-    ; response_selected = read.selected
-    ; response_deselected = read.deselected
-    ; bytes = read.bytes
-    ; response
-    }
-;;
-
-(* A complete transaction for [frame]: send it with the gap, then [receive]. *)
-let exchange ?board ?ready_budget ?pause (t : Fixture.t) frame ~expected =
-  let started = t.cycle in
-  let request_deselected = Driver.send_frame (Fixture.driver t) frame in
-  record_request board ~selected:started ~deselected:request_deselected frame;
-  receive ?board ?ready_budget ?pause t ~started ~request_deselected ~expected
-;;
-
-let transact ?board ?ready_budget ?pause t ~tag request =
-  exchange
-    ?board
-    ?ready_budget
-    ?pause
-    t
-    (Item.encode ~tag request)
-    ~expected:(Wire.Request.correlation ~tag request)
-;;
-
-(* [Driver.read_prefix]: reads the first [bits] bits of a response and abandons it.
-   Returns the bits read, packed MSB first, and the deselection cycle; with a [board],
-   records them as an abandoned read selected in the current cycle.
-*)
-let read_prefix ?board (t : Fixture.t) ~bits =
-  let selected = t.cycle in
-  let packed, deselected = Driver.read_prefix (Fixture.driver t) ~bits in
-  Option.iter board ~f:(fun board ->
-    Scoreboard.abandoned board ~selected ~deselected ~bits packed);
-  packed, deselected
-;;
-
-(* The command reached the core exactly once, [Latency.offer_after_deselect] cycles after
-   its frame's deselection, with [request]'s operands.
-*)
-let expect_offered_once t (exchange : Exchange.t) request ~accepted =
-  expect_offers
-    t
-    ~since:exchange.started
-    "the command is offered once, three cycles after its deselection"
-    [ { cycle = exchange.request_deselected + Latency.offer_after_deselect
-      ; request
-      ; accepted
-      }
-    ]
-;;
-
-(* Out-of-contract selection while a command is in flight: select, clock [bytes] as if
-   sending a request ([Driver.send] checks that LDO stays low at every rise), deselect,
-   and hold the gap. Returns the deselection cycle.
-*)
-let disturb ?board (t : Fixture.t) bytes =
-  Fixture.note t "out-of-contract selection";
-  let selected = t.cycle in
-  let deselected = Driver.send_frame (Fixture.driver t) bytes in
-  record_request board ~selected ~deselected bytes;
-  deselected
-;;
-
-let expect_response t what ~expected (actual : Wire.Response.t) =
-  Fixture.check
-    t
-    ~phase:Host_sample
-    what
-    [%sexp_of: Wire.Response.t]
-    [%equal: Wire.Response.t]
-    ~expected
-    actual
-;;
-
-(* Response written out from a scenario's expected fields. *)
-let response ~tag command ?(payload = Wire.Response.Payload.Empty) result =
-  { Wire.Response.tag; command = Wire.Command.to_int command; result; payload }
-;;
-
-(* A legal INFO with a fresh tag, answered with the fixed INFO descriptor: the check that
-   the loader accepts new work after a malformed frame or a cancellation.
-*)
-let info_payload =
-  Wire.Response.Payload.Info
-    { wire_major = 1
-    ; wire_minor = 0
-    ; isa_version = 1
-    ; memory_layout = 1
-    ; capabilities =
-        [ Status; Program_load; Program_read; Program_verify; Run; Stop; Abort ]
-    ; memory_word_bits = 16
-    ; memory_depth = 256
-    ; max_request_payload_bytes = 4
-    ; protocol_pin_count = 8
-    }
-;;
-
-let expect_info_works ?board (t : Fixture.t) ~tag what =
-  let since = t.cycle in
-  let exchange = transact ?board t ~tag Info in
-  expect_response
-    t
-    what
-    ~expected:(response ~tag Info ~payload:info_payload Complete)
-    exchange.response;
-  expect_no_offers t ~since what
-;;
-
-(* The report of [f]'s [Harness_failure]; fails at [Post_run] if [f] does not raise. *)
-let require_failure t what f =
-  match Fixture.failure_of f with
-  | Some failure -> failure
-  | None -> Fixture.fail t ~phase:Post_run ("the negative check must fail: " ^ what)
-;;
-
-(* Serial monitor expectations: the SP2 scoreboard over the serial monitor alone. *)
-
-(* The serial monitor's items since the last call are exactly [expected], in order.
-   Compared items are dequeued.
-*)
-let expect_observed t what expected =
-  let observed = Fixture.serial_observed t in
-  let actual = Queue.to_list observed in
-  Queue.clear observed;
-  Fixture.check
-    t
-    ~phase:Post_run
-    what
-    [%sexp_of: Scoreboard.serial_item list]
-    [%equal: Observed.t list]
-    ~expected
-    actual
-;;
-
-(* Cycles [Driver.begin_frame] holds after LSEL_N falls. [Read.selected] counts from after
-   it; the monitor's [selected] is the cycle LSEL_N fell.
-*)
-let lead t =
-  let timing = Fixture.timing t in
-  Int.max 0 (timing.select_lead - timing.clock_low)
-;;
-
-(* Expected items, from the driver's side only. *)
-
-let request ?extra_bits ?extra_byte ~selected ~deselected bytes : Observed.t =
-  Request
-    { selected
-    ; deselected
-    ; bytes
-    ; extra_bits = extra_bits_sent ?extra_bits ?extra_byte ()
-    }
-;;
-
-let response_read t (read : Read.t) : Observed.t =
-  Response
-    { selected = read.selected - lead t
-    ; deselected = read.deselected
-    ; bytes = read.bytes
-    ; extra_bits = []
-    ; decoded = Scoreboard.uncorrelated read.decoded
-    ; ending =
-        (match read.outcome with
-         | Commit -> Commit
-         | Replay -> Replay)
-    }
-;;
-
-let committed t (exchange : Exchange.t) : Observed.t =
-  Response
-    { selected = exchange.response_selected - lead t
-    ; deselected = exchange.response_deselected
-    ; bytes = exchange.bytes
-    ; extra_bits = []
-    ; decoded = Ok exchange.response
-    ; ending = Commit
-    }
-;;
-
-(* A request frame [frame] and its committed response. *)
-let transaction ?extra_bits ?extra_byte t (exchange : Exchange.t) frame =
-  [ request
-      ?extra_bits
-      ?extra_byte
-      ~selected:exchange.started
-      ~deselected:exchange.request_deselected
-      frame
-  ; committed t exchange
-  ]
-;;
-
-(* [transact], then requires the serial monitor to have seen exactly its frame and
-   committed response. Returns the exchange, for expectations on the Control_port side.
-*)
-let expect_transaction t ~tag request =
-  let exchange = transact t ~tag request in
-  expect_observed
-    t
-    (Sexp.to_string [%sexp (request : Wire.Request.t)])
-    (transaction t exchange (Item.encode ~tag request));
-  exchange
-;;
