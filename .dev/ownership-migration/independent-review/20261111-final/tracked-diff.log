--- a/test/host_link/endpoint/endpoint_serial_monitor_tests.ml
+++ /dev/null
@@ -1,255 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "endpoint_serial_monitor_tests.ml" *)
-(* SP2: the serial-host agent's passive monitor agrees with its driver at the composed
-   [Host_link]'s serial pins, written against the endpoint fixture.
-
-   The scoreboard here compares two independent streams. Expected items are written from
-   what the driver sent and from the results it returned ([Read.t], [Exchange.t], a prefix
-   and its deselection cycle). Actual items are the monitor's, rebuilt from the sampled
-   pins alone. Neither component reads the other; only this file and its helpers in
-   [Endpoint_scenario] ([expect_observed] and the expected-item builders) join them. The
-   last case corrupts one LDI bit on its way to the DUT, through the fixture's test-only
-   adapter path ([ldi_fault]), and requires the scoreboard to report it. See
-   docs/serial_host_pilot.md, SP2.
-
-   Ported from the archived SP2 suite's serial_host_monitor_tests.ml with the same names,
-   scenarios, order, and checks (docs/serial_host_pilot.md, SP5). The serial comparisons
-   stay this file's own, so each drains the serial monitor itself. The contract-faithful
-   cases run under [Scoreboard.run] with only Control_port expectations on the board: the
-   offers and READBACK responses the test writes out, and, on the serial side, that
-   nothing was left unchecked. The agent construction case builds no fixture, and the
-   fault injection runs under [Fixture.run].
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Endpoint_scenario
-module Wire = Protemu_host_link_wire.Wire
-module Serial_host = Protemu_serial_host_agent
-module Driver = Serial_host.Driver
-module Item = Serial_host.Item
-module Observed = Serial_host.Item.Observed
-module Raw = Serial_host.Item.Raw
-module Exchange = Serial_host.Item.Exchange
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-module Scoreboard = Endpoint.Scoreboard
-
-let%expect_test "the monitor's items for one WRITE_WORD transaction" =
-  Scoreboard.run ~scenario:"monitor trace" (fun t board ->
-    let exchange = transact t ~tag:0x31 (Write_word { address = 0x12; word = 0xbeef }) in
-    Queue.iter (Fixture.serial_observed t) ~f:(fun item ->
-      print_s (Scoreboard.sexp_of_serial_item item));
-    expect_observed
-      t
-      "WRITE_WORD"
-      (transaction
-         t
-         exchange
-         (Item.encode ~tag:0x31 (Write_word { address = 0x12; word = 0xbeef })));
-    ignore
-      (Scoreboard.offer
-         board
-         ~deselected:exchange.request_deselected
-         (Load_write { address = 0x12; data = 0xbeef })
-         ~accepted:true
-       : int));
-  [%expect
-    {|
-    (request (selected 8) (deselected 716)
-     (bytes "a5 10 31 11 04 00 12 00 ef be ff") (extra_bits ()))
-    (response (selected 721) (deselected 1237) (bytes "5a 10 31 11 00 00 00 1e")
-     (extra_bits ())
-     (decoded (Ok ((tag 49) (command 17) (result Complete) (payload Empty))))
-     (ending Commit))
-    |}]
-;;
-
-let%test_unit "legal INFO, READ, and VERIFY transactions" =
-  (* The READBACK data is the responder's default memory, [address * 0x0101 lxor 0xa55a]:
-     0xa659 at address 3 and 0xa15e at address 4.
-  *)
-  Scoreboard.run ~scenario:"monitor: legal transactions" (fun t board ->
-    let offer (exchange : Exchange.t) request ~data ~matches =
-      let offered =
-        Scoreboard.offer
-          board
-          ~deselected:exchange.request_deselected
-          request
-          ~accepted:true
-      in
-      Scoreboard.readback board ~offered ~data ~matches
-    in
-    ignore (expect_transaction t ~tag:0x41 Info : Exchange.t);
-    offer
-      (expect_transaction t ~tag:0x42 (Read_word { address = 3 }))
-      (Read { address = 3 })
-      ~data:0xa659
-      ~matches:false;
-    offer
-      (expect_transaction
-         t
-         ~tag:0x43
-         (Verify_word { address = 3; expected = (Fixture.responder t).memory.(3) }))
-      (Verify { address = 3; expected = 0xa659 })
-      ~data:0xa659
-      ~matches:true;
-    offer
-      (expect_transaction t ~tag:0x44 (Verify_word { address = 4; expected = 0 }))
-      (Verify { address = 4; expected = 0 })
-      ~data:0xa15e
-      ~matches:false)
-;;
-
-let%test_unit "a malformed request is observed as the raw bytes clocked" =
-  Scoreboard.run ~scenario:"monitor: malformed request" (fun t (_ : Scoreboard.t) ->
-    let info = Wire.Command.to_int Info in
-    List.iter
-      [ Raw.frame ~magic:0x00 ~tag:0x24 ~command:info []
-      ; Raw.flip_last (Item.encode ~tag:0x25 Info) ~mask:0x80
-      ]
-      ~f:(fun frame ->
-        let started = t.cycle in
-        let request_deselected = Driver.send_frame (Fixture.driver t) frame in
-        let exchange =
-          receive
-            t
-            ~started
-            ~request_deselected
-            ~expected:{ tag = Char.to_int frame.[2]; command = info }
-        in
-        expect_observed t ("malformed " ^ Item.hex frame) (transaction t exchange frame)))
-;;
-
-let%test_unit "a request with trailing extra bits keeps them apart from its bytes" =
-  Scoreboard.run ~scenario:"monitor: extra bits" (fun t (_ : Scoreboard.t) ->
-    let frame = Item.encode ~tag:0x26 (Write_word { address = 0; word = 0x1234 }) in
-    let started = t.cycle in
-    let request_deselected =
-      Driver.send_frame (Fixture.driver t) frame ~extra_bits:3 ~extra_byte:'\xa0'
-    in
-    let exchange =
-      receive
-        t
-        ~started
-        ~request_deselected
-        ~expected:{ tag = 0x26; command = Wire.Command.to_int Write_word }
-    in
-    expect_observed
-      t
-      "WRITE_WORD and three bits"
-      (transaction t exchange frame ~extra_bits:3 ~extra_byte:'\xa0'))
-;;
-
-let%test_unit "a replayed response, then its commit" =
-  Scoreboard.run ~scenario:"monitor: replay" (fun t (_ : Scoreboard.t) ->
-    let driver = Fixture.driver t in
-    let frame = Item.encode ~tag:0x27 Status in
-    let expected = Wire.Request.correlation ~tag:0x27 Status in
-    let started = t.cycle in
-    let request_deselected = Driver.send_frame driver frame in
-    ignore (Driver.wait_ready driver ~since:request_deselected : int);
-    let replayed = Driver.read_response driver ~expected ~decide:(fun _ -> Replay) () in
-    let exchange = receive t ~started ~request_deselected ~expected in
-    expect_observed
-      t
-      "STATUS replayed once, then committed"
-      [ request ~selected:started ~deselected:request_deselected frame
-      ; response_read t replayed
-      ; committed t exchange
-      ])
-;;
-
-let%test_unit "abandoned reads before and after the header" =
-  (* INFO is the largest response, so the frame its header declares is
-     [Wire.Response.max_length] bytes. Twenty-four bits stop inside the header; sixty-four
-     stop after it, where only the declared length shows the read was cut short.
-  *)
-  Scoreboard.run ~scenario:"monitor: abandoned reads" (fun t (_ : Scoreboard.t) ->
-    let driver = Fixture.driver t in
-    let frame = Item.encode ~tag:0x28 Info in
-    let started = t.cycle in
-    let request_deselected = Driver.send_frame driver frame in
-    ignore (Driver.wait_ready driver ~since:request_deselected : int);
-    let abandoned ~bits ~decoded =
-      let selected = t.cycle in
-      let bytes, deselected = Driver.read_prefix driver ~bits in
-      Observed.Response
-        { selected; deselected; bytes; extra_bits = []; decoded; ending = Abandoned }
-    in
-    let short =
-      abandoned
-        ~bits:24
-        ~decoded:(Error (Truncated { expected = Wire.Response.min_length; actual = 3 }))
-    in
-    let past_header =
-      abandoned
-        ~bits:64
-        ~decoded:(Error (Truncated { expected = Wire.Response.max_length; actual = 8 }))
-    in
-    let exchange =
-      receive
-        t
-        ~started
-        ~request_deselected
-        ~expected:(Wire.Request.correlation ~tag:0x28 Info)
-    in
-    expect_observed
-      t
-      "INFO abandoned twice, then committed"
-      [ request ~selected:started ~deselected:request_deselected frame
-      ; short
-      ; past_header
-      ; committed t exchange
-      ])
-;;
-
-let%test_unit "the agent is active only with a driver" =
-  let passive = Serial_host.Agent.create Serial_host.Config.passive in
-  assert (Option.is_none passive.driver);
-  assert (Queue.is_empty (Serial_host.Agent.observed passive));
-  match Serial_host.Agent.create (Serial_host.Config.active ()) with
-  | (_ : Serial_host.Agent.t) -> raise_s [%message "an active agent without hooks"]
-  | exception _ -> ()
-;;
-
-let%expect_test "the scoreboard reports an LDI bit the driver did not send" =
-  (* Test-only: the adapter inverts LDI on its way to the DUT for the whole interval of
-     request bit 20, from the fall before it to the fall after it. That is bit 4 of the
-     tag byte, so the pins carry tag 0x4a where the driver sent 0x42. The driver's own
-     record is unchanged; only the monitor can see the difference.
-  *)
-  Fixture.run ~transcript_limit:4 ~scenario:"negative: one LDI bit corrupted" (fun t ->
-    let frame = Item.encode ~tag:0x42 Info in
-    let started = t.cycle in
-    let timing = Fixture.timing t in
-    let period = timing.clock_low + timing.clock_high in
-    let from = started + lead t + (20 * period) in
-    t.ldi_fault <- (fun cycle -> cycle >= from && cycle < from + period);
-    let request_deselected = Driver.send_frame (Fixture.driver t) frame in
-    t.ldi_fault <- Fn.const false;
-    print_s
-      (require_failure t "a corrupted LDI bit" (fun () ->
-         expect_observed
-           t
-           "the monitor saw the frame the driver sent"
-           [ request ~selected:started ~deselected:request_deselected frame ])));
-  [%expect
-    {|
-    (test/host_link/hardware_loader_testbench.ml.Harness_failure
-     (scenario "negative: one LDI bit corrupted") (cycle 463) (phase Post_run)
-     (what "the monitor saw the frame the driver sent")
-     (expected
-      (((request (selected 8) (deselected 460) (bytes "a5 10 42 00 00 00 df")
-         (extra_bits ())))))
-     (actual
-      (((request (selected 8) (deselected 460) (bytes "a5 10 4a 00 00 00 df")
-         (extra_bits ())))))
-     (transcript
-      ((earlier_events_omitted 3)
-       (events
-        ((8 (Sent (bytes "a5 10 42 00 00 00 df") (extra_bits 0)))
-         (11 (Busy true)) (460 (Select false)) (463 (Ready true)))))))
-    |}]
-;;
diff --git a/test/host_link/endpoint/endpoint_transaction_tests.ml b/test/host_link/endpoint/endpoint_transaction_tests.ml
deleted file mode 100644
index c0d6e88..0000000
--- a/test/host_link/endpoint/endpoint_transaction_tests.ml
+++ /dev/null
@@ -1,834 +0,0 @@
-(* University of Florida *)
-(* Author: Bohdan Purtell *)
-(* Module: "endpoint_transaction_tests.ml" *)
-(* HL4a: legal transactions, host timing, pauses, and response replay/commit at the
-   composed [Host_link]'s serial pins and [Control_port], written against the endpoint
-   fixture, its agents, and the scoreboard.
-
-   Expected responses are written out from the P3.5 record and the scenario's responder
-   configuration, never computed from the offered request or the loader's logic. Each test
-   says whether its responder follows the [Control_port] contract or deliberately departs
-   from it as a loader robustness probe. See docs/host_link_hl4a_record.md for the case
-   map.
-
-   Ported from the HL4a suite's hardware_loader_transaction_tests.ml with the same names,
-   scenarios, order, and checks (docs/serial_host_pilot.md, SP5). Contract-faithful
-   scenarios run under [Scoreboard.run], which also requires the monitors to have seen
-   each frame and read the driver reports and each offer and READBACK response the test
-   writes out; so do the refused STOP and ABORT probes, whose host traffic is in contract.
-   Other robustness probes, and scenarios the scoreboard cannot express, run under
-   [Fixture.run].
-*)
-
-open! Core
-open! Hardcaml_protemu
-open! Endpoint_scenario
-module Wire = Protemu_host_link_wire.Wire
-module Serial_host = Protemu_serial_host_agent
-module Driver = Serial_host.Driver
-module Item = Serial_host.Item
-module Timing = Serial_host.Config.Timing
-module Pause = Serial_host.Item.Pause
-module Control_port_agent = Protemu_control_port_agent
-module Request = Control_port_agent.Item.Request
-module Status = Control_port_agent.Item.Status
-module Response = Control_port_agent.Item.Response
-module Offer = Control_port_agent.Item.Offer
-module Endpoint = Protemu_host_link_endpoint
-module Fixture = Endpoint.Fixture
-module Scoreboard = Endpoint.Scoreboard
-module Latency = Endpoint.Latency
-
-(* Raw INFO response for tag 0x5c, with its CRC from an independent bitwise CRC-8/ATM
-   script (check value [123456789] -> [0xf4]), not from [Wire].
-*)
-let info_response_5c = "5a 10 5c 00 00 0d 00 01 00 01 01 7f 00 10 00 00 01 04 00 08 36"
-
-let%test_unit "INFO and STATUS report the fixed descriptor and the core's status" =
-  (* Contract-faithful: status is a live observation with no qualifier (item 9). *)
-  Scoreboard.run ~scenario:"INFO and STATUS" (fun t board ->
-    let exchange = transact ~board t ~tag:0x5c Info in
-    Fixture.check
-      t
-      ~phase:Host_sample
-      "INFO bytes"
-      [%sexp_of: string]
-      String.equal
-      ~expected:info_response_5c
-      (Item.hex exchange.bytes);
-    expect_response
-      t
-      "INFO"
-      ~expected:(response ~tag:0x5c Info ~payload:info_payload Complete)
-      exchange.response;
-    expect_no_offers t ~since:exchange.started "INFO is answered without an offer";
-    expect_int
-      t
-      "INFO is ready one cycle after its dispatch cycle"
-      ~expected:
-        (exchange.request_deselected
-         + Latency.offer_after_deselect
-         + Latency.ready_after_offer)
-      exchange.ready;
-    let status_cases : (string * Status.t * Wire.Status.t) list =
-      [ ( "after reset"
-        , Status.halted_idle
-        , { flags = [ Enabled; Halted; Engines_idle ]
-          ; image_length = 0
-          ; words_written = 0
-          ; words_verified = 0
-          ; pc = 0
-          ; fault_kind = No_fault
-          ; phase = Halted
-          } )
-      ; ( "verified image after a normal halt"
-        , { Status.halted_idle with
-            image_valid = 1
-          ; image_length = 3
-          ; words_written = 3
-          ; words_verified = 3
-          ; normal_halt = 1
-          ; pc = 2
-          }
-        , { flags = [ Enabled; Halted; Engines_idle; Image_valid; Normal_halt ]
-          ; image_length = 3
-          ; words_written = 3
-          ; words_verified = 3
-          ; pc = 2
-          ; fault_kind = No_fault
-          ; phase = Halted
-          } )
-      ; ( "executing with an engine on pin 1; the 17-bit PC is reported in 16 bits"
-        , { Status.running with image_length = 10; pc = 0x1_0007 }
-        , { flags =
-              [ Enabled; Image_valid; Execution_active; Pin_output_enabled; Pin_claimed ]
-          ; image_length = 10
-          ; words_written = 0
-          ; words_verified = 0
-          ; pc = 0x0007
-          ; fault_kind = No_fault
-          ; phase = Mechanism_wait
-          } )
-      ; ( "invalid-instruction fault"
-        , { Status.halted_idle with
-            image_valid = 1
-          ; image_length = 1
-          ; words_written = 1
-          ; words_verified = 1
-          ; execution_fault = 1
-          ; fault_kind = 1
-          ; phase = 6
-          ; pc = 1
-          }
-        , { flags = [ Enabled; Halted; Engines_idle; Image_valid; Execution_fault ]
-          ; image_length = 1
-          ; words_written = 1
-          ; words_verified = 1
-          ; pc = 1
-          ; fault_kind = Invalid_base
-          ; phase = Fault
-          } )
-      ; ( "load in progress with a failed verify, a fetch fault, and a software claim"
-        , { Status.halted_idle with
-            load_active = 1
-          ; verification_failed = 1
-          ; fetch_fault = 1
-          ; image_length = 256
-          ; words_written = 255
-          ; words_verified = 17
-          ; software_claim = 0x80
-          ; fault_kind = 9
-          ; phase = 3
-          }
-        , { flags =
-              [ Enabled
-              ; Halted
-              ; Engines_idle
-              ; Load_active
-              ; Verification_failed
-              ; Fetch_fault
-              ; Pin_claimed
-              ]
-          ; image_length = 256
-          ; words_written = 255
-          ; words_verified = 17
-          ; pc = 0
-          ; fault_kind = Mechanism_protocol
-          ; phase = Extension_wait
-          } )
-      ]
-    in
-    List.iteri status_cases ~f:(fun index (what, status, expected) ->
-      set_status t status;
-      let tag = 0x60 + index in
-      let exchange = transact ~board t ~tag Status in
-      expect_response
-        t
-        ("STATUS " ^ what)
-        ~expected:(response ~tag Status ~payload:(Status expected) Complete)
-        exchange.response;
-      expect_no_offers t ~since:exchange.started "STATUS is answered without an offer"))
-;;
-
-(* One accepted command: its request, response, and when LRDY rises after the offer.
-   [readback] is the READBACK pulse's data and match flag for READ and VERIFY.
-*)
-type accepted_case =
-  { what : string
-  ; wire : Wire.Request.t
-  ; request : Request.t
-  ; expected : Wire.Response.t
-  ; ready_after_offer : int
-  ; readback : (int * bool) option
-  ; prepare : Fixture.t -> unit
-  }
-
-let%test_unit "each shared command is offered once with its operands and completes on \
-               time"
-  =
-  (* Contract-faithful: the responder accepts every offer, READBACK responds at item 5's
-     cycle, and ABORT cleanup is visible after the accepting edge (item 6).
-  *)
-  Scoreboard.run ~scenario:"accepted commands" (fun t board ->
-    let immediate = Latency.ready_after_offer in
-    let readback = Latency.readback_after_offer + Latency.ready_after_completion in
-    let abort = Latency.abort_clean_after_offer + Latency.ready_after_completion in
-    let no_prep (_ : Fixture.t) = () in
-    let cases =
-      [ { what = "LOAD_START of one word"
-        ; wire = Load_start { length = 1 }
-        ; request = Load_start { length = 1 }
-        ; expected = response ~tag:0x10 Load_start Complete
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = no_prep
-        }
-      ; { what = "LOAD_START of the whole memory"
-        ; wire = Load_start { length = 256 }
-        ; request = Load_start { length = 256 }
-        ; expected = response ~tag:0x11 Load_start Complete
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = no_prep
-        }
-      ; { what = "WRITE_WORD at address 0"
-        ; wire = Write_word { address = 0; word = 0xbeef }
-        ; request = Load_write { address = 0; data = 0xbeef }
-        ; expected = response ~tag:0x12 Write_word Complete
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = no_prep
-        }
-      ; { what = "WRITE_WORD at the last address"
-        ; wire = Write_word { address = 255; word = 0x1234 }
-        ; request = Load_write { address = 255; data = 0x1234 }
-        ; expected = response ~tag:0x13 Write_word Complete
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = no_prep
-        }
-      ; { what = "READ_WORD"
-        ; wire = Read_word { address = 7 }
-        ; request = Read { address = 7 }
-        ; expected = response ~tag:0x14 Read_word ~payload:(Word 0x0bad) Complete
-        ; ready_after_offer = readback
-        ; readback = Some (0x0bad, false)
-        ; prepare = (fun t -> (Fixture.responder t).memory.(7) <- 0x0bad)
-        }
-      ; { what = "VERIFY_WORD that matches"
-        ; wire = Verify_word { address = 9; expected = 0x5678 }
-        ; request = Verify { address = 9; expected = 0x5678 }
-        ; expected = response ~tag:0x15 Verify_word ~payload:(Word 0x5678) Complete
-        ; ready_after_offer = readback
-        ; readback = Some (0x5678, true)
-        ; prepare = (fun t -> (Fixture.responder t).memory.(9) <- 0x5678)
-        }
-      ; { what = "LOAD_COMPLETE"
-        ; wire = Load_complete
-        ; request = Load_complete
-        ; expected = response ~tag:0x16 Load_complete Complete
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = no_prep
-        }
-      ; { what = "RUN"
-        ; wire = Run
-        ; request = Run
-        ; expected = response ~tag:0x17 Run Complete
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = no_prep
-        }
-      ; { what = "STOP while executing"
-        ; wire = Stop
-        ; request = Stop
-        ; expected = response ~tag:0x18 Stop Accepted_pending
-        ; ready_after_offer = immediate
-        ; readback = None
-        ; prepare = (fun t -> set_status t Status.running)
-        }
-      ; { what = "ABORT while an engine drives pin 1"
-        ; wire = Abort
-        ; request = Abort
-        ; expected = response ~tag:0x19 Abort Complete
-        ; ready_after_offer = abort
-        ; readback = None
-        ; prepare = (fun t -> set_status t Status.running)
-        }
-      ; { what = "STOP while halted"
-        ; wire = Stop
-        ; request = Stop
