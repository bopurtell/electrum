-    load_complete_valid_i = 0;
-
-    run_valid_i = 1;
-    #1;
-    if (!run_accepted_o) $fatal(1, "RUN was not accepted");
-    tick;
-    if (halted_o) $fatal(1, "RUN failed");
-    run_valid_i = 0;
-
-    program_cycles = 0;
