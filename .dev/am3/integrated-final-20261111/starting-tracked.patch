-(* "a5 10 00" -> the three bytes. *)
-let bytes hex =
-  String.split hex ~on:' '
-  |> List.filter ~f:(Fn.non String.is_empty)
-  |> List.map ~f:(fun byte -> Char.of_int_exn (Int.of_string ("0x" ^ byte)))
-  |> String.of_char_list
-;;
-
-let hex bytes =
-  String.to_list bytes
-  |> List.map ~f:(fun byte -> sprintf "%02x" (Char.to_int byte))
-  |> String.concat ~sep:" "
